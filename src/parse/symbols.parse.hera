---
type: civet
---
# symbols.parse.hera

import {hashof} from 'datatypes'
import {clearHash} from 'llutils'
import {str2indents} from 'hera-parse'

let hSymbols: hashof<string> = {}

# ---------------------------------------------------------------------------

#beginParse(text)
	hSymbols = {}
	return str2indents(text)

AllSymbols
	LibBlock+ NL*
		return hSymbols

LibBlock
	LibName NL INDENT Line+ UNDENT
		for lNames of $4
			for name of lNames
				hSymbols[name] = $1
		return

Line
	Symbol (_ Symbol)* NL
		lNames: string[] := [$1]
		for [pre, name] of $2
			lNames.push name
		return lNames

LibName
	/[A-Za-z_][A-Za-z0-9_-]*/
		return $0

Symbol
	/[A-Za-z_][A-Za-z0-9_]*/
		return $0

INDENT
	/\x0F/

UNDENT
	/\x0E/

_
	" "*

NL
	/\r?\n/
