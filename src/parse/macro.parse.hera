---
type: civet
---
# macro.parse.hera

import {str2indents} from 'hera-parse'

#beginParse(text)
	return str2indents(text) + '\n'

Contents
	Block* NL*
		for blk in $1
			mainBlock.add blk
		return mainBlock

Block
	Line NL
		return new CBlock($1)

	Line INDENT Block+ UNDENT
		blk := new CBlock($1)
		for sub of $2[1]
			blk.add sub
		return blk

Line
	/[^\n\x0F\x0E]+/
		return $0

INDENT
	/\x0F/

UNDENT
	/\x0E/

NL
	/\r?\n/
