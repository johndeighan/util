---
type: civet
---
# macro.parse.hera

import {undef, defined, assert} from 'base'
import {isArray} from 'datatypes'
import {CBlock} from 'block'

# --- mainBlock will have an empty header
mainBlock := new CBlock()

#beginParse
	mainBlock.reset()

Contents
	Block* NL*
		for blk in $1
			mainBlock.add blk
		return mainBlock

Block
	Line NL
		return new CBlock($1)

	Line INDENT Block+ UNDENT
		blk := new CBlock($1)
		for sub of $2[1]
			blk.add sub
		return blk

Line
	/[^\n\x0F\x0E]+/
		return $0

INDENT
	/\x0F/

UNDENT
	/\x0E/

NL
	/\r?\n/
