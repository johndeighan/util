---
type: civet
---
# nice.parse.hera

import {undef, defined, assert} from 'base'
import {hash} from 'datatypes'
import {str2indents} from 'hera-parse'

#beginParse(text)
	# --- input parameter is 'text'
	return str2indents(text)

Value
	# --- trailing newlines are permitted, but ignored
	List NL*
		return $1

	Hash NL*
		return $1

	Primitive NL*
		return $1

List
	LItem+
		return $1

Hash
	HItem+
		h: hash := {}
		for [key, val] of $1
			h[key] = val
		return hash

# ---------------------------------------------------------------------------

LItem
	"-" WS Primitive NL
		return $3

	"-" _ NL INDENT LItem+ UNDENT
		return $5

HItem
	Key WS Primitive NL
		return [$1, $3]

	Key _ NL INDENT HItem+ UNDENT
		return $5

# ---------------------------------------------------------------------------

Key
	/[A-Za-z]+/ ":"
		return $1[0]

Primitive

	# --- Special Values
	"｟" Spec "｠"
		return $2

	# --- Forced Strings
	/“([^\n\x0F\x0E]+)/
		return $1

	# --- BigInt
	/(\d+)n/
		return BigInt($1)

	# --- number
	/\d+(\.\d+)?/
		return JSON.parse($0)

	# --- ordinary strings (exclude if leading [ or { )
	/[^\n\x0F\x0E\[\{]+/
		return $0

	# --- JSON parsable values
	/[^\n\x0F\x0E]+/
		return JSON.parse($0)

Spec
	"undef"
		return undef
	"null"
		return null
	"true"
		return true
	"false"
		return false
	"NaN"
		return Number.NaN
	"inf"
		return Infinity
	"neginf"
		return -Infinity
	"symbol" /[^｠]*/
		return Symbol($2)

_
	/[\x20\t]*/

WS
	/\x20+/

INDENT
	/\x0F/

UNDENT
	/\x0E/

NL
	/\r?\n/

