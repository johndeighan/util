---
type: civet
---
# macros.parse.hera

import {defined, notdefined, assert} from 'base'
import {str2indents} from 'hera-parse'
import {
	TTextBlock, TMacroBlock, splitMacroHeader,
	} from 'macros'

#beginParse(text, hOptions)
	return str2indents(text)

# --- Returns (TTextBlock | TMacroBlock)[]

AllBlocks
	Block* NL*
		return $1

Block
	"\x23" Name WS Args NL Content?
		lContent := defined($6) ? $6 : []
		return {type: 'macro', name: $2, args: $4, lContent} as TMacroBlock

	Line NL Content?
		lContent := defined($3) ? $3 : []
		return {type: 'text', firstLine: $1, lContent} as TTextBlock

Name
	/[A-Za-z_][A-Za-z0-9_]*/
		name := $0
		assert not name.startsWith('#')
		return name

Content
	INDENT Block+ UNDENT
		return $2

Args
	/[^\n\r\x0F\x0E]*/
		return $1[0]

Line
	/[^\n\r\x0F\x0E]+/
		assert defined($0), "result not defined!!!"
		return $0

INDENT
	/\x0F/

UNDENT
	/\x0E/

NL
	/\r?\n/

WS
	/\x20*/
