---
type: civet
---
# dir-tree.parse.hera

import {undef, defined, assert} from 'base'
import {hash} from 'datatypes'
import {indented, undented} from 'indent'

export type TFileOp = {
		op: 'clearDir' | 'compile'
		path: string
		}
	| {
		op: 'barf'
		path: string
		contents: string
		}

lFileOps: TFileOp[]  := []
lPathParts: string[] := []

getPath := (fileName: string = '') =>
	if fileName
		return [...lPathParts, fileName].join('/')
	else
		return [...lPathParts].join('/')

#beginParse
	# --- reset everything
	lFileOps.length  = 0
	lPathParts.length = 0

FullDesc
	Root NL (FileDesc / DirDesc)+
		# --- return whatever file ops have been saved
		return lFileOps

Root
	/\.(?:\/[A-Za-z0-9_-]+)*/ _ "clear"?
		root := $1[0]
		lFileOps.push {
			op: defined($3) ? 'clearDir' : 'mkDir'
			path: root
			}
		lPathParts.push root
		return

FileDesc
	Name _ "compile"? INDENT Content UNDENT
		path := getPath($1)
		lFileOps.push {
			op: 'barf'
			path
			contents: $5
			}
		if defined($3)
			lFileOps.push {
				op: 'compile'
				path
				}
		return

DirDesc
	DirName INDENT (DirDesc / FileDesc)+ UNDENT
		lPathParts.pop()
		return

DirName
	"/" Name _ "clear"?
		lPathParts.push($2)
		lFileOps.push {
			op: defined($4) ? 'clearDir' : 'mkDir'
			path: getPath()
			}
		return

Content
	Block+
		return $1.join('\n')

Block
	NL? Line IndentedBlock?
		return defined($3) ? ($2 + '\n' + $3) : $2

IndentedBlock
	INDENT Content UNDENT
		return indented($2)

Line
	/[^\x0F\x0E\n\r]*/
		return $0

Name
	/[A-Za-z_.-][A-Za-z0-9_.-]+/
		return $0

INDENT
	/\x0F/     # ASCII shift-in

UNDENT
	/\x0E/     # ASCII shift-out

NL
	/\r?\n/

_
	/\x20*/
