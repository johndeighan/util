---
type: civet
---
# dir-tree.parse.hera

import {undef, defined, assert} from 'base'
import {hash} from 'datatypes'
import {indented, undented} from 'indent'
import {str2indents} from 'hera-parse'
import {TFileOp} from 'unit-test'

lFileOps: TFileOp[]  := []
lPathParts: string[] := []

getPath := (fileName: string = '') =>
	if fileName
		return [...lPathParts, fileName].join('/')
	else
		return [...lPathParts].join('/')

#beginParse(text)
	# --- reset everything
	lFileOps.length  = 0
	lPathParts.length = 0

	# --- input parameter is 'text'
	return str2indents(text)

FullDesc
	Root (FileDesc / DirDesc)+ NL*
		# --- return whatever file ops have been saved
		return lFileOps

Root
	/\.(\/[A-Za-z0-9_-]+)*/ _ "clear"? NL
		root := $1[0]
		lFileOps.push {
			op: defined($3) ? 'clearDir' : 'mkDir'
			path: root
			}
		lPathParts.push root
		return root

FileDesc
	Name _ "compile"? NL INDENT Content UNDENT
		path := getPath($1)
		lFileOps.push {
			op: 'barf'
			path
			contents: $6
			}
		if defined($3)
			lFileOps.push {
				op: 'compile'
				path
				}
		return

DirDesc
	DirName NL INDENT (DirDesc / FileDesc)+ UNDENT
		lPathParts.pop()
		return

DirName
	"/" Name _ "clear"?
		lPathParts.push($2)
		lFileOps.push {
			op: defined($4) ? 'clearDir' : 'mkDir'
			path: getPath()
			}
		return

Content
	Block+
		return $1.join('\n')

Block
	NL? Line IndentedBlock?
		return defined($3) ? ($2 + $3) : $2

IndentedBlock
	INDENT Content UNDENT
		return indented($2)

Line
	/[^\x0F\x0E\n\r]*/
		return $0

Name
	/[A-Za-z_.\$-][A-Za-z0-9_.\$-]+/
		return $0

INDENT
	/\x0F/     # ASCII shift-in

UNDENT
	/\x0E/     # ASCII shift-out

NL
	/\r?\n/

_
	/\x20*/
