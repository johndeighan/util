# dir-tree.parse.hera

# --- Every hera parser must export symbols:
#        pm    - a CParseMatches object
#        reset - a function called before each parse
```
import {CParseMatches} from 'parse-utils';
export let pm = new CParseMatches();

import {undef, defined, assert, hash} from 'datatypes';
import {indented, undented} from 'indent';

export type TFileOp = {
		op: 'clearDir' | 'compile'
		path: string
		}
	| {
		op: 'barf'
		path: string
		contents: string
		};

let lFileOps: TFileOp[] = [];
let lPathParts: string[] = [];

export const reset = (str): void => {
	lFileOps.length = 0;
	pm.reset(str);
	}

const getPath = (fileName: string = '') => {
	if (fileName) {
		return [...lPathParts, fileName].join('/');
		}
	else {
		return [...lPathParts].join('/');
		}
	};

```
# --- comments allowed
#     _ is optional whitespace

FullDesc
	Root NL (FileDesc / DirDesc)+ ->
		pm.match('FullDesc', $loc);
		return pm.result(lFileOps);

Root
	/\.(?:\/[A-Za-z0-9_-]+)*/ _ "clear"? ->
		pm.match('Root', $loc);
		let root = $1[0];
		lFileOps.push({
			op: defined($3) ? 'clearDir' : 'mkDir',
			path: root
			});
		lPathParts = [root];
		return;

FileDesc
	Name _ "compile"? INDENT Content UNDENT ->
		pm.match('FileDesc', $loc);
		let path = getPath($1);
		lFileOps.push({
			op: 'barf',
			path,
			contents: $5
			});
		if (defined($3)) {
			lFileOps.push({
				op: 'compile',
				path
				});
			}
		return

DirDesc
	DirName INDENT (DirDesc / FileDesc)+ UNDENT ->
		pm.match('DirDesc', $loc);
		lPathParts.pop();
		return;

DirName
	"/" Name _ "clear"? ->
		pm.match('DirName', $loc);
		lPathParts.push($2);
		lFileOps.push({
			op: defined($4) ? 'clearDir' : 'mkDir',
			path: getPath()
			});
		return;

Content
	Block+ ->
		pm.match('Content', $loc);
		return pm.result($1.join('\n'));

Block
	NL? Line IndentedBlock? ->
		pm.match('Block', $loc);
		return pm.result(defined($3) ? ($2+'\n'+$3) : $2);

IndentedBlock
	INDENT Content UNDENT ->
		pm.match('IndentedBlock', $loc);
		return pm.result(indented($2));

Line
	/[^\x0F\x0E\n\r]*/ ->
		pm.match('Line', $loc);
		return pm.result($0);

Name
	/[A-Za-z_.-][A-Za-z0-9_.-]+/ ->
		pm.match('Name', $loc);
		return pm.result($0);

INDENT
	/\x0F/     # ASCII shift-in

UNDENT
	/\x0E/     # ASCII shift-out

NL
	/\r?\n/

_
	/\x20*/
