# ---------------------------------------------------------------------------

TRY () =>
	debugger
	result := testHeraCode """
		---
		type: civet
		---
		name := 'John Deighan'
		lItems: string[] := []

		#beginParse
			lItems.length = 0

		Main
			/abc/
		"""

	console.log result

	expected := s2"""
		```
		import {CParseMatches} from 'parse-utils';
		export let pm = new CParseMatches();

		const name = 'John Deighan'
		const lItems: string[] = []

		export const reset = (text: string): void => {
			pm.reset(text);
			lItems.length = 0
			}
		```
		"""

SKIP () =>
	path := 'src/parse/macro.parse.hera'
	procOneFile path, doCompileHera
	result := parseText 'macro', """
		abc
		def
			ghi
				jkl
				mno
			pqr
		stu
		""", {debug: true}
	DUMP result, 'RESULT'
