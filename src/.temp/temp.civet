await EXEC () =>
	debugger
	lPromises := [
		mockPromise(42, 3000)
		mockPromise(23, 1000)
		mockPromise(300, 2000, 'bad')
		]

	lAllResults: TSettleResult<number>[] := []
	await awaitAllSerially lPromises, (result) =>
		lAllResults.push result
	console.log lAllResults

	expected := [
		[true, 42, 0]
		[true, 23, 1]
		[false, "bad", 2]
		]

