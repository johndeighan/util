SKIP () =>
	result := await parseText('macros', """
		abc
			#h1
				def
		""")

	DUMP result, 'result'

	expected := [
		{
			type: "text",
			firstLine: "abc",
			lContent: [
				{
					type: "macro",
					name: "h1",
					args: ""
					lContent: [
						{
							type: 'text'
							firstLine: 'def'
							lContent: []
							}
						],
					}
				],
			}
		]

SKIP () =>
	table := new TextTable('l r%.2f r%.2f')
	table.fullsep '-'
	table.title   'My Expenses'
	table.fullsep '-'
	table.labels  ['', 'Jan', 'Feb']
	table.sep()
	table.data    ['coffee', 30, 40]
	table.fullsep '='
	LOG table.asString({trace: true})

	expected := """
		-----------------------
		      My Expenses
		-----------------------
		           Jan    Feb
		-------- ------- ------
		coffee     30.00  40.00
		=======================
		"""

