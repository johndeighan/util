# temp.civet

import {expandGlobSync} from '@std/fs/expand-glob'
import {TextLineStream} from "jsr:@std/streams/text-line-stream"
import {exists, existsSync} from '@std/fs'

import {LOG, clearLog, getLog} from 'logger'
import {
	undef, defined, notdefined, assert, obviously, croak,
	TAsyncIterator, deepEqual, sleep, getErrStr, colorize,
	decolorize,
	} from 'base'
import {s, toBlock, EXEC, SKIP, sep, rtrim} from 'llutils'
import {fromFSM} from 'fsm'
import {indented} from 'indent'
import {
	execCmd, doRun, doRemoveFile, doRemoveTsFile,
	doInstallCmd, doUninstallCmd, isInstalled,
	} from 'exec'
import {procOneFile, procFiles} from 'proc-files'
import {
	withExt, rmFile, allDirsMatching,
	CReadableFile, CWritableFile,
	barf, slurp, parsePath,
	} from 'fsys'
import {DUMP, toNice, OL, ML} from 'nice'
import {TextTable, splitRows} from 'text-table'
import {
	doCompileHera, testHeraCode, preprocHera, preprocHeraFile,
	} from 'hera-compile'
import {parseText, str2indents} from 'hera-parse'
import {compileHera} from 'llhera'
import {symbolsFromString} from 'symbols'
import {typeCheckTsCode} from 'lltypescript'
import {CAnalysis, analyzeTsCode, doUnitTest} from 'typescript'
import {
	TTextBlock, TMacroBlock, TBlock,
	TMacroFunc, TMacroLib, isMacroLib,
	mkBlk, expand, mapString, mapFile,
	} from 'macros'
import {doCompileCivet, civet2tsFile} from 'civet'
import {
	getFileOps, TFileOp,
	} from 'unit-test'
import {CRule, CRuleBranch, mkCodeBlock} from 'rule'
import {
	awaitAll, TSettleResult,
	} from 'promise-utils'
import {mockPromise} from 'unit-test'
import {doCompileFile} from 'automate'
import {
	stack, setTracing,
	trEnter, trReturn, trYieldFrom, trResume, tr,
	} from 'trace'
import {CCallStack} from 'trace-stack'
import {civet2js, civet2ts} from 'llcivet'

# ---------------------------------------------------------------------------

EXEC () =>
	code := """
		x: string := 'abc'
		"""
	jsCode := await civet2js code
	DUMP jsCode, 'JS'

await SKIP () =>
	clearLog()
	setTracing true

	trEnter 'func1', [42, undef]
	trEnter 'func2', ['abc', []]
	tr undef, 'x'
	trYieldFrom 'func2', 42
	trResume 'func2'
	tr 42, 'x'
	trReturn 'func2'
	trReturn 'func1'

	str := getLog()

	expected := """
		enter func1
		│   enter func2
		│   └─> return ｟undef｠ from func2\n
		└─> return ｟undef｠ from func1\n
		"""

SKIP () =>
	path := "src/test/civet/test.civet"
	tsPath := withExt(path, '.ts')

	await civet2tsFile path, tsPath, {inlineMap: false}
	code := slurp tsPath
	DUMP rtrim(code), 'CODE'

SKIP () =>
	path := 'src/test/datatypes.lib.test.civet'
	h := parsePath(path)
	stub := h.stub.endsWith('.lib') ? h.stub.replace('.lib', '') : h.stub
	tsPath := withExt(path, '.ts')
	await procOneFile path, doCompileCivet, {force: true, quiet: true}
	hResult := await procOneFile tsPath, doUnitTest, {
		capture: true
		quiet: true
		}
	DUMP hResult, "hResult for #{stub}"

SKIP () =>
	desc := ''
	lFileOps := await parseText<TFileOp[]> 'dir-tree', desc, {trace: true}

	console.log lFileOps

SKIP () =>
	{stdout, stderr} := await execCmd 'echo', ["Hello"]
	console.log stdout
	console.log stderr

SKIP () =>
	# --- Write out an invalid civet file
	path := 'src/test/exec/bad.civet'
	barf path, """
		let  :== 92
		"""
	debugger
	hResult := await procFiles [doCompileCivet, ['src/test/exec/*.civet']], {serial: true}
	DUMP hResult, 'hResult'

SKIP () =>
	result := await parseText 'dir-tree', """
		./src
		file
			abc

			def
		"""
	DUMP result, 'result'

SKIP () =>
	result := await parseText('macros', """
		abc
			#h1
				def
		""")

	DUMP result, 'result'

	expected := [
		{
			type: "text",
			firstLine: "abc",
			lContent: [
				{
					type: "macro",
					name: "h1",
					args: ""
					lContent: [
						{
							type: 'text'
							firstLine: 'def'
							lContent: []
							}
						],
					}
				],
			}
		]

SKIP () =>
	table := new TextTable('l r%.2f r%.2f')
	table.fullsep '-'
	table.title   'My Expenses'
	table.fullsep '-'
	table.labels  ['', 'Jan', 'Feb']
	table.sep()
	table.data    ['coffee', 30, 40]
	table.fullsep '='
	LOG table.asString({trace: true})

	expected := """
		-----------------------
		      My Expenses
		-----------------------
		           Jan    Feb
		-------- ------- ------
		coffee     30.00  40.00
		=======================
		"""

SKIP () =>
	result := await parseText('nice', """
		abc: 1
		def: 2
		""")
	LOG result


	expected := {abc:1, def:2}

SKIP () =>
	debugger
	path := 'src/parse/nice.parse.hera'

	# --- preprocess file
	[heraCode, type] := await preprocHeraFile path, withExt(path, '.temp.hera')
	DUMP heraCode, type

	# --- hera compile to get TypeScript file
	tsCode := await compileHera heraCode, type, 'nice.parse.hera'
	Deno.writeTextFileSync withExt(path, '.ts'), tsCode
	DUMP tsCode, 'RESULT'

	console.log 'DONE'

SKIP () =>
	path := 'src/parse/macro.parse.hera'
	procOneFile path, doCompileHera
	result := parseText 'macro', """
		abc
		def
			ghi
				jkl
				mno
			pqr
		stu
		""", {debug: true}
	DUMP result, 'RESULT'
