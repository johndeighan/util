debugger

# ---------------------------------------------------------------------------

EXEC () =>
	num := (n: number) =>
		await sleep(100)
		return 42

	rej := (n: number) =>
		await sleep(n)
		throw new Error("This is bad")

	lFunctions := [
		() => num(100)
		() => rej(100)
		]

	lTags := ['first', 'second']

	for func of lFunctions
		try
			result := await func()
			console.log "result = #{result}"
		catch err
			console.log "ERROR: #{getErrStr(err)}"

	result := await awaitAllSerially lFunctions, lTags
	console.log result

SKIP () =>
