# ---------------------------------------------------------------------------

avg := (lNumbers: number[]): number =>

	let sum = 0
	for i of lNumbers
		sum += i
	return sum / lNumbers.length

# ---------------------------------------------------------------------------

await EXEC () =>
	pat := '**/*.lib.civet'
	hOptions: hash := {force: true}

	hData: hashof<number[]> := {}

	test := (n: number): void =>
		hOptions.maxRunning = (n > 0) ? n : Infinity
		[hCounts, timeTaken] := await procFiles [doCompileCivet, pat], hOptions
		if (hCounts.err > 0)
			console.log "There were errors"
			Deno.exit(-1)
		nStr := n.toString()
		if not (nStr in hData)
			hData[nStr] = [] as number[]
		hData[nStr].push timeTaken

	for rep of range(5)
		for i of range(10)
			await test(i)

	console.log hData

	for key,lItems in hData
		console.log "[#{key}] #{avg(lItems)}"

