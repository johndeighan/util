# mapper.lib.civet

import {yellow} from '@std/fmt/colors'

import {undef} from 'base-utils'
import {assert, obviously, getErrStr} from 'croak'
import {accumFrom, arrayAndAccumFrom} from 'iter-utils'
import {
	isArray, isFunction, isIterator, isIterable,
	TNonFunction, isString, isAsyncIterableIterator,
	isGeneratorFunction, isAsyncGeneratorFunction,
	} from 'datatypes'

let traceFlag: boolean = false

# ---------------------------------------------------------------------------

export doTrace := (flag: boolean): void =>

	traceFlag = flag
	return

# ---------------------------------------------------------------------------

trace := (x: unknown): void =>

	if traceFlag
		if isString(x)
			console.log yellow(x)
		else if (typeof x == 'object') && (x != null)
			console.log x.toString()
		else
			console.log x
	return

# ---------------------------------------------------------------------------

type TMapper<TIn, TOut> = (
	x: TIn
	) => Generator<TOut, void>

type TAccumMapper<TIn, TAccum extends TNonFunction> = (
	x: TIn
	acc: TAccum
	) => TAccum

type TBothMapper<TIn, TOut, TAccum extends TNonFunction> = (
	x: TIn,
	acc: TAccum
	) => Generator<TOut, TAccum, void>

type TAsyncAccumMapper<TIn, TAccum extends TNonFunction> = (
	x: TIn
	acc: TAccum
	) => Promise<TAccum>

# ---------------------------------------------------------------------------

