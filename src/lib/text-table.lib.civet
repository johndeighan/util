# text-table.lib.civet

import {sprintf} from '@std/fmt/printf'

import {
	undef, defined, notdefined, croak, assert, obviously,
	DBG, toBool, matches, LOG, pushLogLevel, popLogLevel, range,
	} from 'base'
import {
	isString, isNumber, isInteger, isArray, array, arrayof, jsType,
	hash, hashof, integer, char, isArrayOfIntegers, nonEmpty,
	TStringMapper, isArrayOfStrings,
	} from 'datatypes'
import {
	getOptions, words, rtrim, alignString, toBlock, TAlignment,
	blockWidth, blockHeight, likeNum, blockToArray,
	} from 'llutils'
import {OL, LOGVALUE} from 'nice'
import {mkArray, accum, getBoth} from 'mapper'
import {toNice, DUMP, DDUMP} from 'nice'

# ---------------------------------------------------------------------------

type TTitleRec = {
	opcode: 'title'
	title: string
	align: TAlignment
	}

type TLabelsRec = {
	opcode: 'labels'
	lRow: string[]
	}

type TDataRec = {
	opcode: 'data'
	lRow: string[]
	}

type TSepRec = {
	opcode: 'sep'
	ch: char
	}

type TFullSepRec = {
	opcode: 'fullsep'
	ch: char
	}

type TTotalsRec = {
	opcode: 'totals'
	lRow: string[]
	}

type TSubtotalsRec = {
	opcode: 'subtotals'
	lRow: string[]
	}

type TRowDesc = TTitleRec |
	TLabelsRec |
	TDataRec |
	TSepRec |
	TFullSepRec |
	TTotalsRec |
	TSubtotalsRec

type TColDesc = {
	width: integer
	format: string
	align: TAlignment
	total: number? # running total
	subtotal: number? # running subtotal, undef on subtotal()
	}

/**
 * class used to construct a text table as a string
 *
 * SYNOPSIS:
 * 	table := new TextTable('l r%.2f r%.2f')
 * 	table.title   'My Expenses'
 * 	table.fullsep '-'
 * 	table.labels  ['', 'Jan', 'Feb']
 * 	table.sep()
 * 	table.data    ['coffee', 30, 40]
 * 	table.data    ['dining', 130, 40]
 * 	table.sep     '-'
 * 	table.subtotals()
 * 	table.data    ['one time', 10, 20]
 * 	table.data    ['other', 1000, 40]
 * 	table.fullsep '='
 * 	table.totals()
 *
 * 	textTable := table.asString({hide: 1})
 */

type TTableOptions = {
	decPlaces: number
	parseNumbers: boolean
	stringify: (x: unknown) => string
	}

export class TextTable
	hOptions: TTableOptions
	numCols: integer
	lLabels: string[] = []
	lCols: TColDesc[] = []
	lRows: TRowDesc[] = []
	stringify: (x: unknown) => string

	constructor(formatStr: string, hOptions: hash = {})
		# --- Valid options:
		#        decPlaces - used for numbers with no % style format
		#                    default: 2
		#        parseNumbers - string data that looks like a number
		#                       is treated as a number, default: false

		@hOptions = getOptions<TTableOptions> hOptions, {
			decPlaces: 2
			parseNumbers: false
			stringify: toNice
			}
		@stringify = @hOptions.stringify

		for word of words(formatStr)
			let lMatches = word.match /^(l|c|r)(\%\S+)?$/
			if notdefined(lMatches)
				croak "Bad format string: #{OL(word)}"
			[_, align, fmt] := lMatches
			@lCols.push {
				width: 0
				format: fmt
				align: (align || 'l') as TAlignment
				total: undef
				subtotal: undef
				}
		@numCols = @lCols.length

	# ..........................................................

	title(title: string, align: TAlignment = 'c'): void

		assert nonEmpty(title), "Bad title: '@{title}'"
		@lRows.push {
			opcode: 'title'
			title
			align
		}
		return

	# ..........................................................

	labels(lLabels: string[]): void

		assert (lLabels.length == @numCols), "lLabels = #{OL(lLabels)}"
		@adjustColWidths lLabels
		@lRows.push {
			opcode: 'labels'
			lRow: lLabels
			}
		@lLabels = lLabels
		return

	# ..........................................................

	addTo(hCol: TColDesc, amt: number): void

		if defined(hCol.total)
			hCol.total += amt
		else
			hCol.total = amt
		if defined(hCol.subtotal)
			hCol.subtotal += amt
		else
			hCol.subtotal = amt
		return

	# ..........................................................

	data(lData: unknown[]): void

		assert (lData.length == @numCols), "lData = #{OL(lData)}"
		lCols := @lCols
		self := this
		lRow := mkArray lData, (x, i) ->
			typ := jsType x
			switch typ
				when 'integer','float'
					obviously isNumber(x)
					h := self.lCols[i]
					self.addTo h, x
					yield self.formatNum x, h.format
				when 'string'
					obviously isString(x)
					hCol := self.lCols[i]
					if self.hOptions.parseNumbers && likeNum(x)
						num := parseFloat x
						if Number.isNaN(num)
							yield x
						else
							self.addTo hCol, num
							yield self.formatNum num, hCol.format
					else
						yield x
				else:
					yield self.stringify(x)

		@adjustColWidths lRow
		@lRows.push {
			opcode: 'data'
			lRow
			}
		return

	# ..........................................................

	sep(ch: char = '-'): void

		@lRows.push {
			opcode: 'sep'
			ch
		}
		return

	# ..........................................................

	fullsep(ch: char = '-'): void

		@lRows.push {
			opcode: 'fullsep'
			ch
		}
		return

	# ..........................................................

	totals(): void

		self := this
		lRow := mkArray @lCols, (hCol, colNum) ->
			{total, format} := hCol
			yield defined(total) ? self.formatNum(total, format) : ''
		@adjustColWidths lRow
		@lRows.push {
			opcode: 'totals'
			lRow
			}
		return

	# ..........................................................

	subtotals(): void

		self := this
		lRow := mkArray @lCols, (hCol, colNum) ->
			{subtotal, format} := hCol
			if defined(hCol.subtotal)
				hCol.subtotal = 0
			yield defined(subtotal) ? self.formatNum(subtotal, format) : ''
		@adjustColWidths lRow
		@lRows.push {
			opcode: 'subtotals'
			lRow
			}
		return

	# ..........................................................

	adjustColWidths(lRow: string[]): void

		for str,colNum of lRow
			hCol := @lCols[colNum]
			w := blockWidth(str)
			if (w > hCol.width)
				hCol.width = w
		return

	# ..........................................................

	formatNum(num: number, fmt: string): string

		if defined(fmt)
			return sprintf fmt, num
		else
			return num.toFixed @hOptions.decPlaces

	# ..........................................................

	dumpInternals(): void

		LOGVALUE 'numCols:', @numCols
		LOGVALUE 'lCols:', @lCols
		LOGVALUE 'lRows:', @lRows
		return

	# ..........................................................

	getTotalWidth(lHidden: integer[] = [])

		result := accum @lCols, 0, (h, acc, i) ->
			return lHidden.includes(i) ? acc : acc + h.width + 1
		return result - 1

	# ..........................................................

	asString(hOptions = {}): string

		type opt = {
			hide: number | number[]
			trace: boolean
			}
		{hide, trace} := getOptions<opt> hOptions, {
			hide: []
			trace: false
			}

		if trace
			pushLogLevel 'debug'

		lHide := isArray(hide) ? hide : [hide]
		DDUMP lHide, 'lHide'

		totalWidth := @getTotalWidth lHide
		DBG 'totalWidth', totalWidth

		# --- Create lColDesc and lRowDesc
		#     where hidden columns have been removed

		lColDesc := mkArray @lCols, (h, i) ->
			if not lHide.includes(i)
				yield h
		DDUMP lColDesc, 'lColDesc'

		lRowDesc := mkArray @lRows, (h, i) ->
			{opcode} := h
			switch opcode
				when 'title','sep','fullsep'
					yield h
				else
					yield {
						opcode
						lRow: mkArray h.lRow, (str, i) ->
							if not lHide.includes(i)
								yield str
						}
		DDUMP lRowDesc, 'lRowDesc'

		# --- Map each item in @lRows to one or more strings
		lLines := mkArray lRowDesc, (hRowDesc) ->
			# --- yield strings
			switch hRowDesc.opcode

				when "title"
					DBG "opcode: title"
					yield alignString hRowDesc.title, totalWidth, hRowDesc.align

				when 'labels'
					DBG "opcode: labels"
					# --- labels are always center aligned
					yield mkRow hRowDesc.lRow, (label, i) =>
						DBG " in labels opcode, i = #{i}"
						{width} := lColDesc[i]
						assert defined(width), "undef width in 'labels'"
						return alignString label, width, 'center'

				when 'data'
					DBG '='.repeat(60)
					DBG "opcode: data"

					{lRow} := hRowDesc
					DDUMP lRow, 'lRow'

					lSplitRows := splitRows lRow
					DDUMP lSplitRows, 'lSplitRows (in asString())'

					for lSubRow,level of lSplitRows
						yield mkRow(lSubRow, (str, i) =>
							DBG " in data opcode, level = #{level}, i = #{i}, str = #{str}"
							{width, align} := lColDesc[i]
							assert defined(width), "undef width in 'data'"
							return alignString str, width, align
							)

				when 'totals', 'subtotals'
					DBG "opcode: #{hRowDesc.opcode}"
					yield mkRow hRowDesc.lRow, (str, i) =>
						{width, align} := lColDesc[i]
						assert defined(width), "undef width in 'totals'"
						return alignString str, width, align

				when 'sep'
					DBG "opcode: sep"
					{ch} := hRowDesc
					lParts := for {width} of lColDesc
						assert defined(width), "undef width in 'sep'"
						ch.repeat width
					yield lParts.join(' ')

				when 'fullsep'
					DBG "opcode: fullsep"
					yield hRowDesc.ch.repeat totalWidth

		if trace
			popLogLevel()
		return toBlock lLines    # toBlock() right trims all lines

# ---------------------------------------------------------------------------

export splitRows := (
		lRow: string[]
		): string[][] =>

	lRows := mkArray lRow, (str) ->
		yield str.split('\n')

	let max = 0
	for r of lRows
		if (r.length > max)
			max = r.length
	lResult := Array.from({length: max}, () => new Array())
	for lItems,col of lRows
		for row of range(max)
			val := (lRows[col][row] || '')
			lResult[row].push val
	return lResult

# ---------------------------------------------------------------------------

export function mkRow(
		lStrings: string[]
		mapFunc: (s: string, i: number) => string
		): string

	lParts := for str,i of lStrings
		mapFunc str, i
	return lParts.join(' ')
