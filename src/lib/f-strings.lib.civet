# f-strings.lib.civet

import {sprintf} from '@std/fmt/printf'
import {
	cyan, blue, black, red, green, magenta, yellow,
	stripAnsiCode,
	} from '@std/fmt/colors'

import {
	undef, defined, notdefined, mapper, toRelPath, toBool, obviously,
	} from 'base'
import {esc} from 'unicode'
import {hashof} from 'datatypes'
import {alignString} from 'llutils'

# --- hash of all supported colors
hColor := {
	cyan
	blue
	black
	red
	green
	magenta
	yellow
	} as const

type TFormat = {
	toRel: boolean
	escape: boolean
	width: number
	color: string
	}

# ---------------------------------------------------------------------------
#    f"name = #{'John'}:-10"    => "name = John      "
#    f"name = #{'John'}:10"     => "name =       John"
#    f"name = #{'a\tb'}!"       => "name = a→b"
#    f"name = #{'John'}:{blue}" => "name = John" ('John' in blue color)
# ---------------------------------------------------------------------------
# --- Number of strings is always 1 greater than the number of values

export f := (
		lStrings: TemplateStringsArray
		...lValues: unknown[]
		): string =>

	# --- Split the first string
	[mainFmt, firstStr] := fsplit lStrings[0]

	# --- format each of the values, concatenating as we go
	bigStr := mapper lValues, firstStr, (val, acc, i) =>
		[fmt, nextStr] := fsplit(lStrings[i+1])
		return acc + formatVal(val, fmt) + nextStr
	return formatVal(bigStr, mainFmt)

# ---------------------------------------------------------------------------

export colorize := (
		str: string,
		color: string?
		): string =>

	if color && (color in hColor)
		switch color
			when 'cyan' then return cyan(str)
			when 'blue' then return blue(str)
			when 'black' then return black(str)
			when 'red' then return red(str)
			when 'green' then return green(str)
			when 'magenta' then return magenta(str)
			when 'yellow' then return yellow(str)
	return str

# ---------------------------------------------------------------------------

export withColors := (
		str: string
		hColors: hashof<string>
		): string =>

	for word of Object.keys(hColors)
		str = str.replace(word, colorize(word, hColors[word]))
	return str

# ---------------------------------------------------------------------------

export formatVal := (
		val: unknown
		fmt: TFormat?
		): string =>

	str1 := (
		  (val == undefined) ? 'undef'
		: (val == null)      ? 'null'
		: String(val)
		)
	if notdefined(fmt)
		return str1
	{toRel, escape, width, color} := fmt
	str2 := toRel ? toRelPath(str1) : str1
	str3 := escape ? esc(str2) : str2
	str4 := (
		  (width > 0) ? alignString(str3, width, 'right')
		: (width < 0) ? alignString(str3, -width, 'left')
		:                   str3
		)
	return colorize(str4, color)

# ---------------------------------------------------------------------------

export decolorize := (str: string): string =>

	return stripAnsiCode(str)

# ---------------------------------------------------------------------------

export fsplit := (
	str: string
	): [(TFormat?), string] =>

	if not str.startsWith(':')
		return [undef, str]
	lMatches := str.match ///^
			:
			(~)?        # to relative path
			([-+]?\d+)? # width
			(\!)?       # escape text?
			(?:
				{ ([a-z]+) }   # color
				)?
			(.*)        # actual text
			$///

	obviously defined(lMatches)
	[_, toRel, width, doEsc, color, rest] := lMatches
	if not toRel && not width && not doEsc && not color
		return [undef, str]
	return [
		{
			toRel:  toBool(toRel)
			width:  width ? parseInt(width) : 0
			escape: toBool(doEsc)
			color:  defined(color) && (color in hColor) ? color : ''
			},
		rest
		]
