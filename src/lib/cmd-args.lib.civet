# cmd-args.lib.civet

import {initLogLevel, LOG, DBG, ERR} from 'logger'
import {
	undef, defined, notdefined, croak, assert, matches, clearScreen,
	} from 'base'
import {
	hash, hashof, array, arrayof, char, integer, nonEmpty,
	isEmpty, isArray, isBoolean,
	isInteger, isHash, isString,
	clearHash, setHash, clearArray, setArray,
	} from 'datatypes'
import {MAP, mkArray} from 'mapper'
import {
	keys, getOptions, o, spaces, likeNum,
	} from 'llutils'
import {resetOneIndent, indented} from 'indent'
import {OL, DUMP} from 'nice'

doSetLogLevel := true   # --- maybe check an env var first?
doHandleClear := true   # --- maybe check an env var first?

export type TCmdArgDesc = {
	hFlags: hashof<boolean>
	hValues: hashof<string | number>
	lNonOptions: string[]
	helping: boolean
	debugging: boolean
	silent: boolean
	inspecting: boolean
	clearScreen: boolean
	}

# ---------------------------------------------------------------------------

hFlags: hashof<boolean> := {}
hValues: hashof<string> := {}
lNonOptions: arrayof<string> := []

export let helping: boolean = false
export let debugging: boolean = false
export let inspecting: boolean = false
export let silent: boolean = false

# ---------------------------------------------------------------------------

export flag := (ch: char): boolean =>

	return (ch in hFlags) ? hFlags[ch] : false

# ---------------------------------------------------------------------------

export flags := (...lChars: char[]): boolean[] =>

	return for ch of lChars
		flag ch

# ---------------------------------------------------------------------------
# --- hFlags should be { <name>: <char>, ... {\}
# --- return hash      { <name>: <boolean>, ... }

export getFlags := (
		hFlags: hashof<char>
		): hashof<boolean> =>

	lKeys: string[] := keys(hFlags)
	acc0: hashof<boolean> := {}
	return MAP lKeys, acc0, (name, acc) =>
		bool := flag(hFlags[name])
		if bool
			LOG "#{name} = true"
		return {...acc, [name]: bool}

# ---------------------------------------------------------------------------

export setFlag := (ch: char): void =>

	hFlags[ch] = true
	return

# ---------------------------------------------------------------------------

export clearFlag := (ch: char): void =>

	delete hFlags[ch]
	return

# ---------------------------------------------------------------------------

export numNonOptions := (): number =>

	return lNonOptions.length

# ---------------------------------------------------------------------------

export nonOption := (i: integer): string? =>

	return (
		  (0 <= i < lNonOptions.length)
#		  (i >= 0) && (i < lNonOptions.length)
		? lNonOptions[i]
		: undef
		)

# ---------------------------------------------------------------------------

export allNonOptions := (): string[] ->

	return lNonOptions

# ---------------------------------------------------------------------------

export argValue := (name: string): string? =>

	return (name in hValues) ? hValues[name] : undef

# ---------------------------------------------------------------------------

export parseCmdArgs := (
		lArgs: string[]
		): TCmdArgDesc =>

	h: TCmdArgDesc := {
		hFlags: {}
		hValues: {}
		lNonOptions: []
		helping: false
		debugging: false
		silent: false
		inspecting: false
		clearScreen: false
		}

	for arg,i of lArgs
		if (arg == '!') && (i == lArgs.length - 1) && doHandleClear
			h.clearScreen = true
			continue
		if (arg == '--')
			continue
		lMatches := arg.match /^-([A-Za-z0-9_-]+)(?:(=)(.*))?$/
		if (lMatches == null)
			h.lNonOptions.push arg
			continue
		[_, optStr, eqStr, valueStr] := lMatches
		if eqStr
			if likeNum(valueStr)
				h.hValues[optStr] = parseFloat(valueStr)
			else
				h.hValues[optStr] = valueStr
			continue
		for ch of optStr.split('')
			switch ch
				when 'h'
					h.helping = true
				when 'D'
					h.debugging = true
				when 'S'
					h.silent = true
				when 'I'
					h.inspecting = true
			h.hFlags[ch] = true
	assert not (h.silent && h.debugging), "Can't use both -S and -D"
	return h

# ---------------------------------------------------------------------------

export setCmdArgs := (
		lArgs: string[] = Deno.args
		): void =>

	h: TCmdArgDesc := parseCmdArgs(lArgs)

	setHash hFlags, h.hFlags
	setHash hValues, h.hValues
	setArray lNonOptions, h.lNonOptions

	helping    = h.helping
	debugging  = h.debugging
	silent     = h.silent
	inspecting = h.inspecting

	if h.clearScreen
		clearScreen()
	if doSetLogLevel
		if debugging
			initLogLevel 'debug'
		else if silent
			initLogLevel 'silent'

setCmdArgs()

# ---------------------------------------------------------------------------

export type TKeyDesc = {
	type?: string                # --- ignored for key _
	range?: [integer, integer]   #     used only for key _
	desc?: string
	}

export type TCmdDesc = {
	[key: string]: TKeyDesc | string
	}

# ---------------------------------------------------------------------------

export helpStr := (hDesc: TCmdDesc): string =>

	resetOneIndent(undef, '   ')
	lLines := mkArray keys(hDesc), (key) ->
		val := hDesc[key]
		if (key == '_')
			if isString(val)
				yield "non-options: #{val}"
			else
				{range, desc} := val
				if defined(desc)
					yield "non-options: #{desc}"
				if defined(range)
					[min, max] := range
					yield indented("min: #{min}")
					yield indented("max: #{max}")
		else
			if isString(val)
				yield "#{key}: #{val}"
			else
				{type, desc} := val
				if defined(desc)
					if defined(type)
						yield "#{key}: #{type} - #{desc}"
					else
						yield "#{key} - #{desc}"
				else
					if defined(type)
						yield "#{key}: #{type}"
					else
						yield "#{key} - unknown"
	return ['Usage:', ...indented(lLines)].join('\n')

# ---------------------------------------------------------------------------

export getCmdArgErrors := (hDesc: TCmdDesc): string[] =>

	lErrors: string[] := []
	for flag of keys(hFlags)
		if (flag not in hDesc) && not ['D','I','h'].includes(flag)
			lErrors.push "Unknown flag: #{flag}"
	for key of keys(hValues)
		value := hValues[key]
		if key in hDesc
			hKeyDesc := hDesc[key]
			if isHash(hKeyDesc) && ('type' in hKeyDesc)
				switch hKeyDesc.type
					when 'number'
						if not matches(value, /^\d+(?:\.\d*)?$/)
							lErrors.push "Not a number: #{value}"
		else
			lErrors.push "Unknown var: #{key}"
	if ('_' in hDesc) && not isString(hDesc._) && defined(hDesc._.range)
		[min, max] := hDesc._.range
		n := numNonOptions()
		if (n < min)
			lErrors.push "#{n} non options, min = #{min}"
		if (n > max)
			lErrors.push "#{n} non options, max = #{max}"
	return lErrors

# ---------------------------------------------------------------------------
# --- Throws exception if problem found

export checkCmdArgs := (hDesc: TCmdDesc): void =>

	lErrors := getCmdArgErrors hDesc
	DUMP lErrors, 'lErrors in checkCmdArgs'
	if nonEmpty(lErrors)
		errMsg := lErrors.join('\n')
		ERR errMsg
		croak errMsg
	return
