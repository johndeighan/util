# cmd-args.lib.civet

import {initLogLevel, LOG, DBG, ERR, curLogLevel} from 'logger'
import {
	undef, defined, notdefined, croak, assert,
	obviously, matches, clearScreen,
	} from 'base'
import {
	hash, hashof, array, char, integer, nonEmpty,
	isEmpty, isArray, isBoolean, isNumber,
	isInteger, isHash, isString, isIdentifier,
	clearHash, setHash, clearArray, setArray,
	looksLikeInteger, looksLikeNumber,
	} from 'datatypes'
import {MAP, mkArray} from 'mapper'
import {
	keys, getOptions, o, spaces,
	} from 'llutils'
import {resetOneIndent, indented} from 'indent'
import {OL, DUMP} from 'nice'

export doSetLogLevel := true
	# --- interprets:
	#        -D set log level to 'debug'
	#        -S set log level to 'silent'
	#        -I set 'inspect' flag to true

export doHandleClearScreen := true
	# --- interprets:
	#        ! is last arg, clear screen

# ---------------------------------------------------------------------------

export type TNonOptionDesc = {
	range: number[]
	desc?: string
	}

export type TValueDesc = {
	valType: string
	defStr?: string
	defNum?: number
	desc?: string
	}

export type TBoolValDesc = {
	flag: char
	desc?: string
	}

export type TArgDesc = TNonOptionDesc | TValueDesc | TBoolValDesc

# ---------------------------------------------------------------------------

type TCmdArgDetails = {
	hFlagNames: hashof<string>  # --- {<char>: <name>, ...}
	hStrTypes:  hashof<string>  #     {<name>: 'string', ...}
	hNumTypes:  hashof<string>  #     {<name>: 'integer'|'number', ...}
	minNonOpt:  number
	maxNonOpt:  number
	}

export let helping: boolean = false
export let debugging: boolean = false
export let inspect: boolean = false
export let silent: boolean = false

# ---------------------------------------------------------------------------

export getCmdArgs := (
		cmdName: string         # --- cmd name - used in help string
		hDesc: hashof<TArgDesc> = {}
		lArgs: string[] = Deno.args
		): [
			string[]
			hashof<boolean>
			hashof<string>
			hashof<number>
			] =>

	debugger

	# --- Any errors in this throws an exception
	{
		hFlagNames      # hashof<string>
		hStrTypes       # hashof<string>
		hNumTypes       # hashof<string>
		minNonOpt
		maxNonOpt
		} := parseCmdArgDesc hDesc

	# ..........................................................
	# Error handling

	lErrors: string[] := []
	checkErr := (errMsg: string): void =>
		if nonEmpty(errMsg)
			lErrors.push errMsg
		return

	# ..........................................................
	# Actual values

	lNonOptions: string[] := []
	hFlags: hashof<boolean> := {}   # --- keys are full names
	hStrVals: hashof<string> := {}  #     keys are full names
	hNumVals: hashof<number> := {}  #     keys are full names

	helping = false
	debugging = false
	inspect = false
	silent = false

	# ..........................................................
	# --- Return errMsg if error, else return ''

	setFlag := (ch: char): string =>
		fullName := hFlagNames[ch]
		if defined(fullName)
			hFlags[fullName] = true
		else
			# --- check for builtin standard flags
			switch ch
				when 'h'
					helping = true
				when 'D'
					assert not silent, "Can't set both -D and -S"
					debugging = true
				when 'S'
					assert not debugging, "Can't set both -D and -S"
					silent = true
				when 'I'
					inspect = true
				else
					return "Unknown flag: -#{ch}"
		return ''

	# ..........................................................
	# --- Return errMsg if error, else return ''

	setValue := (
			name: string,
			valStr: string
			): string =>

		if (name in hStrTypes)
			hStrVals[name] = valStr
		else if (name in hNumTypes)
			switch hNumTypes[name]
				when 'integer'
					if not looksLikeInteger valStr
						return "Not an integer: #{valStr}"
					hNumVals[name] = parseInt valStr
				when 'number'
					if not looksLikeNumber valStr
						return "Not a number: #{valStr}"
					hNumVals[name] = parseFloat valStr
		else
			return "Unknown value name #{name}"
		return ''

	# ..........................................................

	# --- clear screen first if needed, so user sees any errors
	if (lArgs.at(-1) == '!') && doHandleClearScreen
		clearScreen()

	for arg,i of lArgs
		if (arg == '--') || (arg == '!')
			continue

		lMatches := arg.match ///^
			-
			([A-Za-z][A-Za-z0-9_-]*)
			(?:
				(=)
				([^ ]*)
				)?
			$///
		if defined(lMatches)
			[_, name, hasEq, valStr] := lMatches
			if hasEq
				checkErr setValue(name, valStr)
			else  # --- it's a set of flags
				for ch of name.split('')
					checkErr setFlag(ch)
		else
			lNonOptions.push arg

	# --- check if any keys have defaults and are not set yet
	for name,h in hDesc
		when ('valType' in h)
		switch h.valType
			when 'string'
				if notdefined(hStrVals[name]) && ('defStr' in h) && defined(h.defStr)
					hStrVals[name] = h.defStr
			when 'integer','number'
				if notdefined(hNumVals[name]) && ('defNum' in h) && defined(h.defNum)
					hNumVals[name] = h.defNum

	n := lNonOptions.length
	if (n < minNonOpt)
		lErrors.push "#{n} non-options but min is #{minNonOpt}"
	if (n > maxNonOpt)
		lErrors.push "#{n} non-options but max is #{maxNonOpt}"

	if nonEmpty(lErrors)
		DUMP lErrors, "Command Arg Errors"
		croak "Errors in Command Args"

	if helping && (curLogLevel() != 'testing')
		LOG helpStr(cmdName, hDesc)
		Deno.exit(0)

	# --- Save these for last
	if doSetLogLevel && (curLogLevel() != 'testing')
		if debugging
			initLogLevel 'debug'
		else if silent
			initLogLevel 'silent'

	return [lNonOptions, hFlags, hStrVals, hNumVals]

# ---------------------------------------------------------------------------

export parseCmdArgDesc := (
		hCmdArgDesc: hashof<TArgDesc>
		): TCmdArgDetails =>

	hFlagNames: hashof<string> := {}
	hStrTypes:  hashof<string> := {}
	hNumTypes:  hashof<string> := {}
	let minNonOpt = 0
	let maxNonOpt = 0

	for key of keys(hCmdArgDesc)
		assert isIdentifier(key), "Bad key: #{key}"
		h := hCmdArgDesc[key]
		errMsg := "Bad desc for #{key}: #{h}"
		if ('range' in h) && (key == '_')
			[min, max] := h.range
			assert isInteger(min) && isInteger(max), errMsg
			[minNonOpt, maxNonOpt] = h.range
		else if ('valType' in h)
			switch h.valType
				when 'string'
					hStrTypes[key] = 'string'
				when 'integer','number'
					hNumTypes[key] = h.valType
				else
					croak errMsg
		else if ('flag' in h)
			hFlagNames[h.flag] = key
		else
			croak errMsg
	return {hFlagNames, hStrTypes, hNumTypes, minNonOpt, maxNonOpt}

# ---------------------------------------------------------------------------

export helpStr := (
		cmdName: string
		hCmdArgDesc: hashof<TArgDesc>
		): string =>

	resetOneIndent(undef, spaces(3))
	lLines := mkArray keys(hCmdArgDesc), (key) ->
		h := hCmdArgDesc[key]
		if (key == '_')
			assert ('range' in h), "Bad Desc for _: #{h}"
			{range, desc} := h
			[min, max] := range
			if nonEmpty(desc)
				yield "non-options: #{desc}"
			else
				yield "non-options:"
			yield indented("min: #{min}")
			yield indented("max: #{max}")
		else if ('flag' in h)
			{flag, desc} := h
			if nonEmpty(desc)
				yield "-#{flag}: #{desc}"
			else
				yield "-#{flag}: #{key}"
		else if ('valType' in h)
			{valType, desc} := h
			if nonEmpty(desc)
				yield "-#{key}: #{valType} - #{desc}"
			else
				yield "-#{key}: #{valType}"
	return [
		'Usage:',
		indented(cmdName),
		...indented(lLines)
		].join('\n')
