# proc-files.lib.civet

import {exists, existsSync} from '@std/fs'
import {sprintf} from '@std/fmt/printf'
import {cyan, red, green, yellow} from '@std/fmt/colors'

import {LOG, DBG, ERR} from 'logger'
import {
	undef, defined, notdefined, assert, obviously, croak,
	resetLine, write, writeln, getErrStr,
	} from 'base'
import {CTimer} from 'timer'
import {awaitAll, awaitAllSerially, TSettleResult} from 'promise-utils'
import {hash, nonEmpty} from 'datatypes'
import {f, getOptions} from 'llutils'
import {DUMP} from 'nice'
import {allFilesMatching, isFile, mkpath, toRelPath} from 'fsys'
import {CFileHandler, TExecResult} from 'exec'
import {doCompileCivet} from 'civet'

# ---------------------------------------------------------------------------
# ASYNC

# --- Later, I want to allow passing multiple TProcSpecs
#     string is a glob pattern

export type TProcSpec = [CFileHandler, lPatterns: string[]]
export type TProcResult = [boolean, string]
export type TCallback = (path: string, hResult: TExecResult) => void

export procFiles := (
		procSpec: TProcSpec,
		hOptions: hash = {}
		): [boolean, TExecResult[], number] =>  # --- 3rd = secs taken

	type opt = {
		quiet: boolean
		verbose: boolean
		serial: boolean
		callback: TCallback?
		}
	{quiet, verbose, serial, callback
		} := getOptions<opt> hOptions, {
			quiet: false
			verbose: false
			serial: false
			callback: undef
			}

	assert not (quiet && verbose), "Can't use both quiet and verbose"
	[handler, lPatterns] := procSpec
	{op} := handler
	if verbose
		writeln "(#{op})"

	timer := new CTimer()

	# --- NOTE: We need array lPaths to index into
	lPaths: string[] := Array.from allFilesMatching(lPatterns)
	if (lPaths.length == 0)
		LOG "(#{op}:{cyan} - No files match"
		return [true, [], timer.timeTaken()]

	lFunctions := for path of lPaths
		() => await handler.handleFile(path, hOptions)

	# --- NOTE: if success is true, str is a file path
	#           if success is false, str is an error message

	let nOk = 0
	let nErr = 0
	let nRej = 0
	let nNotNeeded = 0

	lAllResults: TExecResult[] := []
	onSettle := (result: TSettleResult<TExecResult>) =>
		[resolved, value, i] := result
		path := lPaths[i]
		if resolved
			# --- value is a TExecResult hash
			hResult := value
			if defined(callback)
				callback path, hResult
			lAllResults.push hResult
			{success, notNeeded, infile} := hResult
			if success
				nOk += 1
				if notNeeded
					nNotNeeded += 1
				if verbose
					showOkResult handler, path, hResult, hOptions
			else
				nErr += 1
				showErrResult handler, path, handler.getOutput(hResult), hOptions
		else
			# --- value is an error message
			errMsg := getErrStr(value)
			hResult := {
				success: false
				timeTaken: timer.timeTaken()
				stderr: errMsg
				}
			if defined(callback)
				callback path, hResult
			lAllResults.push hResult
			nRej += 1
			showErrResult handler, path, errMsg, hOptions
		return

	if serial
		await awaitAllSerially lFunctions, onSettle
	else
		await awaitAll lFunctions, onSettle

	if not quiet || (nRej + nErr > 0)
		showFinalResult
			op, lPatterns, nNotNeeded,
			nOk, nErr, nRej,
			timer.timeTaken(), verbose
	return [(nErr + nRej == 0), lAllResults, timer.timeTaken()]

# ---------------------------------------------------------------------------
# ASYNC

export procOneFile := (
		path: string,
		handler: CFileHandler,
		hOptions: hash = {}
		): TExecResult =>

	type opt = {
		inspect: boolean
		quiet: boolean
		}
	{inspect, quiet} := getOptions<opt> hOptions, {
		inspect: false
		quiet: false
		}

	op := handler.op
	if not quiet
		prelog op, path

	try
		hResult := await handler.handleFile path, hOptions
		if quiet
			# --- handler.handleFile() will have set infile key
			return hResult

		postlog hResult
		if hResult.success
			showOkResult handler, path, hResult, hOptions
		else
			showErrResult handler, path, handler.getOutput(hResult), hOptions
		return hResult

	catch err
		showErrResult handler, path, getErrStr(err), hOptions
		return {
			success: false
			stderr: getErrStr(err)
			infile: path
			}

# ---------------------------------------------------------------------------

prelog := (
		op: string,
		path: string,
		): void =>

	writeln f"#{op}:{cyan} #{toRelPath(path)}"
	return

# ---------------------------------------------------------------------------

postlog := (hResult: TExecResult): void =>

	{success, notNeeded, timeTaken} := hResult
	if success
		if notNeeded
			writeln f"#{' - not needed'}:{yellow} (#{timeTaken} secs.)"
		else
			writeln f"#{' - OK'}:{green} (#{timeTaken} secs.)"
	else
		writeln f"#{' - FAILED'}:{red} (#{timeTaken} secs.)"
	return

# ---------------------------------------------------------------------------

showOkResult := (
		handler: CFileHandler
		path: string
		hResult: TExecResult
		hOptions: hash = {}
		): void =>

	if hResult.notNeeded
		return
	output := handler.getOutput(hResult)
	if defined(output) && nonEmpty(output)
		DUMP output, 'OUTPUT', {escape: false}
	return

# ---------------------------------------------------------------------------

showErrResult := (
		handler: CFileHandler
		path: string
		errMsg: string
		hOptions: hash = {}
		): void =>

	if errMsg.includes('\n')
		DUMP errMsg, 'ERROR OUTPUT'
	else
		ERR "ERROR: #{errMsg}"
	return

# ---------------------------------------------------------------------------

let headerPrinted = false

showFinalResult := (
		op: string
		lPatterns: string[]
		nNotNeeded: number
		nOk: number
		nErr: number
		nRej: number
		timeTaken: number        # --- in secs
		verbose: boolean = false
		): void =>

	resetLine()
	if verbose
		return
	if not headerPrinted
		LOG '-'.repeat 46
		LOG [
			sprintf('%6s', 'secs.')
			sprintf('%-14s', 'op')
			sprintf('%3s', 'nnd')
			sprintf('%3s', 'OK')
			sprintf('%3s', 'Bad')
			sprintf('%3s', 'Rej')
			'file(s)'
		].join ' '
		LOG '-'.repeat 46
		headerPrinted = true
	LOG [
		sprintf('%.2f', timeTaken)
		cyan(sprintf('%-14s', op))
		sprintf('%3d', nNotNeeded)
		(nOk == 0)  ? sprintf('%3d', nOk)  : green(sprintf('%3d', nOk))
		(nErr == 0) ? sprintf('%3d', nErr) : red(sprintf('%3d', nErr))
		(nRej == 0) ? sprintf('%3d', nRej) : red(sprintf('%3d', nRej))
		lPatterns.join(' + ')
	].join ' '
	return

# ---------------------------------------------------------------------------
# ASYNC

export compileAllLibs := (
		hOptions: hash = {}
		): [boolean, TExecResult[], number] =>

	type opt = {
		root: string
		}
	{root} := getOptions<opt> hOptions, {
		root: '.'
		}
	pat := mkpath(root, '**/*.lib.civet')
	return await procFiles [doCompileCivet, [pat]], hOptions

# ---------------------------------------------------------------------------
# ASYNC

export compileAllUnitTests := (
		hOptions: hash = {}
		): [boolean, TExecResult[], number] =>

	type opt = {
		root: string
		}
	{root} := getOptions<opt> hOptions, {
		root: '.'
		}
	pat := mkpath(root, '**/*.test.civet')
	return await procFiles [doCompileCivet, [pat]], hOptions
