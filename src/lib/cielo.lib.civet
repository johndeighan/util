# cielo.lib.civet

import {pathToFileURL} from 'node-url'
import {exists, existsSync} from '@std/fs'

import {LOG, DBG} from 'logger'
import {CTimer} from 'timer'
import {
	pass, undef, defined, notdefined, croak, assert, sleep,
	} from 'base'
import {hash, isHash} from 'datatypes'
import {OL} from 'nice'
import {
	isFile, fileExt, withExt, slurp, barf, barfTempFile, parsePath,
	} from 'fsys'
import {CFileHandler, TExecResult} from 'exec'

# ---------------------------------------------------------------------------
# ASYNC

export cielo2civet := async (
		code: string
		hOptions: hash = {}
		): string =>

	return code

# ---------------------------------------------------------------------------
# ASYNC

export cielo2civetFile := (
		path: string,
		civetPath: string = withExt(path, '.civet')
		hOptions: hash = {}
		): string =>

	assert isFile(path), "No such file: #{OL(path)} (cielo2civetFile)"
	assert (fileExt(path) == '.cielo'), "Not a cielo file: #{OL(path)}"
	assert (fileExt(civetPath) == '.civet'), "Not a civet file: #{OL(civetPath)}"
	code := await Deno.readTextFile(path)
	civetCode := await cielo2civet(code, hOptions)
	Deno.writeTextFileSync civetPath, civetCode
	assert existsSync(civetPath), "Missing file #{civetPath}"
	return civetPath

# ---------------------------------------------------------------------------

class CCieloCompiler extends CFileHandler

	get op()
		return 'doCompileCielo'

	# ..........................................................

	async canHandle(
			path: string
			hOptions: hash = {}
			)
		return (fileExt(path) == '.cielo')

	# ..........................................................

	override allOutPaths(
			path: string
			hOptions: hash = {}
			)
		return [withExt(path, '.civet')]

	# ..........................................................
	# ASYNC

	override handle(
			path: string,
			hOptions: hash = {}
			): TExecResult

		civetPath := await cielo2civetFile(path)
		return {success: true}

export doCompileCielo := new CCieloCompiler()

# ---------------------------------------------------------------------------
