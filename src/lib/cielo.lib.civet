# cielo.lib.civet

import {pathToFileURL} from 'node-url'

import {LOG, DBG} from 'logger'
import {
	pass, undef, defined, notdefined, croak, assert, sleep,
	} from 'base'
import {hash, isHash} from 'datatypes'
import {OL} from 'nice'
import {
	isFile, fileExt, withExt, slurp, barf, barfTempFile, parsePath,
	} from 'fsys'
import {CFileHandler, TExecResult} from 'exec'
import {doCompileCivet} from 'civet'
import {civet2ts} from 'civet'

# ---------------------------------------------------------------------------
# ASYNC

export cielo2civet := (
		code: string
		hOptions: hash = {}
		): string =>

	sleep(1)
	return code

# ---------------------------------------------------------------------------
# ASYNC

export cielo2civetFile := (
		path: string,
		civetPath: string = withExt(path, '.civet')
		hOptions: hash = {}
		): string =>

	assert isFile(path), "No such file: #{OL(path)} (cielo2civet)"
	assert (fileExt(path) == '.cielo'), "Not a cielo file: #{OL(path)}"
	assert (fileExt(civetPath) == '.civet'), "Not a civet file: #{OL(civetPath)}"
	code := await Deno.readTextFile(path)
	civetCode := await cielo2civet(code, hOptions)
	await Deno.writeTextFile civetPath, civetCode
	assert isFile(civetPath), "File not created: #{OL(civetPath)}"
	return civetPath

# ---------------------------------------------------------------------------
# ASYNC

export cielo2ts := (
		code: string
		hOptions: hash = {}
		): string =>

	civetCode := await cielo2civet code, hOptions
	return await civet2ts civetCode, hOptions

# ---------------------------------------------------------------------------
# ASYNC

export cielo2tsFile := (
		path: string,
		tsPath: string = withExt(path, '.ts')
		hOptions: hash = {}
		): string =>

	assert isFile(path), "No such file: #{OL(path)} (cielo2ts)"
	assert (fileExt(path) == '.cielo'), "Not a cielo file: #{OL(path)}"
	assert (fileExt(tsPath) == '.ts'), "Not a ts file: #{OL(tsPath)}"
	code := await Deno.readTextFile path
	tsCode := await cielo2ts(code)
	await Deno.writeTextFile tsPath, tsCode
	assert isFile(tsPath), "File not created: #{OL(tsPath)}"
	return tsPath

# ---------------------------------------------------------------------------

class CCieloCompiler extends CFileHandler

	get op()
		return 'doCompileCielo'

	# ..........................................................

	async canHandle(
			path: string
			hOptions: hash = {}
			)
		return (fileExt(path) == '.cielo')

	# ..........................................................
	# ASYNC

	override handle(
			path: string,
			hOptions: hash = {}
			): TExecResult

		assert (fileExt(path) == '.cielo'), "Not a cielo file: #{path}"
		civetPath := withExt(path, '.temp.civet')
		await cielo2civetFile(path, civetPath)
		return await doCompileCivet.handle(civetPath, hOptions)

export doCompileCielo := new CCieloCompiler()

# ---------------------------------------------------------------------------
