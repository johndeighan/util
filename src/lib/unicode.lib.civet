# unicode.lib.civet

import {cyan} from '@std/fmt/colors'

import {curLogLevel} from 'logger'
import {undef, defined, assert, decolorize} from 'base'
import {hash, hashof, char} from 'datatypes'

# ---------------------------------------------------------------------------

export uni := {
	lsmartq: '“'      # U+201C
	rsmartq: '”'      # U+201D
	vbar: '│'
	hbar: '─'
	tlcorner: '┌'
	trcorner: '┐'
	blcorner: '└'
	brcorner: '┘'
	tee: '├'
	arrowhead: '>'
	backarrow: '<'
	space: ' '
	dot: '.'
	fatdot: '˳'
	lI18N: '◄'
	rI18N: '►'
	leftshift: '«'
	rightshift: '»'
	poschar: '┊'
	alt_lparen: '｟'
	alt_rparen: '｠'
	alt_lbracket:'〚'
	alt_rbracket: '〛'
	alt_lbrace:'《'      # ⦃
	alt_rbrace: '》'     # ⦄
	leftarrow: '←'
	rightarrow: '→'
	downarrow: '↓'
	uparrow: '↑'
	shiftin: '\x0F'  # U+000F
	shiftout: '\x0E' # U+000E
	ellipsis: '…'    # U+2026
	}

# ---------------------------------------------------------------------------

export lit := (str: char): string =>

	return "｟" + str + "｠"

# ---------------------------------------------------------------------------

export hCtrlChars: hashof<string> := {}
for i of [0..32]
	hCtrlChars[String.fromCodePoint(i)] = String.fromCodePoint(0x2400 + i)

hEsc: hashof<string> := {
	...hCtrlChars
	"\n":    cyan('↓')
	"\t":    cyan('→')
	" ":    '˳'
	'\x0F': cyan('»')
	'\x0E': cyan('«')
	}

# --- these are always literalized
lSpecials: string[] := ["˳", "←", "↓", "→", '»', '«']

# ---------------------------------------------------------------------------

export esc := (
		str: string
		lNeedsEsc: string[] = []
		): string =>

	lParts: string[] := []
	for ch,i of str
		if lNeedsEsc.includes(ch) || lSpecials.includes(ch)
			lParts.push lit(ch)
		else
			lParts.push (hEsc[ch] || ch)
	result := lParts.join ''
	return (curLogLevel() == 'testing') ? decolorize(result) : result

# ---------------------------------------------------------------------------

export escm := (
		str: string
		lNeedsEsc: string[] = []
		): string =>

	escaped := esc(str, lNeedsEsc)
	return escaped.replaceAll('↓', '↓\n')

# ---------------------------------------------------------------------------

export unesc := (
		str: string
		): string =>

	# --- build a reverse hash from hEsc
	hUnEsc: hashof<string> := {}
	for key,val in hEsc
		hUnEsc[decolorize(val)] = key

	lParts: string[] := []
	for ch of str
		if (ch != '\n')
			lParts.push (hUnEsc[ch] || ch)
	return lParts.join ''
