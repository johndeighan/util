# hera-compile.lib.civet

import {exists, existsSync} from '@std/fs'

import {LOG, DBG, ERR, pushLogLevel, popLogLevel} from 'logger'
import {
	pass, undef, defined, notdefined,
	croak, assert, getErrStr, allLinesIn,
	TIterator, TAsyncIterator, toBool,
	} from 'base'
import {uni, esc} from 'unicode'
import {
	hash, isEmpty, nonEmpty, isString, isIterator, isHash,
	} from 'datatypes'
import {
	arrayToBlock, getOptions,
	sep, untabify, f, hasKey, spaces, countChars,
	} from 'llutils'
import {
	resetOneIndent, splitLine, indented, undented,
	} from 'indent'
import {debugging} from 'cmd-args'
import {DUMP, DDUMP} from 'nice'
import {
	fileExt, withExt, pathStr, newerDestFileExists,
	CReadableFile, barfTempFile, parsePath,
	} from 'fsys'
import {TState, fromFSM} from 'fsm'
import {civet2ts} from 'civet'
import {CFileHandler, TExecResult} from 'exec'
import {extractMetaData, mdGet} from 'meta-data'
import {THeraType, isHeraType, compileHera} from 'llhera'
import {CRuleBranch, CRule, CRuleSet, mkCodeBlock} from 'rule'
import {mkArray} from 'mapper'

# ---------------------------------------------------------------------------

export class CHeraCompiler extends CFileHandler

	get op()
		return 'doCompileHera'

	override needed(
			path: string
			hOptions: hash = {}
			): boolean

		destPath := withExt path, '.ts'
		return not (
			   not hOptions.force
			&& await exists(destPath)
			&& newerDestFileExists(path, destPath)
			)

	override handle(
			path: string,
			hOptions: hash = {}
			): TExecResult

		type opt = {
			force: boolean
			trace: boolean
			}
		{force, trace} := getOptions<opt> hOptions, {
			force: false
			trace: false
			}

		assert (fileExt(path) == '.hera'), "Not a hera file"
		destPath := withExt path, '.ts'
		try
			# --- preprocess, save to a temp file
			tempPath := withExt(path, '.temp.hera')
			[heraCode, type] := await preprocHeraFile path, tempPath, hOptions

			fileName := parsePath(path).fileName
			tsCode := await compileHera heraCode, type, fileName
			await Deno.writeTextFile withExt(path, '.ts'), tsCode

			return {
				success: true
				stdout: tsCode
				}

		catch err
			errMsg := "HERA COMPILE FAILED: #{pathStr(path)} - #{getErrStr(err)}"
			return {
				success: false
				stdout: ''
				stderr: errMsg
				}

export doCompileHera := new CHeraCompiler()

# ---------------------------------------------------------------------------
# ASYNC

buildHeraFile := (
		lMainCode: string[]
		lResetCode: string[]
		ruleSet: CRuleSet
		hOptions: hash = {}
		) =>

	type opt = {
		type: THeraType
		trace: boolean
		}
	{type, trace} := getOptions<opt> hOptions, {
		type: 'civet'
		trace: false
		}

	if trace
		pushLogLevel 'debug'

	mainCode := await mkCodeBlock lMainCode, type
	DDUMP mainCode, 'mainCode'

	resetCode := await mkCodeBlock lResetCode, type
	DDUMP resetCode, 'resetCode'

	lRuleBlocks := for rule of ruleSet.allRules()
		await rule.asString(type)

	for block,i of lRuleBlocks
		DDUMP block, "Rule[#{i}]"

	let lParts: string[] = []
	lParts.push
		"```"
		"import {CParseMatches} from 'parse-utils';"
		"export let pm = new CParseMatches();"
		""
	if nonEmpty(mainCode)
		lParts.push mainCode, ""

	lParts.push
		"export const beginParse = ("
		indented "text: string,", 2
		indented "hOptions: {[key: string|symbol]: unknown} = {}", 2
		indented "): string|undefined => {", 2
		indented "pm.reset(text);"
		indented resetCode
		indented '}'
		"```"
		''
		lRuleBlocks.join('\n\n')

	result := lParts.join('\n').replaceAll('\t', spaces(2))

	DDUMP result, 'Result'
	if trace
		popLogLevel()
	return result

# ---------------------------------------------------------------------------

export unbalanced := (str: string): boolean =>

	if ( countChars(str, '(') != countChars(str, ')') )
		return true
	if ( countChars(str, '{') != countChars(str, '}') )
		return true
	return false

# ---------------------------------------------------------------------------
# ASYNC

export preprocHera := (
		contents: string
		hOptions: hash = {}
		): string =>

	type opt = {
		type: THeraType
		trace: boolean
		}
	{type, trace} := getOptions<opt> hOptions, {
		type: 'civet'
		trace: false
		}

	if trace
		pushLogLevel 'debug'

	isComment := (str: string): boolean =>
		return toBool(str.match(/^\s*#\s/)) || isEmpty(str)

	resetOneIndent(undef, spaces(2))

	lMainCode:  string[] := []
	lResetCode: string[] := []

	ruleSet := new CRuleSet()

	lLines: string[] := mkArray allLinesIn(contents), (line) ->
		if not isComment(line)
			yield line

	result := await fromFSM lLines, [

		# 0 --- start
		#          until we see #beginParse, everything, including
		#          blank lines, goes into main code

		(line: string): TState =>
			if line.startsWith('#beginParse')
				return 1
			else
				lMainCode.push line
				return 0

		# 1 --- in beginParse function
		#          until we see a rule name, everything, including
		#          blank lines, goes into reset code

		(line: string): TState =>
			[level, str] := splitLine(line)
			if (level == 0)
				if isEmpty(str)
					lResetCode.push ''
					return 1
				else
					rule := ruleSet.addRule str
					return 2
			else
				lResetCode.push indented(str, level-1)
				return 1

		# 2 --- have rule, want pattern
		#          skip blank lines, but expect a pattern at level 1

		(line: string, i: number): TState =>
			[level, pat] := splitLine(line)
			if (level == 0) && (pat == '')
				return 2

			rule := ruleSet.curRule()
			name := rule.getName()
			nb := rule.numBranches()
			assert (level == 1) && nonEmpty(pat),
				"Expecting pattern for rule #{name}, branch #{nb} on line #{i}"
			rule.addBranch pat
			return 3

		# 3 --- have pattern, want code
		#          ignore blank lines

		(line: string, i: number): TState =>
			[level, str] := splitLine(line)
			rule := ruleSet.curRule()
			switch level
				when 0
					if (str == '')
						return 3
					else
						ruleSet.addRule str
						return 2
				when 1
					rule.addBranch str
					return 3
				else
					branch := rule.curBranch()

					# --- first line of code must be at level 2
					if (branch.numCodeLines() == 0)
						assert (level == 2), "First line of code must be level 2"
						branch.addCode "pm.match('#{ruleSet.ruleName()}', $loc);"

					branch.addCode indented(str, level-2)
					return 3

		],
		(state: TState) =>
			if (state == 3)
				# --- Check all branches of all rules for cases where
				#     no code was generated
				for rule of ruleSet.allRules()
					for branch of rule.allBranches()
						if (branch.numCodeLines() == 0)
							branch.addCode "pm.match('#{rule.getName()}', $loc);"

				return await buildHeraFile(lMainCode, lResetCode, ruleSet, hOptions)
			else
				croak "Ended in state #{state}"
		{}

	assert (typeof result == 'string'), "result not a string: #{result}"
	if trace
		popLogLevel()

	return result

# ---------------------------------------------------------------------------
# ASYNC

export preprocHeraFile := (
		path: string
		tempPath: string? = undef
		hOptions: hash = {}
		): [string, THeraType] =>

	file := new CReadableFile path
	hMetaData := await file.metaData()
	contents := await file.getContents()
	type := mdGet hMetaData, 'type', 'civet'
	assert isHeraType(type), "Bad hera type: #{type}"
	heraCode := await preprocHera contents, {type}
	if defined(tempPath)
		await Deno.writeTextFile tempPath, heraCode
	return [heraCode, type]

# ---------------------------------------------------------------------------
# ASYNC

export testHeraCode := (
		code: string
		type: THeraType = 'civet'
		): string =>


	heraCode := await preprocHera code, {type}

	# --- Make sure the generated code compiles
	try
		await compileHera heraCode, type
	catch err
		DUMP heraCode, 'Hera Code', {lineNumbers: true}
		croak "FAILED TO PARSE: #{getErrStr(err)}"

	return heraCode
