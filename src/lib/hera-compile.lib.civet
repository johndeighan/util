# hera-compile.lib.civet

import {exists, existsSync} from '@std/fs'

import {
	pass, undef, defined, notdefined,
	croak, assert, getErrStr, LOG, DBG, ERR,
	TIterator, TAsyncIterator, toBool,
	} from 'base'
import {uni, esc} from 'unicode'
import {
	hash, isEmpty, nonEmpty, isString, isIterator, isHash,
	} from 'datatypes'
import {
	allLinesInBlock, arrayToBlock, getOptions,
	sep, untabify, f, hasKey, spaces, countChars,
	} from 'llutils'
import {
	resetOneIndent, splitLine, indented, undented,
	} from 'indent'
import {debugging} from 'cmd-args'
import {ML, DUMP} from 'to-nice'
import {
	fileExt, withExt, isValidStub, pathStr, newerDestFileExists,
	openTextFile, openAndReadTextFile, barfTempFile, parsePath,
	} from 'fsys'
import {TState, fromFSM} from 'fsm'
import {civet2ts, civet2tsSync} from 'llcivet'
import {
	execCmd, CFileHandler, TExecResult,
	} from 'exec'
import {extractMetaData, mdGet} from 'meta-data'
import {THeraType, isHeraType, compileHera} from 'llhera'
import {CRuleBranch, CRule, CRuleSet, mkCodeBlock} from 'rule'

# ---------------------------------------------------------------------------

export class CHeraCompiler extends CFileHandler

	get op()
		return 'doCompileHera'

	override notNeeded(
			path: string
			hOptions: hash = {}
			): boolean

		destPath := withExt path, '.ts'
		return (
			   not hOptions.force
			&& existsSync(destPath)
			&& newerDestFileExists(path, destPath)
			)

	override handle(
			path: string,
			hOptions: hash = {}
			): TExecResult

		assert (fileExt(path) == '.hera'), "Not a hera file"
		destPath := withExt path, '.ts'
		if not hOptions.force && existsSync(destPath)
			if newerDestFileExists(path, destPath)
				return {
					success: true
					notNeeded: true
					}

		try
			tempPath := withExt(path, '.temp.hera')
			[heraCode, type] := await preprocessHeraFile path, tempPath
			fileName := parsePath(path).fileName
			tsCode := compileHera heraCode, type, fileName
			await Deno.writeTextFile withExt(path, '.ts'), tsCode

			return {
				success: true
				stdout: tsCode
				}

		catch err
			errMsg := "HERA COMPILE FAILED: #{pathStr(path)} - #{getErrStr(err)}"
			return {
				success: false
				stdout: ''
				stderr: errMsg
				}

export doCompileHera := new CHeraCompiler()

# ---------------------------------------------------------------------------

buildHeraFile := (
		lMainCode: string[]
		lResetCode: string[]
		ruleSet: CRuleSet
		type: THeraType
		debug: boolean = false
		) =>

	mainCode := mkCodeBlock lMainCode, type
	if debug
		DUMP mainCode, 'mainCode'

	resetCode := mkCodeBlock lResetCode, type
	if debug
		DUMP resetCode, 'resetCode'

	lRuleBlocks := ruleSet.lRules.map (rule) => rule.toString(type)
	if debug
		for block,i of lRuleBlocks
			DUMP block, "Rule[#{i}]"

	let lParts: string[] = []
	lParts.push
		"```"
		"import {CParseMatches} from 'parse-utils';"
		"export let pm = new CParseMatches();"
		""
	if nonEmpty(mainCode)
		lParts.push mainCode, ""

	lParts.push
		"export const beginParse = (text: string): string? => {"
		indented(resetCode)
		indented('}')
		"```"
		''
		...lRuleBlocks
	result := lParts.join('\n').replaceAll('\t', spaces(2))
	if debug
		DUMP result, 'Result'
	return result

# ---------------------------------------------------------------------------

export unbalanced := (str: string): boolean =>

	if ( countChars(str, '(') != countChars(str, ')') )
		return true
	if ( countChars(str, '{') != countChars(str, '}') )
		return true
	return false

# ---------------------------------------------------------------------------
# ASYNC

export preprocessHera := (
		contents: string
		type: THeraType = 'typescript'
		debug: boolean = false
		): string =>

	isComment := (str: string): boolean =>
		return toBool(str.match(/^\s*#\s/))

	resetOneIndent()

	lMainCode:  string[] := []
	lResetCode: string[] := []

	ruleSet := new CRuleSet()

	iter := allLinesInBlock(contents).filter((x) => not isComment(x))
	result := fromFSM iter, [

		# 0 --- start
		#          until we see #beginParse(text), everything, including
		#          blank lines, goes into main code

		(line: string): TState =>
			if (line == '#beginParse(text)')
				return 1
			else
				lMainCode.push line
				return 0

		# 1 --- in beginParse function
		#          until we see a rule name, everything, including
		#          blank lines, goes into reset code

		(line: string): TState =>
			[level, str] := splitLine(line)
			if nonEmpty(str) && (level == 0)
				ruleSet.addRule str
				return 2
			else
				if isEmpty(str) && (level == 0)
					lResetCode.push ''
				else
					lResetCode.push indented(str, level-1)
				return 1

		# 2 --- have rule, want pattern
		#          skip blank lines, but expect a pattern at level 1

		(line: string, i: number): TState =>
			[level, pat] := splitLine(line)
			if (level == 0) && (pat == '')
				return 2

			rule := ruleSet.curRule()
			name := rule.getName()
			nb := rule.numBranches()
			assert (level == 1),
				"Expecting pattern for rule #{name}, branch #{nb} on line #{i}"
			rule.addBranch pat
			return 3

		# 3 --- have pattern, want code
		#          ignore blank lines

		(line: string, i: number): TState =>
			[level, str] := splitLine(line)
			rule := ruleSet.curRule()
			switch level
				when 0
					if (str == '')
						return 3
					else
						ruleSet.addRule str
						return 2
				when 1
					rule.addBranch str
					return 3
				else
					branch := rule.curBranch()

					# --- first line of code must be at level 2
					if (branch.numCodeLines() == 0)
						assert (level == 2), "First line of code must be level 2"
						branch.addCode "pm.match('#{ruleSet.ruleName()}', $loc);"

					branch.addCode indented(str, level-2)
					return 3

		], {
			doneFunc: (state: TState): void =>
				if (state == 3)
					str := buildHeraFile(lMainCode, lResetCode, ruleSet, type, debug)
					throw str
				else
					croak "Ended in state #{state}"
			}
	assert (typeof result == 'string'), "result not a string"
	return result

# ---------------------------------------------------------------------------
# ASYNC

export preprocessHeraFile := (
		path: string
		tempPath: string? = undef
		): [string, THeraType] =>

	[hMetaData, contents] := await openAndReadTextFile path
	type := mdGet hMetaData, 'type', 'civet'
	assert isHeraType(type), "Bad hera type: #{type}"
	heraCode := preprocessHera contents, type
	if defined(tempPath)
		await Deno.writeTextFile tempPath, heraCode
	return [heraCode, type]

# ---------------------------------------------------------------------------
# ASYNC

export testHeraCode := (
		code: string
		debug: boolean = false
		): string =>

	path := barfTempFile code, {ext: '.hera'}
	[heraCode, type] := await preprocessHeraFile path

	# --- Make sure the generated code compiles
	try
		compileHera heraCode, type
	catch err
		DUMP heraCode, 'Hera Code', {lineNumbers: true}
		croak "FAILED TO PARSE: #{getErrStr(err)}"

	return heraCode
