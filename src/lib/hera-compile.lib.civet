# hera-compile.lib.civet

import {exists, existsSync} from '@std/fs'

import {
	pass, undef, defined, notdefined,
	croak, assert, getErrStr, LOG, DBG, ERR,
	TIterator,
	} from 'base'
import {uni, esc} from 'unicode'
import {
	hash, isEmpty, nonEmpty, isString, isIterator, isHash,
	} from 'datatypes'
import {
	allLinesInBlock, arrayToBlock, getOptions,
	sep, untabify, f, hasKey, spaces,
	} from 'llutils'
import {
	resetOneIndent, splitLine, indented, undented,
	} from 'indent'
import {debugging} from 'cmd-args'
import {ML, DUMP} from 'to-nice'
import {
	fileExt, withExt, isValidStub, pathStr, newerDestFileExists,
	openTextFile, barfTempFile, parsePath,
	} from 'fsys'
import {TState, fromFSM} from 'fsm'
import {civet2ts, civet2tsSync} from 'llcivet'
import {
	execCmd, execCmdSync, CFileHandler, TExecResult,
	} from 'exec'
import {extractMetaData, mdGet} from 'meta-data'
import {THeraType, isHeraType, compileHera} from 'llhera'

# ---------------------------------------------------------------------------

export class CHeraCompiler extends CFileHandler

	get op()
		return 'doCompileHera'

	override handle(
			path: string,
			hOptions: hash = {}
			): TExecResult

		assert (fileExt(path) == '.hera'), "Not a hera file"
		destPath := withExt path, '.ts'
		if (
				   not hOptions.force
				&& await exists(destPath)
				&& newerDestFileExists(path, destPath)
				)
			return {
				success: true
				notNeeded: true
				}

		try
			tempPath := withExt(path, '.temp.hera')
			[heraCode, type] := await preprocessHeraFile path, tempPath
			fileName := parsePath(path).fileName
			tsCode := compileHera heraCode, type, fileName
			await Deno.writeTextFile withExt(path, '.ts'), tsCode

			return {
				success: true
				stdout: tsCode
				}

		catch err
			errMsg := "HERA COMPILE FAILED: #{pathStr(path)} - #{getErrStr(err)}"
			return {
				success: false
				stdout: ''
				stderr: errMsg
				}

export doCompileHera := new CHeraCompiler()

# ---------------------------------------------------------------------------
# ASYNC

export preprocessHeraFile := (
		path: string
		tempPath: string? = undef
		): [string, THeraType] =>

	{hMetaData, reader} := openTextFile path
	type := mdGet hMetaData, 'type', 'civet'
	assert isHeraType(type), "Bad hera type: #{type}"
	heraCode := preprocessHera reader, type
	if defined(tempPath)
		await Deno.writeTextFile tempPath, heraCode
	return [heraCode, type]

# ---------------------------------------------------------------------------

export mkCodeBlock := (
		lLines: string[]
		type: THeraType
		): string =>

	block := arrayToBlock(lLines).trim()
	switch type
		when 'typescript'
			return block
		when 'civet'
			return civet2tsSync(block, {inlineMap: false}).trim()
		else
			croak "Bad code type: #{type}"

# ---------------------------------------------------------------------------

export isRuleName := (name: string): boolean =>

	return defined(name.match /^[A-Za-z$_][A-Za-z0-9$_-]*$/)

# ---------------------------------------------------------------------------

export class CRule
	private name: string
	private pattern: string = ''
	private lCode: string[] = []

	constructor(@name: string)
		assert isRuleName(@name), "Bad name: <#{@name}>"

	getName(): string
		return @name

	getPattern(): string
		return @pattern

	setPattern(pat: string): void
		@pattern = pat
		return

	addCode(line: string): void
		lMatches := line.match /^(\s*)return\s+(.*);$/
		if defined lMatches
			[_, prefix, valueStr] := lMatches
			@lCode.push (prefix + 'return' + ' pm.result(' + valueStr + ');')
		else
			@lCode.push line
		return

	patternStr(): string
		hashPos := @pattern.indexOf('#')
		if (hashPos == -1)
			return indented(@pattern) + ' ->'
		else
			return indented(@pattern.replace('#', '-> #'))

	numCodeLines(): number
		return @lCode.length

	codeBlock(type: THeraType): string[]
		return indented(@lCode, 2)

	toString(type: THeraType): string
		return [
			@name
			@patternStr()
			indented(mkCodeBlock(@lCode, type), 2)
			'\n'
			].join('\n')

# ---------------------------------------------------------------------------

buildHeraFile := (
		lMainCode: string[]
		lResetCode: string[]
		lRules: CRule[]
		type: THeraType
		debug: boolean = false
		) =>

	mainCode := mkCodeBlock lMainCode, type
	if debug
		DUMP mainCode, 'mainCode'

	resetCode := mkCodeBlock lResetCode, type
	if debug
		DUMP resetCode, 'resetCode'

	lRuleBlocks := lRules.map (rule) => rule.toString(type)
	if debug
		for block,i of lRuleBlocks
			DUMP block, "Rule[#{i}]"

	let lParts: string[] = []
	lParts.push
		"```"
		"import {CParseMatches} from 'parse-utils';"
		"export let pm = new CParseMatches();"
		""
	if nonEmpty(mainCode)
		lParts.push mainCode, ""

	lParts.push
		"export const reset = (text: string): void => {"
		indented("pm.reset(text);")
		indented(resetCode)
		indented('}')
		"```"
		''
		...lRuleBlocks
	result := lParts.join('\n').replaceAll('\t', spaces(2))
	if debug
		DUMP result, 'Result'
	return result

# ---------------------------------------------------------------------------

export decom := (line: string): string =>

	return line.replace /^(\s*)#(\s)/, "$1//$2"

# ---------------------------------------------------------------------------

export preprocessHera := (
		iter: string | TIterator<string>
		type: THeraType = 'typescript'
		debug: boolean = false
		): string =>

	if isString(iter)
		iter = allLinesInBlock(iter)
	resetOneIndent()

	lMainCode: string[]  := []
	lResetCode: string[] := []

	let curRule: CRule = new CRule('Dummy')
	let lRules: CRule[] = []

	result := fromFSM iter, [

		# 0 --- start
		(line: string): TState =>
			if (line == '#reset')
				return 1
			else
				lMainCode.push decom(line)
				return 0

		# 1 --- in reset function
		(line: string): TState =>
			if isEmpty(line)
				lResetCode.push ''
				return 1
			else
				[level, str] := splitLine(line)
				if (level == 0)
					curRule = new CRule(line)
					return 2
				else
					lResetCode.push undented(decom(line))
					return 1

		# 2 --- have rule name, want pattern
		(line: string, i: number): TState =>
			if isEmpty(line)
				return 2
			else
				[level, str] := splitLine(line)
				assert (level == 1),
					"Expecting pattern for rule #{curRule.getName()} on line #{i}"
				curRule.setPattern str
				curRule.addCode "pm.match('#{curRule.getName()}', $loc);"
				return 3

		# 3 --- have pattern, want code
		(line: string, i: number): TState =>
			if isEmpty(line)
				return 3
			else
				[level, str] := splitLine(line)
				if (level == 0)
					lRules.push curRule

					# --- create a new rule
					curRule = new CRule(line)
					return 2
				else if (level == 1)
					ruleName := curRule.getName()
					croak "Unexpected pattern for rule #{ruleName} on line #{i}"
				else
					# --- first line of code must be at level 2
					if (curRule.numCodeLines() == 0)
						assert (level == 2), "First line of code must be level 2"
					curRule.addCode indented(decom(str), level-2)
					return 3
		], (state: TState): void =>
			if (state == 3)
				lRules.push curRule
				str := buildHeraFile(lMainCode, lResetCode, lRules, type, debug)
				throw str
			else
				croak "Ended in state #{state}"
	assert (typeof result == 'string'), "result not a string"
	return result

# ---------------------------------------------------------------------------
# ASYNC

export testHeraCode := (
		code: string
		debug: boolean = false
		): string =>

	path := barfTempFile code, {ext: '.hera'}
	[heraCode, type] := await preprocessHeraFile path

	# --- Make sure the generated code compiles
	try
		compileHera heraCode, type
	catch err
		DUMP heraCode, 'Hera Code', {lineNumbers: true}
		croak "FAILED TO PARSE: #{getErrStr(err)}"

	return heraCode
