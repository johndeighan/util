# --- import compiler configuration
import {hConfig} from 'compile-config'

# ---------------------------------------------------------------------------

export type TCompilerFunc = (path: string, hOptions: hash) => Promise<TExecResult>
export type TPostProcessor = (path: string, hOptions: hash) => Promise<TExecResult>

export type TCompilerInfo = {
	isInstalled: () => Promise<boolean>
	compiler: TCompilerFunc
	getOutPaths: (path: string) => string[]
	}

export isCompilerInfo := (x: unknown): x is TCompilerInfo =>
	if (typeof x == 'object') && (x != null)
		return ('isInstalled' in x) && ('compiler' in x) && ('getOutPaths' in x)
	else
		return false

export type TCompilerConfig =
	hCompilers: hashof<TCompilerInfo>
	hPostProcessors: hashof<TPostProcessor>

export isCompilerConfig := (x: unknown): x is TCompilerConfig =>
	if (typeof x == 'object') && (x != null)
		return ('hCompilers' in x) && ('hPostProcessors' in x)
	else
		return false

# ---------------------------------------------------------------------------
# ASYNC

export getCompilerInfo := (
		ext: string
		fileName: string? = undef
		): TCompilerInfo? =>

	return hConfig.hCompilers[ext]

# ---------------------------------------------------------------------------
# ASYNC

export getPostProcessor := (
		purpose: string
		fileName: string? = undef
		): TPostProcessor? =>

	pp := hConfig.hPostProcessors[purpose]
	if defined(pp)
		return pp
	else
		DBG "No post processor for #{purpose} files"
		return undef

# ---------------------------------------------------------------------------

type TCompileOptions = {
	configFileName: string?
	hCompilerInfo: TCompilerInfo?
	}

class CFileCompiler extends CFileHandler

	hCompilerInfo: TCompilerInfo? = undef

	get op()
		return 'doCompileFile'

	# ..........................................................

	async canHandle(
			path: string
			hOptions: hash = {}
			): boolean

		{configFileName, hCompilerInfo} := getOptions<TCompileOptions> hOptions, {
			configFileName: undef,
			hCompilerInfo: undef
			}

		ext := fileExt path
		if notdefined(ext)
			return false

		assert not allDefined(configFileName, hCompilerInfo),
			"Options configFileName and hCompilerInfo both set"
		@hCompilerInfo := (
			if defined(hCompilerInfo)
				hCompilerInfo
			else
				await getCompilerInfo ext, configFileName
			)
		if notdefined(@hCompilerInfo)
			DBG "no compiler info for ext #{OL(ext)}"
			DBG UNDENT
			return false
		return true

	# ..........................................................
	# ASYNC

	override allOutPaths(
			path: string
			hOptions: hash = {}
			): string[]

		obviously defined(@hCompilerInfo)
		{getOutPaths} := @hCompilerInfo
		return getOutPaths path

	# ..........................................................
	# --- file existence has already been checked.

	override async handle(
			path: string
			hOptions: hash = {}
			): TExecResult

		DBG "COMPILE: #{OL(path)}"
		DBG INDENT
		{stub, purpose, ext} := parsePath path
		obviously defined(@hCompilerInfo)
		{compiler} := @hCompilerInfo

		DBG "compiling #{OL(path)}"
		hResult := await compiler(path, hOptions)
		{success} := hResult

		if hOptions.postproc && purpose
			postProc := await getPostProcessor purpose
			if defined(postProc)
				timer := new CTimer()
				try
					hResult.hPostResult = await postProc(path, hOptions)
				catch err
					hResult.hPostResult = {
						success: false
						timeTaken: timer.timeTaken()
						}

		DBG UNDENT
		return hResult

export doCompileFile := new CFileCompiler()

# ---------------------------------------------------------------------------
# --- For now, there is at most one unit test for a file

export unitTestsFor := (path: string): string[] =>

	{stub, purpose, ext} := parsePath(path)
	assert (ext == '.ts'), "Bad path in unitTestsFor: #{path}"
	if (purpose == 'test')
		return []
	fileName := "#{stub}.#{purpose}.test.ts"
	utPath := findFile fileName
	return defined(utPath) ? [utPath] : []

# ---------------------------------------------------------------------------
# --- path will be the file being tested, e.g.
#        path = src/lib/datatypes.lib.civet
#        the file to execute is named datatypes.lib.test.civet
# --- If the test file doesn't exist, we want to report 0 passed and 0 failed

class CUnitTester extends CFileHandler

	hPathInfo: TPathInfo?
	lUnitTestPaths: string[] = []   # --- set in isNeeded()

	get op()
		return 'doUnitTest'

	# ..........................................................

	async canHandle(
			path: string
			hOptions: hash = {}
			)

		@hPathInfo = parsePath(path)
		{purpose, ext} := @hPathInfo

		# --- NOTE: purpose should NOT be 'test'
		return (ext == '.ts') && (purpose != 'test')

	# ..........................................................

	override async isNeeded(
			path: string
			hOptions: hash = {}
			): boolean

		# --- see if there are any unit tests for this file
		@lUnitTestPaths := unitTestsFor(path)
		return (@lUnitTestPaths.length > 0)

	# ..........................................................

	handle(
			path: string,
			hOptions: hash = {}
			): TExecResult

		type opt = {
			capture: boolean
			inspect: boolean
			lineNum: string?
			}
		{capture, inspect, lineNum} := getOptions<opt> hOptions, {
			capture: true
			inspect: false
			lineNum: undef
			}

		# --- We already know that
		#        - the file exists
		#        - the file extension is .ts
		#        - field lUnitTestPaths exists
		#        - all paths in lUnitTestPaths:
		#           - have purpose 'test' and extension .ts
		#           - (for now, there is only one unit test path)

		# --- this should work, but doesn't
#		utPath := @lUnitTestPaths[0]

		lUtPaths := unitTestsFor(path)
		utPath := lUtPaths[0]

		return await execCmd 'deno', [
				'test'
				'-A'
				'--trace-leaks'
				...(inspect
					? ['--inspect-brk']
					: ['--coverage=./coverage', '--coverage-raw-data-only']
					)
				...(defined(lineNum)
					? ['--filter', "/^line #{lineNum}$/"]
					: []
					)
				utPath
				], {capture}

	# ..........................................................

	override getOutput(
			hResult: TExecResult
			): string

		{stdout, stderr} := hResult
		output := [stdout, stderr].join()
		if not hResult.success || matches(output, /\b(croak|error)\b/i)
			return output

		lLines := Array.from MAP allLinesIn(decolorize(output)), (line) ->
			if line.startsWith('line') || line.startsWith('--->')
				if not line.includes(' ok ')
					yield withColors line, {
						failed: 'red'
						FAILED: 'red'
						ok: 'green'
						OK: 'green'
						}
			else if line.includes('Lcov coverage')
				yield 'coverage report generated'
			else
				lMatches := line.match ///
					\s+
					(\d+)
					\s+
					passed
					\s+ \| \s+
					(\d+)
					\s+
					failed
					\b
					///
				if defined(lMatches)
					[_, numPassed, numFailed] := lMatches
					lParts := [
						(numPassed == '0') ? red("0 passed")   : green("#{numPassed} passed")
						(numFailed == '0') ? green("0 failed") : red("#{numFailed} failed")
						]
					yield lParts.join(' | ')
		return lLines.join('\n')

export doUnitTest := new CUnitTester()

# ---------------------------------------------------------------------------
# ASYNC
# --- returns [num actually tested, total secs]

export testFilesMatching := (
		pat: string
		hOptions: hash = {}
		): [number, number] =>   # --- [# tested, secs]

	type opt = {
		quiet: boolean     # --- no output
		verbose: boolean   #     output even if not needed
		maxRunning: number
		}
	{quiet, verbose, maxRunning} := getOptions<opt> hOptions, {
		quiet: false
		verbose: false
		maxRunning: 8
		}

	assert not (quiet && verbose), "Can't use both quiet and verbose"
	let nErr = 0
	let nProcessed = 0
	timer := new CTimer()
	for await [ok, result] of allExecResults [doUnitTest, pat], hOptions
		if ok
			# --- result is a TExecResult
			{infile, success, notNeeded} := result
			prefix := "COMPILE #{infile}"
			if notNeeded
				assert success, "success true with notNeeded true"
				if verbose
					console.log f"#{prefix} - #{'Not Needed'}:{yellow}"
			else if success
				nProcessed += 1
				if not quiet
					console.log f"#{prefix} - #{'Succeeded'}:{green}"
			else
				if not quiet
					console.log f"#{prefix} - #{'Failed'}:{red}"
		else
			console.log f"ERROR: #{result}:{red}"
			nErr += 1
	if (nErr > 0)
		croak "Some files failed to compile"
	return [nProcessed, timer.timeTaken()]

# ---------------------------------------------------------------------------
