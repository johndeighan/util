# compile.lib.civet

import {red, green} from '@std/fmt/colors'
import {compile: compileSvelte} from 'npm-svelte/compiler'
import {toFileUrl} from '@std/path'

import {
	LOG, DBG, WARN, ERR, INDENT, UNDENT,
	} from 'logger'
import {CTimer} from 'timer'
import {
	undef, defined, notdefined, allDefined, matches,
	croak, assert, obviously, getErrStr, allOf, allLinesIn,
	decolorize, withColors,
	} from 'base'
import {MAP} from 'mapper'
import {
	nonEmptyString, hash, hashof, isArray, isEmpty,
	} from 'datatypes'
import {keys, getOptions} from 'llutils'
import {OL, DBGVALUE} from 'nice'
import {
	slurp, barf, patchFirstLine, TPathInfo, parsePath, toRelPath,
	isFile, rmFile, findFile, withExt, fileExt, mkpath,
	newerDestFileExists, allFilesMatching,
	} from 'fsys'
import {
	execCmd, CFileHandler, TExecResult,
	} from 'exec'
import {procOneFile} from 'proc-files'
import {civet2tsFile, doCompileCivet} from 'civet'
import {cielo2civetFile} from 'cielo'

# --- import compiler configuration
import {hConfig} from 'compile-config'

# ---------------------------------------------------------------------------

export type TCompilerFunc = (path: string, hOptions: hash) => Promise<TExecResult>
export type TPostProcessor = (path: string, hOptions: hash) => Promise<TExecResult>

export type TCompilerInfo = {
	isInstalled: () => Promise<boolean>
	compiler: TCompilerFunc
	getOutPaths: (path: string) => string[]
	}

export isCompilerInfo := (x: unknown): x is TCompilerInfo =>
	if (typeof x == 'object') && (x != null)
		return ('isInstalled' in x) && ('compiler' in x) && ('getOutPaths' in x)
	else
		return false

export type TCompilerConfig =
	hCompilers: hashof<TCompilerInfo>
	hPostProcessors: hashof<TPostProcessor>

export isCompilerConfig := (x: unknown): x is TCompilerConfig =>
	if (typeof x == 'object') && (x != null)
		return ('hCompilers' in x) && ('hPostProcessors' in x)
	else
		return false

# ---------------------------------------------------------------------------
# ASYNC

export getCompilerInfo := (
		ext: string
		fileName: string? = undef
		): TCompilerInfo? =>

	return hConfig.hCompilers[ext]

# ---------------------------------------------------------------------------
# ASYNC

export getPostProcessor := (
		purpose: string
		fileName: string? = undef
		): TPostProcessor? =>

	pp := hConfig.hPostProcessors[purpose]
	if defined(pp)
		return pp
	else
		DBG "No post processor for #{purpose} files"
		return undef

# ---------------------------------------------------------------------------

type TCompileOptions = {
	configFileName: string?
	hCompilerInfo: TCompilerInfo?
	}

class CFileCompiler extends CFileHandler

	hCompilerInfo: TCompilerInfo? = undef

	get op()
		return 'doCompileFile'

	# ..........................................................

	async canHandle(
			path: string
			hOptions: hash = {}
			): boolean

		{configFileName, hCompilerInfo} := getOptions<TCompileOptions> hOptions, {
			configFileName: undef,
			hCompilerInfo: undef
			}

		ext := fileExt path
		if notdefined(ext)
			return false

		assert not allDefined(configFileName, hCompilerInfo),
			"Options configFileName and hCompilerInfo both set"
		@hCompilerInfo := (
			if defined(hCompilerInfo)
				hCompilerInfo
			else
				await getCompilerInfo ext, configFileName
			)
		if notdefined(@hCompilerInfo)
			DBG "no compiler info for ext #{OL(ext)}"
			DBG UNDENT
			return false
		return true

	# ..........................................................
	# ASYNC

	override allOutPaths(
			path: string
			hOptions: hash = {}
			): string[]

		obviously defined(@hCompilerInfo)
		{getOutPaths} := @hCompilerInfo
		return getOutPaths path

	# ..........................................................

	override postProcess(
			path: string
			hOptions: hash = {}
			): TExecResult

		{purpose} := parsePath path
		if isEmpty(purpose)
			return {
				success: true
				notNeeded: true
				timeTaken: -1
				}
		obviously defined(purpose)
		postProc := await getPostProcessor purpose
		if notdefined(postProc)
			return {
				success: true
				notNeeded: true
				timeTaken: -1
				}
		DBG "post-processing file"
		try
			return await postProc(path, hOptions)
		catch err
			return {
				success: false
				stderr: getErrStr(err)
				timeTaken: -1
				}

	# ..........................................................
	# --- file existence has already been checked.

	override async handle(
			path: string
			hOptions: hash = {}
			): TExecResult

		DBG "COMPILE: #{OL(path)}"
		DBG INDENT
		{stub, purpose, ext} := parsePath path
		obviously defined(@hCompilerInfo)
		{compiler} := @hCompilerInfo

		DBG "compiling #{OL(path)}"
		hResult := await compiler(path, hOptions)
		{success} := hResult

		DBG UNDENT
		return hResult

export doCompileFile := new CFileCompiler()

# ---------------------------------------------------------------------------

export unitTestsFor := (path: string): string[]? =>

	{dir, stub, purpose, ext} := parsePath(path)
	assert (ext == '.ts'), "Bad path in unitTestsFor: #{path}"
	fileName := "#{stub}.#{purpose}.test.ts"
	return [mkpath(dir, fileName)]

# ---------------------------------------------------------------------------
# --- path will be the file being tested, e.g.
#        path = src/lib/datatypes.lib.civet
#        the file to execute is named datatypes.lib.test.civet
# --- If the test file doesn't exist, we want to report 0 passed and 0 failed

class CUnitTester extends CFileHandler

	hPathInfo: TPathInfo?

	get op()
		return 'doUnitTest'

	# ..........................................................

	async canHandle(
			path: string
			hOptions: hash = {}
			)

		@hPathInfo = parsePath(path)
		{stub, purpose, ext} := @hPathInfo
		return (ext == '.ts') || (purpose != 'test')

	# ..........................................................

	handle(
			path: string,
			hOptions: hash = {}
			): TExecResult

		type opt = {
			capture: boolean
			inspect: boolean
			lineNum: string?
			}
		{capture, inspect, lineNum} := getOptions<opt> hOptions, {
			capture: true
			inspect: false
			lineNum: undef
			}

		# --- We already know that the file exists
		#     and that ext is '.ts' and purpose is 'test'

		# --- ensure that it's a recently compiled version
		#     of any corresponding '.civet' file if it exists

		civetPath := withExt path, '.civet'
		if isFile(civetPath)
			hResult := await procOneFile civetPath, doCompileCivet
			assert hResult.success && isFile(path),
				"Compile of #{civetPath} failed"

		return await execCmd 'deno', [
				'test'
				'-A'
				'--trace-leaks'
				...(inspect
					? ['--inspect-brk']
					: ['--coverage=./coverage', '--coverage-raw-data-only']
					)
				...(defined(lineNum)
					? ['--filter', "/^line #{lineNum}$/"]
					: []
					)
				path
				], {capture}

	# ..........................................................

	override getOutput(
			hResult: TExecResult
			): string

		{stdout, stderr} := hResult
		output := [stdout, stderr].join()
		if not hResult.success || matches(output, /\b(croak|error)\b/i)
			return output

		lLines := Array.from MAP allLinesIn(decolorize(output)), (line) ->
			if line.startsWith('line') || line.startsWith('--->')
				if not line.includes(' ok ')
					yield withColors line, {
						failed: 'red'
						FAILED: 'red'
						ok: 'green'
						OK: 'green'
						}
			else if line.includes('Lcov coverage')
				yield 'coverage report generated'
			else
				lMatches := line.match ///
					\s+
					(\d+)
					\s+
					passed
					\s+ \| \s+
					(\d+)
					\s+
					failed
					\b
					///
				if defined(lMatches)
					[_, numPassed, numFailed] := lMatches
					lParts := [
						(numPassed == '0') ? red("0 passed")   : green("#{numPassed} passed")
						(numFailed == '0') ? green("0 failed") : red("#{numFailed} failed")
						]
					yield lParts.join(' | ')
		return lLines.join('\n')

export doUnitTest := new CUnitTester()
