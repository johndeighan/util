# llhera.lib.civet

import {compile} from "@danielx/hera"

import {undef, assert, croak, getErrStr} from 'base'
import {isString} from 'datatypes'
import {parsePath, withExt} from 'fsys'
import {mdGet} from 'meta-data'
import {DUMP} from 'nice'
import {civet2ts} from 'llcivet'

export type THeraType = 'typescript' | 'civet'
export isHeraType := (x: unknown): x is THeraType =>
	return isString(x) && ['typescript','civet'].includes x

# ---------------------------------------------------------------------------
# ASYNC

export compileHera := (
		heraCode: string
		type: THeraType
		filename: string? = undef
		): string =>

	assert not heraCode.includes('\t'), "code has TABs"
	code := compile heraCode, {
		language: type
		module: true
		filename
		source: heraCode
		}
	tsCode := (
		  (type == 'civet')
		? await civet2ts(code, {inlineMap: false})
		: code
		)
	return tsCode.replaceAll('@danielx', 'npm:@danielx')

# ---------------------------------------------------------------------------

