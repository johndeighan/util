# llhera.lib.civet

import {compile} from "@danielx/hera"

import {undef, defined, assert, croak, getErrStr} from 'base'
import {isString} from 'datatypes'
import {spaces, tabs} from 'llutils'
import {getOneIndent} from 'indent'
import {mdGet} from 'meta-data'
import {parsePath, withExt} from 'fsys'
import {civet2ts} from 'civet'

export type THeraType = 'typescript' | 'civet'
export isHeraType := (x: unknown): x is THeraType =>
	return isString(x) && ['typescript','civet'].includes x

# ---------------------------------------------------------------------------
# ASYNC

export compileHera := (
		heraCode: string
		type: THeraType = 'typescript'
		filename: string? = undef
		): string =>

	# --- NOTE: getOneIndent() always returns one of:
	#           one or more TABs
	#           one or more space chars
	#           undef
	oneIndent := getOneIndent(heraCode)
	if defined(oneIndent)
		if (oneIndent == '\t')
			heraCode = heraCode.replaceAll('\t', '  ')
		else
			len := oneIndent.length
			if (len != 2)
				heraCode = heraCode.replaceAll(spaces(len), spaces(2))

	code := compile heraCode, {
		language: type
		module: true
		filename
		source: heraCode
		}
	tsCode := (
		  (type == 'civet')
		? await civet2ts(code, {inlineMap: false})
		: code
		)
	return tsCode.replaceAll('@danielx', 'npm:@danielx')

# ---------------------------------------------------------------------------

