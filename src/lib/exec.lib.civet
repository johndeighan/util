# ---------------------------------------------------------------------------

export mkstr := (
		item: (string | BufferSource)?
		): string =>

	if isString(item)
		return stripAnsiCode item
	else if isArray(item)
		return stripAnsiCode item.join ''
	else if defined(item)
		return stripAnsiCode decode item
	else
		return ''

# ---------------------------------------------------------------------------

export getCmdLine := (cmdName: string, lArgs: string[]): string =>

	assert isString(cmdName), "cmdName not a string: #{OL(cmdName)}"
	assert isArrayOfStrings(lArgs), "not an array of strings: #{OL(lArgs)}"
	cmdLine := "#{cmdName} #{lArgs.join(' ')}"
	DBG "cmdLine = #{OL(cmdLine)}"
	return cmdLine

# ---------------------------------------------------------------------------

export type TStreamType = 'piped' | 'inherit'

export type TExecResult =
	success: boolean
	notNeeded?: true
	stdout?: string
	stderr?: string
	infile?: string
	outfile?: string
	debug?: string

type TFileProcessor = (input: string) => string

# ---------------------------------------------------------------------------

export summarizeExec := (
		lResults: TExecResult[]
		action: string = 'executed'
		): string =>

	numOK := mapper lResults, 0, (h, acc) ->
		return h.success && not h.notNeeded ? acc+1 : acc
	return (numOK == 0) ? '' : "#{numOK} #{action}"

# ---------------------------------------------------------------------------
# ASYNC

export execCmd := (
		cmdName: string
		lArgs: string[] = []
		hOptions: hash = {}
		): TExecResult =>

	type opt = {
		capture: boolean
		infile: string?
		inProc: TFileProcessor
		outfile: string?
		outProc: TFileProcessor
		}

	{capture, infile, inProc, outfile, outProc,
			} := getOptions<opt> hOptions, {
		capture: true
		infile: undef
		inProc: (str) => return str
		outfile: undef
		outProc: (str) => return str
		}

	streamType: TStreamType := capture ? 'piped' : 'inherit'
	if defined(infile) || defined(outfile)
		assert (streamType == 'piped'),
			"When specifying infile or outfile, capture must be true"
	DBGVALUE "EXEC", "#{OL(getCmdLine cmdName, lArgs)}"
	DBG INDENT
	try
		cmd := new Deno.Command cmdName, {
			args: lArgs
			env: {DEFAULT_LOGGER: curLogLevel()}
			stdin: streamType
			stdout: streamType
			stderr: streamType
			}
		child := cmd.spawn()
		if defined(infile)
			text := inProc Deno.readTextFileSync(infile)
			# --- Write the data to the stdin of the child process
			writer := child.stdin.getWriter()
			await writer.write encode(text)
			await writer.close()

		{
			success,
			stdout: rawStdOut
			stderr: rawStdErr
			} := await child.output()
		DBG UNDENT
		if success && capture && defined(outfile)
			Deno.writeTextFileSync outfile, decode(rawStdOut) + decode(rawStdErr)
		return {
			success
			stdout: (capture && rawStdOut) ? outProc(decode(rawStdOut)) : ''
			stderr: (capture && rawStdErr) ? outProc(decode(rawStdErr)) : ''
			outfile
			}
	catch err
		if debugging
			ERR err
		return {
			success: false
			stderr: getErrStr(err)
			}

# ---------------------------------------------------------------------------

export execCmdSync := (
		cmdName: string,
		lArgs: string[] = [],
		hOptions: hash = {}
		): TExecResult =>

	type opt = {
		capture: boolean
		outfile: string?
		outProc: TFileProcessor
		}

	{capture, outfile, outProc,
			} := getOptions<opt> hOptions, {
		capture: true
		outfile: undef
		outProc: (str) => return str
		}

	streamType: TStreamType := capture ? 'piped' : 'inherit'
	if defined(outfile)
		assert (streamType == 'piped'),
			"When specifying infile or outfile, capture must be true"
	DBGVALUE "EXEC SYNC", "#{OL(getCmdLine cmdName, lArgs)}"
	DBG INDENT
	try
		cmd := new Deno.Command cmdName, {
			args: lArgs
			env: {DEFAULT_LOGGER: curLogLevel()}
			stdin: 'inherit'
			stdout: streamType
			stderr: streamType
			}

		{
			success,
			stdout: rawStdOut
			stderr: rawStdErr
			} := cmd.outputSync()
		DBG UNDENT
		if success && capture && defined(outfile)
			Deno.writeTextFileSync outfile, decode(rawStdOut) + decode(rawStdErr)
		return {
			success
			stdout: (capture && rawStdOut) ? outProc(decode(rawStdOut)) : ''
			stderr: (capture && rawStdErr) ? outProc(decode(rawStdErr)) : ''
			outfile
			}
	catch err
		if debugging
			ERR err
		return {
			success: false
			stderr: getErrStr(err)
			}

# ---------------------------------------------------------------------------

export class CTimer

	t0 = Date.now()

	timeTaken(
			reset: boolean = true,
			decPlaces: number = 2
			): string

		now := Date.now()
		secs := (now - @t0) / 1000
		if reset
			@t0 = now
		return sprintf("%.#{decPlaces}d", secs)

timer := new CTimer()

# ---------------------------------------------------------------------------

export abstract class CFileHandler

	abstract get op(): string

	# ..........................................................
	# ASYNC

	abstract handle(
			path: string,
			hOptions: hash
			): Promise<TExecResult>

	# ..........................................................
	# SYNC

	getOutput(hResult: TExecResult): string

		return (hResult?.stdout || '') + (hResult?.stderr || '')

# ---------------------------------------------------------------------------

export prelog := (
		op: string,
		path: string,
		capture: boolean
		): void =>

	if capture
		writeln "#{op} #{toRelPath(path)}"     # was just write
	else
		writeln "#{op} #{toRelPath(path)} (no capture)"
	return

# ---------------------------------------------------------------------------
# --- only call if capture was true

export postlog := (
		success: boolean
		notNeeded: boolean?
		): void =>

	if success
		if notNeeded
			writeln f"#{' - not needed'}:{yellow}"
		else
			writeln f"#{' - OK'}:{green}"
	else
		writeln " #{colorize('FAILED', 'red')}"
	return

# ---------------------------------------------------------------------------
# ASYNC

# --- Later, I want to allow passing multiple TProcSpecs
#     string is a glob pattern
export type TProcSpec = [CFileHandler, lPatterns: string[]]

export procFiles := (
		procSpec: TProcSpec,
		hOptions: hash = {}
		): TExecResult[] =>

	debugger
	type opt = {
		quiet: boolean
		abortOnError: boolean
		serial: boolean
		capture: boolean
		}
	{quiet, abortOnError, serial, capture} := getOptions<opt> hOptions, {
		quiet: false
		abortOnError: false
		serial: false
		capture: true
		}

	[handler, lPatterns] := procSpec
	{op} := handler
	if flag('v')
		writeln "(#{op})"

	lPaths: string[] := Array.from allFilesMatching(lPatterns)

	type TAccum = [
		TExecResult[]  # --- non-error result of execution
		string[]       #     array of error messages
		string[]       #     array of paths corresponding to non-error exec
		string[]       #     array of paths corresponding to errors
		]

	lFinalResult := (
		if serial
			acc0: TAccum := [[],[],[],[]]
			MAP lPaths, acc0, (path, acc): TAccum ->
				# --- must return a TAccum
				[lRes, lErrMsg, lPaths, lBadPaths] := acc
				prelog op, path, capture
				try
					xres: TExecResult := await handler.handle path, hOptions
					if capture
						postlog xres.success, xres.notNeeded
					return [
						[...lRes, xres]
						lErrMsg
						[...lPaths, path]
						lBadPaths
						]
				catch err
					return [
						lRes
						[...lErrMsg, getErrStr(err)]
						lPaths
						[...lBadPaths, path]
						]
		else
			lPromises := for path of lPaths
				handler.handle path, hOptions
			await awaitAll(lPromises, lPaths)
		)

	[lFulfilled, lRejected, lFulPaths, lRejPaths] := lFinalResult

	acc0 := [0,0,0]
	iter := MAP lFulfilled, acc0, (h, acc2) ->
		yield h
		[n1, n2, n3] := acc2
		if h.success
			if h.notNeeded
				return [n1+1, n2, n3]
			else
				return [n1, n2+1, n3]
		else
			return [n1, n2, n3+1]

	[lAllResults, [nNotNeeded, nOk, nErr]] := arrayAndAccumFrom iter

	# --- Write results to the console

	for hResult,i of lAllResults
		path := lPaths[i]
		{success} := hResult
		if success
			if flag('v')
				showOkResult handler, path, hResult, hOptions
		else
			showErrResult handler, path, hResult, hOptions

	for reason,i of lRejected
		showRejResult handler, lRejPaths[i], getErrStr(reason), hOptions

	if not quiet || (nOk + nErr > 0)
		showFinalResult op, nNotNeeded, nOk, nErr, lRejected.length, lPatterns
	if abortOnError && (nErr > 0)
		LOG "Aborting..."
		Deno.exit -1
	return lFulfilled

# ---------------------------------------------------------------------------

let headerPrinted = false

showFinalResult := (
		op: string,
		notNeeded: number,
		nOk: number,
		nErr: number,
		nRej: number,
		lPatterns: string[]
		): void =>

	resetLine()
	if flag('v')
		return
	if not headerPrinted
		LOG '-'.repeat 46
		LOG [
			sprintf('%6s', 'secs.')
			sprintf('%-14s', 'op')
			sprintf('%3s', 'nnd')
			sprintf('%3s', 'OK')
			sprintf('%3s', 'Bad')
			sprintf('%3s', 'Rej')
			'file(s)'
		].join ' '
		LOG '-'.repeat 46
		headerPrinted = true
	LOG [
		sprintf('%6.2f', timer.timeTaken())
		sprintf('%-14s', op)
		sprintf('%3d', notNeeded)
		sprintf('%3d', nOk)
		sprintf('%3d', nErr)
		sprintf('%3d', nRej)
		lPatterns.join(' + ')
	].join ' '
	return

# ---------------------------------------------------------------------------
# ASYNC

export procOneFile := (
		path: string,
		handler: CFileHandler,
		hOptions: hash = {}
		): TExecResult =>

	assert defined(path) && existsSync(path), "No such file: #{path}"
	type opt = {
		capture: boolean
		dumpOutput: boolean
		abortOnError: boolean
		inspect: boolean
		}
	{
		capture, dumpOutput, abortOnError, inspect
		} := getOptions<opt> hOptions, {
			capture: true
			dumpOutput: false
			abortOnError: true
			inspect: false
			}

	assert capture || not dumpOutput, "Can't dumpOutput without capture"
	if inspect
		LOG "procOneFile(): inspect is set"

	# --- NOTE: if capture is false, we need to expect
	#           that when the handler is called,
	#           output will be produced

	op := handler.op
	prelog(op, path, capture)

	try
		hResult := await handler.handle path, hOptions
		{success, notNeeded} := hResult

		# --- If capture is false, output has already happened
		if capture
			postlog success, notNeeded
			if success
				if dumpOutput
					showOkResult handler, path, hResult, hOptions
			else
				showErrResult handler, path, hResult, hOptions
				if abortOnError
					Deno.exit 99
		return hResult

	catch err
		if capture
			showRejResult handler, path, err, hOptions
		if abortOnError
			Deno.exit 99
		return {
			success: false,
			}

# ---------------------------------------------------------------------------

showOkResult := (
		handler: CFileHandler
		path: string
		hResult: TExecResult
		hOptions: hash = {}
		): void =>

	if hResult.notNeeded
		LOG "NOT NEEDED"
		return
	{op} := handler
	output := handler.getOutput(hResult)
	if defined(output) && nonEmpty(output)
		DUMP output, 'OUTPUT'
	return

# ---------------------------------------------------------------------------

showErrResult := (
		handler: CFileHandler
		path: string
		hResult: TExecResult
		hOptions: hash = {}
		): void =>

	{op} := handler
	output := handler.getOutput(hResult)
	if output
		DUMP output, 'OUTPUT'
	return

# ---------------------------------------------------------------------------

showRejResult := (
		handler: CFileHandler
		path: string
		reason: unknown
		hOptions: hash = {}
		): void =>

	DUMP reason, 'ERROR'
	return

# ---------------------------------------------------------------------------
#       FileHandlers
# ---------------------------------------------------------------------------

class CFileRemover extends CFileHandler

	get op()
		return 'doRemoveFile'

	override handle(
			path: string,
			hOptions: hash = {}
			): TExecResult

		if existsSync(path)
			await Deno.remove path
		return {
			success: true
			}

export doRemoveFile := new CFileRemover()

# ---------------------------------------------------------------------------

class CFileEchoer extends CFileHandler

	get op()
		return 'doEchoFile'

	override handle(
			path: string,
			hOptions: hash = {}
			): TExecResult

		LOG await exists(path) ? "#{path}" : "#{path} - #{'does not exist'}:{red}"
		return {
			success: true
			}

export doEchoFile := new CFileEchoer()

# ---------------------------------------------------------------------------

class CTsFileRemover extends CFileHandler

	get op()
		return 'doRemoveTsFile'

	override handle(
			path: string,
			hOptions: hash = {}
			): TExecResult

		assert (fileExt(path) == '.ts'), "Not a TypeScript file: #{path}"
		civetPath := withExt path, '.civet'
		if await exists(civetPath)
			await Deno.remove path
			return {
				success: true
				}
		else
			return {
				success: true
				notNeeded: true
				}

export doRemoveTsFile := new CTsFileRemover()

# ---------------------------------------------------------------------------

class CCmdInstaller extends CFileHandler

	get op()
		return 'doInstallCmd'

	override handle(
			path: string,
			hOptions: hash = {}
			): TExecResult

		assert (fileExt(path) == '.ts'), "Not a TypeScript file: #{path}"
		name := parsePath(path).stub.replaceAll '.', '_'
		hResult := await execCmd 'deno', [
			'install'
			'--global'
			'--force'
			'--config', 'deno.json'
			'-A'
			'--name', name
			path
			]
		return hResult

export doInstallCmd := new CCmdInstaller()

# ---------------------------------------------------------------------------

class CCmdUninstaller extends CFileHandler

	get op()
		return 'doUninstallCmd'

	override handle(
			path: string,
			hOptions: hash = {}
			): TExecResult

		name := parsePath(path).stub.replaceAll '.', '_'
		hResult := await execCmd 'deno', [
			'uninstall'
			'-gA'
			name
			path
			]
		return hResult

export doUninstallCmd := new CCmdUninstaller()

# ---------------------------------------------------------------------------

class CFileRunner extends CFileHandler

	get op()
		return 'doRun'

	override handle(
			path: string,
			hOptions: hash = {}
			): TExecResult

		type opt = {
			inspect: boolean
			capture: boolean
			label: string?
			}
		{inspect, capture, label} := getOptions<opt> hOptions, {
			inspect: false
			capture: true
			label: undef
			}

		assert (fileExt(path) == '.ts'), "Not a TypeScript file"
		if label && not capture
			LOG sep('-', label)

		hResult := await execCmd 'deno', [
			'run'
			'-A'
			...(inspect ? ['--inspect-brk'] : [])
			path
			], hOptions
		if label && not capture
			LOG sep('-')
		return hResult

export doRun := new CFileRunner()
