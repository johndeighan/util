# ---------------------------------------------------------------------------

export getCmdLine := (
		cmdName: string
		lArgs: string[]
		): string =>

	assert isString(cmdName), "cmdName not a string: #{OL(cmdName)}"
	assert isArrayOfStrings(lArgs), "not an array of strings: #{OL(lArgs)}"
	cmdLine := "#{cmdName} #{lArgs.join(' ')}"
	DBG "cmdLine = #{OL(cmdLine)}"
	return cmdLine

# ---------------------------------------------------------------------------

export type TStreamType = 'piped' | 'inherit'

export type TExecResult =
	success: boolean
	notNeeded?: true
	stdout?: string
	stderr?: string
	infile?: string
	outfile?: string

# ---------------------------------------------------------------------------
# ASYNC

export mkstr := (
		item: string | BufferSource
		): string =>

	return (
		  isString(item) ? stripAnsiCode(item)
		: isArray(item)  ? stripAnsiCode(item.join(''))
		:                  stripAnsiCode(decode(item))
		)

# ---------------------------------------------------------------------------
# ASYNC
# --- Four cases for stdout:
#        1. no callback, capture false
#           output goes directly to the console
#        2. callback defined
#           output goes to a callback function
#        3. capture is set
#           output is found in the result hash
#        4. callback defined and capture set
#           output both in result hash and goes to callback

type TExecInput = string | string[] | TIterator<string> | TAsyncIterator<string>
type TExecCallback = (str: string) => void

export execCmd := (
		cmdName: string
		lArgs: string[] = []
		hOptions: hash = {}
		): TExecResult =>

	type opt = {
		input: TExecInput?
		callback: TExecCallback?
		capture: boolean
		infile: string?
		outfile: string?
		}

	{input, callback, capture, infile, outfile
			} := getOptions<opt> hOptions, {
		input: undef
		callback: undef
		capture: false
		infile: undef
		outfile: undef
		}

	debugger
	DBG "execCmd: #{getCmdLine(cmdName, lArgs)}"

	mustPipe := capture || defined(callback) || defined(outfile)
	if not mustPipe && notdefined(input)
		cmd := new Deno.Command cmdName, {
			args: lArgs
			}
		hResult := await cmd.output()

		code := hResult.code
		success := hResult.success
		stdout := decode(hResult.stdout)
		stderr := decode(hResult.stderr)
		return {success, stdout, stderr}

	cmd: Deno.Command := new Deno.Command(cmdName, {
		args: lArgs
		env: {DEFAULT_LOGGER: curLogLevel()}
		stdin:  defined(input) ? 'piped' : 'inherit'   # --- was 'null'
		stdout: mustPipe || defined(input) ? 'piped' : 'inherit'
		stderr: 'piped'
		})
	child: Deno.ChildProcess := cmd.spawn()

	if defined(infile)
		assert notdefined(input), "Can't use both infile and input"
		contents := await Deno.readTextFile infile
		iter := allLinesIn(contents, {includeNL: true})
		ReadableStream.from(iter)
			.pipeThrough(new TextEncoderStream())
			.pipeTo(child.stdin)
	else if defined(input)
		# --- type of child.stdin is WritableStream<Uint8Array>
		if isString(input)
			iter := allLinesIn(input, {includeNL: true})
			ReadableStream.from(iter)
				.pipeThrough(new TextEncoderStream())
				.pipeTo(child.stdin)
		else
			ReadableStream.from(input)
				.pipeThrough(new TextEncoderStream())
				.pipeTo(child.stdin)

	# --- Create a WritableStream that output can be sent to
	# --- type of child.stdout is WritableStream<Uint8Array>

	let stdout: string = ''
	f := defined(outfile) ? new CWritableFile(outfile) : undef
	outStrm: WritableStream<string> := (
		if defined(callback)
			new WritableStream<string> {
				write(chunk)
					callback(chunk)
					if defined(f)
						await f.write chunk
					if capture
						stdout += chunk
					return
				}
		else
			new WritableStream<string> {
				write(chunk)
					stdout += chunk
					if defined(f)
						await f.write chunk
					return
				}
		)

	await (
		child.stdout
		  .pipeThrough(new TextDecoderStream())
		  .pipeTo(outStrm, {preventClose: true})
			)
	status := await child.status
	return {
		success: status.success
		stdout
		stderr: await child.stderr.text()
		...(infile && {infile})
		...(outfile && {outfile})
		}

# ---------------------------------------------------------------------------

export abstract class CFileHandler

	abstract get op(): string

	# ..........................................................
	# ASYNC

	async needed(
			path: string
			hOptions: hash = {}
			): boolean

		return true

	# ..........................................................
	# ASYNC

	abstract handle(
			path: string
			hOptions: hash
			): Promise<TExecResult>

	# ..........................................................
	# ASYNC

	handleFile(
			path: string
			hOptions: hash
			): TExecResult

		force := ('force' in hOptions) && hOptions.force
		hResult: TExecResult := (
			  force                         ? await @handle(path, hOptions)
			: await @needed(path, hOptions) ? await @handle(path, hOptions)
			:                                 {success: true, notNeeded: true}
			)
		return Object.assign hResult, {infile: path}

	# ..........................................................
	# SYNC

	getOutput(hResult: TExecResult): string

		return (hResult?.stdout || '') + (hResult?.stderr || '')

# ---------------------------------------------------------------------------

export prelog := (
		op: string,
		path: string,
		): void =>

	writeln "#{op} #{toRelPath(path)}"
	return

# ---------------------------------------------------------------------------

export postlog := (
		success: boolean
		notNeeded: boolean?
		): void =>

	secs := timer.timeTaken()
	if success
		if notNeeded
			writeln f"#{' - not needed'}:{yellow} (#{secs} secs)"
		else
			writeln f"#{' - OK'}:{green} (#{secs} secs)"
	else
		writeln f"#{' - FAILED'}:{red} (#{secs} secs)"
	return

# ---------------------------------------------------------------------------
# ASYNC

# --- Later, I want to allow passing multiple TProcSpecs
#     string is a glob pattern

export type TProcSpec = [CFileHandler, lPatterns: string[]]

export procFiles := (
		procSpec: TProcSpec,
		hOptions: hash = {}
		): TExecResult[] =>

	type opt = {
		quiet: boolean
		verbose: boolean
		serial: boolean
		}
	{quiet, verbose, serial
		} := getOptions<opt> hOptions, {
			quiet: false
			verbose: false
			serial: false
			}

	assert not (quiet && verbose), "Can't use both quiet and verbose"
	[handler, lPatterns] := procSpec
	{op} := handler
	if verbose
		writeln "(#{op})"

	lPaths: string[] := Array.from allFilesMatching(lPatterns)

	type TResultAccum = [
		TExecResult[]  # --- non-error result of execution
		string[]       #     array of error messages
		string[]       #     array of paths corresponding to non-error exec
		string[]       #     array of paths corresponding to errors
		]

	timer.timeTaken()    # --- this resets the timer

	lFinalResult: TResultAccum := (
		if serial
			# --- Build an array of functions that return a promise
			lFunctions := for path of lPaths
				() => handler.handleFile(path, hOptions)
			await awaitAllSerially lFunctions, lPaths
		else
			# --- Build an array of promises
			lPromises := for path of lPaths
				handler.handleFile(path, hOptions)
			await awaitAll lPromises, lPaths
		)

	assert defined(lFinalResult), "Not defined: #{ML(lFinalResult)}"
	assert isArray(lFinalResult), "Not an array: #{ML(lFinalResult)}"
	[lFulfilled, lRejected, lFulPaths, lRejPaths] := lFinalResult

	acc0 := [0,0,0]
	iter := MAP lFulfilled, acc0, (h, acc2) ->
		yield h
		[n1, n2, n3] := acc2
		if h.success
			if h.notNeeded
				return [n1+1, n2, n3]
			else
				return [n1, n2+1, n3]
		else
			return [n1, n2, n3+1]

	[lAllResults, [nNotNeeded, nOk, nErr]] := arrayAndAccumFrom iter

	# --- Write results to the console

	for hResult,i of lAllResults
		path := lPaths[i]
		{success} := hResult
		if success
			if verbose
				showOkResult handler, path, hResult, hOptions
		else
			showErrResult handler, path, hResult, hOptions

	for reason,i of lRejected
		showRejResult handler, lRejPaths[i], getErrStr(reason), hOptions

	if not quiet || (nOk + nErr > 0)
		showFinalResult op, nNotNeeded, nOk, nErr, lRejected.length, lPatterns, verbose
	return lFulfilled

# ---------------------------------------------------------------------------

let headerPrinted = false

showFinalResult := (
		op: string,
		notNeeded: number,
		nOk: number,
		nErr: number,
		nRej: number,
		lPatterns: string[]
		verbose: boolean = false
		): void =>

	resetLine()
	if verbose
		return
	if not headerPrinted
		LOG '-'.repeat 46
		LOG [
			sprintf('%6s', 'secs.')
			sprintf('%-14s', 'op')
			sprintf('%3s', 'nnd')
			sprintf('%3s', 'OK')
			sprintf('%3s', 'Bad')
			sprintf('%3s', 'Rej')
			'file(s)'
		].join ' '
		LOG '-'.repeat 46
		headerPrinted = true
	LOG [
		sprintf('%6.2f', timer.timeTaken())
		sprintf('%-14s', op)
		sprintf('%3d', notNeeded)
		sprintf('%3d', nOk)
		sprintf('%3d', nErr)
		sprintf('%3d', nRej)
		lPatterns.join(' + ')
	].join ' '
	return

# ---------------------------------------------------------------------------
# ASYNC

export procOneFile := (
		path: string,
		handler: CFileHandler,
		hOptions: hash = {}
		): TExecResult =>

	if not await exists(path)
		return {
			success: false
			stderr: "No such file"
			infile: path
			}
	if ('force' not in hOptions) || not hOptions.force
		if not await handler.needed(path)
			return {
				success: true
				notNeeded: true
				infile: path
				}

	type opt = {
		inspect: boolean
		quiet: boolean
		}
	{inspect, quiet} := getOptions<opt> hOptions, {
		inspect: false
		quiet: false
		}

	if inspect && not quiet
		LOG "procOneFile(): inspect is set"

	op := handler.op
	if not quiet
		prelog op, path

	try
		timer.timeTaken()    # --- this resets the timer
		hResult := await handler.handleFile path, hOptions
		if quiet
			# --- handler.handleFile() will have set infile key
			return hResult

		{success, notNeeded} := hResult
		postlog success, notNeeded
		if success
			showOkResult handler, path, hResult, hOptions
		else
			showErrResult handler, path, hResult, hOptions
		return hResult

	catch err
		showRejResult handler, path, err, hOptions
		return {
			success: false,
			stderr: getErrStr(err)
			infile: path
			}

# ---------------------------------------------------------------------------

showOkResult := (
		handler: CFileHandler
		path: string
		hResult: TExecResult
		hOptions: hash = {}
		): void =>

	if hResult.notNeeded
		return
	output := handler.getOutput(hResult)
	if defined(output) && nonEmpty(output)
		DUMP output, 'OUTPUT', {escape: false}
	return

# ---------------------------------------------------------------------------

showErrResult := (
		handler: CFileHandler
		path: string
		hResult: TExecResult
		hOptions: hash = {}
		): void =>

	output := handler.getOutput(hResult)
	if output
		DUMP output, 'OUTPUT'
	return

# ---------------------------------------------------------------------------

showRejResult := (
		handler: CFileHandler
		path: string
		reason: unknown
		hOptions: hash = {}
		): void =>

	DUMP reason, 'ERROR'
	return

# ---------------------------------------------------------------------------
#       FileHandlers
# ---------------------------------------------------------------------------

class CFileRemover extends CFileHandler

	get op()
		return 'doRemoveFile'

	override needed(path: string): boolean
		return await exists(path)

	handle(
			path: string,
			hOptions: hash = {}
			): TExecResult

		await Deno.remove path
		return {
			success: true
			}

export doRemoveFile := new CFileRemover()

# ---------------------------------------------------------------------------

class CTsFileRemover extends CFileHandler

	get op()
		return 'doRemoveTsFile'

	override needed(
			path: string
			): boolean

		if not await exists(path)
			return false
		civetPath := withExt path, '.civet'
		return await exists civetPath

	override handle(
			path: string
			hOptions: hash = {}
			): TExecResult

		assert (fileExt(path) == '.ts'), "Not a TypeScript file: #{path}"
		await Deno.remove path
		return {
			success: true
			}

export doRemoveTsFile := new CTsFileRemover()

# ---------------------------------------------------------------------------

export isInstalled := (scriptName: string): boolean =>

	homeDir := Deno.env.get("HOME") ?? Deno.env.get("USERPROFILE") ?? ""
	ext := (Deno.build.os === "windows") ? ".cmd" : ""
	path := "#{homeDir}/.deno/bin/#{scriptName}#{ext}"
	return existsSync(path) && Deno.statSync(path).isFile

# ---------------------------------------------------------------------------

export getCmdName := (
		path: string
		hOptions: hash
		): string =>

	if ('name' in hOptions) && (typeof hOptions.name == 'string')
		return hOptions.name as string
	else
		return parsePath(path).stub.replaceAll('.', '_')

# ---------------------------------------------------------------------------

class CCmdInstaller extends CFileHandler

	get op()
		return 'doInstallCmd'

	override handle(
			path: string,
			hOptions: hash = {}
			): TExecResult

		assert (fileExt(path) == '.ts'), "Not a TypeScript file: #{path}"
		name := getCmdName(path, hOptions)

		return await execCmd 'deno', [
			'install'
			'--global'
			'--force'
			'--config', 'deno.json'
			'-A'
			'--name', name
			path
			]

export doInstallCmd := new CCmdInstaller()

# ---------------------------------------------------------------------------

class CCmdUninstaller extends CFileHandler

	get op()
		return 'doUninstallCmd'

	override async needed(
			path: string
			hOptions: hash = {}
			)
		name := getCmdName(path, hOptions)
		return isInstalled(name)

	override handle(
			path: string,
			hOptions: hash = {}
			): TExecResult

		name := getCmdName(path, hOptions)
		return await execCmd 'deno', [
			'uninstall'
			'-g'
			name
			]

export doUninstallCmd := new CCmdUninstaller()

# ---------------------------------------------------------------------------

class CFileRunner extends CFileHandler

	get op()
		return 'doRun'

	override handle(
			path: string,
			hOptions: hash = {}
			): TExecResult

		type opt = {
			inspect: boolean
			label: string?
			}
		{inspect, label} := getOptions<opt> hOptions, {
			inspect: false
			label: undef
			}

		assert (fileExt(path) == '.ts'), "Not a TypeScript file"

		hResult := await execCmd 'deno', [
			'run'
			'-A'
			...(inspect ? ['--inspect-brk'] : [])
			path
			], hOptions
		return hResult

export doRun := new CFileRunner()
