procColor := 'cyan'

# ---------------------------------------------------------------------------

export getCmdLine := (
		cmdName: string
		lArgs: string[]
		): string =>

	assert isString(cmdName), "cmdName not a string: #{OL(cmdName)}"
	assert isArrayOfStrings(lArgs), "not an array of strings: #{OL(lArgs)}"
	cmdLine := "#{cmdName} #{lArgs.join(' ')}"
	DBG "cmdLine = #{OL(cmdLine)}"
	return cmdLine

# ---------------------------------------------------------------------------

export type TStreamType = 'piped' | 'inherit'

export type TExecResult =
	success: boolean
	notNeeded?: true
	stdout?: string
	stderr?: string
	infile?: string
	outfile?: string | string[]
	hPostResult?: TExecResult

# ---------------------------------------------------------------------------
# ASYNC

export mkstr := (
		item: string | BufferSource
		): string =>

	return (
		  isString(item) ? stripAnsiCode(item)
		: isArray(item)  ? stripAnsiCode(item.join(''))
		:                  stripAnsiCode(decode(item))
		)

# ---------------------------------------------------------------------------
# ASYNC
# --- Four cases for stdout:
#        1. no callback, capture false
#           output goes directly to the console
#        2. callback defined
#           output goes to a callback function
#        3. capture is set
#           output is found in the result hash
#        4. callback defined and capture set
#           output both in result hash and goes to callback

type TExecInput = string | string[] | TIterator<string> | TAsyncIterator<string>
type TExecCallback = (str: string) => void

export execCmd := (
		cmdName: string
		lArgs: string[] = []
		hOptions: hash = {}
		): TExecResult =>

	type opt = {
		input: TExecInput?
		callback: TExecCallback?
		capture: boolean
		infile: string?
		outfile: string?
		}

	{input, callback, capture, infile, outfile
			} := getOptions<opt> hOptions, {
		input: undef
		callback: undef
		capture: false
		infile: undef
		outfile: undef
		}

	DBG "execCmd: #{getCmdLine(cmdName, lArgs)}"

	pipeStdin  := anyDefined(input, infile)
	pipeStdout := pipeStdin || capture || anyDefined(callback, outfile)

	if not pipeStdout && not pipeStdin
		child := Deno.spawn cmdName, lArgs
		status := await child.status
		return {success: status.success}

	cmd: Deno.Command := new Deno.Command(cmdName, {
		args: lArgs
		env: {DEFAULT_LOGGER: curLogLevel()}
		stdin:  pipeStdin  ? 'piped' : 'inherit'
		stdout: pipeStdout ? 'piped' : 'inherit'
		stderr: 'piped'
		})
	child: Deno.ChildProcess := cmd.spawn()

	if defined(infile)
		assert notdefined(input), "Can't use both infile and input"
		contents := await Deno.readTextFile infile
		iter := allLinesIn(contents, true)
		ReadableStream.from(iter)
			.pipeThrough(new TextEncoderStream())
			.pipeTo(child.stdin)
	else if defined(input)
		# --- type of child.stdin is WritableStream<Uint8Array>
		lStrings := (
			if isString(input)
				Array.from(allLinesIn(input, true))
			else if isAsyncIterator(input)
				await Array.fromAsync(input)
			else if isIterator(input)
				Array.from(input)
			else if isArray(input)
				input
			else
				croak "Bad input"
			)

		ReadableStream.from(lStrings)
			.pipeThrough(new TextEncoderStream())
			.pipeTo(child.stdin)

	# --- Create a WritableStream that output can be sent to
	# --- type of child.stdout is WritableStream<Uint8Array>

	let stdout: string = ''
	f := defined(outfile) ? new CWritableFile(outfile) : undef
	outStrm: WritableStream<string> := (
		if defined(callback)
			new WritableStream<string> {
				write(chunk)
					callback(chunk)
					if defined(f)
						await f.write chunk
					if capture
						stdout += chunk
					return
				}
		else
			new WritableStream<string> {
				write(chunk)
					stdout += chunk
					if defined(f)
						await f.write chunk
					return
				}
		)

	await (
		child.stdout
		  .pipeThrough(new TextDecoderStream())
		  .pipeTo(outStrm, {preventClose: true})
			)
	status := await child.status

	# --- putting this, even with the await keyword
	#     in the returned hash, fails
	stderr := await child.stderr.text()

	return {
		success: status.success
		stdout
		stderr
		...(infile && {infile})
		...(outfile && {outfile})
		}

# ---------------------------------------------------------------------------

export abstract class CFileHandler

	abstract get op(): string

	# ..........................................................
	# ASYNC

	async needed(
			path: string
			hOptions: hash = {}
			): boolean

		return true

	# ..........................................................
	# ASYNC
	# --- if error occurs, throw an Error object

	abstract handle(
			path: string
			hOptions: hash
			): Promise<TExecResult>

	# ..........................................................
	# ASYNC

	handleFile(
			path: string
			hOptions: hash = {}
			): TExecResult

		force := ('force' in hOptions) && hOptions.force
		isNeeded := await @needed(path, hOptions)
		if not force && not isNeeded
			return {
				success: true
				notNeeded: true
				infile: path
				}
		hResult := await @handle path, hOptions
		return Object.assign hResult, {infile: path}

	# ..........................................................
	# SYNC

	getOutput(hResult: TExecResult): string

		return (hResult?.stdout || '') + (hResult?.stderr || '')

# ---------------------------------------------------------------------------
#       FileHandlers
# ---------------------------------------------------------------------------

class CFileRemover extends CFileHandler

	get op()
		return 'doRemoveFile'

	override needed(path: string): boolean
		return await exists(path)

	override handle(
			path: string,
			hOptions: hash = {}
			): TExecResult

		LOG "Removing file #{path}"
		await Deno.remove path
		return {success: true}

export doRemoveFile := new CFileRemover()

# ---------------------------------------------------------------------------

class CTsFileRemover extends CFileHandler

	get op()
		return 'doRemoveTsFile'

	override needed(
			path: string
			): boolean

		if not await exists(path)
			return false
		return await exists withExt(path, '.civet')

	override handle(
			path: string
			hOptions: hash = {}
			): TExecResult

		assert (fileExt(path) == '.ts'), "Not a TypeScript file: #{path}"
		await Deno.remove path
		return {
			success: true
			}

export doRemoveTsFile := new CTsFileRemover()

# ---------------------------------------------------------------------------
# ASYNC

export isInstalled := (scriptName: string): boolean =>

	homeDir := Deno.env.get("HOME") ?? Deno.env.get("USERPROFILE") ?? ""
	ext := (Deno.build.os == "windows") ? ".cmd" : ""
	path := "#{homeDir}/.deno/bin/#{scriptName}#{ext}"
	isThere := await exists(path)
	if isThere
		fileInfo := await Deno.stat(path)
		return fileInfo.isFile
	else
		return false

# ---------------------------------------------------------------------------

export getCmdName := (
		path: string
		hOptions: hash
		): string =>

	if ('name' in hOptions) && (typeof hOptions.name == 'string')
		return hOptions.name as string
	else
		return parsePath(path).stub.replaceAll('.', '_')

# ---------------------------------------------------------------------------

class CCmdInstaller extends CFileHandler

	get op()
		return 'doInstallCmd'

	override handle(
			path: string,
			hOptions: hash = {}
			): TExecResult

		assert path.endsWith('.cmd.ts'), "Not a command file"
		name := getCmdName(path, hOptions)

		return await execCmd 'deno', [
			'install'
			'--global'
			'--force'
			'--config', 'deno.json'
			'-A'
			'--name', name
			path
			]

export doInstallCmd := new CCmdInstaller()

# ---------------------------------------------------------------------------

class CCmdUninstaller extends CFileHandler

	get op()
		return 'doUninstallCmd'

	override needed(
			path: string
			hOptions: hash = {}
			)
		name := getCmdName(path, hOptions)
		return await isInstalled(name)

	override handle(
			path: string,
			hOptions: hash = {}
			): TExecResult

		name := getCmdName(path, hOptions)
		return await execCmd 'deno', [
			'uninstall'
			'-g'
			name
			]

export doUninstallCmd := new CCmdUninstaller()

# ---------------------------------------------------------------------------

class CFileRunner extends CFileHandler

	get op()
		return 'doRun'

	override handle(
			path: string,
			hOptions: hash = {}
			): TExecResult

		type opt = {
			inspect: boolean
			label: string?
			}
		{inspect, label} := getOptions<opt> hOptions, {
			inspect: false
			label: undef
			}

		assert (fileExt(path) == '.ts'), "Not a TypeScript file"

		hResult := await execCmd 'deno', [
			'run'
			'-A'
			...(inspect ? ['--inspect-brk'] : [])
			path
			], hOptions
		return hResult

export doRun := new CFileRunner()

# ---------------------------------------------------------------------------

class CCivetCompiler extends CFileHandler

	get op()
		return 'doCompileCivet'

	# ..........................................................

	override async needed(
			path: string
			hOptions: hash = {}
			): boolean

		return toBool(hOptions.force) || not newerDestFileExists(path, '.ts')

	# ..........................................................

	getOutPath(
			path: string
			output: string   # --- '.ts' or actual file name
			): string

		assert (fileExt(path) == '.civet'), "Not a civet file"
		if (output == '.ts')
			return withExt(path, '.ts')
		else if isFullPath(output)
			croak "output can't be a full path"
		else
			assert (fileExt(output) == '.ts'), "output must have .ts ext"
			return inSameDir(path, output)
		return ''

	# ..........................................................
	# ASYNC

	override handle(
			path: string,
			hOptions: hash = {}
			): TExecResult

		{force, nocheck, output, inlineMap,
			} := getOptions<TCivetOptions> hOptions, {
				force: false
				nocheck: false
				output: '.ts'
				inlineMap: true
				}

		assert (fileExt(path) == '.civet'), "Not a civet file: #{path}"
		tsPath := withExt path, '.ts'
		try
			outPath := await civet2tsFile path, tsPath, {
				inlineMap
				force
				nocheck
				}
			assert (outPath == tsPath), "Bad output file: '#{outPath}'"
			return {
				success: true
				infile: path
				outfile: outPath
				}
		catch err
			errMsg := getErrStr(err)
			if debugging
				LOG errMsg
			return {
				success: false
				stderr: "COMPILE FAILED: #{pathStr(path)} - #{errMsg}"
				}

export doCompileCivet := new CCivetCompiler()

# ---------------------------------------------------------------------------

class CUnitTester extends CFileHandler

	get op()
		return 'doUnitTest'

	# ..........................................................

	override handle(
			path: string,
			hOptions: hash = {}
			): TExecResult

		assert path.endsWith('.test.ts'), "Not a unit test file"
		type opt = {
			capture: boolean
			inspect: boolean
			lineNum: string?
			}
		{capture, inspect, lineNum} := getOptions<opt> hOptions, {
			capture: false
			inspect: false
			lineNum: undef
			}

		hResult := await execCmd 'deno', [
				'test'
				'-A'
				'--trace-leaks'
				...(inspect
					? ['--inspect-brk']
					: ['--coverage=./coverage', '--coverage-raw-data-only']
					)
				...(defined(lineNum)
					? ['--filter', "/^line #{lineNum}$/"]
					: []
					)
				path
				], {capture}
		return hResult

	# ..........................................................

	override getOutput(hResult: TExecResult): string

		{stdout, stderr} := hResult
		output := [stdout, stderr].join()
		if not hResult.success || output.match(/croak|error/i)
			return output

		lLines := Array.from MAP allLinesIn(decolorize(output)), (line) ->
			if line.startsWith('line')
				if not line.includes(' ok ')
					yield withColors line, {
						failed: 'red'
						FAILED: 'red'
						ok: 'green'
						OK: 'green'
						}
			else if line.includes('passed') && line.includes('failed')
				if line.includes(' 0 failed ')
					yield withColors line, {
						ok: 'green'
						passed: 'green'
						}
				else
					yield withColors line, {
						ok: 'green'
						passed: 'green'
						failed: 'red'
						FAILED: 'red'
						}
			else if line.includes('Lcov coverage')
				yield 'coverage report generated'
		return lLines.join('\n')

export doUnitTest := new CUnitTester()
