procColor := 'cyan'

# ---------------------------------------------------------------------------

export getCmdLine := (
		cmdName: string
		lArgs: string[]
		): string =>

	assert isString(cmdName), "cmdName not a string: #{OL(cmdName)}"
	assert isArrayOfStrings(lArgs), "not an array of strings: #{OL(lArgs)}"
	cmdLine := "#{cmdName} #{lArgs.join(' ')}"
	DBG "cmdLine = #{OL(cmdLine)}"
	return cmdLine

# ---------------------------------------------------------------------------

export type TStreamType = 'piped' | 'inherit'

export type TExecResult =
	success: boolean
	notNeeded?: true
	timeTaken: number          # --- in secs
	cmdLine?: string
	stdout?: string
	stderr?: string
	infile?: string
	outfile?: string | string[]
	hPostResult?: TExecResult

# ---------------------------------------------------------------------------
# ASYNC

export mkstr := (
		item: string | BufferSource
		): string =>

	return (
		  isString(item) ? stripAnsiCode(item)
		: isArray(item)  ? stripAnsiCode(item.join(''))
		:                  stripAnsiCode(decode(item))
		)

# ---------------------------------------------------------------------------
# ASYNC
# --- Four cases for stdout:
#        1. no callback, capture false
#           output goes directly to the console
#        2. callback defined
#           output goes to a callback function
#        3. capture is set
#           output is found in the result hash
#        4. callback defined and capture set
#           output both in result hash and goes to callback

type TExecInput = string | string[] | TIterator<string> | TAsyncIterator<string>
type TExecCallback = (str: string) => void

export execCmd := (
		cmdName: string
		lArgs: string[] = []
		hOptions: hash = {}
		): TExecResult =>

	type opt = {
		input: TExecInput?
		callback: TExecCallback?
		capture: boolean
		infile: string?
		outfile: string?
		}

	{input, callback, capture, infile, outfile
			} := getOptions<opt> hOptions, {
		input: undef
		callback: undef
		capture: false
		infile: undef
		outfile: undef
		}

	DBG "execCmd: #{getCmdLine(cmdName, lArgs)}"
	cmdLine := getCmdLine(cmdName, lArgs)
	timer := new CTimer()

	pipeStdin  := anyDefined(input, infile)
	pipeStdout := pipeStdin || capture || anyDefined(callback, outfile)

	if not pipeStdout && not pipeStdin
		child := Deno.spawn cmdName, lArgs
		status := await child.status
		return {
			success: status.success
			cmdLine
			timeTaken: timer.timeTaken()
			}

	cmd: Deno.Command := new Deno.Command(cmdName, {
		args: lArgs
		env: {DEFAULT_LOGGER: curLogLevel()}
		stdin:  pipeStdin  ? 'piped' : 'inherit'
		stdout: pipeStdout ? 'piped' : 'inherit'
		stderr: 'piped'
		})
	child: Deno.ChildProcess := cmd.spawn()

	if defined(infile)
		assert notdefined(input), "Can't use both infile and input"
		contents := await Deno.readTextFile infile
		iter := allLinesIn(contents, true)
		ReadableStream.from(iter)
			.pipeThrough(new TextEncoderStream())
			.pipeTo(child.stdin)
	else if defined(input)
		# --- type of child.stdin is WritableStream<Uint8Array>
		lStrings := (
			if isString(input)
				Array.from(allLinesIn(input, true))
			else if isAsyncIterator(input)
				await Array.fromAsync(input)
			else if isIterator(input)
				Array.from(input)
			else if isArray(input)
				input
			else
				croak "Bad input"
			)

		ReadableStream.from(lStrings)
			.pipeThrough(new TextEncoderStream())
			.pipeTo(child.stdin)

	# --- Create a WritableStream that output can be sent to
	# --- type of child.stdout is WritableStream<Uint8Array>

	let stdout: string = ''
	f := defined(outfile) ? new CWritableFile(outfile) : undef
	outStrm: WritableStream<string> := (
		if defined(callback)
			new WritableStream<string> {
				write(chunk)
					callback(chunk)
					if defined(f)
						await f.write chunk
					if capture
						stdout += chunk
					return
				}
		else
			new WritableStream<string> {
				write(chunk)
					stdout += chunk
					if defined(f)
						await f.write chunk
					return
				}
		)

	await (
		child.stdout
		  .pipeThrough(new TextDecoderStream())
		  .pipeTo(outStrm, {preventClose: true})
			)
	status := await child.status

	# --- putting this, even with the await keyword
	#     in the returned hash, fails
	stderr := await child.stderr.text()

	return {
		success: status.success
		cmdLine
		timeTaken: timer.timeTaken()
		stdout
		stderr
		...(infile && {infile})
		...(outfile && {outfile})
		}

# ---------------------------------------------------------------------------
# ASYNC

export execTsFile := (
		tsPath: string
		hOptions: hash = {}
		): TExecResult =>

	return await execCmd('deno', [
		'run'
		'-A'
		tsPath
		], hOptions)

# ---------------------------------------------------------------------------

export abstract class CFileHandler

	abstract get op(): string

	# ..........................................................
	# ASYNC

	abstract canHandle(
			path: string
			hOptions: hash
			): Promise<boolean>

	# ..........................................................

	async isNeeded(
			path: string
			hOptions: hash = {}
			): boolean

		lOutPaths := @allOutPaths(path)
		if (lOutPaths.length == 0)
			return true
		else
			for outPath of lOutPaths
				if not newerDestFileExists(path, outPath)
					return true
			return false

	# ..........................................................

	allOutPaths(
			path: string
			hOptions: hash = {}
			): string[]

		# --- by default, returns an empty array
		#     so handle() will be called
		return []

	# ..........................................................
	# ASYNC

	abstract handle(
			path: string
			hOptions: hash
			): Promise<TExecResult>

	# ..........................................................
	# ASYNC

	async postProcess(
			path: string
			hOptions: hash = {}
			): TExecResult

		return {
			success: true
			notNeeded: true   # --- no post processing was done
			timeTaken: 0
			}

	# ..........................................................
	# ASYNC

	handleFile(
			path: string
			hOptions: hash = {}
			): TExecResult

		timer := new CTimer()
		try
			assert isFile(path), "No such file: #{path}"
			canHandle := await @canHandle(path, hOptions)
			if not canHandle
				stderr := "#{@op} can't handle '#{path}'"
				ERR stderr
				return {
					success: false
					timeTaken: timer.timeTaken()
					infile: pathStr(path)
					stderr
					}

			force := ('force' in hOptions) && hOptions.force
			DBG "force = #{force}"
			needed := await @isNeeded(path, hOptions)
			if not needed && not force
				DBG "#{@op} not needed"
				return {
					success: true
					notNeeded: true
					timeTaken: timer.timeTaken()
					infile: pathStr(path)
					}

			hResult := await @handle path, hOptions

			unless ('outfile' in hResult)
				lOutFiles := @allOutPaths(path, hOptions)
				if (lOutFiles.length == 1)
					Object.assign hResult, {outfile: lOutFiles[0]}
				else if (lOutFiles.length > 1)
					Object.assign hResult, {outfile: lOutFiles}

			if not hOptions.nopp
				hPostResult := await @postProcess path, hOptions
				unless ('notNeeded' in hPostResult)
					Object.assign hPostResult, {timeTaken: timer.timeTaken()}
					Object.assign hResult, {hPostResult}

			return Object.assign hResult, {
				infile: path
				timeTaken: timer.timeTaken()
				}

		catch err
			stderr := getErrStr(err)
			DBG "#{@op}: err = #{stderr}"
			return {
				success: false
				timeTaken: timer.timeTaken()
				infile: pathStr(path)
				stderr
				}

	# ..........................................................
	# SYNC

	getOutput(hResult: TExecResult): string

		return (hResult?.stdout || '') + (hResult?.stderr || '')

# ---------------------------------------------------------------------------
#       FileHandlers
# ---------------------------------------------------------------------------
# ASYNC

export cmdIsInstalled := (scriptName: string): boolean =>

	homeDir := Deno.env.get("HOME") ?? Deno.env.get("USERPROFILE") ?? ""
	ext := (Deno.build.os == "windows") ? ".cmd" : ""
	path := "#{homeDir}/.deno/bin/#{scriptName}#{ext}"
	isThere := await exists(path)
	if isThere
		fileInfo := await Deno.stat(path)
		return fileInfo.isFile
	else
		return false

# ---------------------------------------------------------------------------

export getCmdName := (
		path: string
		hOptions: hash
		): string =>

	if ('name' in hOptions) && (typeof hOptions.name == 'string')
		return hOptions.name as string
	else
		return parsePath(path).stub.replaceAll('.', '_')

# ---------------------------------------------------------------------------

class CCmdInstaller extends CFileHandler

	get op()
		return 'doInstallCmd'

	async canHandle(
			path: string
			hOptions: hash = {}
			)
		return path.endsWith('.cmd.ts')

	handle(
			path: string,
			hOptions: hash = {}
			): TExecResult

		name := getCmdName(path, hOptions)
		return await execCmd 'deno', [
			'install'
			'--global'
			'--force'
			'--config', 'deno.json'
			'-A'
			'--name', name
			path
			]

export doInstallCmd := new CCmdInstaller()

# ---------------------------------------------------------------------------

class CCmdUninstaller extends CFileHandler

	get op()
		return 'doUninstallCmd'

	# ..........................................................

	async canHandle(
			path: string
			hOptions: hash = {}
			)

		return path.endsWith('.cmd.ts')

	# ..........................................................

	override async isNeeded(
			path: string
			hOptions: hash = {}
			): boolean

		name := getCmdName(path, hOptions)
		return await cmdIsInstalled(name)

	# ..........................................................

	handle(
			path: string,
			hOptions: hash = {}
			): TExecResult

		name := getCmdName(path, hOptions)
		return await execCmd 'deno', [
			'uninstall'
			'-g'
			name
			]

export doUninstallCmd := new CCmdUninstaller()
