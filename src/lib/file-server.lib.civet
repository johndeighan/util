# file-server.lib.civet

import {serveFile, serveDir} from '@std/http/file-server'

import {LOG, DBG, ERR} from 'logger'
import {
	undef, defined, notdefined, croak, assert, getErrStr,
	} from 'base'
import {hash, TStringFilterFunc} from 'datatypes'
import {getOptions} from 'llutils'
import {mkpath, fileExt} from 'fsys'

type TFileResponse = [true, string] | [false, number]

# ---------------------------------------------------------------------------

export class CFileServer
	root: string
	port: number
	hostname: string
	server: Deno.HttpServer

	# ..........................................................

	constructor(
			@root: string
			@port: number = 8000
			@hostname = 'localhost'
			)

		@server = Deno.serve
			{
				hostname: @hostname
				port: @port
				onListen: @onListen
				}
			(req: Request) =>

				url := new URL(req.url)
				path := decodeURIComponent(url.pathname)

				if not @allow(path, req)
					return new Response("403: Forbidden", {status: 403})

				try
					return await @getResponse(path, req)
				catch
					return new Response "404 Not Found", {status: 404}

	# ..........................................................

	onListen(): void

		DBG "Listening on port #{@port}"
		return

	# ..........................................................

	allow(
			path: string
			req: Request
			): boolean

		return true

	# ..........................................................

	getResponse(
			path: string
			req: Request
			): Response

		return await @getFileResponse path, req

	# ..........................................................
	# ASYNC

	getFileResponse(
			path: string
			req: Request
			): Response

		content_type := @getContentType(path, req)
		switch content_type
			when 'text/typescript'
				contents := await Deno.readTextFile mkpath(@root, path)
				assert defined(contents),
						"in getFileResponse(): undef contents"
				return new Response contents, {
					status: 200
					headers: {'Content-type': content_type}
					}
			else
				contents := await Deno.readTextFile mkpath(@root, path)
				assert defined(contents),
						"in getFileResponse()2: undef contents"
				return new Response contents, {
					status: 200
					headers: {'Content-type': content_type}
					}

	# ..........................................................

	getContentType(
			path: string
			req: Request
			): string

		return switch fileExt(path)
			when '.civet' then 'text/civet'
			when '.js' then 'text/javascript'
			when '.ts' then 'text/typescript'
			when '.html', '.htm' then 'text/html'
			else 'text/plain'
		return ''

	# ..........................................................

	[Symbol.dispose](): void
		LOG "stopping file server"
		@server.shutdown()
		return

# ---------------------------------------------------------------------------
# ASYNC

export getFile := (
		fileName: string
		port: number = 8000
		hostname: string = 'localhost'
		): TFileResponse =>

	response := await fetch("http://#{hostname}:#{port}/#{fileName}")
	{ok, status, type} := response
	if ok
		return [true, await response.text()]
	else
		return [false, status]

