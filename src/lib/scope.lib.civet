# scope.lib.civet

import {LOG} from 'logger'
import {
	undef, defined, notdefined, croak, assert, TIterator,
	} from 'base'
import {hash} from 'datatypes'

# ---------------------------------------------------------------------------

export class CScope
	name: string? # --- undef for anonymous functions
	sDefined = new Set<string>()
	sUsed = new Set<string>()
	parent: CScope?
	lChildScopes: CScope[]

	# ..........................................................

	constructor(
			@name: string?,
			lArgs: string[],
			@parent: CScope? = undef
			)

		for name of lArgs
			@define name
		@lChildScopes = []

	# ..........................................................

	allDefined(): TIterator<string>

		for name of @sDefined.values()
			yield name
		return

	# ..........................................................

	getDefined(): string[]

		return Array.from @sDefined.values()

	# ..........................................................

	allUsed(): TIterator<string>

		for name of @sUsed.values()
			yield name
		return

	# ..........................................................

	getUsed(): string[]

		return Array.from @sUsed.values()

	# ..........................................................

	asString(): string

		return """
			----------
			NAME: #{@name || '.undef'}
			DEFINED: #{@getDefined().join(' ')}
			USED: #{@getUsed().join(' ')}
			PARENT: #{defined(@parent) ? @parent.name : '.undef'}
			CHILDREN: #{@lChildScopes.length}
			"""

	# ..........................................................

	newChildScope(name: string?, lArgs: string[])

		childScope := new CScope(name, lArgs, @)
		@lChildScopes.push childScope
		return childScope

	# ..........................................................

	define(name: string): void

		@sDefined.add name
		return

	# ..........................................................

	use(name: string): void

		@sUsed.add name
		return

	# ..........................................................
	# --- is name defined in current function or any ancestor

	isDefined(name: string): boolean

		if @sDefined.has(name)
			return true
		if defined(@parent)
			return @parent.isDefined name
		return false

	# ..........................................................
	# --- is name used in the current scope or in child scopes

	isUsed(name: string): boolean

		if @sUsed.has(name)
			return true
		for childScope of @lChildScopes
			if childScope.isUsed(name)
				return true
		return false

# ---------------------------------------------------------------------------

export class CMainScope extends CScope

	constructor()
		super 'main', []

	# ..........................................................

	newScope(name: string?, lArgs: string[]): CScope

		return @newChildScope name, lArgs

	# ..........................................................

	endScope(scope: CScope): CScope?

		return scope.parent
