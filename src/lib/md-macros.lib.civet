# md-macros.lib.civet

import {exists, existsSync} from '@std/fs'

import {CTimer} from 'timer'
import {
	undef, defined, notdefined, assert, obviously, croak, getErrStr,
	} from 'base'
import {hash} from 'datatypes'
import {getOptions} from 'llutils'
import {fileExt, withExt, pathStr, newerDestFileExists} from 'fsys'
import {CFileHandler, TExecResult} from 'exec'
import {TMacroLib, CMacroCompiler} from 'macros'

# ---------------------------------------------------------------------------

export hMdMacroLib: TMacroLib := {
	'#preproc': (block) =>
		return """
			<style>
				p.head {
					font-weight: bold
					}
				p.desc {
					font-weight: normal
					}
			</style>
			#{block}
			"""
	def: (block) =>
		lLines := block.split('\n')
		lOutput := [
			"""
				<p class="head">
					#{lLines[0]}
				</p>
				<p class="desc">
				"""
			]
		for line of lLines.slice(1)
			lOutput.push "\t#{line}<br>"
		return lOutput.join('\n') + '\n</p>'
	}

export doMakeMarkdown := new CMacroCompiler('.$md', hMdMacroLib)
