# trace.lib.civet

# --- REFERENCE base-utils repo

import {
	LOG, DBG, ERR, stringFits, clearLog, getLog, logWidth,
	} from 'logger'
import {uni} from 'unicode'
import {
	pass, undef, defined, notdefined,
	assert, obviously, croak, words,
	} from 'base'
import {
	jsType, hash, isArrayOfStrings, integer, isString,
	isFunction, isArray, isInteger, nonEmpty, isObject,
	} from 'datatypes'
import {
	blockToArray, arrayToBlock, getOptions, spaces, tabs,
	} from 'llutils'
import {OL, OLS, nice} from 'nice'
import {CCallStack} from 'trace-stack'

let internalDebugging = false
let traceWidth = 78

# ---------------------------------------------------------------------------

export traceInternalDebugging := (
		debugFlag = true
		): void =>

	internalDebugging = debugFlag
	if debugFlag
		LOG "turn on internal debugging in trace.lib.civet"
	else
		LOG "turn off internal debugging in trace.lib.civet"
	return

# ---------------------------------------------------------------------------

export stack := new CCallStack()

type TFuncDesc = {
	funcName: string
	plus: boolean
	}

# --- Comes from call to setTracing()
let lFuncList: TFuncDesc[] = []

type TLogFuncMult = (
	level: number,
	funcName: string,
	lValues: unknown[]
	) => void

type TLogFuncOne = (
	level: number,
	funcName: string,
	lValues: unknown
	) => void

type TLogFuncNone = (
	level: number,
	funcName: string,
	) => void

type TLogValue = (
	level: number,
	value: unknown
	label: string
	) => void

type TLogFunc = TLogFuncMult | TLogFuncOne | TLogFuncNone | TLogValue

let traceAll = false   # --- if true, always log
let traceNone = false  # --- if true, never log

# ---------------------------------------------------------------------------

export setTracing := (
		traceWhat: boolean | string | string[]
		): void =>

	# --- traceWhat can be:
	#        1. a boolean (false = disable, true = debug all)
	#        2. a string (name of a function)
	#        3. an array of strings (names of functions)

	if internalDebugging
		LOG "setTracing #{OL(traceWhat)}"

	resetTracing()

	# --- process traceWhat
	switch jsType(traceWhat)
		when 'boolean'
			if traceWhat
				if internalDebugging
					LOG "set traceAll"
				traceAll = true
			else
				if internalDebugging
					LOG "set traceNone"
				traceNone = true
		when 'string', 'array'
			if internalDebugging
				LOG "traceWhat is #{OL(traceWhat)}"
			obviously (typeof traceWhat == 'string') || isArray(traceWhat)
			lFuncList = getFuncList(traceWhat)
		else
			croak "Bad arg 1: #{OL(traceWhat)}"

	if internalDebugging
		dumpFuncList()
	return

# ---------------------------------------------------------------------------

export isTracingFunc := (
		funcName: string
		): boolean =>

	if traceNone
		return false
	if traceAll
		return true

	# --- funcName came from a call to trEnter()
	#     it might be of form <object>.<method>
	# --- We KNOW that funcName is active!

	if internalDebugging
		LOG "isTracingFunc(#{OL(funcName)})"
		LOG lFuncList
		stack.dumpStack()

	lParts := funcName.split('.')

	for h of lFuncList
		if (h.funcName == funcName)
			if internalDebugging
				LOG "   - TRUE - #{OL(funcName)} is in lFuncList"
			return true
		if h.plus && stack.isActive(h.funcName)
			if internalDebugging
				LOG "   - TRUE - #{OL(h.funcName)} is active"
			return true

	if (lParts.length == 2)   # --- came from trEnter()
		methodName := lParts[1]
		for h of lFuncList
			if (h.funcName == methodName)
				if internalDebugging
					LOG "   - TRUE - #{OL(methodName)} is in lFuncList"
				return true
	if internalDebugging
		LOG "   - FALSE"
	return false

# ---------------------------------------------------------------------------

export resetTracing := () =>

	# --- reset everything
	stack.reset()
	lFuncList = []
	traceAll = false
	traceNone = false
	clearLog()
	return

# ---------------------------------------------------------------------------
# ---------------------------------------------------------------------------

export getFuncList := (
		funcs: string | string[]
		): TFuncDesc[] =>

	lFuncs: TFuncDesc[] := []    # return value

	# --- Allow passing in an array of strings
	if isArray(funcs)
		for str of funcs
			lItems := getFuncList(str)   # recursive call
			lFuncs.push lItems...
	else
		for word of words(funcs)
			[funcName, modifier] := parseFuncStr(word)
			assert defined(funcName), "Bad debug object: #{OL(word)}"
			lFuncs.push {
				funcName
				plus: (modifier == '+')
				}
	return lFuncs

# ---------------------------------------------------------------------------
# Stack is only modified in these 8 functions (it is reset in setTracing())
# ---------------------------------------------------------------------------

export trEnter := (
		funcName: string
		lArgs: unknown[] = []
		): void =>

	isTracing := isTracingFunc(funcName)
	if internalDebugging
		LOG "trEnter #{funcName} #{OL(lArgs)}"
		LOG "   - isTracing = #{OL(isTracing)}"

	if isTracing
		logEnter stack.logLevel, funcName, lArgs
	stack.enter funcName, lArgs, isTracing
	return

# ---------------------------------------------------------------------------

export trReturnFrom := (
		funcName: string,
		val: unknown? = undef
		): void =>

	assert (funcName == stack.curFuncName),
		"trReturnFrom(#{funcName}) but cur func is #{stack.curFuncName}"
	isTracing := isTracingFunc(funcName)
	if internalDebugging
		LOG "trReturnFrom #{OL(funcName)}"
		LOG "   - isTracing = #{OL(isTracing)}"

	if isTracing
		level := stack.logLevel
		logReturnFrom level, funcName, val
	stack.returnFrom funcName, val
	return

# ---------------------------------------------------------------------------

export trYieldFrom := (
		funcName: string
		val: unknown?
		): void =>

	isTracing := isTracingFunc(funcName)
	if internalDebugging
		LOG "trYieldFrom #{OL(funcName)} #{OL(val)}"
		LOG "   - isTracing = #{OL(isTracing)}"

	if isTracing
		level := stack.logLevel
		logYield level, funcName, val
	stack.yieldFrom funcName, val
	return

# ---------------------------------------------------------------------------

export trResume := (
		funcName: string
		): void =>

	isTracing := isTracingFunc(funcName)
	if internalDebugging
		LOG "trResume #{OL(funcName)}"
		LOG "   - isTracing = #{OL(isTracing)}"

	stack.resume funcName
	if isTracing
		level := stack.logLevel
		logResume level-1, funcName
	return

# ---------------------------------------------------------------------------

export tr := (
		val: unknown
		label: string = ''
		): void =>

	isTracing := isTracingFunc(stack.curFuncName)
	if internalDebugging
		LOG "tr #{OL(val)}, #{OL(label)}"
		LOG "   - isTracing = #{OL(isTracing)}"

	if isTracing
		level := stack.logLevel
		logValue level, val, label
	return

# ---------------------------------------------------------------------------
# ---------------------------------------------------------------------------
#    Only these 8 functions ever call LOG or TRACEVAL

export logEnter: TLogFuncMult := (
		level: integer
		funcName: string
		lArgs: unknown[]
		): void =>

	labelPre := getPrefix(level, 'plain')
	if (lArgs.length == 0)
		LOG labelPre + "enter #{funcName}"
	else
		str := "enter #{funcName} #{OLS(lArgs)}"
		if stringFits("#{labelPre}#{str}", traceWidth)
			LOG labelPre + str
		else
			LOG labelPre + "enter #{funcName}"
			for arg,i of lArgs
				TRACEVAL arg, "arg[#{i}]", {
						prefix: getPrefix(level+1, 'plain')
						itemPrefix: getPrefix(level+2, 'noLastVbar')
						short: false
						}
	return

# ---------------------------------------------------------------------------

export logReturnFrom: TLogFuncOne := (
		level: integer
		funcName: string
		val: unknown
		): void =>

	labelPre := getPrefix(level, 'withArrow')
	str := (
		  defined(val)
		? "return #{OL(val)} from #{funcName}"
		: "return from #{funcName}"
		)
	if stringFits(str, traceWidth) || notdefined(val)
		LOG labelPre + str
	else
		LOG labelPre + "return from #{funcName}"
		TRACEVAL val, 'val', {
			prefix: getPrefix(level, 'noLastVbar')
			itemPrefix: getPrefix(level, 'noLastVbar')
			short: false
			}
	return

# ---------------------------------------------------------------------------

export logYield: TLogFuncOne := (
		level: integer
		funcName: string
		val: unknown
		): void =>

	labelPre := getPrefix(level, 'withYield')
	str := "yield from #{funcName}: #{OL(val)}"
	if stringFits(str, traceWidth)
		LOG labelPre + str
	else
		TRACEVAL val, 'val', {
			prefix: getPrefix(level, 'plain'),
			itemPrefix: getPrefix(level, 'plain')
			}
	return

# ---------------------------------------------------------------------------

export logResume: TLogFuncNone := (
		level: integer
		funcName: string,
		): void =>

	assert isInteger(level), "level not an integer"
	labelPre := getPrefix(level+1, 'withResume')
	LOG labelPre + "resume"
	return

# ---------------------------------------------------------------------------

export logValue: TLogValue := (
		level: integer
		val: unknown
		label: string = ''
		): void =>

	TRACEVAL val, label, {
		prefix: getPrefix(level, 'plain')
		}
	return

# ---------------------------------------------------------------------------

export parseFuncStr := (str: string): [string, string] =>
	# --- returns [fullName, modifier]

	lMatches := str.match(///^
		(
			[A-Za-z_][A-Za-z0-9_]*
			(?:
				\.
				[A-Za-z_][A-Za-z0-9_]*
				)?
			)
		(\+)?
		$///)
	assert defined(lMatches), "Bad func desc: ${OL(str)}"
	[_, fullName, modifier] := lMatches
	return [fullName, modifier]

# ---------------------------------------------------------------------------

export dumpFuncList := () =>

	LOG 'lFuncList: --------------------------------'
	LOG nice(lFuncList)
	LOG '-------------------------------------------'
	return

# ---------------------------------------------------------------------------

export TRACEVAL = (
		value: unknown
		label: string = ''
		hOptions: hash = {}
		): void =>

	# --- Allow label to be empty, i.e. ''

	type opt = {
		prefix: string
		short: boolean
		oneIndent: string
		}
	{prefix, short, oneIndent} := getOptions<opt> hOptions, {
		prefix: ''
		short: false      # prefer short strings, e.g. 'HASH', 'ARRAY'
		oneIndent: '    '
		}

	if internalDebugging
		str1 := OL(value)
		str2 := OL(label)
		str3 := OL(prefix)
		LOG "CALL TRACEVAL(#{str1}, label=#{str2}), prefix=#{str3}"

	labelStr := nonEmpty(label) ? "#{label} = " : ''

	jsTyp := jsType(value)

	# --- Handle certain values which should fit, unless
	#     indentation is very deep, but we'll keep it on one line
	#     in any case

	olStr := "#{prefix}#{labelStr}#{OL(value)}"
	if isShortVal(jsTyp) || stringFits(olStr, traceWidth)
		if internalDebugging
			LOG "Using OL(), #{olStr.length} <= #{logWidth}"
		LOG olStr
		return

	if short
		shortWord := (
			if ['array','hash','function'].includes(jsTyp)
				jsTyp.toUpperCase()
			else
				''
			)
		if nonEmpty(shortWord)
			LOG "#{prefix}#{labelStr}#{shortWord}"
			return

	itemPrefix := prefix + oneIndent

	# --- We know now that OL(value) doesn't fit
	#     and all "short values" have been checked already
	switch jsTyp
		when 'string'
			obviously (typeof value == 'string')
			LOG "#{prefix}#{labelStr}\"\"\""
			for line of blockToArray(value)
				LOG "#{itemPrefix}#{line}
			LOG "#{itemPrefix}\"\"\""

		when 'hash'
			str := nice(value, 78, {
				sortKeys: true
				oneIndent: spaces(3)
				})
			if labelStr
				LOG "#{prefix}#{labelStr}"
			for s of blockToArray(str)
				LOG "#{itemPrefix}#{s}"

		when 'array'
			str := nice(value, 78, {
				sortKeys: true
				oneIndent: spaces(3)
				})
			if labelStr
				LOG "#{prefix}#{labelStr}"
			for s of blockToArray(str)
				LOG "#{itemPrefix}#{s}"

		when 'function'
			LOG "#{prefix}#{labelStr}<function>"

		when 'object'
			str := nice(value)
			if str.includes("\n")
				if labelStr
					LOG "#{prefix}#{labelStr}"
				for line of blockToArray(str)
					LOG "#{itemPrefix}#{line}"
			else
				LOG "#{prefix}#{labelStr}#{str}"
	return

# ---------------------------------------------------------------------------

isShortVal := (typ: string) =>

	return words('undef null boolean integer float bigint symbol',
	             'NaN inf neginf null regexp').includes(typ)

# ---------------------------------------------------------------------------

export shortStr := (
		value: unknown
		typ: string = jsType(value)
		maxLen: number = 32
		): string =>

	if isShortVal(typ)
		return OL(value)
	switch typ
		when 'string'
			obviously (typeof value == 'string')
			len := value.length
			return (
				  (len <= maxLen)
				? value
				: value.substring(0, len - 3) + '...'
				)

		when 'hash'           then return 'HASH'
		when 'array'          then return 'ARRAY'
		when 'set'            then return 'SET'
		when 'map'            then return 'MAP'
		when 'iterator'       then return 'ITERATOR'
		when 'asyncIterator'  then return 'ASYNC ITERATOR'
		when 'class'          then return 'CLASS'
		when 'generator'      then return 'GENERATOR'
		when 'asyncGenerator' then return 'ASYNC GENERATOR'
		when 'plainFunction'  then return 'FUNCTION'
		else croak "Unknown value type: #{OL(value)}"

# ---------------------------------------------------------------------------

pre := {
	fourSpaces: uni.space    + uni.space     + uni.space     + uni.space
	oneIndent:  uni.vbar     + uni.space     + uni.space     + uni.space
	arrow:      uni.blcorner + uni.hbar      + uni.arrowhead + uni.space
	flat:       uni.tee      + uni.hbar      + uni.hbar      + uni.space
	resume:     uni.tee      + uni.hbar      + uni.arrowhead + uni.space
	yieldSym:   uni.tee      + uni.backarrow + uni.hbar      + uni.space
	}

# ---------------------------------------------------------------------------

# --- options (if level = 2):
#        plain         '│   │   '
#        withArrow     '│   └─> '
#        withResume    '│   ├─> '
#        withFlat      '│   ├── '
#        withYield     '│   ├<─ '
#        noLastVbar    '│       '
#        none

export getPrefix := (
		level: number
		option = 'none'
		): string =>

	switch option
		case 'plain','':
			return pre.oneIndent.repeat level
		case 'withArrow':
			if level == 0
				return pre.arrow
			else
				return pre.oneIndent.repeat(level - 1) + pre.arrow
		case 'withResume':
			if level == 0
				return pre.resume
			else
				return pre.oneIndent.repeat(level - 1) + pre.resume
		case 'withFlat':
			if level == 0
				return pre.flat
			else
				return pre.oneIndent.repeat(level - 1) + pre.flat
		case 'withYield':
			if level == 0
				return pre.yieldSym
			else
				return pre.oneIndent.repeat(level - 1) + pre.yieldSym
		case 'noLastVbar':
			if level == 0
				throw new Error("getPrefix(): noLastVbar but level is 0")
			return pre.oneIndent.repeat(level - 1) + pre.fourSpaces
		default:
			return pre.fourSpaces.repeat level
