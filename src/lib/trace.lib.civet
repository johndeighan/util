# trace.lib.civet

# --- REFERENCE base-utils repo

import {
	LOG, DBG, ERR, stringFits, clearLog, getLog, logWidth,
	} from 'logger'
import {
	pass, undef, defined, notdefined,
	assert, obviously, croak, words,
	} from 'base'
import {getPrefix} from 'unicode'
import {
	jsType, hash, isArrayOfStrings, integer, isString,
	isFunction, isArray, isInteger, nonEmpty, isObject,
	} from 'datatypes'
import {
	blockToArray, arrayToBlock, getOptions, spaces, tabs,
	} from 'llutils'
import {OL, ML, toNice} from 'nice'
import {parsePath} from 'fsys'
import {CCallStack} from 'trace-stack'

let internalDebugging = false

# ---------------------------------------------------------------------------

export traceInternalDebugging := (
		debugFlag = true
		): void =>

	internalDebugging = debugFlag
	if debugFlag
		LOG "turn on internal debugging in trace.lib.civet"
	else
		LOG "turn off internal debugging in trace.lib.civet"
	return

# ---------------------------------------------------------------------------

export stack := new CCallStack()

type TFuncDesc = {
	funcName: string
	plus: boolean
	}

# --- Comes from call to setTracing()
let lFuncList: TFuncDesc[] = []

type TLogFuncMult = (
	level: number,
	funcName: string,
	lValues: unknown[]
	) => void

type TLogFuncOne = (
	level: number,
	funcName: string,
	lValues: unknown
	) => void

type TLogFuncNone = (
	level: number,
	funcName: string,
	) => void

type TLogValue = (
	level: number,
	value: unknown
	label: string
	) => void

type TLogFunc = TLogFuncMult | TLogFuncOne | TLogFuncNone | TLogValue

# --- Loggers
let logEnter:  TLogFuncMult
let logReturn: TLogFuncOne
let logYield:  TLogFuncOne
let logResume: TLogFuncNone
let logValue:  TLogValue

let traceAll = false   # --- if true, always log
let traceNone = false  # --- if true, never log

# ---------------------------------------------------------------------------

export setTracing := (
		traceWhat: boolean | string | string[]
		): void =>

	# --- traceWhat can be:
	#        1. a boolean (false = disable, true = debug all)
	#        2. a string (name of a function)
	#        3. an array of strings (names of functions)

	if internalDebugging
		LOG "setTracing #{OL(traceWhat)}"

	resetTracing()

	# --- process traceWhat
	switch jsType(traceWhat)
		when 'boolean'
			if traceWhat
				if internalDebugging
					LOG "set traceAll"
				traceAll = true
			else
				if internalDebugging
					LOG "set traceNone"
				traceNone = true
		when 'string', 'array'
			if internalDebugging
				LOG "traceWhat is #{OL(traceWhat)}"
			obviously (typeof traceWhat == 'string') || isArray(traceWhat)
			lFuncList = getFuncList(traceWhat)
		else
			croak "Bad arg 1: #{OL(traceWhat)}"

	if internalDebugging
		dumpFuncList()
	return

# ---------------------------------------------------------------------------

export resetTracing := () =>

	# --- reset everything
	stack.reset()
	lFuncList = []
	traceAll = false
	traceNone = false
	logEnter  = stdEnter
	logReturn = stdReturn
	logYield  = stdYield
	logResume = stdResume
	logValue  = stdLogValue
	clearLog()
	return

# ---------------------------------------------------------------------------
#  EXPAND THESE
# ---------------------------------------------------------------------------

export setEnterLogger := (
		type: string
		func: TLogFuncMult
		): void =>

	if internalDebugging
		DBG "set custom enter logger"
	logEnter = func
	return

# ---------------------------------------------------------------------------

export getFuncList := (
		funcs: string | string[]
		): TFuncDesc[] =>

	lFuncs: TFuncDesc[] := []    # return value

	# --- Allow passing in an array of strings
	if isArray(funcs)
		for str of funcs
			lItems := getFuncList(str)   # recursive call
			lFuncs.push lItems...
	else
		for word of words(funcs)
			[funcName, modifier] := parseFuncStr(word)
			assert defined(funcName), "Bad debug object: #{OL(word)}"
			lFuncs.push {
				funcName
				plus: (modifier == '+')
				}
	return lFuncs

# ---------------------------------------------------------------------------
# Stack is only modified in these 8 functions (it is reset in setTracing())
# ---------------------------------------------------------------------------

export trEnter := (
		funcName: string
		lArgs: unknown[] = []
		): void =>

	isTracing := isTracingFunc(funcName)
	if internalDebugging
		LOG "trEnter #{funcName} #{OL(lArgs)}"
		LOG "   - isTracing = #{OL(isTracing)}"

	if isTracing
		logEnter stack.logLevel, funcName, lArgs
	stack.enter funcName, lArgs, isTracing
	return

# ---------------------------------------------------------------------------

export trReturn := (
		funcName: string,
		val: unknown? = undef
		): void =>

	assert (funcName == stack.curFuncName),
		"trReturn(#{funcName}) but cur func is #{stack.curFuncName}"
	isTracing := isTracingFunc(funcName)
	if internalDebugging
		LOG "trReturn #{OL(funcName)}"
		LOG "   - isTracing = #{OL(isTracing)}"

	if isTracing
		level := stack.logLevel
		logReturn level, funcName, val
	stack.returnFrom funcName, val
	return

# ---------------------------------------------------------------------------

export trYieldFrom := (
		funcName: string
		val: unknown?
		): void =>

	isTracing := isTracingFunc(funcName)
	if internalDebugging
		LOG "trYieldFrom #{OL(funcName)} #{OL(val)}"
		LOG "   - isTracing = #{OL(isTracing)}"

	if isTracing
		level := stack.logLevel
		logYield level, funcName, val
	stack.yieldFrom funcName, val
	return

# ---------------------------------------------------------------------------

export trResume := (
		funcName: string
		): void =>

	isTracing := isTracingFunc(funcName)
	if internalDebugging
		LOG "trResume #{OL(funcName)}"
		LOG "   - isTracing = #{OL(isTracing)}"

	stack.resume funcName
	if isTracing
		level := stack.logLevel
		logResume level-1, funcName
	return

# ---------------------------------------------------------------------------

export tr := (
		val: unknown
		label: string = ''
		): void =>

	isTracing := isTracingFunc(stack.curFuncName)
	if internalDebugging
		LOG "tr #{OL(val)}, #{OL(label)}"
		LOG "   - isTracing = #{OL(isTracing)}"

	if isTracing
		level := stack.logLevel
		logValue level, val, label
	return

# ---------------------------------------------------------------------------

export isTracingFunc := (
		funcName: string
		): boolean =>

	if traceNone
		return false
	if traceAll
		return true

	# --- funcName came from a call to trEnter()
	#     it might be of form <object>.<method>
	# --- We KNOW that funcName is active!

	if internalDebugging
		LOG "isTracingFunc(#{OL(funcName)})"
		LOG lFuncList
		stack.dumpStack()

	lParts := funcName.split('.')

	for h of lFuncList
		if (h.funcName == funcName)
			if internalDebugging
				LOG "   - TRUE - #{OL(funcName)} is in lFuncList"
			return true
		if h.plus && stack.isActive(h.funcName)
			if internalDebugging
				LOG "   - TRUE - #{OL(h.funcName)} is active"
			return true

	if (lParts.length == 2)   # --- came from trEnter()
		methodName := lParts[1]
		for h of lFuncList
			if (h.funcName == methodName)
				if internalDebugging
					LOG "   - TRUE - #{OL(methodName)} is in lFuncList"
				return true
	if internalDebugging
		LOG "   - FALSE"
	return false

# ---------------------------------------------------------------------------
# ---------------------------------------------------------------------------
#    Only these 8 functions ever call LOG or LOGVALUE

export stdEnter: TLogFuncMult := (
		level: integer
		funcName: string
		lArgs: unknown[]
		): void =>

	labelPre := getPrefix(level, 'plain')
	if (lArgs.length == 0)
		LOG labelPre + "enter #{funcName}"
	else
		str := "enter #{funcName} #{OL(lArgs)}"
		if stringFits("#{labelPre}#{str}")
			LOG labelPre + str
		else
			LOG labelPre + "enter #{funcName}"
			for arg,i of lArgs
				LOGVALUE arg, "arg[#{i}]", {
						prefix: getPrefix(level+1, 'plain')
						itemPrefix: getPrefix(level+2, 'noLastVbar')
						short: false
						}
	return

# ---------------------------------------------------------------------------

export stdReturn: TLogFuncOne := (
		level: integer
		funcName: string
		val: unknown
		): void =>

	labelPre := getPrefix(level, 'withArrow')
	str := "return #{OL(val)} from #{funcName}"
	if stringFits(str)
		LOG labelPre + str
	else
		LOG labelPre + "return from #{funcName}"
		LOGVALUE val, "val", {
			prefix: getPrefix(level, 'noLastVbar')
			itemPrefix: getPrefix(level, 'noLastVbar')
			short: false
			}
	return

# ---------------------------------------------------------------------------

export stdYield: TLogFuncOne := (
		level: integer
		funcName: string
		val: unknown
		): void =>

	labelPre := getPrefix(level, 'withYield')
	str := "yield from #{funcName}: #{OL(val)}"
	if stringFits(str)
		LOG labelPre + str
	else
		LOGVALUE val, '', {
			prefix: getPrefix(level, 'plain'),
			itemPrefix: getPrefix(level, 'plain')
			}
	return

# ---------------------------------------------------------------------------

export stdResume: TLogFuncNone := (
		level: integer
		funcName: string,
		): void =>

	assert isInteger(level), "level not an integer"
	labelPre := getPrefix(level+1, 'withResume')
	LOG labelPre + "resume"
	return

# ---------------------------------------------------------------------------

export stdLogValue: TLogValue := (
		level: integer
		val: unknown
		label: string = ''
		): void =>

	LOGVALUE val, label, {
		prefix: getPrefix(level, 'plain')
		}
	return

# ---------------------------------------------------------------------------
# ........................................................................

export parseFuncStr := (str: string): [string, string] =>
	# --- returns [fullName, modifier]

	lMatches := str.match(///^
		(
			[A-Za-z_][A-Za-z0-9_]*
			(?:
				\.
				[A-Za-z_][A-Za-z0-9_]*
				)?
			)
		(\+)?
		$///)
	assert defined(lMatches), "Bad func desc: ${OL(str)}"
	[_, fullName, modifier] := lMatches
	return [fullName, modifier]

# ---------------------------------------------------------------------------

export dumpFuncList := () =>

	LOG 'lFuncList: --------------------------------'
	LOG toNice(lFuncList)
	LOG '-------------------------------------------'
	return

# ---------------------------------------------------------------------------

export dumpLoggers := (label = undef): void =>

	lLines: string[] := []
	if nonEmpty(label)
		lLines.push "LOGGERS (#{label})"
	else
		lLines.push "LOGGERS"
	lLines.push "   enter      - #{logType(logEnter, stdEnter)}"
	lLines.push "   return     - #{logType(logReturn, stdReturn)}"
	lLines.push "   yield      - #{logType(logYield, stdYield)}"
	lLines.push "   resume     - #{logType(logResume, stdResume)}"
	lLines.push "   value      - #{logType(logValue, stdLogValue)}"
	LOG arrayToBlock(lLines)
	return

# ---------------------------------------------------------------------------

logType := (
		cur: TLogFunc
		std: TLogFunc
		): string =>

	if (cur == std)
		return 'std'
	else if defined(cur)
		return 'custom'
	else
		return 'undef'

# ---------------------------------------------------------------------------

export LOGVALUE = (
		value: unknown
		label: string = ''
		hOptions: hash = {}
		): void =>

	# --- Allow label to be empty, i.e. ''

	type opt = {
		prefix: string
		short: boolean
		oneIndent: string
		}
	{prefix, short, oneIndent} := getOptions<opt> hOptions, {
		prefix: ''
		short: false      # prefer short strings, e.g. 'HASH', 'ARRAY'
		oneIndent: '\t'
		}

	if internalDebugging
		str1 := OL(value)
		str2 := OL(label)
		str3 := OL(prefix)
		LOG "CALL LOGVALUE(#{str1}, #{str2}), prefix=#{str3}"

	labelStr := defined(label) ? "#{label} = " : ''

	jsTyp := jsType(value)

	# --- Handle certain values which should fit, unless
	#     indentation is very deep, but we'll keep it on one line
	#     in any case

	olStr := "#{prefix}#{labelStr}#{OL(value)}"
	if isShortVal(jsTyp) || stringFits(olStr)
		if internalDebugging
			LOG "Using OL(), #{olStr.length} <= #{logWidth}"
		LOG olStr
		return

	if short
		if (jsTyp == 'array')
			LOG "#{prefix}#{labelStr}ARRAY"
			return
		if (jsTyp == 'hash')
			LOG "#{prefix}#{labelStr}HASH"
			return
		if (jsTyp == 'function')
			LOG "#{prefix}#{labelStr}FUNCTION"
			return

	itemPrefix := prefix + oneIndent

	# --- We know now that OL(value) doesn't fit
	#     and all "short values" have been checked already
	switch jsTyp
		when 'string'
			obviously (typeof value == 'string')
			LOG "#{prefix}#{labelStr}\"\"\""
			for line of blockToArray(value)
				LOG "#{itemPrefix}#{line}
			LOG "#{itemPrefix}\"\"\""

		when 'hash'
			str := toNice(value, {
				sortKeys: true
				oneIndent: spaces(3)
				})
			if labelStr
				LOG "#{prefix}#{labelStr}"
			for s in blockToArray(str)
				LOG "#{itemPrefix}#{s}"

		when 'array'
			str := toNice(value, {
				sortKeys: true
				oneIndent: spaces(3)
				})
			if labelStr
				LOG "#{prefix}#{labelStr}"
			for s in blockToArray(str)
				LOG "#{itemPrefix}#{s}"

		when 'function'
			LOG "#{prefix}#{labelStr}<function>"

		when 'object'
			str := toNice(value)
			if str.includes("\n")
				if labelStr
					LOG "#{prefix}#{labelStr}"
				for line in blockToArray(str)
					LOG "#{itemPrefix}#{line}"
			else
				LOG "#{prefix}#{labelStr}#{str}"
	return

# ---------------------------------------------------------------------------

isShortVal := (typ: string) =>

	return words('undef null boolean integer float bigint symbol',
	             'NaN inf neginf null regexp').includes(typ)

# ---------------------------------------------------------------------------

export shortStr := (
		value: unknown
		typ: string = jsType(value)
		maxLen: number = 32
		): string =>

	if isShortVal(typ)
		return OL(value)
	switch typ
		when 'string'
			obviously (typeof value == 'string')
			len := value.length
			return (
				  (len <= maxLen)
				? value
				: value.substring(0, len - 3) + '...'
				)

		when 'hash'           then return 'HASH'
		when 'array'          then return 'ARRAY'
		when 'set'            then return 'SET'
		when 'map'            then return 'MAP'
		when 'iterator'       then return 'ITERATOR'
		when 'asyncIterator'  then return 'ASYNC ITERATOR'
		when 'class'          then return 'CLASS'
		when 'generator'      then return 'GENERATOR'
		when 'asyncGenerator' then return 'ASYNC GENERATOR'
		when 'plainFunction'  then return 'FUNCTION'
		else croak "Unknown value type: #{OL(value)}"

# ---------------------------------------------------------------------------

resetTracing()
