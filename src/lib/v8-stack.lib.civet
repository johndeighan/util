# v8-stack.lib.civet

import {existsSync} from '@std/fs'
import {sprintf} from '@std/fmt/printf'
import {SourceMapConsumer} from '@mozilla/source-map'
import {red, green, stripAnsiCode} from '@std/fmt/colors'
import {dirname} from '@std/path'
import {CallSite} from "node-types";

import {
	openDebugFile, removeDebugFile, closeDebugFile, inUnitTest,
	LOG, DBG, ERR,
	} from 'logger'
import {
	undef, defined, notdefined, getErrStr, assert, matches, TIterator,
	} from 'base'
import {integer} from 'datatypes'
import {normalizePath, toRelPath, isFullPath, toFullPath} from 'llfs'
import {fromFSM, TState, defaultDoneFunc} from 'fsm'

removeDebugFile 'stack'

# ---------------------------------------------------------------------------

export type TStackFrame = {
	type: string
	source: string        # relative file path or ''
	line: number
	col: number
	name: string          # name of function or method
	orgSource: string
	orgLine: number
	orgCol: number
	}

# ---------------------------------------------------------------------------

export type RawSourceMap = {
	version: number;           # The version of the source map spec (usually 3)
	file: string;              # The generated file this map is associated with
	sources: string[];         # Array of URLs to the original source files
	names: string[];           # Array of identifiers (names) used in the mappings
	sourceRoot?: string;       # Optional: URL root for the sources
	sourcesContent?: string[]; # Content of the original source files (optional)
	mappings: string;          # The actual encoded mappings (Base64 VLQ)
	}

# ---------------------------------------------------------------------------

export allStackFrames := (
		debug: boolean = false
		): TIterator<TStackFrame> ->

	openDebugFile 'stack'

	try
		oldLimit: number := Error.stackTraceLimit
		oldPreparer := Error.prepareStackTrace
		Error.stackTraceLimit = 99

		Error.prepareStackTrace = (
				error: unknown
				lCallSites: CallSite[]
				) =>

			assert (lCallSites.length > 0), "lCallSites is EMPTY"

			if debug
				for site of lCallSites
					console.log '='.repeat(64)
					console.log fullCallSite(site)
					console.log getFrame(site)

			lFrames: TStackFrame[] := []    # yield these values later

			fromFSM
				lCallSites,
				[
					# --- state 0
					(site, i): TState =>
						type := getFrameType(site)
						if (type == 'for-next') || (type == 'for-from')
							return 0
						if (type != 'function')
							return 0
						source := getFrameSource(site)
						if matches source, /\bv8-stack\.lib\.(?:ts|civet)$/
							return 0
						else
							lFrames.push getFrame(site)
							return 1

					# --- state 1
					(site, i): TState =>
						lFrames.push getFrame(site)
						return 1
					]
				(state) => return lFrames
				{}

			# --- fix a bug in the V8 engine where calls inside a
			#     top level anonymous function is reported as
			#     being of type 'script'

			nFrames := lFrames.length
			for frame,i of lFrames
				if (i < nFrames-1) && (frame.type == 'script')
					frame.type = 'function'
			return lFrames

		obj: Object := {}
		Error.captureStackTrace(obj)
		# @ts-ignore
		lStack: TStackFrame[] := obj.stack

		assert (lStack.length > 0), "EMPTY STACK"

		# --- reset to previous values
		Error.stackTraceLimit = oldLimit
		Error.prepareStackTrace = oldPreparer
		for frame of lStack
			yield frame
		return

	catch err
		ERR "'ERROR in allStackFrames: #{getErrStr(err)}"
		return
	finally
		closeDebugFile 'stack'

# ---------------------------------------------------------------------------

getFrame := (site: CallSite): TStackFrame =>

	type: TFrameType := getFrameType(site)
	name := getFrameName(site)
	orgSource: string := getFrameSource(site)
	orgLine: number   := site.getLineNumber() || -1
	orgCol: number    := site.getColumnNumber() || -1

	frame: TStackFrame := {
		type
		orgSource
		orgLine
		orgCol
		source: orgSource
		line:   orgLine
		col:    orgCol
		name
		}

	if ['for-next','for-from','unknown','external'].includes type
		console.log "DEBUG: type = #{type}"
		return frame

	# --- follow source maps recursively

	let {source, line, col} = frame
	let newFilePos = mapPosSync({source, line, col})
	if notdefined(newFilePos)
		console.log "DEBUG: No source map in #{source}"
	while defined(newFilePos)
		frame.source = toRelPath(newFilePos.source)
		frame.line   = newFilePos.line
		frame.col    = newFilePos.col
		newFilePos = mapPosSync(newFilePos)
	return frame

# ---------------------------------------------------------------------------

export type TFrameType = (
	'for-next' |
	'for-from' |
	'unknown' |
	'external' |
	'eval' |
	'native' |
	'constructor' |
	'method' |
	'function' |
	'script' |
	'unknown'
	)

getFrameType := (
		site: CallSite
		): TFrameType =>

	source: string? := site.getFileName()
	type := (
		if defined(source)
			(
			  source.startsWith('ext:') ? 'external'
			: site.getFunctionName()    ? 'function'
			: site.getMethodName()      ? 'method'
			: site.isTopLevel           ? 'script'
			: site.isEval()             ? 'eval'
			: site.isNative()           ? 'native'
			: site.isConstructor()      ? 'constructor'
			:                             'script'
			)
		else
			name := (
					site.getFunctionName()
				|| site.getMethodName()
				|| ''
				)
			(
			  (name == 'next') ? 'for-next'
			: (name == 'from') ? 'for-from'
			:                    'unknown'
			)
		)
	return type

# ---------------------------------------------------------------------------

getFrameName := (site: CallSite): string =>

	return (
			site.getFunctionName()
		|| site.getMethodName()
		|| ''
		)

# ---------------------------------------------------------------------------

getFrameSource := (site: CallSite): string =>

	src := site.getFileName()
	if not src
		return ''
	return src.startsWith('ext:') ? src : toRelPath(src || '')

# ---------------------------------------------------------------------------
# ASYNC

export type TFilePosition = {
	source: string
	line: number
	col: number
	}

export mapPos := (
	filePos: TFilePosition
	): TFilePosition? =>

	{source, line, col} := filePos
	contents := await Deno.readTextFile source
	[code, hSrcMap] := extractSourceMap contents
	if defined(hSrcMap)
		consumer := await new SourceMapConsumer(hSrcMap)
		pos := consumer.originalPositionFor({line, column: col})
		return pos as TFilePosition
	else
		return undef

# ---------------------------------------------------------------------------

hCache := new Map<string,RawSourceMap>()

export mapPosSync := (filePos: TFilePosition): TFilePosition? =>

	{source, line, col} := filePos
	contents := Deno.readTextFileSync source
	hSrcMap := (
		if hCache.has source
			hCache.get source
		else
			[_, hSrcMap] := extractSourceMap contents
			hSrcMap
		)

	if notdefined(hSrcMap)
		return undef

	# --- add to the cache
	hCache.set source, hSrcMap

	[fileNum, srcLine, srcCol] := getOrgPos hSrcMap, line, col
	fileName := hSrcMap.sources[fileNum]
	if (fileName == 'unknown')
		return undef
	return {
		source: normalizePath "#{dirname(source)}/#{fileName}"
		line: srcLine
		col: srcCol
		}

# ---------------------------------------------------------------------------

type TOrgPos = [fileNum: number, line: number, col: number]
type TCompareResult = -1 | 0 | 1

compare := (
		find: [number, number],
		gen:  [number, number]
		): TCompareResult =>

	return (
		  (find[0] < gen[0]) ? -1
		: (find[0] > gen[0]) ?  1
		: (find[1] < gen[1]) ? -1
		: (find[1] > gen[1]) ?  1
		:                       0
		)

export getOrgPos := (
		hSrcMap: RawSourceMap,
		line: number,
		col: number
		): TOrgPos =>

	lMappings := getMappings(hSrcMap.mappings)
	if (lMappings.length <= 0)
		throw new Error "Empty mappings array"
	let pos = 0, end = lMappings.length - 1
	while (pos <= end)

		# --- Calculate the middle index
		mid := Math.floor((pos + end) / 2)
		[tsLine, tsCol, orgFileNum, civetLine, civetCol] := lMappings[mid]
		switch compare([line, col], [tsLine, tsCol])
			when 0
				return [orgFileNum, civetLine, civetCol]
			when -1
				end = mid - 1;
			when 1
				pos = mid + 1;

	# --- If the loop finishes, the target is not in the array
	if (pos < lMappings.length)
		let [tsLine, tsCol, orgFileNum, civetLine, civetCol] = lMappings[pos]
		if (tsLine != line) || (tsCol != col)
			[tsLine, tsCol, orgFileNum, civetLine, civetCol] = lMappings[pos-1]
		return [orgFileNum, civetLine, civetCol]
	else
		last := lMappings.at(-1)
		if notdefined(last)
			throw new Error "last not defined"
		[tsLine, tsCol, orgFileNum, civetLine, civetCol] := last
		return [orgFileNum, civetLine, civetCol]

# ---------------------------------------------------------------------------

export getMappings := (
		data: string,
		): number[][] =>

	lMappings: number[][] := []
	var sum: number[] = [0, 0, 0, 0]
	for line,lineNum of data.split(";")
		sum[0] = 0
		decodeLine(line).forEach (p) =>
			for (i of [0...p.length])
				sum[i] += p[i]
			lMappings.push [lineNum, sum[0], sum[1], sum[2], sum[3]]
	return lMappings

# ---------------------------------------------------------------------------

export frameHdr := (): string =>

	return sprintf "%-8s %-16s %s", 'type', 'name', 'source'

# ---------------------------------------------------------------------------

export frameStr := (
		frame: TStackFrame,
		): string =>

	posStr := (line: number, col: number): string =>
		return inUnitTest() ? "#{line}:#{col}" : green("#{line}:#{col}")

	{type, orgSource, orgLine, orgCol, source, line, col, name} := frame
	typeStr := sprintf('%-8s', type)
	nameStr := (
		if (type == 'function') && not name
			sprintf('%-16s', '<anon>')
		else
			sprintf('%-16s', name)
		)
	prefix := "#{typeStr} #{nameStr}"
	if orgSource
		mapped := (
			  (source == orgSource)
			? ''
			: "\n#{' '.repeat(30)}=> #{source} #{posStr(line, col)}"
			)
		return "#{prefix} #{orgSource} #{posStr(orgLine, orgCol)}" + mapped
	else
		return "#{prefix} <none>"

# ---------------------------------------------------------------------------

export v8StackStr := (
		lFrames: TStackFrame[]? = undef
		debug: boolean = false
		): string =>

	lLines := for frame of (lFrames || allStackFrames(debug))
		frameStr frame
	return [
		frameHdr()
		'-'.repeat(68)
		...lLines
		'-'.repeat(68)
		].join('\n')

# ---------------------------------------------------------------------------

export extractSourceMap := (
		contents: string
		): [string, RawSourceMap?] =>

	lMatches := contents.match ///^
			(.*)
			\/ \/ \#? \s+
			sourceMappingURL=data:application\/json;
			(?:charset=utf-8;)?
			base64,
			(.+)
			$///s
	if (lMatches == null)
		return [contents, undef]
	[_, code, hSrcMapStr] := lMatches
	hSrcMap := JSON.parse(atob(hSrcMapStr)) as RawSourceMap
	{file} := hSrcMap
	hSrcMap.file = toRelPath(file)
	hSrcMap.sources = for path of hSrcMap.sources
		toRelPath(path)
	return [code, hSrcMap]

# ---------------------------------------------------------------------------

export decodeLine := (line: string): number[][] =>

	if (line == '')
		return []

	return for token of line.split(',')
		lOutput: number[] := []
		let i = 0
		while (i < token.length)
			let v = 0, d = atob("AAA" + token[i]).charCodeAt(2)
			i += 1
			v |= (d & 31)          # put lowest 5 bits of d into v
			let shift = 5
			while (d & 32)         # repeat if high bit of d is set
				d = atob("AAA" + token[i]).charCodeAt(2)
				i += 1
				v |= (d & 31) << shift   # put lowest 5 bits of d into v
				shift += 5
			lOutput.push(v & 1 ? -(v >> 1) : v >> 1) # low bit is sign
		lOutput

# ---------------------------------------------------------------------------

export getMyOutsideCaller := (): TStackFrame? =>

	let mySrc: string? = undef

	lFrames := Array.from allStackFrames()
	return fromFSM
		lFrames,
		[
			# --- state 0
			(frame: TStackFrame): TState =>
				{source} := frame
				if source
					mySrc = source
					return 1
				else
					return 0

			# --- state 1
			(frame: TStackFrame): TState =>
				{source} := frame
				if source && (source != mySrc)
					throw frame
				else
					return 1
			]
		(finalState: TState) =>
			return undef
		{}

# ---------------------------------------------------------------------------

export inFunc := (funcName: string): boolean =>

	lFrames := Array.from allStackFrames()
	frame := lFrames[0]
	return (frame.type == 'function') && (frame.name == funcName)

# ---------------------------------------------------------------------------

export deeplyInFunc := (funcName: string): boolean =>

	for frame of allStackFrames()
		if (frame.type == 'function') && (frame.name == funcName)
			return true
	return false

# ---------------------------------------------------------------------------

type CallSiteEx = {
	fileName: string | undefined
	functionName: string | undefined
	methodName: string | undefined
	isTopLevel: boolean
	isEval: boolean
	isNative: boolean
	isConstructor: boolean
	lineNumber: number
	columnNumber: number
	}

fullCallSite := (
		site: CallSite
		): CallSiteEx =>

	return {
		fileName: site.getFileName()
		functionName: site.getFunctionName()
		methodName: site.getMethodName()
		isTopLevel: site.isTopLevel
		isEval: site.isEval()
		isNative: site.isNative()
		isConstructor: site.isConstructor()
		lineNumber: site.getLineNumber() || -1
		columnNumber: site.getColumnNumber() || -1
		}
