# cmd-utils.lib.civet

import {LOG, DBG, ERR} from 'logger'
import {
	undef, defined, notdefined, getOptions, getErrStr, centered,
	} from 'base'
import {hash} from 'datatypes'
import {CTimer} from 'timer'
import {toRelPath} from 'llfs'
import {f} from 'llutils'
import {allFilesMatching, parsePath} from 'fsys'
import {doCompileCivet} from 'civet'
import {TTask, runTasks} from 'run-tasks'
import {doUnitTest} from 'compile'

# ---------------------------------------------------------------------------

export cmdStep := (str: string): string =>

	return centered str, {char: '=', color: 'cyan'}

# ---------------------------------------------------------------------------

type opt = {
	root: string
	force: boolean
	quiet: boolean
	verbose: boolean
	}

getCmdOptions := (hOptions: hash = {}): opt =>

	return getOptions<opt> hOptions, {
		root: Deno.cwd()
		force: false
		quiet: false
		verbose: false
		}

# ---------------------------------------------------------------------------
# Exclude any files in a subdirectory of 'test' directory

filter := (path: string): boolean =>

	relPath := toRelPath(path)
	index := relPath.indexOf('/test/')
	keep := (index == -1)
	DBG "#{relPath} #{keep ? 'keep' : 'discard'}"
	return (relPath.indexOf('/test/') == -1)

# ---------------------------------------------------------------------------

export compileAllLibs := (
		hOptions: hash = {}
		): boolean =>

	return await compileFilesMatching '**/*.lib.civet', {...hOptions, filter}

# ---------------------------------------------------------------------------

export compileAllUnitTests := (
		hOptions: hash = {}
		): boolean =>

	return await compileFilesMatching '**/*.test.civet', {...hOptions, filter}

# ---------------------------------------------------------------------------

export compileAllCommands := (
		hOptions: hash = {}
		): boolean =>

	return await compileFilesMatching '**/*.cmd.civet', {...hOptions, filter}

# ---------------------------------------------------------------------------

export type TCompileContext = {
	nCompiled: number
	nNotNeeded: number
	timeTaken: number
	}

export compileFilesMatching := (
		pat: string
		hOptions: hash = {}
		): boolean =>

	{root, force, quiet, verbose} := getCmdOptions hOptions
	try
		LOG cmdStep("COMPILE ALL LIBS")
		timer := new CTimer()
		lTasks := for path of allFilesMatching pat, {root}
			{
				title: toRelPath(path),
				task: (
						ctx: TCompileContext,
						task: TTask
						): void =>
					task.output = 'Compiling...'
					hResult := await doCompileCivet.handleFile path, {
						force
						postproc: false
						}
					if (hResult.notNeeded)
						ctx.nNotNeeded += 1
						task.title = ''
					else
						ctx.nCompiled += 1
						task.title = f"#{task.title}:-14 #{'compiled'}:{green}"
					return
				}
		{
			nCompiled, nNotNeeded, timeTaken
			} := await runTasks lTasks, {
				nCompiled: 0
				nNotNeeded: 0
				timeTaken: 0
				}, {concurrent: 8}

		if (nCompiled > 0)
			LOG "#{nCompiled} libs compiled"
		if (nNotNeeded > 0)
			LOG "#{nNotNeeded} libs already compiled"
		LOG "   (#{timeTaken} secs.)"
		return true
	catch err
		ERR "Not all libs compiled: #{getErrStr(err)}"
		return false

# ---------------------------------------------------------------------------
# ASYNC

export type TUnitTestContext = {
	numNotNeeded: number
	numPassed: number
	numFailed: number
	timeTaken: number
	lErrors?: string[]
	}

export runAllUnitTests := (
		hOptions: hash = {}
		): boolean =>

	{force, quiet, verbose} := getCmdOptions hOptions
	LOG cmdStep("RUN ALL UNIT TESTS")
	timer := new CTimer()
	lTasks := for path of allFilesMatching ["**/*.lib.ts", "src/test/*/*"]
		stub := parsePath(path).stub
		{
			title: toRelPath(path),
			task: (ctx: TUnitTestContext, task: TTask): void =>
				task.output = 'Testing...'
				hResult := await doUnitTest.handleFile path
				if hResult.notNeeded
					ctx.numNotNeeded += 1
					task.title = f"#{task.title}:-14 #{'not needed'}:{yellow}"
				else if hResult.success
					ctx.numPassed += 1
					task.title = f"#{task.title}:-14 #{'passed'}:{green}"
				else
					ctx.numFailed += 1
					task.title = f"#{task.title}:-14 #{'failed'}:{red}"
				return
			}
	{
		numNotNeeded, numPassed, numFailed, timeTaken
		} := await runTasks lTasks, {
			numNotNeeded: 0
			numPassed: 0
			numFailed: 0
			timeTaken: 0
			}, {concurrent: 8}

	LOG "#{numPassed} unit tests passed"
	if (numFailed > 0)
		LOG "#{numFailed} unit tests failed"
	if (numNotNeeded > 0)
		LOG "#{numNotNeeded} unit tests already run"
	LOG "   (#{timer.timeTaken} secs.)"
	return (numFailed == 0)
