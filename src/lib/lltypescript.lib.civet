# lltypescript.lib.civet

import {croak, mkTempFile, DBG} from 'base'
import {hash} from 'datatypes'
import {getOptions} from 'llutils'

# ---------------------------------------------------------------------------
# ASYNC

export typeCheckTsFile := (
		path: string
		): void =>

	cmd := new Deno.Command 'deno', {
		args: ["check", path]
		stdout: "piped"
		stderr: "piped"
		}

	{success, stderr} := await cmd.output()
	if success
		return
	else
		croak new TextDecoder().decode(stderr)

# ---------------------------------------------------------------------------
# ASYNC

export typeCheckTsCode := (
		tsCode: string
		): void =>

	tsPath := await mkTempFile '.ts'
	await Deno.writeTextFile tsPath, tsCode
	await typeCheckTsFile tsPath
	return

# ---------------------------------------------------------------------------
#            SYNCHRONOUS VERSIONS
# ---------------------------------------------------------------------------

export typeCheckTsFileSync := (
		path: string
		): void =>

	cmd := new Deno.Command 'deno', {
		args: ["check", path]
		stdout: "piped"
		stderr: "piped"
		}

	{success, stderr} := cmd.outputSync()
	if success
		return
	else
		croak new TextDecoder().decode(stderr)

# ---------------------------------------------------------------------------

export typeCheckTsCodeSync := (
		tsCode: string
		): void =>

	tsPath := "./_typecheck_.ts"
	Deno.writeTextFileSync tsPath, tsCode
	typeCheckTsFileSync tsPath
	return
