# lltypescript.lib.civet

import {LOG, DBG} from 'logger'
import {croak, assert, mkTempFile} from 'base'
import {hash} from 'datatypes'
import {getOptions} from 'llutils'
import {execCmd} from 'exec'

# ---------------------------------------------------------------------------
# ASYNC

export typeCheckTsFile := (
		path: string
		): void =>

	hResult := await execCmd 'deno', ["check", path]
	assert hResult.success, "type check of #{path} failed"

# ---------------------------------------------------------------------------
# ASYNC

export typeCheckTsCode := (
		tsCode: string
		): void =>

	tsPath := await mkTempFile '.ts'
	await Deno.writeTextFile tsPath, tsCode
	await typeCheckTsFile tsPath
	return
