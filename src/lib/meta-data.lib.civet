# meta-data.lib.civet

import {
	undef, defined, notdefined, croak, assert,
	} from 'base'
import {isString, isHash, hash, hashof} from 'datatypes'
import {fromTAML, f, allLinesInBlock} from 'llutils'

export type TConverter = (str: string) => unknown

hMetaDataTypes: hashof<TConverter> := {
	'---': (block: string) =>
		return fromTAML("---\n#{block}")
	}

# ---------------------------------------------------------------------------

export addMetaDataType := (
	marker: string,
	converter: TConverter
	): void =>

	assert (marker.length == 3), f"Bad 'start' key: #{marker}"
	assert (marker[1] == marker[0]) && (marker[2] == marker[0]),
		"Bad 'start' key: #{marker}"

	hMetaDataTypes[marker] = converter
	return

# ---------------------------------------------------------------------------

export isMetaDataStart := (str: string): boolean =>

	return (str in hMetaDataTypes)

# ---------------------------------------------------------------------------
# --- block does NOT contain the meta data start line

export convertMetaData := (
		marker: string,
		block: string
		): hash =>

	assert isMetaDataStart(marker), "Bad meta data"
	converter := hMetaDataTypes[marker]
	result := converter(block)
	assert isHash(result), "meta data not a hash"
	return result

# ---------------------------------------------------------------------------

export extractMetaData := (
		block: string
		): [hash, string] =>

	lMetaLines: string[] := []
	lDataLines: string[] := []

	let marker: string = ''
	let metaDone: boolean = false
	for line,i of allLinesInBlock(block)
		if (i == 0)
			if not isMetaDataStart(line)
				return [{}, block]
			marker = line
		else if metaDone
			lDataLines.push line
		else if (line == marker)
			metaDone = true
		else
			lMetaLines.push line
	return [
		convertMetaData(marker, lMetaLines.join('\n'))
		lDataLines.join('\n')
		]

# ---------------------------------------------------------------------------

export mdGet := <T>(
		hMetaData: hash
		name: string
		defVal: T
		): T =>

	return hMetaData[name] as T
