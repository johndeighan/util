# hera-parse.lib.civet

import {
	undef, defined, notdefined, deepCopy,
	croak, assert, getErrStr,
	} from 'base'
import {uni, esc} from 'unicode'
import {
	hash, isEmpty, nonEmpty,
	TStringMapper, TVoidFunc,
	} from 'datatypes'
import {isFile, findFile} from 'fsys'
import {MAP} from 'mapper'
import {
	allLinesInBlock, getOptions, sep,
	} from 'llutils'
import {OL, ML} from 'to-nice'
import {resetOneIndent, splitLine} from 'indent'
import {LOG, DBG, ERR} from 'logger'
import {CParseMatches} from 'parse-utils';

# ---------------------------------------------------------------------------
# --- Replaces indentation with uni.shiftin and uni.shiftout
#     oneIndent, if defined, must be '\t' or some number of space chars

export str2indents := (str: string): string =>

	assert not str.includes(uni.shiftin), "Bad input string, has shiftin"
	assert not str.includes(uni.shiftout), "Bad input string, has shiftout"

	resetOneIndent()
	let lParts: string[] = []
	let level = 0
	for line,i of allLinesInBlock(str)
		if (i==0)
			assert not line.match(/^\s/), "Leading whitespace not allowed"
			lParts.push line
			continue
		if isEmpty(line)
			lParts.push '\n'
		else
			[newLevel, str] := splitLine line
			if (newLevel == level)
				lParts.push '\n'
				lParts.push str
			else if (newLevel > level)
				lParts.push uni.shiftin.repeat(newLevel - level) + str
			else      # --- newLevel < level
				lParts.push uni.shiftout.repeat(level - newLevel) + str
			level = newLevel

	return lParts.join('') + uni.shiftout.repeat(level)

# ---------------------------------------------------------------------------

export toDebugStr := (str: string): string =>

	estr := str2indents(str)

	pre := (level: number): string =>
		return (level < 1) ? '' : '   '.repeat(level)

	let level = 0
	lChars := [...estr]
	debugger
	lParts := MAP lChars, (ch) ->
		switch ch
			when '\n'
				yield "\n#{pre(level)}#{uni.downarrow}"
			when uni.shiftin
				yield "\n#{pre(level)}#{uni.rightshift}  "
				level += 1
			when uni.shiftout
				level -= 1
				yield "\n#{pre(level-1)}#{uni.leftshift}  "
			when ' '
				yield uni.fatdot
			when '\t'
				yield uni.rightarrow
			else
				yield ch
	return Array.from(lParts).join('')

# ---------------------------------------------------------------------------
# ASYNC

export doParse := <T = unknown>(
		stub: string
		text: string
		hOptions: hash = {}
		): T =>

	type opt = {
		lTransforms: TStringMapper[]
		debug: boolean
		abortOnError: boolean
		}
	{lTransforms, debug, abortOnError} := getOptions<opt> hOptions, {
		lTransforms: [str2indents]
		debug: false
		abortOnError: true
		}

	if debug
		LOG "debug = #{debug}"

	# --- Save original text, then apply transforms to text
	orgText := text
	for func of lTransforms
		text = func(text)

	# --- import things from the parser
	try
		fileName := "#{stub}.parse.ts"
		path := findFile fileName
		assert isFile(path)
		{pm, reset, parse} := await import stub
		reset(text)
		result := parse(text) as Awaited<T>
		if debug
			pm.dumpParseInfo()

		# --- Return a deep copy of the result
		return deepCopy(result)

	catch err
		if (err instanceof TypeError)
			throw "Bad Parser: #{stub}: #{getErrStr(err)}"
		else
			ERR "in doParse(#{stub})", 'PARSE ERROR'
			LOG '', toDebugStr(orgText)

			{pm} := await import stub
			pm.dumpParseInfo()

			ERR err
			if abortOnError
				Deno.exit 99
			else
				throw err
