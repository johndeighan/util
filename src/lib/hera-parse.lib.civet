# hera-parse.lib.civet

import {toFileUrl} from "@std/path"

import {logLevel, LOG, DBG, ERR} from 'logger'
import {
	undef, defined, notdefined, deepCopy,
	croak, assert, getErrStr, allLinesIn,
	} from 'base'
import {uni, esc} from 'unicode'
import {
	hash, isEmpty, nonEmpty, isString,
	TStringMapper, TVoidFunc, isFunction,
	} from 'datatypes'
import {isFile, findFile, CReadableFile} from 'fsys'
import {MAP, mkArray} from 'mapper'
import {resetOneIndent, splitLine} from 'indent'
import {getOptions, sep} from 'llutils'
import {procOneFile} from 'proc-files'
import {CParseMatches} from 'parse-utils';
import {doCompileHera} from 'hera-compile'

# ---------------------------------------------------------------------------
# --- Replaces indentation with uni.shiftin and uni.shiftout
#     oneIndent, if defined, must be '\t' or some number of space chars
#     there will always be a terminating newline

export str2indents := (
		str: string
		): string =>

	assert not str.includes(uni.shiftin), "Bad input string, has shiftin"
	assert not str.includes(uni.shiftout), "Bad input string, has shiftout"

	resetOneIndent()
	let curLevel = 0
	lLines := mkArray allLinesIn(str), (line) ->
		[level, str] := splitLine line
		if (str == '')
			yield '\n'
		else
			prefix := (
				  (level > curLevel) ? uni.shiftin.repeat(level - curLevel)
				: (level < curLevel) ? uni.shiftout.repeat(curLevel - level)
				: ''
				)
			curLevel = level
			yield "#{prefix}#{str}\n"

	block := lLines.join('')
	return (
		  (curLevel == 0)
		? block
		: block + uni.shiftout.repeat(curLevel) + '\n'
		)

# ---------------------------------------------------------------------------
# ASYNC

export parseText := <T = unknown>(
		stub: string
		text: string
		hOptions: hash = {}
		): T =>

	type opt = {
		trace: boolean
		abortOnError: boolean
		}
	{trace, abortOnError} := getOptions<opt> hOptions, {
		trace: false
		abortOnError: true
		}

	let parseMatcher
	try
		# --- Make sure parser is compiled and up to date
		heraFileName := "#{stub}.parse.hera"
		heraPath := findFile heraFileName
		assert defined(heraPath), "No such file: #{heraFileName}"
		hResult := await procOneFile heraPath, doCompileHera
		assert hResult.success, "parse of #{heraPath} failed"

		tsFileName := "#{stub}.parse.ts"
		DBG "tsFileName = #{tsFileName}"
		path := findFile tsFileName
		assert defined(path), "No such file: ${tsFileName}"
		assert isFile(path), "Not a file: #{path}"

		fileURL := toFileUrl(path).href
		{pm, beginParse, parse} := await import fileURL
		parseMatcher = pm
		assert defined(parse), "Parser not found"
		assert isFunction(parse), "Parser not a function"

		newText := beginParse(text)
		if isString(newText)
			text = newText

		pm.reset(text)

		# --- I don't know why parse() sometimes returns a function
		#     that must be called to get the actual return value
		let result = parse(text)
		if isFunction(result)
			result = result()

		if trace
			pm.dumpParseInfo()

		# --- Return a deep copy of the result
		return deepCopy(result)

	catch err
		if (logLevel != 'silent') && (logLevel != 'testing')
			ERR getErrStr(err)
			ERR "Parser: '#{stub}'", 'PARSE ERROR'
			LOG "Parsing: #{esc(text)}"
			parseMatcher.dumpParseInfo()
		throw err

# ---------------------------------------------------------------------------
# ASYNC

export parseFile := <T = unknown>(
		stub: string
		path: string
		hOptions: hash = {}
		): T =>

	file := new CReadableFile path
	hMetaData := await file.metaData()
	contents := await file.getContents()
	return await parseText<T> stub, contents, {hMetaData}
