# logger.lib.civet

import {red, cyan} from '@std/fmt/colors'

import {assert} from 'croak'
import {write, writeln} from 'console-utils'
import {hash, isString} from 'datatypes'
import {f} from 'f-strings'
import {getOptions, o} from 'llutils'
import {OL, ML} from 'to-nice'

let level = 0
export INDENT := Symbol 'indent'
export UNDENT := Symbol 'undent'

# --- useful for unit testing
#     or saving final log to a log file
export let lLogLines: string[] = []
export type TLogLevel = 'silent' | 'info' | 'debug'

let lLogLevels: TLogLevel[] = ['info']

# ---------------------------------------------------------------------------

logLine := (
		str: string,
		): void =>

	line := '\t'.repeat(level) + str
	lLogLines.push line
	writeln line
	return

# ---------------------------------------------------------------------------

export LOG := (...lItems: unknown[]): void =>

	if (curLogLevel() != 'silent')
		for item of lItems
			if (item == INDENT)
				level += 1
			else if (item == UNDENT)
				if (level > 0)
					level -= 1
			else
				logLine isString(item) ? item : OL(item)
	return

# ---------------------------------------------------------------------------

export DBG := (...lItems: unknown[]): void =>

	if (curLogLevel() == 'debug')
		LOG ...lItems
	return

# ---------------------------------------------------------------------------

export WARN := (
		msg: string
		label: string = 'WARNING'
		): void =>

	if (curLogLevel() != 'silent')
		console.error cyan(label) + ': ' + msg
	return

# ---------------------------------------------------------------------------

export ERR := (
		err: unknown
		label: string = 'ERROR'
		): void =>

	errMsg := (
		  (typeof err == 'string') ? err
		: (err instanceof Error)   ? err.message
		:                            "Unknown Error"
		)
	console.error red(label) + ': ' + errMsg
	return

# ---------------------------------------------------------------------------

export LOGVALUE := (label: string, value: unknown): void =>

	LOG f"#{label}:{blue} = #{ML(value)}"
	return

# ---------------------------------------------------------------------------

export DBGVALUE := (label: string, value: unknown): void =>

	DBG f"#{label}:{blue} = #{ML(value)}"
	return

# ---------------------------------------------------------------------------

export getLog := (): string =>

	return lLogLines.join('\n')

# ---------------------------------------------------------------------------

export curLogLevel := (): TLogLevel =>

	if (lLogLevels.length == 0)
		return 'info'
	else
		return lLogLevels[lLogLevels.length - 1]

# ---------------------------------------------------------------------------

export setLogLevel := (
		level: TLogLevel
		hOptions: hash = {}
		): void =>

	type opt = {
		echo: boolean
		}
	{echo} := getOptions<opt> hOptions, {
		echo: false
		}

	assert (lLogLevels.length > 0), "Empty lLogLevels"
	lLogLevels[lLogLevels.length - 1] = level
	if echo
		LOG "LOG LEVEL set to #{level}"
	return

# ---------------------------------------------------------------------------

export pushLogLevel := (
		level: TLogLevel
		hOptions: hash = {}
		): void =>

	type opt = {
		echo: boolean
		}
	{echo} := getOptions<opt> hOptions, {
		echo: false
		}

	lLogLevels.push level
	if echo
		LOG "LOG LEVEL pushed to #{level}"
	return

# ---------------------------------------------------------------------------

export popLogLevel := (): TLogLevel =>

	if (lLogLevels.length == 0)
		return 'info'
	else
		retval := lLogLevels[lLogLevels.length - 1]
		lLogLevels.pop()
		return retval

