# logger.lib.civet

import {cyan, red, yellow} from '@std/fmt/colors'
import {existsSync} from '@std/fs'

export let logWidth = 78

export type TLogLevel = 'testing' | 'silent' | 'info' | 'debug'
export let lLogLevels: TLogLevel[] = ['info']
export let logLevel: TLogLevel = 'info'
export getLogLevels := () => return lLogLevels

# ---------------------------------------------------------------------------

export stringFits := (
		str: string
		width: number = logWidth
		): boolean =>

	return (str.length <= width)

# ---------------------------------------------------------------------------

setDebugFiles := new Set<string>()

let indentLevel = 0
let lLogLines: string[] = []

export INDENT := Symbol 'indent'
export UNDENT := Symbol 'undent'

# ---------------------------------------------------------------------------

export openDebugFile := (
		stub: string
		clear: boolean = false
		): void =>

	path := "./logs/#{stub}.log"
	setDebugFiles.add path
	if clear && existsSync(path)
		Deno.removeSync path
	return

# ---------------------------------------------------------------------------

export appendDebugFile := (
		...lItems: unknown[]
		): void =>

	for item of lItems
		block := (typeof item == 'string') ? item : toJSON(item)
		for path of setDebugFiles
			Deno.writeTextFileSync path, block + "\n", {append: true}
	return

# ---------------------------------------------------------------------------

export closeDebugFile := (stub: string): void =>

	path := "src/logs/#{stub}.log"
	setDebugFiles.delete path
	return

# ---------------------------------------------------------------------------

export curLogLevel := (): TLogLevel =>

	return logLevel

# ---------------------------------------------------------------------------

export initLogLevel := (
		level: TLogLevel
		): void =>

	lLogLevels = [level]
	logLevel = level
	console.log "INITIAL LOG LEVEL set to #{level}"
	return

# ---------------------------------------------------------------------------

export pushLogLevel := (
		level: TLogLevel
		): void =>

	lLogLevels.push level
	logLevel = level
	return

# ---------------------------------------------------------------------------

export popLogLevel := (): void =>

	if (lLogLevels.length == 0)
		throw new Error("Empty lLogLevels in pop()")
	logLevel = lLogLevels.pop() || 'info'
	if (logLevel == undefined)
		throw new Error("Empty lLogLevels in pop()")
	return

# ---------------------------------------------------------------------------

export toJSON := (item: unknown): string =>

	return JSON.stringify(item, null, 3)

# ---------------------------------------------------------------------------

export LOG := (
		...lItems: unknown[]
		): void =>

	if (logLevel == 'silent')
		return
	for item of lItems
		if (item == INDENT)
			indentLevel += 1
		else if (item == UNDENT)
			if (indentLevel > 0)
				indentLevel -= 1
		else
			logLine item
	return

# ---------------------------------------------------------------------------

export DBG := (
		...lItems: unknown[]
		): void =>

	# --- if an append file is defined, output even if
	#     current log level is not 'debug'
	appendDebugFile ...lItems

	if (curLogLevel() == 'debug')
		LOG ...lItems
	return

# ---------------------------------------------------------------------------

export WARN := (
		msg: string
		label: string = 'WARN'
		): void =>

	lLogLines.push msg
	if (logLevel == 'silent')
		return
	console.error yellow(label) + ': ' + msg
	return

# ---------------------------------------------------------------------------

export ERR := (
		err: unknown
		label: string = 'ERR'
		): void =>

	msg := (
		  (err instanceof Error)   ? err.message
		: (typeof err == 'string') ? err
		:                            'Unknown error'
		)
	lLogLines.push msg
	if (logLevel == 'silent')
		return
	console.error red(label) + ': ' + msg
	return

# ---------------------------------------------------------------------------
# --- Make sure lines have no trailing whitespace

export getLog := (
		func?: () => void
		): string =>

	if (func != undefined)
		clearLog()
		func()
	lLines: string[] := []     # --- should contain no NL chars
	for block of lLogLines
		for line of block.split('\n')
			lLines.push line.replace(/\s+$/, '')
	return lLines.join '\n'

# ---------------------------------------------------------------------------

logLine := (
		x: unknown,
		): void =>

	line := '\t'.repeat(indentLevel) + unknownToString(x)
	if (logLevel != 'testing')
		# --- Anything going to the console has TABs replaced
		console.log line.replaceAll('\t', '   ')
	lLogLines.push line
	return

# ---------------------------------------------------------------------------

export clearLog := (): void =>

	lLogLines.length = 0
	return

# ---------------------------------------------------------------------------

export unknownToString := (x: unknown): string =>

	return (
		  (typeof x == 'string') ? x
		: (x == undefined)       ? 'undef'
		: (x == null)            ? 'null'
		:                          JSON.stringify(x)
		)

# ---------------------------------------------------------------------------
