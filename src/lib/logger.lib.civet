# logger.lib.civet

import {cyan, red, yellow, stripAnsiCode} from '@std/fmt/colors'
import {existsSync} from '@std/fs'

export let logWidth = 78

export enum TLogLevel {
	SILENT,    # 0
	TESTING,   # 1
	INFO,      # 2
	DEBUG      # 3
	}

let lLogLevels: TLogLevel[] = [TLogLevel.INFO]
let logLevel: TLogLevel = TLogLevel.INFO

# ---------------------------------------------------------------------------

curLevelLowerThan := (level: TLogLevel): boolean =>

	return (logLevel < level)

# ---------------------------------------------------------------------------

export logLevelStr := (level: TLogLevel): string =>

	switch level
		when TLogLevel.SILENT then return 'silent'
		when TLogLevel.TESTING then return 'testing'
		when TLogLevel.INFO    then return 'info'
		when TLogLevel.DEBUG   then return 'debug'
	return 'unknown'

# ---------------------------------------------------------------------------

export logLevelFromStr := (level: string): TLogLevel =>

	switch level
		when 'silent'  then return TLogLevel.SILENT
		when 'testing' then return TLogLevel.TESTING
		when 'info'    then return TLogLevel.INFO
		when 'debug'   then return TLogLevel.DEBUG
		else
			throw new Error("No such log level: #{level}")

# ---------------------------------------------------------------------------

let indentLevel = 0
let lLogLines: string[] = []

export INDENT := Symbol 'indent'
export UNDENT := Symbol 'undent'

# ---------------------------------------------------------------------------
#   debug files
# ---------------------------------------------------------------------------

setDebugFiles := new Set<string>()

# ---------------------------------------------------------------------------

debugFilePath := (stub: string): string =>

	return "./logs/#{stub}.log"

# ---------------------------------------------------------------------------

export openDebugFile := (
		stub: string
		): void =>

	path := debugFilePath stub
	setDebugFiles.add path
	return

# ---------------------------------------------------------------------------

export removeDebugFile := (stub: string): void =>

	path := debugFilePath stub
	if existsSync(path)
		Deno.removeSync path
	return

# ---------------------------------------------------------------------------

export appendDebugFile := (
		...lItems: unknown[]
		): void =>

	for item of lItems
		block := (
			  (typeof item == 'string')
			? stripAnsiCode(item)
			: toJSON(item)
			)
		for path of setDebugFiles
			Deno.writeTextFileSync path, block + "\n", {append: true}
	return

# ---------------------------------------------------------------------------

export closeDebugFile := (stub: string): void =>

	path := "src/logs/#{stub}.log"
	setDebugFiles.delete path
	return

# ---------------------------------------------------------------------------
# ---------------------------------------------------------------------------

export curLogLevel := (): string =>

	return logLevelStr(logLevel)

# ---------------------------------------------------------------------------

export initLogLevel := (
		level: TLogLevel | string
		): void =>

	if (typeof level == 'string')
		level = logLevelFromStr level
	lLogLevels = [level]
	logLevel = level
	console.log "INITIAL LOG LEVEL set to #{logLevelStr(level)}"
	return

# ---------------------------------------------------------------------------

export pushLogLevel := (
		level: TLogLevel | string
		): void =>

	if (typeof level == 'string')
		level = logLevelFromStr level
	lLogLevels.push level
	logLevel = level
	return

# ---------------------------------------------------------------------------

export popLogLevel := (): void =>

	if (lLogLevels.length == 0)
		throw new Error("Empty lLogLevels in pop()")
	logLevel = lLogLevels.pop() || TLogLevel.INFO
	if (logLevel == undefined)
		throw new Error("Empty lLogLevels in pop()")
	return

# ---------------------------------------------------------------------------

toJSON := (item: unknown): string =>

	return JSON.stringify(item, null, 3)

# ---------------------------------------------------------------------------

export stringFits := (
		str: string
		width: number = logWidth
		): boolean =>

	return (str.length <= width)

# ---------------------------------------------------------------------------

export LOG := (
		...lItems: unknown[]
		): void =>

	if (logLevel == TLogLevel.SILENT)
		return
	for item of lItems
		logItem item
	return

# ---------------------------------------------------------------------------

export WARN := (
		msg: string
		label: string = 'WARNING'
		): void =>

	if curLevelLowerThan TLogLevel.TESTING
		return
	logItem yellow(label) + ': ' + msg
	return

# ---------------------------------------------------------------------------

export DBG := (
		...lItems: unknown[]
		): void =>

	# --- if a debug file is defined, output even if
	#     current log level is not 'debug'
	appendDebugFile ...lItems

	if curLevelLowerThan TLogLevel.DEBUG
		return
	for item of lItems
		logItem item
	return

# ---------------------------------------------------------------------------

export ERR := (
		err: unknown
		label: string = 'ERROR'
		): void =>

	msg := (
		  (err instanceof Error)   ? err.message
		: (typeof err == 'string') ? err
		:                            'Unknown error'
		)

	# --- if a debug file is defined, output even if
	#     current log level is not 'debug'
	appendDebugFile msg

	logItem red(label) + ': ' + msg
	return

# ---------------------------------------------------------------------------
# --- Make sure lines have no trailing whitespace

export getLog := (
	func?: () => void
	): string =>

	if (func != undefined)
		clearLog()
		func()
	lLines: string[] := []     # --- should contain no NL chars
	for block of lLogLines
		for line of block.split('\n')
			lLines.push line.replace(/\s+$/, '')
	return lLines.join '\n'

# ---------------------------------------------------------------------------

logItem := (
		item: unknown,
		): void =>

	if (item == INDENT)
		indentLevel += 1
	else if (item == UNDENT)
		if (indentLevel > 0)
			indentLevel -= 1
	else
		line := '\t'.repeat(indentLevel) + unknownToString(item)

		# --- Anything going to the console has TABs replaced
		# --- In TESTING level, no output to console
		if (logLevel != TLogLevel.TESTING)
			console.log line.replaceAll('\t', '   ')

		# --- Anything going to internal log has ANSI codes stripped
		#     Add to lLogLines in TESTING level
		lLogLines.push stripAnsiCode(line)
		return

# ---------------------------------------------------------------------------

export clearLog := (width: number = 78): void =>

	if (width < 1)
		throw new Error("Bad width: #{width}")
	logWidth = width
	lLogLines.length = 0
	return

# ---------------------------------------------------------------------------

unknownToString := (x: unknown): string =>

	return (
		  (typeof x == 'string') ? x
		: (x == undefined)       ? 'undef'
		: (x == null)            ? 'null'
		:                          JSON.stringify(x)
		)

# ---------------------------------------------------------------------------
