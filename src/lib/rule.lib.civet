# rule.lib.civet

import {
	undef, defined, notdefined, assert, croak, TIterator,
	LOG, ERR, toBool,
	} from 'base'
import {DUMP} from 'nice'
import {isEmpty} from 'datatypes'
import {toBlock} from 'llutils'
import {indented} from 'indent'
import {THeraType} from 'llhera'
import {civet2tsSync} from 'llcivet'

# ---------------------------------------------------------------------------

export isValidRuleName := (str: string): boolean =>

	return toBool str.match(/^[A-Za-z_][A-Za-z0-9_]*$/)

# ---------------------------------------------------------------------------

export class CRuleBranch
	private pattern: string
	private lCode: string[] = []

	constructor(
			@pattern: string,
			lCode: string[] = []
			)

		for str of lCode
			@lCode.push str

	# ..........................................................

	addCode(
			line: string
			): void

		lMatches := line.match /^(\s*)return\s+(.*)$/
		if defined lMatches
			[_, prefix, valueStr] := lMatches
			if valueStr.includes('$skip')
				@lCode.push line
			else
				len := valueStr.length
				useStr := (
					  valueStr.endsWith(';')
					? valueStr.substring(0, len-1)
					: valueStr
					)

				@lCode.push (prefix + 'return pm.returnVal(' + useStr + ');')
		else
			@lCode.push line
		return

	# ..........................................................

	patternStr(): string

		if isEmpty(@lCode)
			return @pattern
		else
			hashPos := @pattern.indexOf('#')
			if (hashPos == -1)
				return @pattern + ' ->'
			else
				return @pattern.replace('#', '-> #')

	# ..........................................................

	numCodeLines(): number

		return @lCode.length

	# ..........................................................

	asString(
			type: THeraType = 'civet'
			): string

		patStr := @patternStr()
		code := mkCodeBlock @lCode, type
		return toBlock [patStr, indented(code)]

# ---------------------------------------------------------------------------

export mkCodeBlock := (
		lCodeBlock: string[]
		type: THeraType
		): string =>

	block := toBlock lCodeBlock
	if (type == 'typescript')
		return block
	try
		code := civet2tsSync(block, {inlineMap: false})
		return code
	catch err
		ERR "civet compile failed"
		DUMP block
		throw err

# ---------------------------------------------------------------------------

export class CRule
	private name: string
	private lBranches: CRuleBranch[] = []

	constructor(@name: string)

		assert defined(@name.match /^[A-Za-z$_][A-Za-z0-9$_-]*$/),
			"Bad name: <#{@name}>"

	# ..........................................................

	getName(): string

		return @name

	# ..........................................................

	addBranch(pat: string): CRuleBranch

		branch := new CRuleBranch(pat)
		@lBranches.push branch
		return branch

	# ..........................................................

	curBranch(): CRuleBranch

		assert (@lBranches.length > 0), "No branches in rule #{@name}"
		return @lBranches[@lBranches.length - 1]

	# ..........................................................

	numBranches(): number

		return @lBranches.length

	# ..........................................................

	allBranches(): TIterator<CRuleBranch>

		for branch of @lBranches
			yield branch
		return

	# ..........................................................

	asString(type: THeraType = 'civet'): string

		assert (@lBranches.length > 0), "rule #{@name} has no branches"
		return [
			@name
			...@lBranches.map((b) => indented(b.asString(type)))
			].join('\n')

# ---------------------------------------------------------------------------

export class CRuleSet

	lRules: CRule[] = []

	addRule(name: string): CRule

		assert isValidRuleName(name), "Bad rule name: #{name}"
		rule := new CRule(name)
		@lRules.push rule
		return rule

	curRule(): CRule
		assert (@lRules.length > 0), "No rules in set"
		return @lRules[@lRules.length - 1]

	ruleName(
			ruleNum: number = @lRules.length - 1
			): string

		return @lRules[ruleNum].getName()
