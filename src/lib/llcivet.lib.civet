# llcivet.lib.civet

import {
	compile, CompileOptions,
	} from '@danielx/civet'
import {findInDir, loadConfig} from "@danielx/civet/config"

import {LOG, DBG, ERR} from 'logger'
import {
	undef, defined, notdefined, assert, croak,
	withExt, newerDestFileExists, getErrStr,
	} from 'base'
import {DUMP} from 'nice'
import {hash} from 'datatypes'
import {getOptions} from 'llutils'
import {typeCheckTsFile} from 'lltypescript'

let hCivetConfig: CompileOptions? = undef

# ---------------------------------------------------------------------------
# ASYNC

export getCivetConfig := (
		hExtra: CompileOptions = {}
		): CompileOptions =>

	if defined(hCivetConfig)
		return Object.assign hCivetConfig, hExtra
	path := await findInDir(process.cwd())
	assert defined(path), "No civet config file found"
	hCivetConfig = await loadConfig(path)
	return Object.assign hCivetConfig, hExtra

# ---------------------------------------------------------------------------
# ASYNC

export civet2ts := (
		civetCode: string,
		hOptions: hash = {}
		): string =>

	type opt = {
		inlineMap: boolean
		}
	{inlineMap} := getOptions<opt> hOptions, {
		inlineMap: true
		}
	try
		hConfig := await getCivetConfig {inlineMap}
		tsCode := await compile civetCode, hConfig
		return tsCode
	catch err
		ERR getErrStr(err)
		throw err

# ---------------------------------------------------------------------------
# ASYNC

export civet2js := (
		civetCode: string,
		hOptions: hash = {}
		): string =>

	type opt = {
		inlineMap: boolean
		}
	{inlineMap} := getOptions<opt> hOptions, {
		inlineMap: false
		}
	try
		hConfig := await getCivetConfig {inlineMap}
		assert defined(hConfig.parseOptions), "Bad config file"
		hConfig.js = true
		jsCode := await compile civetCode, hConfig
		return jsCode
	catch err
		ERR getErrStr(err)
		throw err

# ---------------------------------------------------------------------------
# ASYNC

export civet2tsFile := (
		civetPath: string
		tsPath: string = withExt(civetPath, '.ts')
		hOptions: hash = {}
		): string =>   # --- returns tsPath

	type opt = {
		inlineMap: boolean
		force: boolean
		check: boolean
		}
	{inlineMap, force, check} := getOptions hOptions, {
		inlineMap: true
		force: false
		check: true
		}

	if newerDestFileExists(civetPath, tsPath) && not force
		DBG "File #{civetPath} already compiled"
		return tsPath
	civetCode := await Deno.readTextFile civetPath
	tsCode := await civet2ts civetCode, hOptions
	await Deno.writeTextFile tsPath, tsCode
	if check
		ok := await typeCheckTsFile tsPath
	return tsPath
