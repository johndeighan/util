# llcivet.lib.civet

import {
	compile as compileCivet, CompileOptions,
	} from '@danielx/civet'
import {findInDir, loadConfig} from "@danielx/civet/config"

import {
	undef, defined, notdefined, assert, croak,
	DBG, ERR, withExt, newerDestFileExists, getErrStr,
	} from 'base'
import {DUMP} from 'nice'
import {hash} from 'datatypes'
import {getOptions} from 'llutils'
import {
	typeCheckTsFile, typeCheckTsCode,
	typeCheckTsFileSync, typeCheckTsCodeSync,
	} from 'lltypescript'

let hCivetConfig: CompileOptions? = undef

# ---------------------------------------------------------------------------
# ASYNC

export getCivetConfig := (
		hExtra: CompileOptions = {}
		): CompileOptions =>

	if defined(hCivetConfig)
		return Object.assign hCivetConfig, hExtra
	path := await findInDir(process.cwd())
	assert defined(path), "No civet config file found"
	hCivetConfig = await loadConfig(path)
	return Object.assign hCivetConfig, hExtra

# ---------------------------------------------------------------------------
# ASYNC

export civet2ts := (
		civetCode: string,
		hOptions: hash = {}
		): string =>

	type opt = {
		inlineMap: boolean
		}
	{inlineMap} := getOptions<opt> hOptions, {
		inlineMap: true
		}
	debugger
	try
		hConfig := await getCivetConfig {inlineMap}
		tsCode := await compileCivet civetCode, hConfig
		return tsCode
	catch err
		ERR getErrStr(err)
		throw err

# ---------------------------------------------------------------------------
# ASYNC

export civet2tsFile := (
		civetPath: string
		tsPath: string = withExt(civetPath, '.ts')
		hOptions: hash = {}
		): string =>

	type opt = {
		inlineMap: boolean
		force: boolean
		check: boolean
		}
	{inlineMap, force, check} := getOptions hOptions, {
		inlineMap: true
		force: false
		check: true
		}

	if newerDestFileExists(civetPath, tsPath) && not force
		DBG "File #{civetPath} already compiled"
		return tsPath
	civetCode := await Deno.readTextFile civetPath
	tsCode := await civet2ts civetCode, hOptions
	await Deno.writeTextFile tsPath, tsCode
	if check
		await typeCheckTsFile tsPath
	return tsPath

# ---------------------------------------------------------------------------
#            SYNCHRONOUS VERSIONS
# ---------------------------------------------------------------------------

export getCivetConfigSync := (
		hExtra: CompileOptions = {}
		): CompileOptions =>

	if defined(hCivetConfig)
		return Object.assign hCivetConfig, hExtra
	path := findInDir(process.cwd(), "civet.config.json", {sync: true})
	assert defined(path), "No civet config file found"
	hCivetConfig = loadConfig(path, {sync: true})
	return Object.assign hCivetConfig, hExtra

# ---------------------------------------------------------------------------

export civet2tsSync := (
		civetCode: string,
		hOptions: hash = {}
		): string =>

	type opt = {
		inlineMap: boolean
		}
	{inlineMap} := getOptions<opt> hOptions, {
		inlineMap: true
		}
	try
		hConfig := getCivetConfigSync {inlineMap, sync: true}
		return compileCivet civetCode, hConfig
	catch err
		ERR "Civet compileCivet failed"
		DUMP civetCode, 'civetCode'
		throw err

# ---------------------------------------------------------------------------

export civet2tsFileSync := (
		civetPath: string
		tsPath: string = withExt(civetPath, '.ts')
		hOptions: hash = {}
		): string =>

	type opt = {
		inlineMap: boolean
		force: boolean
		check: boolean
		}
	{inlineMap, force, check} := getOptions hOptions, {
		inlineMap: true
		force: false
		check: true
		}

	if newerDestFileExists(civetPath, tsPath) && not force
		DBG "File #{civetPath} already compiled"
		return tsPath
	civetCode := Deno.readTextFileSync civetPath
	tsCode := civet2tsSync civetCode, hOptions
	Deno.writeTextFileSync tsPath, tsCode
	if check
		typeCheckTsFileSync tsPath
	return tsPath
