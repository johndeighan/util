# symbols.lib.civet

import {existsSync} from '@std/fs'

import {
	undef, defined, notdefined, assert, croak,
	} from 'base'
import {hashof} from 'datatypes'
import {keys} from 'llutils'
import {findFile} from 'fsys'
import {parseText} from 'hera-parse'

/**
 * @module symbols - locate common symbols
 *    parses a file (default name: .symbols) that looks like:
 *       indent
 *          oneIndent resetOneIndent indentLevel
 *          TLineDesc splitLine indented
 *       fsys
 *          isFile isDir
 *          fileExt withExt
 *
 *    and implements function:
 *       sourceLib := (symbol: string): string?
 */
# --- holds symbols in symbolsPath,
#     but only loaded when needed
#     and only if file exists

# --- { <symbol> => <lib>, ... }
export hSymbols: hashof<string> := {}

# ---------------------------------------------------------------------------

export clearSymbols := (): void =>

	for key of keys(hSymbols)
		delete hSymbols[key]
	return

# ---------------------------------------------------------------------------

export addSymbol := (
		symbol: string
		lib: string
		): void =>

	hSymbols[symbol] = lib
	return

# ---------------------------------------------------------------------------

export getSymbolLib := (symbol: string): string? =>

	return hSymbols[symbol]

# ---------------------------------------------------------------------------
# ASYNC

export loadSymbols := (
		fileName: string = '.symbols'
		): hashof<string> =>

	clearSymbols()
	path := findFile fileName
	assert defined(path) && existsSync(path),
		"No such file: #{fileName}"
	contents := await Deno.readTextFile path
	await parseText 'symbols', contents
	return hSymbols

# ---------------------------------------------------------------------------
# ASYNC

export symbolsFromString := (
		str: string
		): hashof<string> =>

	return await parseText 'symbols', str

# ---------------------------------------------------------------------------

export getNeededImportStmts := (
		lSymbols: string[]
		): string[] =>

	# --- build hash {<lib>: string[], ...}
	hLibs: hashof<string[]> := {}
	for sym of lSymbols
		lib := getSymbolLib(sym)
		if defined(lib)
			if lib in hLibs
				hLibs[lib].push sym
			else
				hLibs[lib] = [sym]

	lStmts := []
	for lib of keys(hLibs)
		lSyms := hLibs[lib]
		lStmts.push "import {#{lSyms.join ', '}} from '#{lib}';"
	return lStmts
