# symbols.lib.civet

import {existsSync} from '@std/fs'

import {
	undef, defined, notdefined, assert, croak,
	} from 'base'
import {hash, hashof, isHash, clearHash} from 'datatypes'
import {keys} from 'llutils'
import {OL} from 'nice'
import {findFile, isFile, modTime} from 'fsys'
import {parseText} from 'hera-parse'

/**
 * @module symbols - locate common symbols
 *    loadSymbols() parses a file (default name: .symbols)
 *    that looks like:
 *       indent
 *          oneIndent resetOneIndent indentLevel
 *          TLineDesc splitLine indented
 *       fsys
 *          isFile isDir
 *          fileExt withExt
 *
 *    and implements function:
 *       getSymbolLib := (symbol: string): string?
 */

# --- holds symbols in symbolsPath,
#     but only loaded when isNeeded
#     and only if file exists

# --- { <symbol> => <lib>, ... }
hAllSymbols: hashof<string> := {}

# --- Keep track of file from which symbols were loaded
#     Plus the time stamp of the file when loaded
let loadFilePath: string = ''
let loadFileModTime: Date = new Date(0)

# ---------------------------------------------------------------------------
# ASYNC

export loadSymbols := (
		fileName: string = '.symbols'
		): hashof<string> =>

	path := findFile fileName
	assert defined(path), "No such file: #{fileName}"
	pathModTime := modTime(path)
	if (path == loadFilePath) && (pathModTime == loadFileModTime)
		return hAllSymbols    # --- return cached symbols

	contents := await Deno.readTextFile path
	clearHash(hAllSymbols)
	Object.assign hAllSymbols, await loadSymbolsFrom contents, hAllSymbols
	loadFilePath = path
	loadFileModTime = pathModTime
	return hAllSymbols

# ---------------------------------------------------------------------------
# ASYNC

export loadSymbolsFrom := (
		str: string
		h: hashof<string> = {}
		): hashof<string> =>

	hFound := await parseText 'symbols', str
	assert isHash<string>(hFound), "Not a hash of strings: #{OL(hFound)}"
	return {...h, ...hFound}

# ---------------------------------------------------------------------------
# ASYNC

export symbolsFromString := (
		str: string
		): hashof<string> =>

	return await parseText 'symbols', str

# ---------------------------------------------------------------------------

export getNeededImportStmts := (
		lSymbols: string[]
		): string[] =>

	# --- build hash {<lib>: string[], ...}
	hLibs: hashof<string[]> := {}
	for sym of lSymbols
		lib := getSymbolLib(sym)
		if defined(lib)
			if lib in hLibs
				hLibs[lib].push sym
			else
				hLibs[lib] = [sym]

	lStmts := []
	for lib of keys(hLibs)
		lSyms := hLibs[lib]
		lStmts.push "import {#{lSyms.join ', '}} from '#{lib}';"
	return lStmts

# ---------------------------------------------------------------------------

export getSymbolLib := (
		symbol: string
		hSymbols: hash = hAllSymbols
		): string? =>

	if (symbol in hSymbols)
		return hSymbols[symbol] as string
	else
		return undef
