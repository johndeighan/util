# symbols.lib.civet

import {existsSync} from '@std/fs'

import {LOG, DBG, ERR} from 'logger'
import {
	undef, defined, notdefined, assert, croak, getErrStr,
	TIterator, words,
	} from 'base'
import {hash, hashof, isHash, clearHash} from 'datatypes'
import {keys, f} from 'llutils'
import {indented} from 'indent'
import {OL} from 'nice'
import {
	findFile, isFile, modTime,
	barf, allFilesMatching, withExt, parsePath,
	CReadableFile, CWritableFile, toRelPath,
	} from 'fsys'
import {parseText} from 'hera-parse'
import {CAnalysis, analyzeTsCode} from 'typescript'

/**
 * @module symbols - locate common symbols
 *    loadSymbols() parses a file (default name: .symbols)
 *    that looks like:
 *       indent
 *          oneIndent resetOneIndent indentLevel
 *          TLineDesc splitLine indented
 *       fsys
 *          isFile isDir
 *          fileExt withExt
 *
 *    and implements function:
 *       getSymbolLib := (symbol: string): string?
 */

# --- holds symbols in symbolsPath,
#     but only loaded when isNeeded
#     and only if file exists

# --- { <symbol> => <lib>, ... }
hAllSymbols: hashof<string> := {}

# --- Keep track of file from which symbols were loaded
#     Plus the time stamp of the file when loaded
let loadFilePath: string = ''
let loadFileModTime: Date = new Date(0)

maxLineLen := 78

# ---------------------------------------------------------------------------
# ASYNC

export loadSymbols := (
		fileName: string = '.symbols'
		): hashof<string> =>

	path := findFile fileName
	assert defined(path), "No such file: #{fileName}"
	pathModTime := modTime(path)
	if (path == loadFilePath) && (pathModTime == loadFileModTime)
		return hAllSymbols    # --- return cached symbols

	contents := await Deno.readTextFile path
	clearHash(hAllSymbols)
	Object.assign hAllSymbols, await loadSymbolsFrom contents, hAllSymbols
	loadFilePath = path
	loadFileModTime = pathModTime
	return hAllSymbols

# ---------------------------------------------------------------------------
# ASYNC

export loadSymbolsFrom := (
		str: string
		h: hashof<string> = {}
		): hashof<string> =>

	hFound := await parseText 'symbols', str
	assert isHash<string>(hFound), "Not a hash of strings: #{OL(hFound)}"
	return {...h, ...hFound}

# ---------------------------------------------------------------------------
# ASYNC

export symbolsFromString := (
		str: string
		): hashof<string> =>

	return await parseText 'symbols', str

# ---------------------------------------------------------------------------

export getNeededImportStmts := (
		lSymbols: string[]
		): string[] =>

	# --- build hash {<lib>: string[], ...}
	hLibs: hashof<string[]> := {}
	for sym of lSymbols
		lib := getSymbolLib(sym)
		if defined(lib)
			if lib in hLibs
				hLibs[lib].push sym
			else
				hLibs[lib] = [sym]

	lStmts := []
	for lib of keys(hLibs)
		lSyms := hLibs[lib]
		lStmts.push "import {#{lSyms.join ', '}} from '#{lib}';"
	return lStmts

# ---------------------------------------------------------------------------

export getSymbolLib := (
		symbol: string
		hSymbols: hashof<string> = hAllSymbols
		): string? =>

	return hSymbols[symbol]

# ---------------------------------------------------------------------------

export buildDotSymbols := (
		outPath: string = 'src/.symbols'
		trace: boolean = false
		): void =>

	outfile := new CWritableFile(outPath)
	for path of allFilesMatching('**/*.lib.ts')
		try
			infile := new CReadableFile(path)
			contents := await infile.getContents()
			analysis := analyzeTsCode(contents)
			lExports := analysis.getExports()
			{stub} := parsePath(path)

			await outfile.writeln(stub)
			let numSymbols = 0
			for line of allExportLines lExports
				await outfile.writeln(indented(line))
				if trace
					numSymbols += words(line).length
			if trace
				LOG f"#{numSymbols}:3 #{toRelPath(path)}"
		catch err
			ERR getErrStr(err) + " in #{path}"

# ---------------------------------------------------------------------------
# --- TIterator

allExportLines := (
		lExports: string[]
		): TIterator<string> ->

	lSymbols: string[] := []
	let lineLen = 0     # --- always <= maxLineLen
	for name of lExports.sort((a, b) => a.localeCompare(b))
		pos := name.indexOf '<'
		sym := (pos == -1) ? name : name.substring(0, pos)
		if (lineLen + sym.length + 1 > maxLineLen)
			yield lSymbols.join(' ')

			# --- Initialize next line with current symbol
			lSymbols.length = 0
			lSymbols.push sym
			lineLen = sym.length
		else
			lSymbols.push sym
			lineLen += sym.length + 1
	if (lSymbols.length > 0)
		yield lSymbols.join(' ')
	return
