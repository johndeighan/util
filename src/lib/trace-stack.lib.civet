# trace-stack.lib.civet

import {LOG, DBG} from 'logger'
import {
	undef, defined, notdefined, assert, obviously, croak,
	deepCopy, TIterator, colorize,
	} from 'base'
import {esc} from 'unicode'
import {
	hash, isInteger, isString, isArray, isNonEmptyString, isEmpty,
	} from 'datatypes'
import {
	spaces, getOptions, centered, sep, arrayToBlock, rtrim,
	} from 'llutils'
import {indented} from 'indent'
import {OL} from 'nice'

export mainName := '_MAIN_'

# ---------------------------------------------------------------------------

export class CCallNode

	id: number
	name: string
	lArgs: unknown[]
	caller: CCallNode?
	calling: CCallNode? = undef
	isYielded: boolean = false
	doLog: boolean = false

	constructor(
			@id: number
			@name: string = mainName
			lArgs: unknown[] = []
			@caller: CCallNode? = undef
			@doLog: boolean = false
			)

		assert defined(@caller) || (@name == mainName), "Missing caller"
		assert isNonEmptyString(@name), "Bad funcName: #{@name}"
		@lArgs = deepCopy(lArgs)

# ---------------------------------------------------------------------------

export class CCallStack

	root = new CCallNode(1)
	nextID: number = 2
	curFunc: CCallNode
	level: number = 0
	logLevel: number = 0
	debug: boolean = false

	doDebugStack: boolean  = false
	doThrowErrors: boolean = false

	oneIndent: string

	# ........................................................................

	constructor(hOptions: hash = {})

		type opt = {
			oneIndent: string
			debug: boolean
			doDebugStack: boolean
			}
		{oneIndent, debug, doDebugStack} := getOptions<opt> hOptions, {
			oneIndent: spaces(3)
			debug: false
			doDebugStack: false
			}

		if debug
			@debug = true
		if doDebugStack
			@doDebugStack = true
			@dumpStack()
		@level = @logLevel = 0
		@oneIndent = oneIndent
		@curFunc = @root

	# ........................................................................

	allNodes(): TIterator<CCallNode>

		yield @root
		let node = @root
		while defined(node.calling)
			node = node.calling
			yield node
		return

	# ........................................................................

	reset(): void

		@log 'RESET'
		@level = @logLevel = 0
		@curFunc = @root
		return

	# ........................................................................

	get curFuncName(): string

		return @curFunc.name

	# ........................................................................
	# ........................................................................

	enter(
			funcName: string
			lArgs: unknown[]? = []
			doLog: boolean = false
			): void

		@log 'ENTER', funcName, lArgs

		node := new CCallNode(@nextID, funcName, lArgs, @curFunc, doLog)
		@nextID += 1
		@curFunc.calling = node
		@curFunc = node
		@incLevel()
		@dumpStack()
		return

	# ........................................................................

	returnFrom(
			funcName: string
			val: unknown? = undef
			): void

		assert (funcName == @curFuncName),
			"return from #{funcName}, but cur func is #{@curFuncName}"

		# --- Always returns from the current function
		#     parameter is just a check for correct function name

		@decLevel()   # --- Adjust levels before logging

		@log 'RETURN FROM', funcName, val

		caller := @curFunc.caller
		assert defined(caller), "Cur func has no caller"
		@curFunc = caller
		assert defined(@curFunc.calling), "calling stack empty"
		@curFunc.calling = undef

		@dumpStack()
		return

	# ........................................................................

	yieldFrom(
			funcName: string
			val: unknown?
			): void

		@log 'YIELD FROM', funcName, [val]

		assert (@curFuncName != mainName), "yield from #{mainName}"
		assert (funcName == @curFuncName),
			"yield from #{funcName}, but cur func is #{@curFuncName}"

		@curFunc.isYielded = true
		let func = @curFunc.caller
		assert defined(func), "caller not defined"
		while defined(func) && (func.isYielded)
			func = func.caller
			assert defined(func), "caller not defined"
		@curFunc = func

		# --- Adjust levels after logging
		@decLevel()

		@dumpStack()
		return

	# ........................................................................

	resume(
			funcName: string
			): void

		@log 'RESUME', funcName

		assert defined(@curFunc.calling), "resume(): no calling func"
		@incLevel()

		@curFunc = @curFunc.calling
		assert (@curFuncName == funcName),
			"resume #{funcName} but resumed #{@curFuncName}"
		assert @curFunc.isYielded, "resume #{funcName} but it's not yielded"
		@curFunc.isYielded = false

		@dumpStack()
		return

	# ........................................................................
	# ........................................................................

	log(
			op: string
			funcName: string = ''
			lArgs: (unknown[] | string | unknown)? = undef
			): void

		if @debug
			argStr := (
				  isString(lArgs) ? esc(lArgs)
				: isArray(lArgs)  ? OL(lArgs)
				: defined(lArgs)  ? OL(lArgs)
				:                   ''
				)
			LOG colorize(rtrim("#{spaces(3*@level)}#{op} #{funcName} #{argStr}"), 'cyan')
		return

	# ........................................................................

	isActive(
			funcName: string
			root: CCallNode = @root
			): boolean

		if (funcName == root.name)
			return true
		for node of @allNodes()
			if node.isYielded
				break
			if (node.name == funcName)
				return true
		return false

	# ........................................................................

	isLogging(): boolean

		return @curFunc.doLog

	# ........................................................................

	incLevel(): void

		@level += 1
		if @curFunc.doLog
			@logLevel += 1
		return

	# ........................................................................

	decLevel(): void

		assert (@level > 0), "dec level when level is 0"
		@level -= 1
		if @isLogging()
			assert (@logLevel > 0), "dec logLevel when logLevel is 0"
			@logLevel -= 1
		return

	# ........................................................................

	dumpStack(): void

		if @doDebugStack
			LOG centered 'CALL STACK', {char: '-'}
			for node,i of @allNodes()
				LOG indented @callStr(node), i, {oneIndent: @oneIndent}
			LOG sep()
		return

	# ........................................................................

	callStr(hNode: CCallNode): string

		prefix := (
			  ((hNode == @curFunc) ? '>' : '')
			+ "[#{hNode.id}"
			+ (hNode.isYielded || hNode.doLog ? ' ' : '')
			+ (hNode.isYielded ? 'Y' : '')
			+ (hNode.doLog ? 'L' : '')
			+ "]"
			)

		{name, lArgs} := hNode
		if isEmpty(lArgs)
			return "#{prefix} #{name}()"
		else
			argStr := (
				for arg of lArgs
					OL(arg)
				).join(', ')
			return "#{prefix} #{name}(#{argStr})"
