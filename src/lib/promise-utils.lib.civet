# promise-utils.lib.civet

import {assert, getErrStr, sleep} from 'base'
import {MAP, accum} from 'mapper'
import {hash, isArray, isPromise, isFunction} from 'datatypes'
import {getOptions} from 'llutils'
import {OL} from 'nice'

# ---------------------------------------------------------------------------

type TRunResult<T> = [T[], string[], string[], string[]]

# ---------------------------------------------------------------------------
# ASYNC
# --- returns [lFulfilled, lRejected, lFulfilledTags, lRejectedTags]
#        lFulfilled is an array of TAccum
#        lRejected is an array of unknown
#        lFulfilledTags and lRejectedTags are arrays of strings

export awaitAllConcurrently := <T>(
		lPromises: Promise<T>[]
		lTags: string[] = []
		): TRunResult<T> ->

	lSettled := await Promise.allSettled(lPromises)
	assert isArray(lSettled), "Not an array: #{lSettled}"
	acc0: TRunResult<T> := [[],[],[],[]]
	lFinalAccum := accum lSettled, acc0, (h, acc, i): TRunResult<T> ->
		tag := (i >= 0) && (i < lTags.length) ? lTags[i] : ''
		[lFulfilled, lRejected, lTags1, lTags2] := acc
		if (h.status == 'fulfilled')
			return [
				[...lFulfilled, h.value],
				lRejected,
				[...lTags1, tag],
				lTags2
				]
		else
			return [
				lFulfilled
				[...lRejected, getErrStr(h.reason)]
				lTags1
				[...lTags2, tag]
				]
	return lFinalAccum

# ---------------------------------------------------------------------------

type TVoidPromiseFunc<T=unknown> = () => Promise<T>

export awaitAllSerially := <T,TErr>(
		lFunctions: TVoidPromiseFunc<T>[]
		lTags: string[] = []
		): TRunResult<T> ->

	lResult: TRunResult<T> := [[],[],[],[]]
	for func,i of lFunctions
		assert isFunction(func), "Not a function: #{func}"
		try
			result := await func()
			lResult[0].push result
			lResult[2].push lTags[i]
		catch err
			lResult[1].push getErrStr(err)
			lResult[3].push lTags[i]
	return lResult

# ---------------------------------------------------------------------------
# ASYNC
# --- returns an error message if promise rejects

type TResult<T> = [true, T] | [false, string]

export evalPromise := <T=unknown>(
		prom: Promise<T>
		): TResult<T> =>

	try
		return [true, await prom]
	catch err
		return [false, getErrStr(err)]

# ---------------------------------------------------------------------------

export type TSettleResult<T> =
	[true, T, number] | [false, any, number]

export awaitAll := <T>(
		lTasks: (() => Promise<T>)[]
		onSettle: (result: TSettleResult<T>) => void
		hOptions: hash = {}
		): void =>

	type opt = {
		serial: boolean
		}

	{serial} := getOptions<opt> hOptions, {
		serial: false
		}

	if serial
		for task,i of lTasks
			try
				value := await task()
				onSettle [true, value, i]
			catch (reason)
				onSettle [false, reason, i]
	else
		lWrappedPromises := lTasks.map (task, index) =>
			try
				value := await task()
				successResult: TSettleResult<T> := [true, value, index]
				onSettle successResult
				return successResult
			catch (reason)
				errorResult: TSettleResult<T> := [false, reason, index]
				onSettle errorResult
				return errorResult

		await Promise.all(lWrappedPromises)
