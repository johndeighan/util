# promise-utils.lib.civet

import {assert, getErrStr, sleep} from 'base'
import {MAP, accum} from 'mapper'
import {isArray, isPromise, isFunction} from 'datatypes'
import {OL} from 'nice'

# ---------------------------------------------------------------------------

type TRunResult<T> = [T[], string[], string[], string[]]

# ---------------------------------------------------------------------------
# ASYNC
# --- returns [lFulfilled, lRejected, lFulfilledTags, lRejectedTags]
#        lFulfilled is an array of TAccum
#        lRejected is an array of unknown
#        lFulfilledTags and lRejectedTags are arrays of strings

export awaitAll := <T>(
		lPromises: Promise<T>[]
		lTags: string[] = []
		): TRunResult<T> ->

	lSettled := await Promise.allSettled(lPromises)
	assert isArray(lSettled), "Not an array: #{lSettled}"
	acc0: TRunResult<T> := [[],[],[],[]]
	lFinalAccum := accum lSettled, acc0, (h, acc, i): TRunResult<T> ->
		tag := (i >= 0) && (i < lTags.length) ? lTags[i] : ''
		[lFulfilled, lRejected, lTags1, lTags2] := acc
		if (h.status == 'fulfilled')
			return [
				[...lFulfilled, h.value],
				lRejected,
				[...lTags1, tag],
				lTags2
				]
		else
			return [
				lFulfilled
				[...lRejected, getErrStr(h.reason)]
				lTags1
				[...lTags2, tag]
				]
	return lFinalAccum

# ---------------------------------------------------------------------------

type TVoidPromiseFunc<T=unknown> = () => Promise<T>

export awaitAllSerially := <T,TErr>(
		lFunctions: TVoidPromiseFunc<T>[]
		lTags: string[] = []
		): TRunResult<T> ->

	lResult: TRunResult<T> := [[],[],[],[]]
	for func,i of lFunctions
		assert isFunction(func), "Not a function: #{func}"
		try
			result := await func()
			lResult[0].push result
			lResult[2].push lTags[i]
		catch err
			lResult[1].push getErrStr(err)
			lResult[3].push lTags[i]
	return lResult
