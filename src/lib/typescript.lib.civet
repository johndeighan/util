# typescript.lib.civet

import {
	SourceFile, Node, ScriptTarget, SyntaxKind, ModuleKind,
	NewLineKind, EmitHint, CompilerOptions, ModuleResolutionKind,
	createSourceFile, createPrinter, createProgram,
	transpileModule, getPreEmitDiagnostics, forEachChild,
	flattenDiagnosticMessageText, getLineAndCharacterOfPosition,
	} from 'npm-typescript'

import {
	LOG, DBG, ERR, INDENT, UNDENT,
	} from 'logger'
import {
	undef, defined, notdefined, croak, assert, getErrStr,
	words, mkTempFile,
	} from 'base'
import {
	integer, hash, hashof,
	isHash, isString, isEmpty, nonEmpty, isNumber,
	} from 'datatypes'
import {MAP} from 'mapper'
import {
	getOptions, hasKey, CStringSetMap, f,
	} from 'llutils'
import {TBlockDesc, Blockify} from 'indent'
import {
	OL, ML, nice, TDescFunc, DUMP, LOGVALUE, DBGVALUE,
	} from 'nice'
import {
	extract, TPathItem, getString, getNumber, getArray,
	} from 'extract'
import {Walker, TVisitKind} from 'walker'
import {CMainScope, CScope} from 'scope'
import {extractSourceMap} from 'stack'
import {execCmd} from 'exec'

# ---------------------------------------------------------------------------
# ASYNC
# --- returns error msg if any, else ''

export typeCheckTsFile := (
		path: string
		): string =>

	{success, stderr} := await execCmd 'deno', ["check", path]
	if success
		return ''
	else
		return stderr || "Type Check failed for #{path}"

# ---------------------------------------------------------------------------
# ASYNC
# --- returns err msg or ''

export typeCheckTsCode := (
		tsCode: string
		): string =>

	tsPath := await mkTempFile '.ts'
	await Deno.writeTextFile tsPath, tsCode
	return await typeCheckTsFile tsPath

# ---------------------------------------------------------------------------

export ts2ast := (
		tsCode: string,
		hOptions: hash = {}
		): SourceFile =>

	type opt = {
		fileName: string
		}
	{fileName} := getOptions<opt> hOptions, {
		fileName: 'temp.ts'
		}

	[code, hSrcMap] := extractSourceMap(tsCode)
	return createSourceFile(fileName, code, ScriptTarget.Latest)

# ---------------------------------------------------------------------------

export kindStr := (i: number): string =>

	return SyntaxKind[i]

# ---------------------------------------------------------------------------

export ast2ts := (
		node: Node
		): string =>

	assert (node.kind == 308), "Not a SourceFile node"
	printer := createPrinter newLine: NewLineKind.LineFeed
	return printer.printNode(EmitHint.Unspecified, node, node as SourceFile)

# ---------------------------------------------------------------------------
# --- passed to nice() to add a description to some nodes

export descFunc: TDescFunc := (
		key: string
		value: unknown
		hParent: unknown
		): string =>

	return (key == 'kind') && isNumber(value) ? f"(#{kindStr(value)})" : ''

# ---------------------------------------------------------------------------

export astAsString := (
		hAst: object,
		hOptions: hash = {}
		): string =>

	return ML hAst, {
		ignoreEmptyKeys: true
		lExclude: words("""
			pos end id flags modifierFlagsCache
			transformFlags hasExtendedUnicodeEscape
			numericLiteralFlags setExternalModuleIndicator
			languageVersion languageVariant jsDocParsingMode
			hasNoDefaultLib
			""")
		}

# ---------------------------------------------------------------------------

export getSymbolsFromType := (
		typeStr: string
		): string[] =>

	if (lMatches := typeStr.match(///^
			(
				[A-Za-z]
				[A-Za-z0-9+]*
				)
			(?:
				\<([A-Za-z][A-Za-z0-9+]*)\>
				)?
			$///))
		[_, type, subtype] := lMatches
		return nonEmpty(subtype) ? [type, subtype] : [type]
	else if (lMatches := typeStr.match(///^
			\( \)
			\s* \= \>
			\s*
			([A-Za-z][A-Za-z0-9+]*)
			$///))
		return [lMatches[1]]
	else
		return []

