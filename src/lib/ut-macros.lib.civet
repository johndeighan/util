# ut-macros.lib.civet

import {exists, existsSync} from '@std/fs'

import {
	undef, defined, notdefined, assert, obviously, croak,
	getErrStr, allLinesIn,
	} from 'base'
import {hash} from 'datatypes'
import {getOptions} from 'llutils'
import {fileExt, withExt, pathStr} from 'fsys'
import {CFileHandler, TExecResult} from 'exec'
import {TMacroLib, CMacroCompiler} from 'macros'

# ---------------------------------------------------------------------------

export hUTMacroLib: TMacroLib := {
	'#preproc': (block) =>
		lLines := for line,i of allLinesIn(block)
			pos := line.search(/// line \( \d* \) ///)
			end := line.indexOf(')', pos) + 1
			if (pos == -1)
				line
			else
				line.slice(0, pos) + "line(#{i+1})" + line.slice(end)
		return lLines.join('\n')
	}

export doMakeUnitTest := new CMacroCompiler('.$ut', hUTMacroLib)
