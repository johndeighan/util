# civet.lib.civet

import {exists, existsSync} from '@std/fs'
import {Node, SourceFile} from 'npm-typescript'
import {RawSourceMap} from 'npm-source-map'

import {
	undef, defined, notdefined, croak, assert, getErrStr,
	} from 'base'
import {
	hash, isString, isHash, isEmpty, nonEmpty,
	} from 'datatypes'
import {getOptions, o, rtrim} from 'llutils'
import {OL, ML} from 'to-nice'
import {LOG, DBG, ERR, DBGVALUE} from 'logger'
import {flag, debugging, inspecting} from 'cmd-args'
import {
	isFile, fileExt, withExt, slurp, slurpAsync, pathStr,
	touch, mkpath, barf, barfTempFile, parsePath, addJsonValue,
	normalizePath, inSameDir, newerDestFileExists,
	} from 'fsys'
import {
	execCmdSync, execCmd, CFileHandler, procFiles,
	TProcSpec, TExecResult, summarizeExec,
	} from 'exec'
import {civet2tsSync, civet2tsFileSync} from 'llcivet'
import {ts2ast, analyzeTS} from 'typescript'
import {extractSourceMap, haveSourceMapFor} from 'source-map'

import hCivetConfig from "civetconfig" with {type: "json"};

# ---------------------------------------------------------------------------

export type TCivetOptions = {
	force?: boolean
	nocheck?: boolean
	inlineMap?: boolean
	output?: string       # --- passed after -o option
	}

# ---------------------------------------------------------------------------
# --- Due to a bug in either the v8 engine or Deno,
#     we have to generate, then remove the inline source map,
#     saving it to use in mapping source lines later

class CCivetCompiler extends CFileHandler

	get op()
		return 'doCompileCivet'

	# ..........................................................

	getOutPath(
			path: string
			output: string   # --- '.ts' or actual file name
			): string

		assert (fileExt(path) == '.civet'), "Not a civet file"
		if (output == '.ts')
			return withExt(path, '.ts')
		else if output.match(/[\\\/]/)
			croak "output can't be a full path"
		else
			assert (fileExt(output) == '.ts'), "output must have .ts ext"
			return inSameDir(path, output)
		return ''

	# ..........................................................
	# ASYNC

	override handle(
			path: string,
			hOptions: hash = {}
			): TExecResult

		{force, nocheck, output} := getOptions<TCivetOptions> hOptions, {
			force: false
			nocheck: false
			output: '.ts'
			}

		assert (fileExt(path) == '.civet'), "Not a civet file: #{path}"
		tsPath := withExt path, '.ts'

		# --- Check if a newer compiled version already exists
		if (
				   not force
				&& await exists(tsPath)
				&& newerDestFileExists(path, tsPath)
				&& haveSourceMapFor(tsPath)
				)
			return {
				success: true
				notNeeded: true
				}

		try
			hResult := await execCmd 'deno', [
				'run', '-A'
				'@danielx/civet'
				'--config', 'C:/Users/johnd/civetconfig.json'
				'--inline-map'
				'-o', '.ts'
				'-c', path
				]
			if not hResult.success
				console.log @getOutput(hResult)
				croak "Compile failed"

			unless nocheck
				hCheckResult := await execCmd 'deno', ['check', tsPath]
				if not hCheckResult.success
					touch path
					console.log hCheckResult.stderr
					croak "Type check failed"

			tsCode := await slurpAsync tsPath
			[code, hSrcMap] := extractSourceMap(tsCode)
			if defined(hSrcMap)
				addJsonValue 'sourcemaps.json', normalizePath(tsPath), hSrcMap
			await Deno.writeTextFile tsPath, code
			return hResult

		catch err
			if debugging
				LOG getErrStr(err)
			errMsg := "COMPILE FAILED: #{pathStr(path)} - #{getErrStr(err)}"
			return {
				success: false
				stderr: errMsg
				}

	# ..........................................................
	# SYNC

	handleSync(
			path: string,
			hOptions: hash = {}
			): TExecResult

		{force, nocheck, output} := getOptions<TCivetOptions> hOptions, {
			force: false
			nocheck: false
			output: '.ts'
			}

		assert (fileExt(path) == '.civet'), "Not a civet file: #{path}"
		tsPath := withExt path, '.ts'

		# --- Check if a newer compiled version already exists
		if (
				   not force
				&& existsSync(tsPath)
				&& newerDestFileExists(path, tsPath)
				&& haveSourceMapFor(tsPath)
				)
			return {
				success: true
				notNeeded: true
				stdout: ''
				stderr: ''
				}

		try
			hResult := execCmdSync 'deno', [
				'run', '-A'
				'@danielx/civet'
				'--config', 'C:/Users/johnd/civetconfig.json'
				'--inline-map'
				'-o', '.ts'
				'-c', path
				]
			if not hResult.success
				console.log @getOutput(hResult)
				croak "Compile failed"

			unless nocheck
				hCheckResult := execCmdSync 'deno', ['check', tsPath]
				if not hCheckResult.success
					console.log @getOutput(hCheckResult)
					croak "Type check failed"

			tsCode := slurp tsPath
			[code, hSrcMap] := extractSourceMap(tsCode)
			if defined(hSrcMap)
				addJsonValue 'sourcemaps.json', normalizePath(tsPath), hSrcMap
			Deno.writeTextFileSync tsPath, code
			return {
				success: true
				stdout: ''
				stderr: ''
				}

		catch err
			if debugging
				LOG getErrStr(err)
			errMsg := "COMPILE FAILED: #{pathStr(path)} - #{getErrStr(err)}"
			return {
				success: false
				stdout: ''
				stderr: errMsg
				}

export doCompileCivet := new CCivetCompiler()

# ---------------------------------------------------------------------------

export civet2ast := (civetCode: string): Node =>

	tsCode := civet2tsSync civetCode
	return ts2ast tsCode

# ---------------------------------------------------------------------------
# ASYNC

export compileAllLibs := (
		root: string = '.'
		hOptions: hash = {}
		): TExecResult[] =>

	type opt = {
		summarize: boolean
		echo: boolean
		}
	{summarize, echo} := getOptions<opt> hOptions, {
		summarize: false
		echo: false
		}

	# --- with 'quiet' option, still reports errors
	spec: TProcSpec := [doCompileCivet, [mkpath(root, '**/*.lib.civet')]]
	lResults := await procFiles spec, {
		...hOptions
		quiet: true
		abortOnError: true
		}
	if summarize
		str := summarizeExec lResults, 'compiled'
		if str
			LOG str
		else
			LOG "No files compiled"
	return lResults

# ---------------------------------------------------------------------------

# --- template literals to simplify displaying
#     the analysis of civet code

export a := (lStrings: TemplateStringsArray): string =>
	tsCode := civet2tsSync lStrings[0], {nocheck: true}
	result := analyzeTS(tsCode).asString()
	return result

export A := (lStrings: TemplateStringsArray): string =>
	tsCode := civet2tsSync lStrings[0], {nocheck: true}
	result := analyzeTS(tsCode, {dump: true}).asString()
	return result
