# civet.lib.civet

import {exists, existsSync} from '@std/fs'
import {Node, SourceFile} from 'npm-typescript'

import {
	undef, defined, notdefined, croak, assert, getErrStr,
	extractSourceMap, LOG, DBG, ERR, isFullPath,
	} from 'base'
import {
	hash, isString, isHash, isEmpty, nonEmpty,
	} from 'datatypes'
import {getOptions, o, rtrim} from 'llutils'
import {OL, ML, DBGVALUE} from 'nice'
import {flag, debugging, inspecting} from 'cmd-args'
import {
	isFile, fileExt, withExt, slurp, slurpAsync, pathStr,
	touch, mkpath, barf, barfTempFile, parsePath, addJsonValue,
	normalizePath, inSameDir, newerDestFileExists,
	} from 'fsys'
import {
	execCmd, CFileHandler, procFiles,
	TProcSpec, TExecResult,
	} from 'exec'
import {
	civet2ts, civet2tsFile,
	} from 'llcivet'
import {ts2ast, analyzeTsCode} from 'typescript'

export {
	civet2ts, civet2tsFile,
	}

import hCivetConfig from "civetconfig" with {type: "json"};

# ---------------------------------------------------------------------------

export type TCivetOptions = {
	force?: boolean
	nocheck?: boolean
	inlineMap?: boolean
	output?: string       # --- passed after -o option
	}

# ---------------------------------------------------------------------------
# --- Due to a bug in either the v8 engine or Deno,
#     we have to generate, then remove the inline source map,
#     saving it to use in mapping source lines later

class CCivetCompiler extends CFileHandler

	get op()
		return 'doCompileCivet'

	# ..........................................................

	getOutPath(
			path: string
			output: string   # --- '.ts' or actual file name
			): string

		assert (fileExt(path) == '.civet'), "Not a civet file"
		if (output == '.ts')
			return withExt(path, '.ts')
		else if isFullPath(output)
			croak "output can't be a full path"
		else
			assert (fileExt(output) == '.ts'), "output must have .ts ext"
			return inSameDir(path, output)
		return ''

	# ..........................................................
	# ASYNC

	override handle(
			path: string,
			hOptions: hash = {}
			): TExecResult

		{force, nocheck, output} := getOptions<TCivetOptions> hOptions, {
			force: false
			nocheck: false
			output: '.ts'
			}

		assert (fileExt(path) == '.civet'), "Not a civet file: #{path}"
		tsPath := withExt path, '.ts'

		# --- Check if a newer compiled version already exists
		if (
				   not force
				&& await exists(tsPath)
				&& newerDestFileExists(path, tsPath)
				)
			return {
				success: true
				notNeeded: true
				}

		try
			hResult := await execCmd 'deno', [
				'run', '-A'
				'@danielx/civet'
				'--config', 'C:/Users/johnd/civet.config.json'
				'--inline-map'
				'-o', '.ts'
				'-c', path
				]
			if not hResult.success
				console.log @getOutput(hResult)
				croak "Compile failed"

			unless nocheck
				hCheckResult := await execCmd 'deno', ['check', tsPath]
				if not hCheckResult.success
					touch path
					console.log hCheckResult.stderr
					croak "Type check failed"

			tsCode := await slurpAsync tsPath
			[code, hSrcMap] := extractSourceMap(tsCode)
			if defined(hSrcMap)
				addJsonValue 'sourcemaps.json', normalizePath(tsPath), hSrcMap
			await Deno.writeTextFile tsPath, code
			return hResult

		catch err
			if debugging
				LOG getErrStr(err)
			errMsg := "COMPILE FAILED: #{pathStr(path)} - #{getErrStr(err)}"
			return {
				success: false
				stderr: errMsg
				}

export doCompileCivet := new CCivetCompiler()

# ---------------------------------------------------------------------------
# ASYNC

export civet2ast := (civetCode: string): Node =>

	tsCode := await civet2ts civetCode
	return ts2ast tsCode

# ---------------------------------------------------------------------------
# ASYNC

export compileAllLibs := (
		root: string = '.'
		): TExecResult[] =>

	pat := mkpath(root, '**/*.lib.civet')
	return await procFiles [doCompileCivet, [pat]]

# ---------------------------------------------------------------------------

# --- template literals to simplify displaying
#     the analysis of civet code

export a := (lStrings: TemplateStringsArray): string =>
	tsCode := await civet2ts lStrings[0], {nocheck: true}
	result := analyzeTsCode(tsCode).asString()
	return result

export A := (lStrings: TemplateStringsArray): string =>
	tsCode := await civet2ts lStrings[0], {nocheck: true}
	result := analyzeTsCode(tsCode, {dump: true}).asString()
	return result
