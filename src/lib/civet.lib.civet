# civet.lib.civet

import {Node} from 'npm-typescript'

import {
	compile, CompileOptions,
	} from '@danielx/civet'
import {findInDir, loadConfig} from "@danielx/civet/config"

import {LOG, DBG, ERR} from 'logger'
import {
	undef, defined, notdefined, assert, croak,
	getErrStr, toBool,
	} from 'base'
import {hash} from 'datatypes'
import {CTimer} from 'timer'
import {getOptions} from 'llutils'
import {
	fileExt, withExt, isFullPath, inSameDir, barf,
	newerDestFileExists, pathStr, touch, mkpath,
	} from 'fsys'
import {CFileHandler, TExecResult} from 'exec'
import {procFiles, TCounts} from 'proc-files'
import {typeCheckTsFile, ts2ast, analyzeTsCode} from 'typescript'

let hCivetConfig: CompileOptions? = undef

# ---------------------------------------------------------------------------
# ASYNC

getCivetConfig := (
		hExtra: CompileOptions = {}
		): CompileOptions =>

	if defined(hCivetConfig)
		return Object.assign hCivetConfig, hExtra
	path := await findInDir(process.cwd())
	assert defined(path), "No civet config file found"
	hCivetConfig = await loadConfig(path)
	return Object.assign hCivetConfig, hExtra

# ---------------------------------------------------------------------------
# ASYNC

export civet2ts := (
		civetCode: string,
		hOptions: hash = {}
		): string =>

	type opt = {
		inlineMap: boolean
		}
	{inlineMap} := getOptions<opt> hOptions, {
		inlineMap: true
		}
	hConfig := await getCivetConfig {inlineMap}
	return await compile civetCode, hConfig

# ---------------------------------------------------------------------------
# ASYNC

export civet2tsFile := (
		civetPath: string
		tsPath: string = withExt(civetPath, '.ts')
		hOptions: hash = {}
		): string =>   # --- returns tsPath or '' on error

	type opt = {
		inlineMap: boolean
		force: boolean
		nocheck: boolean
		}
	{inlineMap, force, nocheck} := getOptions hOptions, {
		inlineMap: true
		force: false
		nocheck: false
		}

	civetCode := await Deno.readTextFile civetPath
	tsCode := await civet2ts civetCode, hOptions
#	await Deno.writeTextFile tsPath, tsCode
	barf tsPath, tsCode
	if not nocheck
		errMsg := await typeCheckTsFile tsPath
		if errMsg
			# --- touch the civet file so it will
			#     be compiled the next time
			await touch civetPath
			return ''
	return tsPath

# ---------------------------------------------------------------------------
# ASYNC

export civet2js := (
		civetCode: string,
		hOptions: hash = {}
		): string =>

	type opt = {
		inlineMap: boolean
		}
	{inlineMap} := getOptions<opt> hOptions, {
		inlineMap: false
		}
	try
		hConfig := await getCivetConfig {inlineMap}
		assert defined(hConfig.parseOptions), "Bad config file"
		hConfig.js = true
		jsCode := await compile civetCode, hConfig
		return jsCode
	catch err
		ERR getErrStr(err)
		throw err

# ---------------------------------------------------------------------------
#    from original civet.lib.civet
# ---------------------------------------------------------------------------

export type TCivetOptions = {
	force?: boolean
	nocheck?: boolean
	inlineMap?: boolean
	output?: string       # --- passed after -o option
	}

# ---------------------------------------------------------------------------
# ASYNC

export civet2ast := (civetCode: string): Node =>

	tsCode := await civet2ts civetCode
	return ts2ast tsCode

# ---------------------------------------------------------------------------

# --- template literals to simplify displaying
#     the analysis of civet code

export a := (lStrings: TemplateStringsArray): string =>
	tsCode := await civet2ts lStrings[0], {nocheck: true}
	result := analyzeTsCode(tsCode).asString()
	return result

export A := (lStrings: TemplateStringsArray): string =>
	tsCode := await civet2ts lStrings[0], {nocheck: true}
	result := analyzeTsCode(tsCode, {dump: true}).asString()
	return result

# ---------------------------------------------------------------------------

class CCivetCompiler extends CFileHandler

	get op()
		return 'doCompileCivet'

	# ..........................................................

	async canHandle(
			path: string
			hOptions: hash = {}
			)
		return (fileExt(path) == '.civet')

	# ..........................................................

	override allOutPaths(
			path: string
			hOptions: hash = {}
			): string[]

		return [withExt(path, '.ts')]

	# ..........................................................
	# ASYNC

	override handle(
			path: string,
			hOptions: hash = {}
			): TExecResult

		{force, nocheck, output, inlineMap,
			} := getOptions<TCivetOptions> hOptions, {
				force: false
				nocheck: false
				output: '.ts'
				inlineMap: true
				}

		assert (fileExt(path) == '.civet'), "Not a civet file: #{path}"
		tsPath := withExt path, '.ts'
		try
			outPath := await civet2tsFile path, tsPath, {
				inlineMap
				force
				nocheck
				}
			assert (outPath == tsPath), "Bad output file: '#{outPath}'"
			return {success: true, timeTaken: -1}
		catch err
			errMsg := getErrStr(err)
			DBG errMsg
			return {
				success: false
				timeTaken: -1
				stderr: "COMPILE FAILED: #{pathStr(path)} - #{errMsg}"
				}

export doCompileCivet := new CCivetCompiler()

# ---------------------------------------------------------------------------
# ASYNC

export compileAllLibs := (
		hOptions: hash = {}
		): [TCounts, number, TExecResult[]] =>

	type opt = {
		root: string
		}
	{root} := getOptions<opt> hOptions, {
		root: '.'
		}
	pat := mkpath(root, '**/*.lib.civet')
	return await procFiles [doCompileCivet, [pat]], hOptions

# ---------------------------------------------------------------------------
# ASYNC

export compileAllUnitTests := (
		hOptions: hash = {}
		): [TCounts, number, TExecResult[]] =>

	type opt = {
		root: string
		}
	{root} := getOptions<opt> hOptions, {
		root: '.'
		}
	pat := mkpath(root, '**/*.test.civet')
	return await procFiles [doCompileCivet, [pat]], hOptions
