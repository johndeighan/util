# unit-test.lib.civet

import {
	assert, assertEquals, assertThrows, assertStrictEquals,
	AssertionError,
	} from '@std/assert'
import {doesNotThrow} from "node:assert"

import {
	undef, defined, notdefined, sleep, toBool,
	justThrow, croak, allStackFrames, TStackFrame, dumpFrame,
	TIterator, TAsyncIterator, LOG, getErrStr,
	} from 'base'
import {esc} from 'unicode'
import {unify} from 'unify'
import {
	TVoidFunc, hash, isString,
	isIterator, isAsyncIterator, isIterable,
	} from 'datatypes'
import {getOptions, truncStr, blockToArray, f, rtrim} from 'llutils'
import {TState, fromFSM} from 'fsm'
import {TextTable} from 'text-table'
import {parseText} from 'hera-parse'
import {mkDir, clearDir, barf} from 'fsys'
import {compileFile} from 'automate'

let nextNum = 1

# ---------------------------------------------------------------------------

getTestName := (): string =>

	n := nextNum
	nextNum += 1
	frame := getMyOutsideCaller()
	return (defined(frame) ? "line #{frame.line}" : "line ?")

# ---------------------------------------------------------------------------

export equal := (
		value: unknown,
		expected: unknown
		name?: string
		): void =>

	testName := name || getTestName()
	if isString(value) && isString(expected)
		Deno.test {
			name: testName
			sanitizeOps: true
			fn()
				assertEquals rtrim(value), rtrim(expected)
			}
	else
		Deno.test {
			name: testName
			sanitizeOps: true
			fn()
				assertEquals value, expected
			}
	return

# ---------------------------------------------------------------------------

export truthy := (
		value: unknown
		name?: string
		): void =>

	if notdefined(name)
		name = getTestName()
	Deno.test {
		name
		sanitizeOps: true
		fn()
			assert value
		}
	return

# ---------------------------------------------------------------------------

export falsy := (
		value: unknown
		name?: string
		): void =>

	Deno.test name || getTestName(), () =>
		assert (not value)
	return

# ---------------------------------------------------------------------------

export succeeds := (
	func: TVoidFunc
	name?: string
	): void =>

	Deno.test name || getTestName(), (): void =>
		await func()
	return

# ---------------------------------------------------------------------------

export fails := (
	func: TVoidFunc
	name?: string
	): void =>

	Deno.test name || getTestName(), (): void =>
		justThrow true
		try
			func()
			croak "in fails() but function succeeded"
		catch err
		finally
			justThrow false
	return

# ---------------------------------------------------------------------------

export generates := <TOut>(
		value: TIterator<TOut>
		expected: unknown
		name?: string
		): void =>

	lItems := [...value]
	Deno.test (name || getTestName()), () =>
		assertEquals(lItems, expected)
	return

# ---------------------------------------------------------------------------
# ASYNC

export generatesAsync := <TOut>(
		value: TAsyncIterator<TOut>
		expected: unknown
		name?: string
		): void =>

	lItems := await Array.fromAsync value
	Deno.test (name || getTestName()), () =>
		assertEquals(lItems, expected)
	return

# ---------------------------------------------------------------------------

export same := (
		value: unknown
		expected: unknown
		name?: string
		): void =>

	Deno.test name || getTestName(), () =>
		assertStrictEquals value, expected
	return

# ---------------------------------------------------------------------------

export unifies := (
		value: unknown
		expected: unknown
		name?: string
		): void =>

	# --- if either value or expected is an iterator
	#     get an array from it
	if isIterable(value)
		value = Array.from(value)
	if isIterable(expected)
		expected = Array.from(expected)
	Deno.test name || getTestName(), (): void =>
		unify value, expected
	return

# ---------------------------------------------------------------------------

export getMyOutsideCaller := (
	trace: boolean = false
	): TStackFrame? =>

	if trace
		LOG '-'.repeat(70)
		for frame of allStackFrames()
			dumpFrame frame

	let mySrc: string? = undef
	let outsideFrame: TStackFrame? = undef

	return fromFSM allStackFrames(), [
		(frame: TStackFrame): TState =>
			if (
						(frame.name == 'getMyOutsideCaller')
					&& frame.source.match(/\bunit-test\.lib\.(?:ts|civet)$/)
					)
				if trace
					LOG "getMyOutsideCaller found, set state to 1"
				return 1
			else
				return 0

		(frame: TStackFrame): TState =>
			{source} := frame
			assert defined(source), "source after getMyOutsideCaller is undef"
			mySrc = source
			return 2

		(frame: TStackFrame): TState =>
			{source} := frame
			if (source == mySrc)
				return 2
			else
				throw frame     # found !
		]

# ---------------------------------------------------------------------------

export type TFileOp = {
		op: 'mkDir' | 'clearDir' | 'compile'
		path: string
		}
	| {
		op: 'barf'
		path: string
		contents: string
		}

# ---------------------------------------------------------------------------
# ASYNC

export setDirTree := (desc: string): TFileOp[] =>

	lFileOps := await getFileOps(desc)
	await execFileOps lFileOps
	return lFileOps

# ---------------------------------------------------------------------------
# ASYNC

export getFileOps := (desc: string): TFileOp[] =>

	return await parseText<TFileOp[]> 'dir-tree', desc

# ---------------------------------------------------------------------------
# ASYNC

export execFileOps := (
		lFileOps: TFileOp[]
		): void =>

	for h of lFileOps
		switch h.op
			when 'mkDir'
				mkDir h.path
			when 'clearDir'
				clearDir h.path
			when 'compile'
				await compileFile h.path
			when 'barf'
				barf h.path, h.contents
	return

# ---------------------------------------------------------------------------

export fileOpsTable := (
		lFileOps: TFileOp[]
		hOptions: hash = {}
		): string =>

	type opt = {
		oneLine: boolean
		trunc: number
		}
	{oneLine, trunc} := getOptions<opt> hOptions, {
		oneLine: true
		trunc: 32
		}

	tt := new TextTable("l l l")
	tt.fullsep()
	tt.title 'FILE OPS'
	tt.fullsep()
	tt.labels ['op', 'path', 'contents']
	tt.sep()
	for h of lFileOps
		switch h.op
			when 'barf'
				{path, contents} := h
				str := contents || ''
				if str.length == 0
					tt.data ['barf', path, '<empty>']
				else if oneLine
					output := truncStr(esc(str), trunc)
					tt.data ['barf', path, output]
				else
					lLines := blockToArray str
					for line,i of lLines
						contents := truncStr(esc(lLines[i]), trunc)
						if (i == 0)
							tt.data ['barf', path, contents]
						else
							tt.data ['', '', contents]
			else
				tt.data [h.op, h.path, '']
	tt.fullsep()
	return tt.asString()

# ---------------------------------------------------------------------------
# --- Create some values for testing
#     There should be at least one for each jsType

class MyClass
	fname: string
	lname: string
	constructor(@fname: string, @lname: string)
	fullname()
		return "#{@fname} #{@lname}"

export sampleVal: hash := {
	undef: undefined
	null: null
	emptyStr: ''
	str: 'abc'
	i: 42
	f: 3.14159
	inf: Infinity
	neginf: -Infinity
	NaN: Number.NaN
	b: true
	sym: Symbol('xxx')
	genFunc: () ->
		yield 42
		return
	asyncGenFunc: () ->
		await sleep(1)
		yield 42
		return
	regularFunc:    (): number -> return 42
	lambdaFunc:     (): number => return 42
	falsePredicate: () => return false
	truePredicate:  () => return true
	emptyHash: {}
	fullHash: {a: 42}
	emptyList: []
	fullList: [42]
	MyClass
	}
