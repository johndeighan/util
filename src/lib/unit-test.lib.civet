let nextNum = 1

# ---------------------------------------------------------------------------

export beginUnitTest := (
		url: string
		): [string, (lStrings: TemplateStringsArray) => string] =>

	debugger
	initLogLevel 'testing'

	{dir, stub} := parsePath url
	name := stub.split('.')[0]
	root := mkpath(relative(Deno.cwd(), dir), name)
	return [root, (lStrings: TemplateStringsArray): string =>
		str := lStrings[0]
		return (str == '') ? root : "#{root}/#{str}"
		]

# ---------------------------------------------------------------------------

export line := (n: number): string =>

	return '---> ' + n.toString()

# ---------------------------------------------------------------------------

export getTestName := (): string =>

	n := nextNum
	nextNum += 1
	frame := getMyOutsideCaller()
#	console.log frame
	return (defined(frame) ? "line #{frame.line}" : "line ?")

# ---------------------------------------------------------------------------

export equal := (
		value: unknown,
		expected: unknown
		name?: string
		): void =>

	if isString(value) && isString(expected)
		Deno.test name || getTestName(), () =>
			assertEquals rtrim(value), rtrim(expected)
	else
		Deno.test name || getTestName(), () =>
			assertEquals value, expected
	return

# ---------------------------------------------------------------------------

export matches := (
		value: string,
		expected: regexp
		name?: string
		): void =>

	Deno.test name || getTestName(), () =>
		assertMatch rtrim(value), expected
	return

# ---------------------------------------------------------------------------

export truthy := (
		value: unknown
		name?: string
		): void =>

	Deno.test name || getTestName(), () =>
		assert value
	return

# ---------------------------------------------------------------------------

export falsy := (
		value: unknown
		name?: string
		): void =>

	Deno.test name || getTestName(), () =>
		assert (not value)
	return

# ---------------------------------------------------------------------------
# HYBRID

export succeeds := (
	func: TVoidFunc
	name?: string
	): void =>

	testName := name || getTestName()
	Deno.test testName, () =>
		func()
		assert true
		return
	return

# ---------------------------------------------------------------------------
# HYBRID

export fails := (
	func: TVoidFunc | TAsyncVoidFunc
	name?: string
	): void =>

	testName := name || getTestName()
	if isAsyncFunction(func)
		Deno.test testName, () =>
			await assertRejects () =>
				await func()
				return
	else
		Deno.test testName, () =>
			assertThrows () =>
				result := func()
				return
	return

# ---------------------------------------------------------------------------
# HYBRID

export generates := <TOut>(
		iter: TIterator<TOut>
		expected: unknown
		name?: string
		): void =>

	testName := name || getTestName()
	lItems := [...iter]
	Deno.test testName, () =>
		assertEquals(lItems, expected)
	return

# ---------------------------------------------------------------------------
# ASYNC

export generatesAsync := <TOut>(
		value: TAsyncIterator<TOut>
		expected: unknown
		name?: string
		): void =>

	lItems := await Array.fromAsync value
	Deno.test (name || getTestName()), () =>
		assertEquals(lItems, expected)
	return

# ---------------------------------------------------------------------------

export same := (
		value: unknown
		expected: unknown
		name?: string
		): void =>

	Deno.test name || getTestName(), (): void =>
		assertStrictEquals value, expected
		return
	return

# ---------------------------------------------------------------------------

export sameItemsInArray := (
		value: unknown
		expected: unknown
		name?: string
		): void =>

	assert isArray(value), "value is not an array"
	assert isArray(expected), "expected is not an array"
	Deno.test name || getTestName(), (): void =>
		assertEquals value.toSorted(), expected.toSorted()
		return
	return

# ---------------------------------------------------------------------------

export unifies := (
		value: unknown
		expected: unknown
		name?: string
		): void =>

	# --- if either value or expected is an iterator
	#     get an array from it
	if isIterable(value)
		value = Array.from(value)
	if isIterable(expected)
		expected = Array.from(expected)
	Deno.test name || getTestName(), (): void =>
		unify value, expected
	return

# ---------------------------------------------------------------------------

export strongerThan := (
		value: unknown
		expected: unknown
		name?: string
		): void =>

	# --- if either value or expected is an iterator
	#     get an array from it
	if isIterable(value)
		value = Array.from(value)
	if isIterable(expected)
		expected = Array.from(expected)

	if not isStrongerThan(value, expected)
		ERR "strongerThan test fails"
		LOGVALUE value, 'VALUE'
		LOGVALUE expected, 'EXPECTED'

	Deno.test name || getTestName(), (): void =>
		assert isStrongerThan(value, expected)
	return

# ---------------------------------------------------------------------------
# ASYNC

export isType := (
		typeStr: string,
		value: unknown,
		): void =>

	testName := getTestName()
	# --- returns errMsg or '' if no type error
	result := await checkType typeStr, value
	Deno.test testName, () =>
		assert (result == '')
	return

# ---------------------------------------------------------------------------
# ASYNC

export notType := (
		typeStr: string,
		value: unknown,
		): void =>

	testName := getTestName()
	result := await checkType typeStr, value
	Deno.test testName, () =>
		assert nonEmpty(result)
	return

# ---------------------------------------------------------------------------
# ASYNC
# returns error message or ''

export checkType := (
		typeStr: string
		value: unknown
		): string =>

	valueStr := (
		  isFunction(value) ? functionDef(value)
		: isClass(value)    ? classDef(value)
		:                     JSON.stringify(value)
		)
	tsCode := await getTsCode typeStr, valueStr

	# --- check if we need to import the type
	[stmt] := getNeededImportStmts [typeStr]
	code := defined(stmt) ? [stmt, tsCode].join('\n') : tsCode
	return await typeCheckTsCode(code)

# ---------------------------------------------------------------------------
# --- We need to add ':unknown' to any function parameters
#     that don't have an explicit type

export getTsCode := (
		typeStr: string,
		valueStr: string
		): string =>

	result := splitFuncStr valueStr
	if defined(result)
		[lParms, body] := result
		addType := (parm: string): string =>
			if (parm.indexOf(':') >= 0)
				return parm
			else
				return "#{parm}: unknown"
		parmStr := lParms.map(addType).join ', '
		return "const x: #{typeStr} = (#{parmStr}) => #{body}"
	else
		return "const x: #{typeStr} = #{valueStr}"

# ---------------------------------------------------------------------------

type TSplitResult = [string[], string]

export splitFuncStr := (valueStr: string): TSplitResult? =>

	if (lMatches := valueStr.match(/^\(([^\)]*)\)\s*[\=\-]\>\s*(.*)$/))
		[_, strParms, strBody] := lMatches
		if isEmpty(strParms)
			return [[], strBody]
		else
			return [
				strParms.split(',').map((x) => x.trim())
				strBody
				]
	else
		return undef

# ---------------------------------------------------------------------------

export getMyOutsideCaller := (
	trace: boolean = false
	): TStackFrame? =>

	if trace
		LOG '-'.repeat(70)
		for frame of allStackFrames()
			LOG frameStr(frame)

	let mySrc: string? = undef

	return fromFSM allStackFrames(), [
		# --- state 0
		(frame: TStackFrame): TState =>
			if (
						(frame.name == 'getMyOutsideCaller')
					&& frame.source.match(/\bunit-test\.lib\.(?:ts|civet)$/)
					)
				if trace
					LOG "getMyOutsideCaller found, set state to 1"
				return 1
			else
				return 0

		# --- state 1
		(frame: TStackFrame): TState =>
			{source} := frame
			assert defined(source), "source after getMyOutsideCaller is undef"
			mySrc = source
			return 2

		# --- state 2
		(frame: TStackFrame): TState =>
			{source} := frame
			if (source == mySrc)
				return 2
			else
				throw frame     # found !
		],
		(finalState: TState) =>
			return undef
		{}

# ---------------------------------------------------------------------------

export type TFileOp = {
		op: 'mkDir' | 'clearDir' | 'compile'
		path: string
		}
	| {
		op: 'barf'
		path: string
		contents: string
		}

# ---------------------------------------------------------------------------
# ASYNC

export setDirTree := (desc: string): TFileOp[] =>

	lFileOps := await getFileOps(desc)
	await execFileOps lFileOps
	return lFileOps

# ---------------------------------------------------------------------------
# ASYNC

export getFileOps := (desc: string): TFileOp[] =>

	return await parseText<TFileOp[]> 'dir-tree', desc

# ---------------------------------------------------------------------------
# ASYNC

export execFileOps := (
		lFileOps: TFileOp[]
		): void =>

	for h of lFileOps
		switch h.op
			when 'mkDir'
				mkDir h.path
			when 'clearDir'
				clearDir h.path
			when 'compile'
				await procOneFile h.path, doCompileFile
			when 'barf'
				barf h.path, h.contents
	return

# ---------------------------------------------------------------------------

export fileOpsTable := (
		lFileOps: TFileOp[]
		hOptions: hash = {}
		): string =>

	type opt = {
		oneLine: boolean
		trunc: number
		}
	{oneLine, trunc} := getOptions<opt> hOptions, {
		oneLine: true
		trunc: 32
		}

	tt := new TextTable("l l l")
	tt.fullsep()
	tt.title 'FILE OPS'
	tt.fullsep()
	tt.labels ['op', 'path', 'contents']
	tt.sep()
	for h of lFileOps
		switch h.op
			when 'barf'
				{path, contents} := h
				str := contents || ''
				if str.length == 0
					tt.data ['barf', path, '<empty>']
				else if oneLine
					output := truncStr(esc(str), trunc)
					tt.data ['barf', path, output]
				else
					lLines := blockToArray str
					for line,i of lLines
						contents := truncStr(esc(lLines[i]), trunc)
						if (i == 0)
							tt.data ['barf', path, contents]
						else
							tt.data ['', '', contents]
			else
				tt.data [h.op, h.path, '']
	tt.fullsep()
	return tt.asString()

# ---------------------------------------------------------------------------
# --- Returns a function that, when called, returns a promise

export mockAsyncTask := <T=unknown>(
		value: T
		ms: number = 10
		doFail: boolean = false
		): () => Promise<T> =>

	return () =>
		return new Promise<T> (resolve, reject) =>
			DBG "START TASK #{value}"
			await sleep(ms)
			DBG "END TASK #{value}"
			if doFail
				reject(new Error("Task #{value} failed"))
			else
				resolve(value)

# ---------------------------------------------------------------------------
# --- Returns a function that, when called, returns a promise

export mockPromise := <T=unknown>(
		value: T
		ms: number = 10
		errMsg: string? = undef
		): Promise<T> =>

	return new Promise<T> (resolve, reject) =>
		DBG "START TASK #{value}"
		await sleep(ms)
		DBG "END TASK #{value}"
		if defined(errMsg)
			reject(new Error(errMsg))
		else
			resolve(value)

