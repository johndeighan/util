# --- Create some values for testing
#     There should be at least one for each jsType

class MyClass
	fname: string
	lname: string
	constructor(@fname: string, @lname: string)
	fullname()
		return "#{@fname} #{@lname}"

export sampleVal: hash := {
	undef: undefined
	null: null
	emptyStr: ''
	str: 'abc'
	i: 42
	f: 3.14159
	inf: Infinity
	neginf: -Infinity
	NaN: Number.NaN
	b: true
	sym: Symbol('xxx')
	genFunc: () ->
		yield 42
		return
	asyncGenFunc: () ->
		await sleep(1000)
		yield 42
		return
	regularFunc:    (): number -> return 42
	lambdaFunc:     (): number => return 42
	falsePredicate: () => return false
	truePredicate:  () => return true
	emptyHash: {}
	fullHash: {a: 42}
	emptyList: []
	fullList: [42]
	MyClass
	}
