# unit-test.lib.civet

import {cyan, red, green} from '@std/fmt/colors'
import {sprintf} from 'jsr:@std/fmt/printf'

import {
	assert, assertEquals, assertThrows, assertStrictEquals,
	AssertionError,
	} from '@std/assert'
import {doesNotThrow} from "node:assert"

import {
	LOG, DBG, initLogLevel, pushLogLevel, popLogLevel,
	} from 'logger'
import {allStackFrames, TStackFrame, frameStr,} from 'stack'
import {
	undef, defined, notdefined, pass, sleep, toBool,
	croak, TIterator, TAsyncIterator, getErrStr,
	} from 'base'
import {esc} from 'unicode'
import {unify} from 'unify'
import {
	TVoidFunc, hash, isString, isEmpty, nonEmpty,
	isIterator, isAsyncIterator, isIterable,
	isFunction, functionDef, isClass, classDef,
	} from 'datatypes'
import {getOptions, truncStr, blockToArray, f, rtrim} from 'llutils'
import {TState, fromFSM} from 'fsm'
import {TextTable} from 'text-table'
import {parseText} from 'hera-parse'
import {mkDir, clearDir, barf} from 'fsys'
import {procOneFile} from 'proc-files'
import {doCompileFile} from 'automate'
import {typeCheckTsCode} from 'lltypescript'
import {getImportCode} from 'typescript'

let nextNum = 1

# ---------------------------------------------------------------------------

export line = (n: number): string =>

	return cyan('line ' + n.toString())

# ---------------------------------------------------------------------------

getTestName := (): string =>

	n := nextNum
	nextNum += 1
	frame := getMyOutsideCaller()
	return (defined(frame) ? "line #{frame.line}" : "line ?")

# ---------------------------------------------------------------------------

export equal := (
		value: unknown,
		expected: unknown
		name?: string
		): void =>

	testName := name || getTestName()
	if isString(value) && isString(expected)
		Deno.test {
			name: testName
			sanitizeOps: true
			fn()
				val1 := rtrim(value)
				val2 := rtrim(expected)
				assertEquals val1, val2
			}
	else
		Deno.test {
			name: testName
			sanitizeOps: true
			fn()
				assertEquals value, expected
			}
	return

# ---------------------------------------------------------------------------

export mark := (
		testName: string
		): void =>

	Deno.test {
		name: red(sprintf("%-7s", testName))
		sanitizeOps: true
		fn()
			assertEquals 1, 1
		}
	return

# ---------------------------------------------------------------------------

export truthy := (
		value: unknown
		name?: string
		): void =>

	if notdefined(name)
		name = getTestName()
	Deno.test {
		name
		sanitizeOps: true
		fn()
			assert value
		}
	return

# ---------------------------------------------------------------------------

export falsy := (
		value: unknown
		name?: string
		): void =>

	Deno.test name || getTestName(), () =>
		assert (not value)
	return

# ---------------------------------------------------------------------------

export succeeds := (
	func: TVoidFunc
	name?: string
	): void =>

	Deno.test name || getTestName(), () =>
		pushLogLevel 'testing'
		let succeeds = true
		try
			func()
		catch err
			succeeds = false
		popLogLevel()
		if not succeeds
			croak "in succeeds(), but function failed"
		return
	return

# ---------------------------------------------------------------------------

export fails := (
	func: TVoidFunc
	name?: string
	): void =>

	Deno.test name || getTestName(), () =>
		pushLogLevel 'testing'
		try
			func()
			throw new Error("in fails(), but function succeeded")
		popLogLevel()
		return
	return

# ---------------------------------------------------------------------------
# ASYNC

export succeedsAsync := (
	func: TVoidFunc
	name?: string
	): void =>

	Deno.test name || getTestName(), () =>
		pushLogLevel 'testing'
		let succeeds = true
		try
			await func()
		catch err
			succeeds = false
		popLogLevel()
		if not succeeds
			croak "in succeeds(), but function failed"
		return
	return

# ---------------------------------------------------------------------------
# ASYNC

export failsAsync := (
	func: TVoidFunc
	name?: string
	): void =>

	Deno.test name || getTestName(), () =>
		pushLogLevel 'testing'
		try
			await func()
			throw new Error("in fails(), but function succeeded")
		popLogLevel()
		return
	return

# ---------------------------------------------------------------------------

export generates := <TOut>(
		value: TIterator<TOut>
		expected: unknown
		name?: string
		): void =>

	lItems := [...value]
	Deno.test (name || getTestName()), () =>
		assertEquals(lItems, expected)
	return

# ---------------------------------------------------------------------------
# ASYNC

export generatesAsync := <TOut>(
		value: TAsyncIterator<TOut>
		expected: unknown
		name?: string
		): void =>

	lItems := await Array.fromAsync value
	Deno.test (name || getTestName()), () =>
		assertEquals(lItems, expected)
	return

# ---------------------------------------------------------------------------

export same := (
		value: unknown
		expected: unknown
		name?: string
		): void =>

	Deno.test name || getTestName(), () =>
		assertStrictEquals value, expected
	return

# ---------------------------------------------------------------------------

export unifies := (
		value: unknown
		expected: unknown
		name?: string
		): void =>

	# --- if either value or expected is an iterator
	#     get an array from it
	if isIterable(value)
		value = Array.from(value)
	if isIterable(expected)
		expected = Array.from(expected)
	Deno.test name || getTestName(), (): void =>
		unify value, expected
	return

# ---------------------------------------------------------------------------
# ASYNC

export isType := (
		typeStr: string,
		value: unknown,
		): void =>

	testName := getTestName()
	# --- returns errMsg or '' if no type error
	result := await checkType typeStr, value
	Deno.test testName, () =>
		assert result
	return

# ---------------------------------------------------------------------------
# ASYNC

export notType := (
		typeStr: string,
		value: unknown,
		): void =>

	testName := getTestName()
	result := await checkType typeStr, value
	Deno.test testName, () =>
		assert not result
	return

# ---------------------------------------------------------------------------
# ASYNC
# returns error message or ''

checkType := (
		typeStr: string
		value: unknown
		): boolean =>

	valueStr := (
		  isFunction(value) ? functionDef(value)
		: isClass(value)    ? classDef(value)
		:                     JSON.stringify(value)
		)
	tsCode := await getTsCode typeStr, valueStr

	# --- check if we need to import the type
	importCode := getImportCode typeStr

	code := """
		#{importCode}
		#{tsCode}
		"""

	return await typeCheckTsCode(code)

# ---------------------------------------------------------------------------
# --- We need to add ':unknown' to any function parameters
#     that don't have an explicit type

export getTsCode := (
		typeStr: string,
		valueStr: string
		): string =>

	result := splitFuncStr valueStr
	if defined(result)
		[lParms, body] := result
		addType := (parm: string): string =>
			if (parm.indexOf(':') >= 0)
				return parm
			else
				return "#{parm}: unknown"
		parmStr := lParms.map(addType).join ', '
		return "const x: #{typeStr} = (#{parmStr}) => #{body}"
	else
		return "const x: #{typeStr} = #{valueStr}"

# ---------------------------------------------------------------------------

type TSplitResult = [string[], string]

export splitFuncStr := (valueStr: string): TSplitResult? =>

	if (lMatches := valueStr.match(/^\(([^\)]*)\)\s*[\=\-]\>\s*(.*)$/))
		[_, strParms, strBody] := lMatches
		if isEmpty(strParms)
			return [[], strBody]
		else
			return [
				strParms.split(',').map((x) => x.trim())
				strBody
				]
	else
		return undef

# ---------------------------------------------------------------------------

export getMyOutsideCaller := (
	trace: boolean = false
	): TStackFrame? =>

	if trace
		LOG '-'.repeat(70)
		for frame of allStackFrames()
			LOG frameStr(frame)

	let mySrc: string? = undef

	return fromFSM allStackFrames(), [
		# --- state 0
		(frame: TStackFrame): TState =>
			if (
						(frame.name == 'getMyOutsideCaller')
					&& frame.source.match(/\bunit-test\.lib\.(?:ts|civet)$/)
					)
				if trace
					LOG "getMyOutsideCaller found, set state to 1"
				return 1
			else
				return 0

		# --- state 1
		(frame: TStackFrame): TState =>
			{source} := frame
			assert defined(source), "source after getMyOutsideCaller is undef"
			mySrc = source
			return 2

		# --- state 2
		(frame: TStackFrame): TState =>
			{source} := frame
			if (source == mySrc)
				return 2
			else
				throw frame     # found !
		],
		(finalState: TState) =>
			return undef
		{}

# ---------------------------------------------------------------------------

export type TFileOp = {
		op: 'mkDir' | 'clearDir' | 'compile'
		path: string
		}
	| {
		op: 'barf'
		path: string
		contents: string
		}

# ---------------------------------------------------------------------------
# ASYNC

export setDirTree := (desc: string): TFileOp[] =>

	lFileOps := await getFileOps(desc)
	await execFileOps lFileOps
	return lFileOps

# ---------------------------------------------------------------------------
# ASYNC

export getFileOps := (desc: string): TFileOp[] =>

	return await parseText<TFileOp[]> 'dir-tree', desc

# ---------------------------------------------------------------------------
# ASYNC

export execFileOps := (
		lFileOps: TFileOp[]
		): void =>

	for h of lFileOps
		switch h.op
			when 'mkDir'
				mkDir h.path
			when 'clearDir'
				clearDir h.path
			when 'compile'
				await procOneFile h.path, doCompileFile
			when 'barf'
				barf h.path, h.contents
	return

# ---------------------------------------------------------------------------

export fileOpsTable := (
		lFileOps: TFileOp[]
		hOptions: hash = {}
		): string =>

	type opt = {
		oneLine: boolean
		trunc: number
		}
	{oneLine, trunc} := getOptions<opt> hOptions, {
		oneLine: true
		trunc: 32
		}

	tt := new TextTable("l l l")
	tt.fullsep()
	tt.title 'FILE OPS'
	tt.fullsep()
	tt.labels ['op', 'path', 'contents']
	tt.sep()
	for h of lFileOps
		switch h.op
			when 'barf'
				{path, contents} := h
				str := contents || ''
				if str.length == 0
					tt.data ['barf', path, '<empty>']
				else if oneLine
					output := truncStr(esc(str), trunc)
					tt.data ['barf', path, output]
				else
					lLines := blockToArray str
					for line,i of lLines
						contents := truncStr(esc(lLines[i]), trunc)
						if (i == 0)
							tt.data ['barf', path, contents]
						else
							tt.data ['', '', contents]
			else
				tt.data [h.op, h.path, '']
	tt.fullsep()
	return tt.asString()

# ---------------------------------------------------------------------------
# --- Returns a function that, when called, returns a promise

export mockAsyncTask := <T=unknown>(
		value: T
		ms: number = 10
		doFail: boolean = false
		): () => Promise<T> =>

	return () =>
		return new Promise<T> (resolve, reject) =>
			DBG "START TASK #{value}"
			await sleep(ms)
			DBG "END TASK #{value}"
			if doFail
				reject(new Error("Task #{value} failed"))
			else
				resolve(value)

# ---------------------------------------------------------------------------
# --- Returns a function that, when called, returns a promise

export mockPromise := <T=unknown>(
		value: T
		ms: number = 10
		doFail: boolean = false
		): Promise<T> =>

	return new Promise<T> (resolve, reject) =>
		DBG "START TASK #{value}"
		await sleep(ms)
		DBG "END TASK #{value}"
		if doFail
			reject(new Error("Task #{value} failed"))
		else
			resolve(value)

