# macros.lib.civet

import {DBG} from 'logger'
import {CTimer} from 'timer'
import {
	undef, defined, notdefined, assert, obviously,
	croak, matches, getErrStr,
	} from 'base'
import {
	hash, hashof, isString, isHash, isFunction, TStringMapper,
	isEmpty, nonEmpty, isArray, isStringMapper,
	} from 'datatypes'
import {indented} from 'indent'
import {OL} from 'nice'
import {entries, toBlock, keys, getOptions} from 'llutils'
import {mkArray} from 'mapper'
import {
	withExt, parsePath, CReadableFile, pathStr,
	} from 'fsys'
import {CFileHandler, TExecResult} from 'exec'
import {parseText} from 'hera-parse'

# ---------------------------------------------------------------------------
# --- a macro with an empty name
#     expands without calling a function on the block

export type TTextBlock = {
	type: 'text'
	firstLine: string
	lContent: TBlock[]
	}

export type TMacroBlock = {
	type: 'macro'
	name: string
	args: string
	lContent: TBlock[]
	}

export type TBlock = TTextBlock | TMacroBlock

# ---------------------------------------------------------------------------

export type TMacroFunc = (
		block: string
		args?: string
		) => string

# --- In a TMacroLib, the key '#preproc'
#     is a function to preprocess the entire output

export type TMacroLib = hashof<TMacroFunc>

export isMacroLib := (x: unknown): x is TMacroLib =>

	if not isHash(x)
		return false
	for [key,func] of Object.entries(x)
		if not isFunction(func)
			return false
	return true

# ---------------------------------------------------------------------------

export expand := (
		lContent: TBlock[]
		hMacros: TMacroLib
		): string =>

	lParts := mkArray lContent, (x) ->
		switch x.type
			when 'text'
				yield x.firstLine
				if nonEmpty(x.lContent)
					yield indented(expand(x.lContent, hMacros))
			when 'macro'
				func := hMacros[x.name]
				yield func expand(x.lContent, hMacros), x.args

	return toBlock lParts

# ---------------------------------------------------------------------------
# ASYNC

export strApplyMacros := (
		text: string
		hMacros: TMacroLib
		): string =>

	lBlocks: TBlock[] := await parseText 'macros', text
	block :=  toBlock expand(lBlocks, hMacros)
	func := hMacros['#preproc']
	return defined(func) ? func(block) : block

# ---------------------------------------------------------------------------
# ASYNC

export fileApplyMacros := (
		path: string
		hMacros: TMacroLib
		): string =>

	{ext} := parsePath path
	assert defined(ext) && ext.startsWith('.$'),
		"Not a macro file: #{path}"
	file := new CReadableFile path
	hMetaData := await file.metaData()
	text := await file.getContents()
	return await strApplyMacros text, hMacros

# ---------------------------------------------------------------------------

export class CMacroCompiler extends CFileHandler

	ext: string
	outext: string
	hLib: TMacroLib

	constructor(
			@ext: string
			@hLib: TMacroLib
			)

		super()
		lMatches := @ext.match ///^
			\.
			\$
			([A-Za-z][A-Za-z0-9]*)
			$///
		if defined(lMatches)
			@outext = '.' + lMatches[1]
		else
			croak "Bad ext: #{@ext}"

	# ..........................................................

	get op()

		return 'doCompileMacroFile'

	# ..........................................................

	async canHandle(
			path: string
			hOptions: hash = {}
			)

		return path.endsWith(@ext)

	# ..........................................................

	override allOutPaths(
			path: string
			hOptions: hash = {}
			): string[]

		return [withExt(path, @outext)]

	# ..........................................................
	# ASYNC

	override handle(
			path: string,
			hOptions: hash = {}
			): TExecResult

		type opt = {
			force: boolean
			trace: boolean
			}
		{force, trace} := getOptions<opt> hOptions, {
			force: false
			trace: false
			}

		destPath := @allOutPaths(path, hOptions)[0]
		try
			input := await Deno.readTextFile path
			output := await strApplyMacros(input, @hLib)
			await Deno.writeTextFile destPath, output
			return {
				success: true
				stdout: output
				timeTaken: -1
				}

		catch err
			errMsg := "MACRO FAILED: #{pathStr(path)} - #{getErrStr(err)}"
			DBG errMsg
			return {
				success: false
				stderr: errMsg
				timeTaken: -1
				}
