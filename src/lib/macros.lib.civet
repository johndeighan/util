# macros.lib.civet

import {
	undef, defined, notdefined, assert, croak
	} from 'base'
import {
	hashof, isString, isHash, TStringMapper,
	isEmpty, nonEmpty, isArray, isStringMapper,
	} from 'datatypes'
import {indented} from 'indent'
import {OL} from 'nice'
import {entries, toBlock} from 'llutils'
import {mkArray} from 'mapper'
import {parsePath, openTextFile} from 'fsys'
import {CFileHandler, TExecResult} from 'exec'
import {parseText} from 'hera-parse'

# ---------------------------------------------------------------------------
# --- a macro with an empty name
#     expands without calling a function on the block

export type TTextBlock = {
	type: 'text'
	firstLine: string
	lContent: TBlock[]
	}

export type TMacroBlock = {
	type: 'macro'
	name: string
	args: string
	lContent: TBlock[]
	}

export type TBlock = TTextBlock | TMacroBlock

# ---------------------------------------------------------------------------

export mkBlk := (
		firstLine: string
		...lOrgContent: (TTextBlock | TMacroBlock | string)[]
		): TTextBlock | TMacroBlock =>


	lContent := mkArray lOrgContent, (x) ->
		if isString(x)
			yield {
				type: 'text'
				firstLine: x
				lContent: []
				}
		else
			yield x

	lMatches := firstLine.match ///^
		\#
		([A-Za-z_][A-Za-z0-9_]*)
		\s*
		(.*)
		$///

	if defined(lMatches)
		return {
			type: 'macro'
			name: lMatches[1]
			args: lMatches[2]
			lContent
			} as TMacroBlock
	else
		return {
			type: 'text'
			firstLine
			lContent
			} as TTextBlock


# ---------------------------------------------------------------------------

export type TMacroFunc = (
		block: string
		args?: string
		) => string

# --- In a TMacroLib, the key '#preproc'
#     is a function to preprocess the output

export type TMacroLib = hashof<TMacroFunc>

export isMacroLib := (x: unknown): x is TMacroLib =>

	if not isHash(x)
		return false
	for _,macro of entries(x)
		if not isStringMapper(macro)
			return false
	return true

# ---------------------------------------------------------------------------

export expand := (
		lContent: TBlock[]
		hMacros: TMacroLib
		): string =>

	lParts := mkArray lContent, (x) ->
		switch x.type
			when 'text'
				yield x.firstLine
				if nonEmpty(x.lContent)
					yield indented(expand(x.lContent, hMacros))
			when 'macro'
				func := hMacros[x.name]
				yield func expand(x.lContent, hMacros), x.args

	return toBlock lParts

# ---------------------------------------------------------------------------
# ASYNC

export mapString := (
		text: string
		hMacros: TMacroLib
		): string =>

	lBlocks: TBlock[] := await parseText 'macros', text
	block :=  toBlock expand(lBlocks, hMacros)
	func := hMacros['#preproc']
	return defined(func) ? func(block) : block

# ---------------------------------------------------------------------------
# ASYNC

export mapFile := (
		path: string
		hMacros: TMacroLib
		): string =>

	{ext} := parsePath path
	assert defined(ext) && ext.startsWith('.$'),
		"Not a macro file: #{path}"
	[hMetaData, text] := await openTextFile path, true
	return await mapString text, hMacros
