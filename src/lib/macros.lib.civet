# macros.lib.civet

import {
	undef, defined, notdefined, assert, croak
	} from 'base'
import {
	hashof, isString, isHash, isFunction, TStringMapper,
	isEmpty, nonEmpty, isArray, isStringMapper,
	} from 'datatypes'
import {indented} from 'indent'
import {OL} from 'nice'
import {entries, toBlock} from 'llutils'
import {mkArray} from 'mapper'
import {parsePath, CReadableFile} from 'fsys'
import {CFileHandler, TExecResult} from 'exec'
import {parseText} from 'hera-parse'
import {hMdMacroLib} from 'md-macros'

# ---------------------------------------------------------------------------
# --- a macro with an empty name
#     expands without calling a function on the block

export type TTextBlock = {
	type: 'text'
	firstLine: string
	lContent: TBlock[]
	}

export type TMacroBlock = {
	type: 'macro'
	name: string
	args: string
	lContent: TBlock[]
	}

export type TBlock = TTextBlock | TMacroBlock

# ---------------------------------------------------------------------------

export type TMacroFunc = (
		block: string
		args?: string
		) => string

# --- In a TMacroLib, the key '#preproc'
#     is a function to preprocess the output

export type TMacroLib = hashof<TMacroFunc>

export isMacroLib := (x: unknown): x is TMacroLib =>

	if not isHash(x)
		return false
	for [key,func] of Object.entries(x)
		if not isFunction(func)
			return false
	return true

# ---------------------------------------------------------------------------

export expand := (
		lContent: TBlock[]
		hMacros: TMacroLib
		): string =>

	lParts := mkArray lContent, (x) ->
		switch x.type
			when 'text'
				yield x.firstLine
				if nonEmpty(x.lContent)
					yield indented(expand(x.lContent, hMacros))
			when 'macro'
				func := hMacros[x.name]
				yield func expand(x.lContent, hMacros), x.args

	return toBlock lParts

# ---------------------------------------------------------------------------
# ASYNC

export mapString := (
		text: string
		hMacros: TMacroLib
		): string =>

	lBlocks: TBlock[] := await parseText 'macros', text
	block :=  toBlock expand(lBlocks, hMacros)
	func := hMacros['#preproc']
	return defined(func) ? func(block) : block

# ---------------------------------------------------------------------------
# ASYNC

export mapFile := (
		path: string
		hMacros: TMacroLib
		): string =>

	{ext} := parsePath path
	assert defined(ext) && ext.startsWith('.$'),
		"Not a macro file: #{path}"
	file := new CReadableFile path
	hMetaData := await file.metaData()
	text := await file.getContents()
	return await mapString text, hMacros

# ---------------------------------------------------------------------------

hMacroLibs := {
	'md': hMdMacroLib
	}

# ---------------------------------------------------------------------------

export class CMacroFileCompiler extends CFileHandler

	get op()
		return 'doCompileMacroFile'

	# ..........................................................

	override canHandle(
			path: string
			hOptions: hash = {}
			): boolean

		ext := fileExt(path)
		if not matches(ext, /^\.\$/)
			return false
		kind := ext.substring(2)
		if not (kind in hMacroLibs)
			return false
		return true

	# ..........................................................

	override needed(
			path: string
			hOptions: hash = {}
			): boolean

		if ('force' in hOptions) && hOptions.force
			return true
		ext := fileExt(path)
		assert matches ext, /^\.\$/
		kind := ext.substring(2)
		assert (kind in hMacroLibs), "Unknown macro kind #{kind}"
		destPath := withExt path, ".#{kind}"
		return not newerDestFileExists(path, destPath)

	# ..........................................................
	# ASYNC

	override handle(
			path: string,
			hOptions: hash = {}
			): TExecResult

		type opt = {
			force: boolean
			trace: boolean
			}
		{force, trace} := getOptions<opt> hOptions, {
			force: false
			trace: false
			}

		assert (fileExt(path) == '.$md'), "Not an md macro file"
		try
			input := await Deno.readTextFile path
			output := await mapString(input, hMdMacroLib)
			await Deno.writeTextFile withExt(path, '.md'), output
			return {
				success: true
				stdout: output
				}

		catch err
			errMsg := "MARKDOWN PREPROC FAILED: #{pathStr(path)} - #{getErrStr(err)}"
			return {
				success: false
				stdout: ''
				stderr: errMsg
				}

export doCompileMacroFile := new CMacroFileCompiler()
