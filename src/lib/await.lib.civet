# --- Executes an array of thunks concurrently up to a specified limit
#     and yields their results or errors as they resolve.

import {newQueue} from '@henrygd/queue'

import {
	undef, defined, getErrStr, assert, TAsyncIterator, range, sleep,
	} from 'base'
import {integer} from 'datatypes'

export type TThunk<T> = () => Promise<T>
export type TSettleResult<T> = [true, T, integer] | [false, string, integer]

# ---------------------------------------------------------------------------

getPromise := <T>(
		i: integer
		thunk: TThunk<T>
		): Promise<TSettleResult<T>> ->
	try
		result: T := await thunk()
		return [true, result, i]
	catch err
		return [false, getErrStr(err), i]

# ---------------------------------------------------------------------------
# ASYNC

export allPromiseResults := <T>(
		lThunks: TThunk<T>[]
		limit: number = 10
		): TAsyncIterator<TSettleResult<T>> ->

	if (limit <= 0)
		limit = Infinity
	queue := newQueue(limit)
	for thunk,i of lThunks
		try
			response := await queue.add(thunk)
			yield [true, response, i]
		catch err
			yield [false, getErrStr(err), i]
	await queue.done()
	return
