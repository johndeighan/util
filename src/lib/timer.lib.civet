# timer.lib.civet

import {sprintf} from '@std/fmt/printf'

import {undef} from 'base'
import {integer} from 'datatypes'

loadTime: integer := Date.now()

# ---------------------------------------------------------------------------
# --- in seconds

export sinceLoad := (
		datetime: Date | integer = Date.now()
		): number =>

	if (datetime instanceof Date)
		return (datetime.valueOf() - loadTime) / 1000
	else
		return (datetime - loadTime) / 1000

# ---------------------------------------------------------------------------

export sinceLoadStr := (
		datetime: (Date | integer)? = undef
		) =>

	return sprintf("%8.3f sec", sinceLoad(datetime))

# ---------------------------------------------------------------------------

export class CTimer

	t0 = Date.now()

	# ..........................................................

	reset(): void

		@t0 = Date.now()

	# ..........................................................

	timeTaken(
			reset: boolean = false,
			decPlaces: number = 2
			divideBy: number = 1
			): number

		now := Date.now()
		secs := (now - @t0) / 1000
		if reset
			@t0 = now
		return secs / divideBy

	# ..........................................................

	timeTakenStr(
			reset: boolean = false,
			decPlaces: number = 2
			divideBy: number = 1
			): string

		now := Date.now()
		secs := (now - @t0) / 1000
		if reset
			@t0 = now
		return sprintf("%.#{decPlaces}d secs.", secs / divideBy)
