# extract.lib.civet

import {
	undef, defined, notdefined, croak, assert, LOG,
	} from 'base'
import {
	isString, isArray, isNumber,
	isEmpty, nonEmpty, integer,
	} from 'datatypes'
import {o, sep} from 'llutils'
import {toNice} from 'to-nice'

# ---------------------------------------------------------------------------

export type TPathItem = string | number

export getDsPath := (lPath: TPathItem[]): string =>

	results := []
	for x of lPath
		results.push (isString(x) ? ".#{x}" : "[#{x}]")
	lParts := results
	return lParts.join ''

# ---------------------------------------------------------------------------

export reportExtractError := (
		pathstr: string
		x: unknown
		errMsg: string? = undef
		expected: string? = undef
		): void =>

	LOG sep '=', "ERROR EXTRACTING #{pathstr}"
	LOG sep '=', 'FROM'
	try
		LOG toNice(x), {ignoreEmptyKeys: true}
	catch err
		LOG JSON.stringify(x, null, 3)
	LOG sep '='
	if defined(errMsg)
		LOG errMsg
	if defined(expected)
		LOG "EXPECTED #{expected}"
	LOG sep '='
	return

# ---------------------------------------------------------------------------

export extract := (
		x: unknown,
		dspath: string | TPathItem[]
		tester: (x: unknown) => boolean = (x) => true
		expected: string? = undef
		): unknown =>

	assert defined(x), "extract(): x not defined"
	pathstr := isArray(dspath) ? getDsPath(dspath) : dspath
	assert nonEmpty(pathstr), "Empty pathstr"
	try
		eval "x = x#{pathstr}"
		assert tester(x), "Expected #{expected}"
		return x
	catch err
		msg: string := (
			  isString(err)          ? err
			: (err instanceof Error) ? err.message
			:                          'Unknown error'
			)
		reportExtractError pathstr, x, msg
		Deno.exit 99

# ---------------------------------------------------------------------------

export getString := (
		x: unknown,
		dspath: string | TPathItem[],
		value: string? = undef
		): string =>

	val := extract x, dspath, (x) => isString(x), 'string'
	assert isString(val), "getString(): not a string"
	if value
		assert (val == value), "Expected #{value}, got #{val}"
	return val

# ---------------------------------------------------------------------------

export getNumber := (
		x: unknown,
		dspath: string | TPathItem[],
		value: number? = undef
		): number =>

	val := extract x, dspath, (x) => isNumber(x), 'number'
	assert isNumber(val), "getNumber(): not a number"
	if value
		assert (val == value), "Expected #{value}, got #{val}"
	return val

# ---------------------------------------------------------------------------

export getArray := (
		x: unknown,
		dspath: string | TPathItem[],
		len: integer? = undef
		): unknown[] =>

	assert defined(x), "getArray(): x not defined"
	val := extract x, dspath, (x) => isArray(x), 'array'
	assert isArray(val), "getArray(): not an array"
	if len
		assert (val.length == len), "Expected #{len} len array, got #{val}"
	return val
