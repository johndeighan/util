# extract.lib.civet

import {LOG} from 'logger'
import {
	undef, defined, notdefined, croak, assert, deepEqual,
	} from 'base'
import {
	isString, isArray, isNumber,
	isEmpty, nonEmpty, integer, array,
	} from 'datatypes'
import {sep} from 'llutils'
import {nice} from 'nice'

# ---------------------------------------------------------------------------

export type TPathItem = string | number

export getDsPath := (lPath: TPathItem[]): string =>

	results := []
	for x of lPath
		results.push (isString(x) ? ".#{x}" : "[#{x}]")
	lParts := results
	return lParts.join ''

# ---------------------------------------------------------------------------

export extract := (
		x: unknown,
		pathstr: string
		): unknown =>

	assert defined(x), "extract(): x not defined"
	try
		eval "x = x#{pathstr}"
		return x
	catch err
		msg: string := (
			  isString(err)          ? err
			: (err instanceof Error) ? err.message
			:                          'Unknown error'
			)
		reportExtractError x, pathstr, msg
		throw err

# ---------------------------------------------------------------------------

export getPathString := (
		dspath: string | TPathItem[]
		): string =>

	assert nonEmpty(dspath), "Empty dspath"
	pathstr := isArray(dspath) ? getDsPath(dspath) : dspath
	assert nonEmpty(pathstr), "Empty pathstr"
	return pathstr

# ---------------------------------------------------------------------------

export reportExtractError := (
		x: unknown
		pathstr: string
		errMsg: string? = undef
		): void =>

	LOG sep '=', "ERROR EXTRACTING #{pathstr}"
	LOG sep '=', 'FROM'
	try
		LOG nice(x), {ignoreEmptyKeys: true}
	catch err
		LOG JSON.stringify(x, null, 3)
	LOG sep '='
	if defined(errMsg)
		LOG errMsg
	LOG sep '='
	return

# ---------------------------------------------------------------------------
# ---------------------------------------------------------------------------

export getString := (
		x: unknown,
		dspath: string | TPathItem[],
		expected: string? = undef
		): string =>

	pathstr := getPathString(dspath)
	val := extract(x, pathstr) || ''
	if not isString(val)
		reportExtractError x, pathstr,
				"string expected, got #{val}"
	if expected
		assert (val == expected), "Expected #{expected}, got #{val}"
	return val as string

# ---------------------------------------------------------------------------

export getNumber := (
		x: unknown,
		dspath: string | TPathItem[],
		expected: number? = undef
		): number =>

	pathstr := getPathString(dspath)
	value := extract x, pathstr
	if not isNumber(value)
		reportExtractError x, pathstr,
				"getNumber(): number expected, got #{value}"
	if expected
		assert (value == expected), "Expected #{expected}, got #{value}"
	return value as number

# ---------------------------------------------------------------------------

export getArray := (
		x: unknown,
		dspath: string | TPathItem[],
		expected: array? = undef
		): unknown[] =>

	pathstr := getPathString(dspath)
	value := extract x, pathstr
	if notdefined(value)
		return []
	if not isArray(value)
		reportExtractError x, pathstr,
				"getArray(): array expected, got #{value}"
	if expected
		assert deepEqual(value, expected),
			"Expected #{expected}, got #{value}"
	return value as array

# ---------------------------------------------------------------------------

export getTuple := (
		x: unknown,
		dspath: string | TPathItem[],
		len: integer = 2
		): unknown[] =>

	pathstr := getPathString(dspath)
	val := extract x, pathstr
	if not isArray(val)
		reportExtractError x, pathstr,
				"getTuple(): array expected, got #{val}"
	assert isArray(val), "BS"
	if len
		assert (val.length == len), "Expected #{len} len array, got #{val}"
	return val as array
