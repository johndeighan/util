# datatypes.lib.civet

import {minify} from 'npm-uglify-js'

import {
	deepCopy, undef, defined, notdefined,
	anyDefined, anyNotDefined,
	croak, assert, getErrStr,
	TIterator, TAsyncIterator, TNonFunction,
	} from 'base'

# ---------------------------------------------------------------------------

export type TSequence<T=unknown> = T | TIterator<T> | TAsyncIterator<T>
export type TStringSeq = TSequence<string>

export type char = string
export type integer = number
export type nonEmptyString = string
export type regexp = RegExp
export type TIntArray = integer[]

export type TVoidFunc = () => void
export type TVoidIterator<T=unknown> = () => TIterator<T>
export type TUnaryFunc<TIn, TOut> = (item: TIn) => TOut
export type TStringifier = (item: unknown) => string
export type TStringMapper = (str: string) => string
export type TStringFilterFunc = (str: string) => boolean

# ---------------------------------------------------------------------------

export isStringMapper := (x: unknown): x is TStringMapper =>

	return isFunction(x)

# ---------------------------------------------------------------------------

GenFunc := (function* () {}).constructor
AsyncGenFunc := (async function* () {}).constructor

export jsType := (x: unknown): string =>

	switch typeof x
		when 'undefined'
			return 'undef'
		when 'boolean', 'string', 'symbol', 'bigint'
			return typeof x
		when 'number'
			if Number.isFinite(x)
				return Number.isInteger(x) ? 'integer' : 'float'
			else
				return (
					  Number.isNaN(x)  ? 'NaN'
					: (x == -Infinity) ? 'neginf'
					:                    'inf'
					)
		when 'object'
			return (
				  (x == null)           ? 'null'
				: (x instanceof RegExp) ? 'regexp'
				: (x instanceof Set)    ? 'set'
				: (x instanceof Map)    ? 'map'
				: Array.isArray(x)      ? 'array'
				: isIterator(x)         ? 'iterator'
				: isAsyncIterator(x)    ? 'asyncIterator'
				:                         'hash'
				)
		when 'function'
			return (
				  x.toString().startsWith('class ') ? 'class'
				: (x instanceof GenFunc)            ? 'generator'
				: (x instanceof AsyncGenFunc)       ? 'asyncGenerator'
				:                                     'plainFunction'
				)

# ---------------------------------------------------------------------------
# ---------------------------------------------------------------------------

export type hashof<T> = {
	[key: string | symbol]: T
	}
export type hash = hashof<unknown>

export type arrayof<T> = T[]
export type array = arrayof<unknown>

# ---------------------------------------------------------------------------
# ---------------------------------------------------------------------------

export isString := (x: unknown): x is string =>

	return (typeof x == 'string') || (x instanceof String)

# ---------------------------------------------------------------------------

export isChar := (x: unknown): x is char =>

	return isString(x) && (x.length == 1)

# ---------------------------------------------------------------------------

export isBoolean := (x: unknown): x is boolean =>

	return (typeof x == 'boolean') || (x instanceof Boolean)

# ---------------------------------------------------------------------------

export isNumber := (x: unknown): x is number =>

	return (
		   (typeof x == 'bigint')
		|| (typeof x == 'number')
		|| (x instanceof Number)
		)

# ---------------------------------------------------------------------------

export isInteger := (x: unknown): x is integer =>

	return isNumber(x) && Number.isInteger(x.valueOf())

# ---------------------------------------------------------------------------

export isRegExp := (item: unknown): item is regexp =>

	return (item instanceof RegExp)

# ---------------------------------------------------------------------------

export regexpDef := (x: unknown): string =>

	if (typeof x == 'object') && (x instanceof RegExp)
		return x.source
	croak "Not a RegExp"
	return ''
# --- TypeScript bug

# ---------------------------------------------------------------------------

export isHash := <T = unknown>(
		x: unknown
		): x is hashof<T> =>

	return (jsType(x) == 'hash')

# ---------------------------------------------------------------------------

export isArray := <T = unknown>(
		x: unknown
		): x is arrayof<T> =>

	return Array.isArray x

# ---------------------------------------------------------------------------

export isSymbol := (x: unknown): x is symbol =>

	return (typeof x == 'symbol')

# ---------------------------------------------------------------------------

export symbolName := (x: unknown): string =>

	if (typeof x == 'symbol')
		return x.description || ''
	throw new Error("Not a symbol: #{x}")

# ---------------------------------------------------------------------------

export isObject := (x: unknown): x is object =>

	return (typeof x == 'object') && (x != null)

# ---------------------------------------------------------------------------

export isFunction := (item: unknown): item is Function =>

	return (typeof item == 'function')

# ---------------------------------------------------------------------------

export functionName := (x: Function): string =>

	if x.name
		return x.name
	else
		return '<anonymous>'

# ---------------------------------------------------------------------------

export functionDef := (x: Function): string =>

	return normalizeExpr x.toString()

# ---------------------------------------------------------------------------

export isClass := (x: unknown): boolean =>

	return (typeof x == 'function') && x.toString().startsWith('class ')

# ---------------------------------------------------------------------------

export className := (x: unknown): string =>

	# --- item can be a class or an object
	if (typeof x == 'function') && x.toString().startsWith('class')
		if x.name
			return x.name
		else
			return '<anonymous>'

	if (typeof x == 'object') && (x != null)
		if x.constructor.name
			return x.constructor.name
		else
			return '<anonymous>'

	croak "Not a class"
	return ''    # --- TypeScript bug

# ---------------------------------------------------------------------------

export classDef := (x: unknown): string =>

	if (typeof x == 'function') && x.toString().startsWith('class')
		return normalizeCode x.toString()
	croak "Not a class"
	return ''     # --- TypeScript bug

# ---------------------------------------------------------------------------
# --- NOTE: An '&' preceding a key name indicates
#           that it should be a function

export isClassInstance := (
		x: unknown,
		): boolean =>

	if (typeof x != 'object') || isArray(x) || isPromise(x)
		return false
	if notdefined(x?.constructor?.name)
		return false
	if (x?.constructor?.name == 'Object')
		return false
	return true

# ---------------------------------------------------------------------------

export isNonEmptyString := (x: unknown): x is nonEmptyString =>

	# --- must contain non-whitespace character
	return isString(x) && defined(x.match /\S/)

# ---------------------------------------------------------------------------

export lPrimTypes := [
	'undefined'
	'boolean'
	'string'
	'symbol'
	'bigint'
	'number'
	'function'
	]

export isPrimitive := (x: unknown): boolean =>

	return (
		   (x == null)
		|| lPrimTypes.includes(typeof x)
		|| (x instanceof RegExp)
		)

# ---------------------------------------------------------------------------

export isNonPrimitive := (x: unknown): boolean =>

	return not isPrimitive(x)

# ---------------------------------------------------------------------------

export isEmpty := (x: unknown): boolean =>

	if (x == undef) || (x == null)
		return true
	if isString(x)
		return (x.match(/^\s*$/) != null)
	if isArray(x)
		return (x.length == 0)
	if (x instanceof Set) || (x instanceof Map)
		return (x.size == 0)
	if (typeof x == 'object')
		return (Object.keys(x).length == 0)
	else
		return false

# ---------------------------------------------------------------------------

export nonEmpty := (x: unknown): boolean =>

	return not isEmpty(x)

# ---------------------------------------------------------------------------

# --- Functions to normalize JavaScript code & expressions
#     Only used internally in functionDef() and classDef()

# ---------------------------------------------------------------------------

uniqInt := (start: number = 1): Generator<number> ->
	for i of [start..1000000]
		yield i

addFunctionNames := (code: string): string =>
	# --- The names we add will look like: '__dummy99' where
	#     '99' can be any sequence of digits
	#     to make it trivial to remove them later

	gen := uniqInt()     # create an iterator

	# --- Args to replacer function are:
	#    function replacer(match, p1, p2, /* …, */ pN, offset, string, groups) {
	#       return replacement;
	#	     }

	replaceFunc := (match: string, aster: string?) =>
		return "function#{aster} __dummy#{gen.next().value}("
	return code.replaceAll /function\s*(\*)?\s*\(/g, replaceFunc

# ---------------------------------------------------------------------------

removeFunctionNames := (code: string): string =>

	return code.replaceAll /__dummy\d+/g, ''

# ---------------------------------------------------------------------------

normalizeCode := (code: string): string =>

	# --- Due to a bug in JavaScript, we have to make sure
	#     that all function names (even in generators)
	#     have a name, which we must remove after minimization
	newCode := addFunctionNames code

	# --- Remove extra whitespace
	#     Remove extra parens from '(str)=>return'
	#     Remove comments

	hOptions := {
		annotations: false
		mangle: false
		compress: undefined
		keep_fargs: true
		keep_fnames: true
		warnings: true
		}

	hResult := minify newCode, hOptions
	if hResult.error
		throw new Error(hResult.error.message)
	else if hResult.code
		return removeFunctionNames hResult.code
	else
		throw new Error("Unknown error in normalizeCode()")

# ---------------------------------------------------------------------------

normalizeExpr := (code: string): string =>

	str := normalizeCode code
	len := str.length
	if str[len - 1] == ';'
		return str.substring 0, len - 1
	else
		return str

# ---------------------------------------------------------------------------
# ---------------------------------------------------------------------------

export isArrayOfStrings := (x: unknown): x is string[] =>

	if not Array.isArray(x)
		return false
	for item of x
		if not isString(item)
			return false
	return true

# ---------------------------------------------------------------------------

export isArrayOfIntegers := (x: unknown): x is TIntArray =>

	if not Array.isArray(x)
		return false
	for item of x
		if not isInteger(item)
			return false
	return true

# ---------------------------------------------------------------------------

export isPromise := <T>(x: unknown): x is Promise<T> =>

	return (
		   (typeof x == 'object')
		&& (x != null)
		&& ('then' in x)
		&& (typeof x.then == 'function')
		)

# ---------------------------------------------------------------------------

export isIterator := <T>(
		x: unknown
		): x is Iterator<T, void, void> =>

	return (
		   isObject(x)
		&& ('next' in x)
		&& (typeof x.next == 'function')
		)

# ---------------------------------------------------------------------------

export isAsyncIterator := <T>(
		x: unknown
		): x is AsyncIterator<T> =>

	return (
		   isObject(x)
		&& ('next' in x)
		&& (typeof x.next == 'function')
		&& (Symbol.asyncIterator in x)
		&& (typeof x[Symbol.asyncIterator] == 'function')
		)

# ---------------------------------------------------------------------------

export isIterable := <T>(
		x: unknown
		): x is Iterable<T> =>

	return (
		   isObject(x)
		&& (Symbol.iterator in x)
		&& (typeof x[Symbol.iterator] == 'function')
		)

# ---------------------------------------------------------------------------

export isAsyncIterable := <T>(
		x: unknown
		): x is AsyncIterator<T> =>

	return (
		   (typeof x == 'object')
		&& (x != null)
		&& (Symbol.asyncIterator in x)
		&& (typeof x[Symbol.asyncIterator] == 'function')
		)

# ---------------------------------------------------------------------------

export isGeneratorFunction := (
		x: unknown
		): x is GeneratorFunction =>

	return (
		   (typeof x == 'function')
		&& (x.toString().match(/\bfunction\s*\*/) != null)
		)

# ---------------------------------------------------------------------------

export isAsyncGeneratorFunction := (
		x: unknown
		): x is AsyncGeneratorFunction =>

	return (
		   (typeof x == 'function')
		&& (x.toString().match(/\basync\s+function\s*\*/) != null)
		)

# ---------------------------------------------------------------------------

export isAsyncFunction := (fn: unknown): boolean =>

	if isFunction(fn)
		return (fn.constructor.name == 'AsyncFunction') ||
				(fn.constructor.name == 'AsyncGenerator')
	else
		return false

# ---------------------------------------------------------------------------

export clearHash := (h: hash): void =>

	for key of Object.keys(h)
		delete h[key]
	return

# ---------------------------------------------------------------------------

export clearArray := (l: array): void =>

	l.length = 0
	return

# ---------------------------------------------------------------------------

export setHash := (h: hash, h2: hash): void =>

	for key of Object.keys(h)
		delete h[key]
	for key of Object.keys(h2)
		h[key] = h2[key]
	return

# ---------------------------------------------------------------------------

export setArray := (l: array, l2: array): void =>

	l.length = 0
	for x of l2
		l.push x
	return

