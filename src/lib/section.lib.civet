# section.lib.civet

import {undef, defined, notdefined, croak, assert} from 'base'
import {
	TStringMapper, isArray, isEmpty, isFunction, isInteger, isString,
	} from 'datatypes'
import {toBlock} from 'llutils'
import {OL} from 'to-nice'
import {indented} from 'indent'

# ---------------------------------------------------------------------------

export type TSectionName = string

export isSectionName := (x: string): x is TSectionName =>

	return defined(x.match(/^[a-z][A-Za-z0-9_-]*/))

# ---------------------------------------------------------------------------

export class Section

	name: TSectionName
	mapper?: TStringMapper
	level: number

	lLines: string[] = []

	constructor(
			@name: TSectionName,
			@level: number = 0
			mapper: TStringMapper? = undef
			)

		if defined(mapper)
			assert isFunction(mapper),
					"bad mapper in section #{OL(@name)}"
			@mapper = mapper

	# ..........................................................

	add(level: number, ...lLines: string[]): void
	add(...lLines: string[]): void
	add(
		first: (string | number),
		...lLines: string[]
		): void

		level := (
			if isString(first)
				@lLines.push first
				0
			else
				first
			)

		for line,i of lLines
			@lLines.push indented(line, level)
		return

	# ..........................................................

	prepend(level: number, ...lLines: string[]): void
	prepend(...lLines: string[]): void
	prepend(
		first: (string | number),
		...lLines: string[]
		): void

		level := (
			if isString(first)
				@lLines.unshift first
				0
			else
				first
			)

		for line,i of lLines
			@lLines.unshift indented(line, level)
		return

	# ..........................................................

	getBlock(): string

		block := toBlock(@lLines)
		mapped := defined(@mapper) ? @mapper(block) : block
		return @level ? indented(mapped, @level) : mapped
