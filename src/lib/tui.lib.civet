# tui.lib.civet

import {Select} from "jsr:@cliffy/prompt"
import {colors} from "jsr:@cliffy/ansi/colors"
import Listr from 'listr'

import {getErrStr} from 'base'
import {f} from 'llutils'

# ---------------------------------------------------------------------------

export type TTask = {
	title: string
	task: Function
	}

export type TTuiOption = {
	name: string
	value?: unknown
	}

# ---------------------------------------------------------------------------

export logLabel := (label: string): void =>

	console.log f":{cyan}===== #{label} ====="
	return

# ---------------------------------------------------------------------------
# ASYNC

export runTasks := async (
		lTasks: TTask[]
		): void =>

	handleErr := (err: unknown) =>
	hOptions := {
		concurrent: true
		exitOnError: false
		}
	try
		new Listr(lTasks, {concurrent: true}).run()
	catch err
	return

# ---------------------------------------------------------------------------
# ASYNC

export prompt := (
		message: string
		lOptions: TTuiOption[]
		): unknown =>

	for opt of lOptions
		if ('value' not in opt)
			opt.value = opt.name

	return await Select.prompt {
		message: "Pick an action"
		options: lOptions
		}

