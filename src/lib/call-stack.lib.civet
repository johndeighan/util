# call-stack.lib.civet

import {
	undef, defined, notdefined, assert, croak, nonEmptyString,
	} from 'datatypes'
import {spaces, tabs} from 'llutils'
import {LOG, ERR, getLog} from 'logger'
import {OL, OLS} from 'to-nice'

mainName := '_MAIN_'
noValue := Symbol('noValue')

# ---------------------------------------------------------------------------

class Node

	id: number
	name: string
	lArgs: unknown[]
	caller: Node?
	lCalling: Node[] = []
	isYielded: boolean = false
	doLog: boolean = false

	constructor(
			@id: number
			@name: string
			lArgs: unknown[] = []
			@caller: Node? = undef
			@doLog = false
			)

		@lArgs = structuredClone(lArgs)

# ---------------------------------------------------------------------------

export class CallStack

	nextID: number = 2
	root = new Node(1, mainName, [], undef, true)
	curFunc: Node = @root
	level: number = 0
	logLevel: number = 0
	doLogCalls: boolean = true
	doDebugStack: boolean = true
	doThrowErrors: boolean = true

	# ........................................................................

	logCalls(flag: boolean = true): void

		@doLogCalls = flag
		return

	# ........................................................................

	debug(flag: boolean = true): void

		@doDebugStack = flag
		return

	# ........................................................................

	throwErrors(flag: boolean = true): void

		@doThrowErrors = flag
		return

	# ........................................................................

	log(str: string): void

		LOG "#{tabs(@level)}#{str}"
		return

	# ........................................................................

	reset(): void

		if @doLogCalls
			@log "RESET STACK"
		@nextID = 2
		@curFunc = @root = new Node(1, mainName, [], undef)
		@level = @logLevel = 0
		@doLogCalls = @doDebugStack = @doThrowErrors = true
		@setCurFunc(@root)
		return

	# ........................................................................

	setCurFunc(node: Node): void

		@curFunc = node
		return

	# ........................................................................

	isActive(
			funcName: string
			hNode = @root
			): boolean

		if (hNode.name == funcName)
			return true
		{lCalling} := hNode
		for node of hNode.lCalling
			if @isActive(funcName, node) && not node.isYielded
				return true
		return false

	# ........................................................................
	# ........................................................................

	enter(
			funcName: nonEmptyString
			lArgs: unknown[] = []
			doLog = false
			): void

		if @doLogCalls
			if (lArgs.length == 0)
				@log "ENTER #{OL(funcName)}"
			else
				@log "ENTER #{OL(funcName)} #{OLS(lArgs)}"

		node := new Node(@nextID, funcName, lArgs, @curFunc, doLog)
		@nextID += 1
		@curFunc.lCalling.push node
		@setCurFunc node

		@incLevel()

		if @doDebugStack
			@dump(@level)
		return

	# ........................................................................

	returnFrom(funcName: string, val: unknown = noValue): void
		# --- Always returns from the current function
		#     parameter is just a check for correct function name
		# --- We must use spread operator to distinguish between
		#        returnFrom('func', undef)
		#        returnFrom('func')

		# --- Adjust levels before logging
		@decLevel()

		if @doLogCalls
			if (val == noValue)
				@log "RETURN FROM #{OL(funcName)}"
			else
				@log "RETURN FROM #{OL(funcName)} #{OL(val)}"

		assert defined(@curFunc.caller), "return from main"
		assert (funcName == @curFunc.name),
			"return from #{funcName}, but cur func is #{@curFunc.name}"
		if notdefined(@curFunc.caller)
			@setCurFunc @curFunc.caller

		assert (@curFunc.lCalling.length > 0), "calling stack empty"
		@curFunc.lCalling.pop()

		if @doDebugStack
			@dump(@level)
		return

	# ........................................................................

	yield(funcName: string, val: unknown = noValue): void

		# --- Adjust levels before logging
		@decLevel()

		if @doLogCalls
			if (val == noValue)
				@log "YIELD FROM #{OL(funcName)}"
			else
				@log "YIELD FROM #{OL(funcName)} #{OL(val)}"

		assert defined(@curFunc.caller), "return from main"
		assert (funcName == @curFunc.name),
			"yield #{funcName}, but cur func is #{@curFunc.name}"

		@curFunc.isYielded = true

		let newCurFunc: Node? = @curFunc.caller
		while defined(newCurFunc.caller) && (newCurFunc.isYielded)
			newCurFunc = newCurFunc.caller
		@setCurFunc newCurFunc

		if @doDebugStack
			@dump(@level)
		return

	# ........................................................................

	resume(funcName: string): void

		if @doLogCalls
			@log "RESUME #{OL(funcName)}"

		@setCurFunc @curFunc.lCalling[@curFunc.lCalling.length - 1]
		assert (@curFunc.name == funcName),
			"resume #{funcName} but resumed @curFunc.name"
		assert @curFunc.isYielded, "resume #{funcName} but it's not yielded"
		@curFunc.isYielded = false

		@incLevel()

		if @doDebugStack
			@dump(@level)
		return

	# ........................................................................
	# ........................................................................

	incLevel(): void

		@level += 1
		if @curFunc.doLog
			@logLevel += 1
		return

	# ........................................................................

	decLevel(): void

		assert (@level > 0), "dec level when level is 0"
		@level -= 1
		if @curFunc.doLog
			assert (@logLevel > 0), "dec logLevel when logLevel is 0"
			@logLevel -= 1
		return

	# ........................................................................

	dump(
			level=0
			oneIndent = spaces(5)
			): void

		prefix := oneIndent.repeat(level)
		LOG prefix + '-------- CALL STACK --------'
		LOG prefix + "(curFunc = #{@curFunc.name})"
		LOG @dumpStr @root, level, oneIndent
		LOG prefix + '----------------------------'
		return

	# ........................................................................

	dumpStr(
			node: Node
			level: number
			oneIndent: string
			): string

		lLines := for node: Node of node.lCalling
			@dumpStr(node, level+1, oneIndent)
		return [
			oneIndent.repeat(level) + @callStr(node)
			...lLines
			].join("\n")

	# ........................................................................

	callStr(hNode: Node): string

		curSym := (hNode == @curFunc) ? '> ' : '. '

		{caller, lCalling} := hNode
		callerStr := defined(caller) ? caller.id.toString(10) : '-'
		callingStr := @idStr(lCalling)

		sym := (
			if hNode.doLog
				hNode.isYielded ? ' LY' : ' L'
			else
				hNode.isYielded ? ' Y' : ''
			)
		return "#{curSym}[#{hNode.id}] #{hNode.name} #{callerStr} #{callingStr} #{sym}"

	# ........................................................................

	idStr(lNodes: Node[]): string

		if (lNodes.length == 0)
			return '-'
		lIDs := for node of lNodes
			node.id.toString(10)
		return lIDs.join(',')

# ---------------------------------------------------------------------------

export getStackLog = (): string =>

	return getLog() || ''

