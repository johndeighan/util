# mapper.lib.civet

import {yellow} from '@std/fmt/colors'

import {
	undef, defined, notdefined,
	getErrStr, assert, obviously,
	TIterator, TAsyncIterator, TNonFunction,
	} from 'base'
import {
	array, hash, jsType,
	isString, isArray, isObject, isAsyncFunction,
	isFunction, isIterator, isAsyncIterator,
	isGeneratorFunction, isAsyncGeneratorFunction,
	} from 'datatypes'
import {
	allValuesFrom, allValuesFromAsync, accumFromAsync,
	arrayAndAccumFrom,
	} from 'iter-utils'

let traceFlag: boolean = false

# ---------------------------------------------------------------------------

export doTrace := (flag: boolean): void =>

	traceFlag = flag
	return

# ---------------------------------------------------------------------------

trace := (x: unknown): void =>

	if traceFlag
		if isString(x)
			console.log yellow(x)
		else if isObject(x)
			console.log x.toString()
		else
			console.log x
	return

# ---------------------------------------------------------------------------

type TMapper<TIn, TOut> = (
	x: TIn
	i: number
	) => TIterator<TOut>

type TAccumMapper<TIn, TAccum extends TNonFunction> = (
	x: TIn
	acc: TAccum
	i: number
	) => TAccum

type TBothMapper<TIn, TOut, TAccum extends TNonFunction> = (
	x: TIn,
	acc: TAccum
	i: number
	) => TIterator<TOut, TAccum>

type TAsyncMapper<TIn, TOut> = (
	x: TIn
	i: number
	) => TAsyncIterator<TOut>

type TAsyncAccumMapper<TIn, TAccum extends TNonFunction> = (
	x: TIn
	acc: TAccum
	i: number
	) => Promise<TAccum>

type TAsyncBothMapper<TIn, TOut, TAccum extends TNonFunction> = (
	x: TIn,
	acc: TAccum
	i: number
	) => TAsyncIterator<TOut, TAccum>

# ---------------------------------------------------------------------------
# --- Variant 1, no accumulator, just iterator

export function MAPv1<TIn, TOut, TAccum extends TNonFunction>(
		lItems:  TIn[] | TIterator<TIn>
		mapFunc: TMapper<TIn, TOut>
		): TIterator<TOut>

	for value,i of allValuesFrom(lItems)
		yield* mapFunc(value, i)

# ---------------------------------------------------------------------------
# --- Variant 2, only accumulator, no iterator

export function MAPv2<TIn, TOut, TAccum extends TNonFunction>(
		lItems:  TIn[] | TIterator<TIn>
		acc: TAccum
		mapFunc: TAccumMapper<TIn, TAccum>
		): TAccum

	for value,i of allValuesFrom(lItems)
		acc = mapFunc(value, acc, i)
	return acc

# ---------------------------------------------------------------------------
# --- Variant 3, iterator with accumulator

export function MAPv3<TIn, TOut, TAccum extends TNonFunction>(
		lItems:  TIn[] | TIterator<TIn>
		acc: TAccum
		mapFunc: TBothMapper<TIn, TOut, TAccum>
		): TIterator<TOut, TAccum>

	for value,i of allValuesFrom(lItems)
		acc = yield* mapFunc(value, acc, i)
	return acc

# ---------------------------------------------------------------------------
# --- Variant 4, async input, no accumulator
# ASYNC

export function MAPv4<TIn, TOut, TAccum extends TNonFunction>(
		lItems:  TIn[] | TIterator<TIn> | TAsyncIterator<TIn>
		mapFunc: TMapper<TIn, TOut> | TAsyncMapper<TIn, TOut>
		nothing: void
		): TAsyncIterator<TOut>

	for await value,i of allValuesFromAsync(lItems)
		yield* await mapFunc(value, i)
	return

# ---------------------------------------------------------------------------
# --- Variant 5, async input, only accumulator
# ASYNC

export function MAPv5<TIn, TOut, TAccum extends TNonFunction>(
		lItems:  TIn[] | TIterator<TIn> | TAsyncIterator<TIn>
		acc: TAccum
		mapFunc: TAccumMapper<TIn, TAccum> | TAsyncAccumMapper<TIn, TAccum>
		): TAccum?

	for await value,i of allValuesFromAsync(lItems)
		acc = await mapFunc(value, acc, i)
	return Promise.resolve(acc)

# ---------------------------------------------------------------------------
# --- Variant 6, async input, iterator with accumulator
# ASYNC

export function MAPv6<TIn, TOut, TAccum extends TNonFunction>(
		lItems: TIn[] | TIterator<TIn> | TAsyncIterator<TIn>
		acc: TAccum
		mapFunc: TBothMapper<TIn, TOut, TAccum> | TAsyncBothMapper<TIn, TOut, TAccum>
		): TAsyncIterator<TOut, TAccum>

	for await value,i of allValuesFromAsync(lItems)
		acc = yield* await mapFunc(value, acc, i)
	return Promise.resolve(acc)

# ---------------------------------------------------------------------------

# --- Variant 1, no accumulator
#     NOT ASYNC
export function MAP<TIn, TOut, TAccum extends TNonFunction>(
		lItems:  TIn[] | TIterator<TIn>
		mapFunc: TMapper<TIn, TOut>
		nothing: void
		): TIterator<TOut>

# --- Variant 2, only accumulator
#     NOT ASYNC
export function MAP<TIn, TOut, TAccum extends TNonFunction>(
		lItems:  TIn[] | TIterator<TIn>
		acc: TAccum
		mapFunc: TAccumMapper<TIn, TAccum>         # plain function
		): TAccum

# --- Variant 3, iterator with accumulator
#     NOT ASYNC
export function MAP<TIn, TOut, TAccum extends TNonFunction>(
		lItems:  TIn[] | TIterator<TIn>
		acc: TAccum
		mapFunc: TBothMapper<TIn, TOut, TAccum>
		): TIterator<TOut, TAccum>

# --- Variant 4, possibly async input, no accumulator
#     ASYNC
export function MAP<TIn, TOut, TAccum extends TNonFunction>(
		iter: TIn[] | TIterator<TIn> | TAsyncIterator<TIn>
		mapFunc: TMapper<TIn, TOut> | TAsyncMapper<TIn, TOut>
		nothing: void
		): TAsyncIterator<TOut>

# --- Variant 5, possibly async input, only accumulator
#     ASYNC
export function MAP<TIn, TOut, TAccum extends TNonFunction>(
		iter: TIn[] | TIterator<TIn> | TAsyncIterator<TIn>
		acc: TAccum
		mapFunc: TAsyncAccumMapper<TIn, TAccum> | TAccumMapper<TIn, TAccum>
		): Promise<TAccum>

# --- Variant 6, possibly async input, iterator with accumulator
#     ASYNC
export function MAP<TIn, TOut, TAccum extends TNonFunction>(
		iter: TIn[] | TIterator<TIn> | TAsyncIterator<TIn>
		acc: TAccum
		mapFunc: TAsyncBothMapper<TIn, TOut, TAccum> | TBothMapper<TIn, TOut, TAccum>
		): TAsyncIterator<TOut, TAccum, void>

export function MAP<TIn, TOut, TAccum extends TNonFunction>(
		lItems:  TIn[] | TIterator<TIn> | TAsyncIterator<TIn>
		arg2: TMapper<TIn, TOut> | TAsyncMapper<TIn, TOut> | TAccum
		arg3: TAccumMapper<TIn, TAccum> | TBothMapper<TIn, TOut, TAccum> | void
		): TIterator<TOut> |              # variant 1
			TAccum |                       # variant 2
			TIterator<TOut, TAccum> |      # variant 3
			TAsyncIterator<TOut> |         # variant 4
			Promise<TAccum> |              # variant 5
			TAsyncIterator<TOut, TAccum>   # variant 6

	if isAsyncIterator(lItems)
		if isFunction(arg2)
			mapFunc := arg2
			trace "mapFunc is type '#{jsType(mapFunc)}'"
			return MAPv4 lItems, mapFunc
		else
			acc := arg2
			mapFunc := arg3
			obviously not isFunction(acc)
			obviously isFunction(mapFunc)
			trace "mapFunc is a '#{jsType(mapFunc)}'"
			if isGeneratorFunction(mapFunc)
				# --- 3rd arg to MAPv6 is a generator function
				# @ts-ignore
				return MAPv6 lItems, acc, mapFunc
			else
				# --- 3rd arg to MAPv5 is a plain function
				# @ts-ignore
				return MAPv5 lItems, acc, mapFunc
	else
		if isFunction(arg2)
			mapFunc := arg2
			trace "mapFunc is a '#{jsType(mapFunc)}'"
			if (jsType(mapFunc) == 'asyncGenerator')
				# @ts-ignore
				return MAPv4 lItems, mapFunc
			else
				# @ts-ignore
				return MAPv1 lItems, mapFunc
		else
			acc := arg2
			mapFunc := arg3
			obviously not isFunction(acc)
			obviously isFunction(mapFunc)
			trace "mapFunc is a '#{jsType(mapFunc)}'"
			if isAsyncGeneratorFunction(mapFunc)
				# --- 3rd arg is an async generator function
				# @ts-ignore
				return MAPv5 lItems, acc, mapFunc
			else if isGeneratorFunction(mapFunc)
				# --- 3rd arg is a generator function
				# @ts-ignore
				return MAPv3 lItems, acc, mapFunc
			else
				# --- 3rd arg is a plain function
				# @ts-ignore
				return MAPv2 lItems, acc, mapFunc

# ---------------------------------------------------------------------------
# HYBRID

export function mkArray<TIn, TOut>(
		lItems: TIn[] | TIterator<TIn>
		mapFunc: TMapper<TIn, TOut>
		): TOut[]

export function mkArray<TIn, TOut>(
		lItems: TAsyncIterator<TIn>
		mapFunc: TMapper<TIn, TOut> | TAsyncMapper<TIn, TOut>
		): Promise<TOut[]>

export function mkArray<TIn, TOut>(
		lItems: TIn[] | TIterator<TIn> | TAsyncIterator<TIn>
		mapFunc: TMapper<TIn, TOut> | TAsyncMapper<TIn, TOut>
		): TOut[] | Promise<TOut[]>

	iter := MAP lItems, mapFunc
	return isAsyncIterator(iter) ? Array.fromAsync(iter) : Array.from(iter)

# ---------------------------------------------------------------------------

export function accum<TIn, TAccum>(
		lItems:  TIn[] | TIterator<TIn>
		acc: TAccum
		mapFunc: TAccumMapper<TIn, TAccum>
		): TAccum

export function accum<TIn, TAccum>(
		lItems: TIn[] | TIterator<TIn> | TAsyncIterator<TIn>
		acc: TAccum
		mapFunc: TAccumMapper<TIn, TAccum> | TAsyncAccumMapper<TIn, TAccum>
		): Promise<TAccum>

export function accum<TIn, TAccum>(
		lItems: TIn[] | TIterator<TIn> | TAsyncIterator<TIn>
		acc: TAccum
		mapFunc: TAsyncAccumMapper<TIn, TAccum> | TAccumMapper<TIn, TAccum>
		): Promise<TAccum>

	return MAP lItems, acc, mapFunc

# ---------------------------------------------------------------------------

# --- Variant 3, iterator with accumulator
#     NOT ASYNC

export function getBoth<TIn, TOut, TAccum>(
		lItems:  TIn[] | TIterator<TIn>
		acc: TAccum
		mapFunc: TBothMapper<TIn, TOut, TAccum>
		): [TOut[], TAccum]

	return arrayAndAccumFrom(MAP lItems, acc, mapFunc)
