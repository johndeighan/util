# html-window.lib.civet

import {createResponse} from '@mwid/better-sse'
import {WebUI} from '@webui'
import {render} from 'npm-pug'

import {LOG, DBG, ERR} from 'logger'
import {
	undef, defined, notdefined, croak, assert, matches,
	} from 'base'
import {
	TVoidFunc, hash, hashof, TStringMapper, TAsyncStringMapper,
	} from 'datatypes'
import {getOptions, abbrevStr} from 'llutils'
import {DUMP} from 'nice'
import {mkpath, withExt, slurp, barf, isFile, isDir} from 'fsys'
import {civet2js} from 'llcivet'

# ---------------------------------------------------------------------------

export isHTML := (str: string): boolean =>

	return matches str, ///^
		( \s* \<!DOCTYPE .*? \> )?
		\s* \< html
		.*
		\< \/ html \> \s*
		$///s

# ---------------------------------------------------------------------------

export isPug := (str: string): boolean =>

	return matches str, ///^
		( doctype \s html \s)?
		html
		///s

# ---------------------------------------------------------------------------

export pug2html := (
		code: string,
		hData: hash = {}
		): string =>

	return render(code, hData)

# ---------------------------------------------------------------------------
# ASYNC

export pug2htmlFile := (
		path: string,
		hData: hash = {}
		): void =>

	code := await Deno.readTextFile path
	html := render code, hData
	await Deno.writeTextFile withExt(path, '.html'), html
	return

# ---------------------------------------------------------------------------
# uses deno-webui
# see https://webui.me/docs.html#/deno

# --- Define blissPlus functions

blissPlusStr := """
	function elem(tag, h) {
		if (
					(typeof h === 'string')
				|| (typeof h === 'number')
				|| (h instanceof Element)
				|| Array.isArray(h)
				) {
			return $.create(tag, {contents: h});
			}
		else {
			return $.create(tag, h);
			}
		}
	"""

export class CHtmlWindow

	window = new WebUI()
	initialized: boolean = false
	root: string

	source: string
	userScript: string?

	html: string = ''        # --- actual HTML
	jsCode: string? = undef  # --- actual JavaScript

	codeConverter: TStringMapper | TAsyncStringMapper
	htmlConverter: TStringMapper | TAsyncStringMapper

	bliss: boolean
	blissPlus: boolean

	# ..........................................................

	constructor(
			@root: string
			@source: string
			@userScript: string? = undef
			@hOptions: hash = {}
			)

		# --- unpack options
		type opt = {
			isPublic: boolean
			width: number
			height: number
			codeConverter: TStringMapper | TAsyncStringMapper
			htmlConverter: TStringMapper | TAsyncStringMapper
			bliss: boolean
			blissPlus: boolean
			}
		{
			isPublic
			width
			height
			htmlConverter: @htmlConverter
			codeConverter: @codeConverter
			bliss: @bliss
			blissPlus: @blissPlus
			} := getOptions<opt> @hOptions, {
				isPublic: true
				width: 800
				height: 600
				htmlConverter: pug2html
				codeConverter: civet2js
				bliss: true
				blissPlus: true
				}

		@window.setRootFolder @root
		@window.setPublic isPublic
		@window.setSize(width, height)

	# ..........................................................
	# ASYNC

	initialize(): void

		@html = await (
			if isHTML(@source)
				@source
			else
				src := await @htmlConverter(@source)
				assert isHTML(src), "Bad HTML source: #{abbrevStr(@source)}"
				src
			)

		@html = @html.replace
			'</html>'
			"""
				<script src="webui.js"></script>
				</html>
				"""

		if @bliss
			@html = @html.replace
				'</html>'
				"""
					<script src="https://cdnjs.cloudflare.com/ajax/libs/blissfuljs/1.0.6/bliss.min.js"></script>
					</html>
					"""

		if @blissPlus
			@html = @html.replace
				'</html>'
				"""
					<script>#{blissPlusStr}</script>
					</html>
					"""

		if @userScript
			jsCode := await @codeConverter(@userScript)
			@html = @html.replace
				'</html>'
				"<script>#{jsCode}</script></html>"
		@initialized = true

	# ..........................................................
	# ASYNC

	show(): void

		if not @initialized
			await @initialize()
			@initialized = true

		await @window.showBrowser @html, WebUI.Browser.ChromiumBased
		return

	# ..........................................................
	# ASYNC

	run(code: string): void

		if not @initialized
			await @initialize()
			@initialized = true

		jsCode := await @codeConverter code
		@window.run jsCode
		return

	# ..........................................................
	# ASYNC

		if not @initialized
			await @initialize()
			@initialized = true

	script(code: string): unknown

		jsCode := await @codeConverter code
		return @window.script jsCode

	# ..........................................................

	close(): void

		await @window.close()

	# ..........................................................

	[Symbol.dispose](): void

		console.log "disposing HTML window"
		await WebUI.exit()
		console.log "cleaning up HTML window"
		await WebUI.clean()
