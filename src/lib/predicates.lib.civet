# predicates.lib.civet

import {
	undef, defined, notdefined, integer,
	} from 'datatypes'

export type TPredicate<T=unknown> = (item: T) => boolean
export type TNoArgPredicate = () => boolean

# ---------------------------------------------------------------------------

export isEven := (i: integer): boolean =>

	return (i % 2 == 0)

# ---------------------------------------------------------------------------

export isOdd := (i: integer): boolean =>

	return (i % 2 == 1)

# ---------------------------------------------------------------------------

export anyOf := <T>(
		lItems: T[],
		checkFunc: TPredicate<T>
		): boolean =>

	for item of lItems
		if checkFunc(item)
			return true
	return false

# ---------------------------------------------------------------------------

export allOf := <T>(
		lItems: T[],
		checkFunc: TPredicate<T>
		): boolean =>

	for item of lItems
		if not checkFunc(item)
			return false
	return true
