# iter-utils.lib.civet

import {getErrStr, croak, assert, obviously} from 'croak'
import {
	sleep, undef, defined, notdefined,
	} from 'base-utils'
import {TIterator, TAsyncIterator, isArray} from 'datatypes'

# ---------------------------------------------------------------------------

export arrayAndAccumFrom := <TOut, TAccum>(
		iter: Generator<TOut, TAccum, void>
		): [TOut[], TAccum] ->

	let lItems: TOut[] = []
	let finalVal: TAccum? = undef
	loop
		{value, done} := iter.next()
		if done
			finalVal = value
			break
		else
			lItems.push value
	return [lItems, finalVal]

# ---------------------------------------------------------------------------
# ASYNC - returns a Promise<[TOut[], TAccum]

export asyncArrayAndAccumFrom := <TOut, TAccum>(
		iter: AsyncGenerator<TOut, TAccum, void>
		): Promise<[TOut[], TAccum]> ->

	let lItems: TOut[] = []
	let finalVal: TAccum? = undef
	loop
		{value, done} := await iter.next()
		if done
			finalVal = value
			break
		else
			lItems.push value
	return new Promise (resolve, reject) =>
		try
			resolve [lItems, finalVal]
		catch err
			reject err

# ---------------------------------------------------------------------------

export allValuesFrom := <T>(
		lItems: T[] | TIterator<T>
		): TIterator<T> ->

	iter := isArray(lItems) ? lItems.values() : lItems
	loop
		{value, done} := iter.next()
		if done
			break
		else
			yield value
	return

# ---------------------------------------------------------------------------

export allValuesFromAsync := <T>(
		lItems: T[] | TIterator<T> | TAsyncIterator<T>
		): TAsyncIterator<T> ->

	iter := isArray(lItems) ? lItems.values() : lItems
	loop
		{value, done} := await iter.next()
		if done
			break
		else
			yield value
	return

# ---------------------------------------------------------------------------

export accumFrom := <TIn, TAccum>(
		lItems: TIn[] | TIterator<TIn, TAccum>
		initAcc: TAccum? = undef
		): TAccum? =>

	iter := isArray(lItems) ? lItems.values() : lItems
	loop
		{value, done} := iter.next()
		if done
			return value

# ---------------------------------------------------------------------------

export accumFromAsync := <TIn, TAccum>(
		lItems: TIn[] | TIterator<TIn, TAccum> | TAsyncIterator<TIn, TAccum>
		initAcc: TAccum? = undef
		): TAccum? =>

	iter := isArray(lItems) ? lItems.values() : lItems
	loop
		{value, done} := await iter.next()
		if done
			return Promise.resolve(value)

# ---------------------------------------------------------------------------
# ASYNC

export generateAsync := <T>(
		lItems: T[],
		sleepFor = 1
		): AsyncGenerator<T> ->

	for item of lItems
		await sleep(sleepFor)
		yield item
	return

# ---------------------------------------------------------------------------
