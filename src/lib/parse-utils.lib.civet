# parse-utils.lib.civet

import {sprintf} from '@std/fmt/printf'

import {LOG, DBG, ERR} from 'logger'
import {
	undef, defined, notdefined, croak, assert, colorize,
	} from 'base'
import {uni, esc} from 'unicode'
import {hash, hashof, isArray} from 'datatypes'
import {centered, sep, f} from 'llutils'
import {OL, LOGVALUE} from 'nice'
import {TextTable} from 'text-table'

# ---------------------------------------------------------------------------

export slot := (
		name: string
		width: number
		): [string, string] =>

	switch width
		case 0:
			return ['', '']
		case 1:
			return [
				uni.vbar
				name[0]
			]
		case 2:
			return [
				uni.blcorner + uni.brcorner
				name.substring(0, 2)
			]
		default:
			return [
				uni.blcorner + uni.hbar.repeat(width - 2) + uni.brcorner
				centered(name.substring(0, width), {char: ' ', width})
			]

# ---------------------------------------------------------------------------

export type TStrLoc =
	pos: number
	length: number

export type TParseMatch = [
	name: string,
	pos: number,
	len: number
	data: unknown
	]

# ---------------------------------------------------------------------------

export class CParseMatches

	str: string = ''
	lParseMatches: TParseMatch[] := []

	# ..........................................................

	reset(text: string): void

		@lParseMatches.length = 0
		@str = text
		return

	# ..........................................................

	match(
			name: string,
			loc: TStrLoc | [number, number]
			): void

		[pos, len] := (
			if isArray(loc)
				[loc[0], loc[1]]
			else
				[loc.pos, loc.length]
			)
		@lParseMatches.push [name, pos, len, undef]
		return

	# ..........................................................

	returnVal(
			value: unknown
			): unknown

		assert (@lParseMatches.length > 0), "No matches yet"
		@lParseMatches[@lParseMatches.length - 1][3] = value
		return value

	# ..........................................................

	matchesTable(): string

		try
			table := new TextTable "l r%d r%d l"
			table.fullsep '-'
			table.title 'matches'
			table.fullsep '-'
			table.labels ['Op', 'Pos', 'Len', 'data']
			table.sep()
			for [name, pos, len, value] of @lParseMatches
				table.data [
					name
					pos
					len
					value
					]
			table.fullsep '-'
			return table.asString()
		catch err
			ERR "Can't build matches table"
			LOGVALUE @lParseMatches, 'lParseMatches'
			throw err

	# ..........................................................

	debugStr(
			str: string,
			hReplace: hashof<string> = {}
			): string

		n := @lParseMatches.length
		lLineNum: number[] := new Array<number>(n).fill 0
		lLines: string[] := []
		let nRemaining = n
		let lineNum = 0
		while nRemaining > 0
			let line1 = ''
			let line2 = ''
			lineNum += 1
			let linePos = 0
			let i1 = 0
			for [name, pos, len] of @lParseMatches
				i := i1++
				if (pos >= linePos) && (lLineNum[i] == 0)
					line1 += ' '.repeat(pos - linePos)
					line2 += ' '.repeat(pos - linePos)
					[str1, str2] := slot hReplace[name] || name, len
					line1 += str1
					line2 += str2
					lLineNum[i] = lineNum
					nRemaining -= 1
					linePos = pos + len
			lLines.push line1, line2
		return esc(str) + '\n' + lLines.join('\n')

	# ..........................................................

	dumpParseInfo(): void

		# --- display the string along with
		#     whatever matches have already been found
		LOG @matchesTable()

		LOG sep '-', 'debug'
		LOG colorize("|    .    ".repeat(7).trim(), 'yellow')
		LOG @debugStr(@str)
		LOG sep '-'
		return
