		): string =>

	return Deno.makeTempFileSync {suffix}

# ---------------------------------------------------------------------------

export type TAssertFunc = (
		cond: unknown,
		msg: string
		) => asserts cond

export assert: TAssertFunc := (
		cond: unknown,
		msg: string
		): asserts cond =>

	if not cond
		croak msg
	return

type TObviouslyFunc = (
		cond: unknown,
		condStr?: string
		) => asserts cond

export obviously: TObviouslyFunc := (
		cond: unknown
		condStr: string = ''
		): asserts cond =>

	if not cond
		croak "#{condStr || 'condition'} not obviously true"
		Deno.exit()
	return

