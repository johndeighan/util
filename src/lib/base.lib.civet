# base.lib.civet

import {
	cyan, blue, black, red, green, magenta, yellow,
	stripAnsiCode,
	} from '@std/fmt/colors'
import {AssertionError} from '@std/assert'
import {SourceMapConsumer} from '@mozilla/source-map'
import {resolve, relative, isAbsolute} from '@std/path'
import {TextLineStream} from '@std/streams'
import deepEqual from 'npm-fast-deep-equal'
import {existsSync, emptyDirSync, ensureDirSync} from '@std/fs'
import {sprintf} from '@std/fmt/printf'
import {expandGlobSync} from '@std/fs/expand-glob'

encoder := new TextEncoder()

export {deepEqual}
export deepCopy = structuredClone

# ---------------------------------------------------------------------------

export type TIterator<T, U=void, V=void> = Generator<T, U, V>
export type TAsyncIterator<T, U=void, V=void> = AsyncGenerator<T, U, V>
export type TNonFunction<T=unknown> = Exclude<T, Function>

# ---------------------------------------------------------------------------

export findFile := (
		fileName: string
		root: string = Deno.cwd()
		): string? =>

	assert not root.endsWith('/'), "Bad root: #{root}"

	let foundPath: string? = undef
	for {path} of expandGlobSync "#{root}/**/#{fileName}", {
			root
			includeDirs: false
			canonicalize: false
			}
		if defined(foundPath)
			croak "Multiple files named #{fileName} found in #{root}"
		else
			foundPath = normalizePath path
	return foundPath

# ---------------------------------------------------------------------------

export pass := (): void =>
	# do nothing

# ---------------------------------------------------------------------------
# ASYNC

export sleep := (sec: number): void =>

	await new Promise((r) => setTimeout r, 1000 * sec)
	return

# ---------------------------------------------------------------------------

export undef := undefined
type TDefined = NonNullable<unknown>
type TNotDefined = null | undefined

# ---------------------------------------------------------------------------

export defined := (x: unknown): x is TDefined =>

	return (x != undef) && (x != null)

# ---------------------------------------------------------------------------

export anyDefined := (...lItems: unknown[]): boolean =>

	for item of lItems
		if defined(item)
			return true
	return false

# ---------------------------------------------------------------------------

export notdefined := (x: unknown): x is TNotDefined =>

	return (x == undef) || (x == null)

# ---------------------------------------------------------------------------

export anyNotDefined := (...lItems: unknown[]): boolean =>

	for item of lItems
		if notdefined(item)
			return true
	return false

# ---------------------------------------------------------------------------
#             LOGGING
# ---------------------------------------------------------------------------

let debugFilePath: string? = undef
let indentLevel = 0
let lLogLines: string[] = []

export INDENT := Symbol 'indent'
export UNDENT := Symbol 'undent'

export type TLogLevel = 'silent' | 'info' | 'debug'
let lLogLevels: TLogLevel[] = ['info']

# ---------------------------------------------------------------------------

export curLogLevel := (): TLogLevel =>

	return (lLogLevels.length == 0) ? 'info' : lLogLevels[lLogLevels.length-1]

# ---------------------------------------------------------------------------

export initLogLevel := (
		level: TLogLevel
		): void =>

	lLogLevels = [level]
	console.log "LOG LEVEL set to #{level}"
	return

# ---------------------------------------------------------------------------

export pushLogLevel := (
		level: TLogLevel
		): void =>

	lLogLevels.push level
	return

# ---------------------------------------------------------------------------

export popLogLevel := (): TLogLevel =>

	if (lLogLevels.length == 0)
		return 'info'
	else
		result := lLogLevels.pop()
		return result || 'info'

# ---------------------------------------------------------------------------

export openDebugFile := (stub: string): void =>

	debugFilePath := "src/logs/#{stub}.log"
	return

# ---------------------------------------------------------------------------

export closeDebugFile := (stub: string): void =>

	debugFilePath = undef
	return

# ---------------------------------------------------------------------------

export appendDebugFile := (
		...lItems: unknown[]
		): void =>

	if defined(debugFilePath)
		for item of lItems
			Deno.writeTextFileSync debugFilePath, String(item) + "\n", {
				append: true
				}
	return

# ---------------------------------------------------------------------------

export LOG := (
		...lItems: unknown[]
		): void =>

	if (curLogLevel() == 'silent')
		return
	for item of lItems
		if (item == INDENT)
			indentLevel += 1
		else if (item == UNDENT)
			if (indentLevel > 0)
				indentLevel -= 1
		else
			logLine item
	return

# ---------------------------------------------------------------------------

export DBG := (
		...lItems: unknown[]
		): void =>

	if (curLogLevel() == 'debug')
		LOG ...lItems
		if defined(debugFilePath)
			appendDebugFile ...lItems
	return

# ---------------------------------------------------------------------------

export WARN := (
		msg: string
		label: string = 'WARNING'
		): void =>

	if (curLogLevel() != 'silent')
		console.error "#{cyan(label)}: #{msg}"
	return

# ---------------------------------------------------------------------------

export ERR := (
		err: unknown
		label: string = 'ERROR'
		): void =>

	errMsg := getErrStr(err)
	console.error red(label) + ': ' + errMsg
	lLogLines.push errMsg
	return

# ---------------------------------------------------------------------------

logLine := (
		x: unknown,
		): void =>

	line := '\t'.repeat(indentLevel) + String(x)
	console.log line
	lLogLines.push line
	return

# ---------------------------------------------------------------------------

export clearLog := (): void =>

	lLogLines.length = 0
	return

# ---------------------------------------------------------------------------

export getLog := (): string =>

	return lLogLines.join('\n')

# ---------------------------------------------------------------------------
# ---------------------------------------------------------------------------

export max := (x: number, y: number): number =>

	return (x > y) ? x : y

# ---------------------------------------------------------------------------

export range := (n: number): TIterator<number> ->

	for i of [0...n]
		yield i
	return

# ---------------------------------------------------------------------------
#              File System Utils
# ---------------------------------------------------------------------------

export normalizePath := (
		path: string
		): string =>

	newpath := path.replaceAll '\\', '/'
	if (newpath.charAt(1) == ':')
		return newpath.charAt(0).toUpperCase() + newpath.substring(1)
	else
		return newpath

# ---------------------------------------------------------------------------

export fileExt := (path: string): string =>

	lMatches := path.match(/\.[^\.]+$/)
	return lMatches ? lMatches[0] : ''

# ---------------------------------------------------------------------------

export withExt := (path: string, ext: string): string =>

	assert ext.startsWith('.'), "Bad file extension: #{ext}"
	pos := path.lastIndexOf '.'
	assert (pos >= 0), "path contains no period: #{path}"
	return normalizePath path.substring(0, pos) + ext

# ---------------------------------------------------------------------------

export toRelPath := (
		path: string,
		root: string = Deno.cwd()
		): string =>

	return normalizePath relative(root, path)

# ---------------------------------------------------------------------------

export toFullPath := (
		path: string
		): string =>

	return normalizePath resolve('.', path)

# ---------------------------------------------------------------------------

export isFullPath := (
		path: string
		): boolean =>

	return isAbsolute(path)

# ---------------------------------------------------------------------------

export newerDestFileExists := (
		srcPath: string,
		destPath: string    # --- can be a file extension
		): boolean =>

	# --- source file must exist
	assert existsSync(srcPath), "No such file: #{srcPath}"

	# --- allow passing a file extension for 2nd argument
	if destPath.startsWith('.')
		destPath = withExt(srcPath, destPath)

	if not existsSync(destPath)
		return false
	try
		destms := getFileStats(destPath).mtime
		assert defined(destms)
		srcms  := getFileStats(srcPath).mtime
		assert defined(srcms)
		return (destms > srcms)
	catch err
		return false

# ---------------------------------------------------------------------------

export type TFileStats = {
	isFile: boolean
	isDirectory: boolean
	mtime: Date?
	}

export getFileStats := (
		path: string
		): TFileStats =>

	hStats := Deno.statSync path
	return {
		isFile:      hStats.isFile
		isDirectory: hStats.isDirectory
		mtime:       hStats.mtime || undef
		}

# ---------------------------------------------------------------------------
# ASYNC

export allLinesIn := (
		path: string
		): TAsyncIterator<string> ->

	file := await Deno.open path
	readable := (file.readable
			.pipeThrough(new TextDecoderStream())
			.pipeThrough(new TextLineStream())
			)
	for await line of readable
		yield line
	return

export let onlyThrow = false

# ---------------------------------------------------------------------------
# ASYNC

export mkTempFile := (
		suffix: string
		): string =>

	return await Deno.makeTempFile {suffix}

# ---------------------------------------------------------------------------
# ASYNC

export mkTempFileSync := (
		suffix: string
		): string =>

	return Deno.makeTempFileSync {suffix}

# ---------------------------------------------------------------------------
# ---------------------------------------------------------------------------

export justThrow := (flag: boolean=true): void =>

	onlyThrow = flag
	return

# ---------------------------------------------------------------------------

export type TAssertFunc = (
		cond: unknown,
		msg?: string
		) => asserts cond

export assert: TAssertFunc := (
		cond: unknown,
		msg: string = "An unknown error occurred"
		): asserts cond =>

	if not cond
		croak msg
	return

export obviously: TAssertFunc := (
		cond: unknown
		): asserts cond =>

	if not cond
		croak "condition obviously not true"
	return

# ---------------------------------------------------------------------------
# ---------------------------------------------------------------------------

export type RawSourceMap = {
	version: number;           # The version of the source map spec (usually 3)
	file: string;              # The generated file this map is associated with
	sources: string[];         # Array of URLs to the original source files
	names: string[];           # Array of identifiers (names) used in the mappings
	sourceRoot?: string;       # Optional: URL root for the sources
	sourcesContent?: string[]; # Content of the original source files (optional)
	mappings: string;          # The actual encoded mappings (Base64 VLQ)
	}

export type TFilePosition = {
	source: string
	line: number
	col: number
	}

# ---------------------------------------------------------------------------
# ASYNC

mapPos := (
	filePos: TFilePosition
	): TFilePosition? =>

	{source, line, col} := filePos
	contents := await Deno.readTextFile source
	[code, hSrcMap] := extractSourceMap contents
	if defined(hSrcMap)
		consumer := await new SourceMapConsumer(hSrcMap)
		pos := consumer.originalPositionFor({line, column: col})
		return pos as TFilePosition
	else
		return undef

# ---------------------------------------------------------------------------

mapPosSync := (
	filePos: TFilePosition
	): TFilePosition? =>

	{source, line, col} := filePos
	contents := Deno.readTextFileSync source
	[code, hSrcMap] := extractSourceMap contents
	if defined(hSrcMap)
		[fileNum, srcLine, srcCol] := orgPos hSrcMap, line, col
		return {
			source: hSrcMap.sources[fileNum]
			line: srcLine
			col: srcCol
			}
	else
		return undef

# ---------------------------------------------------------------------------

export extractSourceMap := (
		contents: string
		): [string, RawSourceMap?] =>

	lMatches := contents.match ///^
			(.*)
			\/ \/ \# \s+
			sourceMappingURL=data:application\/json;
			(?:charset=utf-8;)?
			base64,
			(.+)
			$///s
	if (lMatches == null)
		return [contents, undef]
	[_, code, hSrcMapStr] := lMatches
	hSrcMap := JSON.parse(atob(hSrcMapStr)) as RawSourceMap
	{file} := hSrcMap
	hSrcMap.file = toRelPath(file)
	hSrcMap.sources = for path of hSrcMap.sources
		toRelPath(path)
	return [code, hSrcMap]

# ---------------------------------------------------------------------------

type TOrgPos = [fileNum: number, line: number, col: number]
type TCompareResult = -1 | 0 | 1

compare := (
		find: [number, number],
		gen:  [number, number]
		): TCompareResult =>

	return (
		  (find[0] < gen[0]) ? -1
		: (find[0] > gen[0]) ?  1
		: (find[1] < gen[1]) ? -1
		: (find[1] > gen[1]) ?  1
		:                       0
		)

export orgPos := (
		hSrcMap: RawSourceMap,
		findLine: number,
		findCol: number
		): TOrgPos =>

	lMappings := getMappings(hSrcMap.mappings)
	assert (lMappings.length > 0), "Empty mappings array"
	let pos = 0, end = lMappings.length - 1
	while (pos <= end)

		# --- Calculate the middle index
		mid := Math.floor((pos + end) / 2)
		[genLine, genCol, orgFile, orgLine, orgCol] := lMappings[mid]
		switch compare([findLine, findCol], [genLine, genCol])
			when 0
				return [orgFile, orgLine, orgCol]
			when -1
				end = mid - 1;
			when 1
				pos = mid + 1;

	# --- If the loop finishes, the target is not in the array
	if (pos < lMappings.length)
		usePos := (pos == 0) ? pos : pos-1
		[genLine, genCol, orgFile, orgLine, orgCol] := lMappings[usePos]
		return [orgFile, orgLine, orgCol]
	else
		last := lMappings.at(-1)
		assert defined(last)
		[genLine, genCol, orgFile, orgLine, orgCol] := last
		return [orgFile, orgLine, orgCol]

# ---------------------------------------------------------------------------

export getMappings := (
		data: string,
		): number[][] =>

	lMappings: number[][] := []
	var sum: number[] = [0, 0, 0, 0]
	for line,lineNum of data.split(";")
		sum[0] = 0
		decodeLine(line).forEach (p) =>
			for (i of [0...p.length])
				sum[i] += p[i]
			lMappings.push [lineNum, sum[0], sum[1], sum[2], sum[3]]
	return lMappings

# ---------------------------------------------------------------------------

export decodeLine := (line: string): number[][] =>

	if (line == '')
		return []

	return for token of line.split(',')
		lOutput: number[] := []
		let i = 0
		while (i < token.length)
			let v = 0, d = atob("AAA" + token[i]).charCodeAt(2)
			i += 1
			v |= (d & 31)          # put lowest 5 bits of d into v
			let shift = 5
			while (d & 32)         # repeat if high bit of d is set
				d = atob("AAA" + token[i]).charCodeAt(2)
				i += 1
				v |= (d & 31) << shift   # put lowest 5 bits of d into v
				shift += 5
			lOutput.push(v & 1 ? -(v >> 1) : v >> 1) # low bit is sign
		lOutput

# ---------------------------------------------------------------------------
# ---------------------------------------------------------------------------

export type TFrameType = (
	'eval' |
	'native' |
	'constructor' |
	'method' |
	'function' |
	'script' |
	'unknown'
	)

export type TStackFrame = {
	i: number
	type: string
	source: string        # relative file path or 'unknown'
	line: number
	col: number
	name: string          # name of function or method
	}

# ---------------------------------------------------------------------------

export allStackFrames := (
		trace = false
		): TIterator<TStackFrame> ->

	try
		# @ts-ignore
		oldLimit := Error.stackTraceLimit
		# @ts-ignore
		oldPreparer := Error.prepareStackTrace
		# @ts-ignore
		Error.stackTraceLimit = 99

		let prevFrame: TStackFrame? = undefined

		# @ts-ignore
		Error.prepareStackTrace = (error, lOrgFrames) =>

			lFrames: TStackFrame[] := for orgFrame,i of lOrgFrames
				# --- These can be overwritten when using source maps
				let source   = orgFrame.getFileName()
				if source
					source = normalizePath source
				let line     = orgFrame.getLineNumber()
				let col      = orgFrame.getColumnNumber()

				functionName := orgFrame.getFunctionName()
				methodName   := orgFrame.getMethodName()

				# --- if it's a function in a *.ts file,
				#     attempt to use source map
				if source
					if source.match(///ext \: cli \/ \d+_test\.js///)
						continue

					# --- HACK, which hopefully we'll eventually remove
					if source.includes 'src/lib/src/lib/'
						source = source.replace 'src/lib/src/lib/', 'src/lib/'
					if source.includes 'src/test/src/test/'
						source = source.replace 'src/test/src/test/', 'src/test/'
					if source.includes 'src/.temp/src/.temp/'
						source = source.replace 'src/.temp/src/.temp/', 'src/.temp/'

					newFilePos := mapPosSync({source, line, col})
					if defined(newFilePos)
						source = newFilePos.source
						line   = newFilePos.line
						col    = newFilePos.col

				frame: TStackFrame := {
					i
					type: (
						  functionName             ? 'function'
						: methodName               ? 'method'
						: orgFrame.isToplevel()    ? 'script'
						: orgFrame.isEval()        ? 'eval'
						: orgFrame.isNative()      ? 'native'
						: orgFrame.isConstructor() ? 'constructor'
						:                            'unknown'
						)
					source: source ? toRelPath(source) : ''
					line
					col
					name: functionName || methodName || ''
					}

				# --- fix a bug in the V8 engine where calls inside a
				#     top level anonymous function is reported as
				#     being of type 'script'

				if prevFrame && (frame.type == 'script') && (prevFrame.type == 'script')
					prevFrame.type = 'function'
					prevFrame.name = '<anon>'


				if trace
					dumpFrame frame, 'ORG FRAME'
				prevFrame = frame
				frame

			return lFrames

		obj: Object := {}
		Error.captureStackTrace(obj)
		# @ts-ignore
		lStack: TStackFrame[] := obj.stack

		# --- reset to previous values
		# @ts-ignore
		Error.stackTraceLimit = oldLimit
		# @ts-ignore
		Error.prepareStackTrace = oldPreparer

		for frame of lStack
			yield frame
		return

	catch err
		console.error "#{red('ERROR in allStackFrames:')} #{getErrStr(err)}"
		return

# ---------------------------------------------------------------------------

export dumpFrame := (
		frame: TStackFrame,
		label: string = 'FRAME'
		): void =>

	{i, type, source, line, col, name} := frame
	typeStr := sprintf('%-8s', type)
	nameStr := sprintf('%-16s', name)
	if source
		LOG "#{label}[#{i}]: #{typeStr} #{nameStr} #{source}:#{line}:#{col}"
	else
		LOG "#{label}[#{i}]: #{typeStr} #{nameStr} <none>"
	return

# ---------------------------------------------------------------------------

export getErrStr := (err: unknown): string =>

	if (typeof err == 'string')
		return err
	else if (err instanceof AssertionError)
		errmsg := err.message || '<No message in Error object>'
		return "#{colorize('AssertionError: ', 'red')}#{errmsg}"
	else if (err instanceof Error)
		return err.message || '<No message in Error object>'
	else
		return "Serious Error"

# ---------------------------------------------------------------------------

type TNeverFunc = (err?: unknown) => never

export croak: TNeverFunc := (
		err: unknown = undef
		): never =>

	if notdefined(err)
		throw new Error()
	else
		errMsg := getErrStr(err)
		if onlyThrow
			# --- allows the error to be caught and handled or ignored
			throw new Error(errMsg)
		else
			console.error red('CROAK') + ': ' + errMsg
			console.error "-----  STACK -----"
			for frame of allStackFrames()
				dumpFrame frame
			Deno.exit()

# ---------------------------------------------------------------------------

export TRY := (func: () => void): void =>

	try
		func()
	catch err
		croak err

# ---------------------------------------------------------------------------

export type TPredicate<T=unknown> = (item: T) => boolean

# ---------------------------------------------------------------------------

export toBool := (x: unknown): boolean =>

	return not not x

# ---------------------------------------------------------------------------

export anyOf := <T>(
		lItems: T[],
		checkFunc: TPredicate<T> = (x) => toBool(x)
		): boolean =>

	for item of lItems
		if checkFunc(item)
			return true
	return false

# ---------------------------------------------------------------------------

export allOf := <T>(
		lItems: T[],
		checkFunc: TPredicate<T> = (x) => toBool(x)
		): boolean =>

	for item of lItems
		if not checkFunc(item)
			return false
	return true

# ---------------------------------------------------------------------------
#       mapper()
# ---------------------------------------------------------------------------

type TMapper<TIn, TAccum extends TNonFunction> = (
	x: TIn
	acc: TAccum
	i: number
	) => TAccum

type TAsyncMapper<TIn, TAccum extends TNonFunction> = (
	x: TIn
	acc: TAccum
	i: number
	) => Promise<TAccum>

# ---------------------------------------------------------------------------

isAsyncGeneratorFunction := (
		x: unknown
		): x is AsyncGeneratorFunction =>

	return (
		   (typeof x == 'function')
		&& (x.toString().match(/\basync\s+function\s*\*/) != null)
		)
# ---------------------------------------------------------------------------

# --- Variant 2, only accumulator
#     NOT ASYNC
export function mapper<TIn, TOut, TAccum extends TNonFunction>(
		lItems:  TIn[] | TIterator<TIn>
		acc: TAccum
		mapFunc: TMapper<TIn, TAccum>         # plain function
		): TAccum

# --- Variant 5, possibly async input, only accumulator
#     ASYNC
export function mapper<TIn, TOut, TAccum extends TNonFunction>(
		iter: TIn[] | TIterator<TIn> | TAsyncIterator<TIn>
		acc: TAccum
		mapFunc: TAsyncMapper<TIn, TAccum> | TMapper<TIn, TAccum>
		): Promise<TAccum>

export function mapper<TIn, TOut, TAccum extends TNonFunction>(
		lItems:  TIn[] | TIterator<TIn> | TAsyncIterator<TIn>
		acc: TAccum
		mapFunc: TAsyncMapper<TIn, TAccum> | TMapper<TIn, TAccum>
		): TAccum | Promise<TAccum>

	if (Symbol.asyncIterator in lItems) || isAsyncGeneratorFunction(mapFunc)
		# @ts-ignore
		return mapperv2 lItems, acc, mapFunc
	else
		# @ts-ignore
		return mapperv1 lItems, acc, mapFunc

# ---------------------------------------------------------------------------
# --- Variant 1, only accumulator, no iterator

function mapperv1<TIn, TOut, TAccum extends TNonFunction>(
		lItems:  TIn[] | TIterator<TIn>
		acc: TAccum
		mapFunc: TMapper<TIn, TAccum>
		): TAccum

	for value,i of allValuesFrom(lItems)
		acc = mapFunc(value, acc, i)
	return acc

# ---------------------------------------------------------------------------
# --- Variant 5, async input, only accumulator
# ASYNC

function mapperv2<TIn, TOut, TAccum extends TNonFunction>(
		lItems:  TIn[] | TIterator<TIn> | TAsyncIterator<TIn>
		acc: TAccum
		mapFunc: TMapper<TIn, TAccum> | TAsyncMapper<TIn, TAccum>
		): TAccum?

	for await value,i of allValuesFromAsync(lItems)
		acc = await mapFunc(value, acc, i)
	return Promise.resolve(acc)

# ---------------------------------------------------------------------------

export allValuesFrom := <T>(
		lItems: T[] | TIterator<T>
		): TIterator<T> ->

	iter := Array.isArray(lItems) ? lItems.values() : lItems
	loop
		{value, done} := iter.next()
		if done
			break
		else
			yield value
	return

# ---------------------------------------------------------------------------

export allValuesFromAsync := <T>(
		lItems: T[] | TIterator<T> | TAsyncIterator<T>
		): TAsyncIterator<T> ->

	iter := Array.isArray(lItems) ? lItems.values() : lItems
	loop
		{value, done} := await iter.next()
		if done
			break
		else
			yield value
	return

# ---------------------------------------------------------------------------

export write := (str: string): void =>

	Deno.stdout.writeSync encoder.encode(str)
	return

# ---------------------------------------------------------------------------

export writeln := (str: string = ''): void =>

	write str + '\n'
	return

# ---------------------------------------------------------------------------

export clearScreen := (): void =>

	write '\x1b[H\x1b[2J'
	return

# ---------------------------------------------------------------------------

export resetLine := (): void =>

	write "\x1b[2K"
	return

# ---------------------------------------------------------------------------

export clearPreviousLines := (numLines: number): void =>
	# \x1b[nA moves the cursor up 'n' lines
	# \r moves the cursor to the beginning of the line
	# \x1b[K clears the line from the cursor to the end (optional, but good practice)

	Deno.stdout.writeSync encoder.encode("\x1b[#{numLines}A\r\x1b[K")

# ---------------------------------------------------------------------------

export type TColor = 'cyan'|'blue'|'black'|'red'|'green'|'magenta'|'yellow'

export isColor := (str: string): str is TColor =>

	return ['cyan','blue','black','red','green','magenta','yellow'].includes str

# ---------------------------------------------------------------------------

export colorize := (
		str: string,
		color: string?
		): string =>

	if notdefined(color) || not isColor(color)
		return str
	switch color
		when 'cyan'    then return cyan(str)
		when 'blue'    then return blue(str)
		when 'black'   then return black(str)
		when 'red'     then return red(str)
		when 'green'   then return green(str)
		when 'magenta' then return magenta(str)
		when 'yellow'  then return yellow(str)
		else
			return str

# ---------------------------------------------------------------------------
# --- hColors is {<word>: <color>, ... }

type TColorMap = {
	[word: string]: TColor
	}

export withColors := (
		str: string
		hColors: TColorMap
		): string =>

	for word of Object.keys(hColors)
		color := hColors[word]
		str = str.replaceAll(word, colorize(word, color))
	return str

# ---------------------------------------------------------------------------

export decolorize := (str: string): string =>

	return stripAnsiCode(str)
