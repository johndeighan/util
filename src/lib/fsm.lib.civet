# fsm.lib.civet

import {
	undef, defined, notdefined, croak, assert, obviously,
	TIterator, TAsyncIterator, DBG, pushLogLevel, popLogLevel,
	} from 'base'
import {hash, isArray, isInteger, TVoidFunc} from 'datatypes'
import {f, getOptions} from 'llutils'
import {OL, ML} from 'to-nice'

# ---------------------------------------------------------------------------

export type TState = number

export isStateNum := (x: number): x is TState =>
	return isInteger(x) && (x >= 0)

# --- a TStateFunc throws the final value
export type TStateFunc<T> = (
		item: T,
		i: number
		) => TState

export type TDoneFunc = (state: TState) => void

# ---------------------------------------------------------------------------

export fromFSM := <TIn, TOut=unknown>(
		iter:  TIterator<TIn> | ArrayIterator<TIn>
		lStates: TStateFunc<TIn>[]
		doneFunc: TDoneFunc = (state: TState) =>
			croak("Ended in state #{state}")
		hOptions: hash = {}
		): TOut =>

	type opt = {
		debug: boolean
		}
	{debug} := getOptions hOptions, {
		debug: false
		}

	if debug
		pushLogLevel 'debug'
	numStates := lStates.length
	let state = 0
	try
		for item,i of iter
			stateFunc := lStates[state]
			newState := stateFunc item, i+1  # --- line numbers start at 1
			assert (newState >= 0) && (newState < numStates),
				"Bad state: #{newState}"
			DBG f"#{state}:3 => #{newState}:3 #{OL(item)}"
			state = newState

		DBG "Processed all items, state = #{state}"
		doneFunc(state)    # --- must throw something
		croak "doneFunc failed to throw anything"
	catch x
		if (x instanceof Error)
			throw x
		else
			DBG "END STATE #{state}"
			DBG ML(x)
			return x as TOut
	finally
		if debug
			popLogLevel()
