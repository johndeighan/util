# fsm.lib.civet

import {LOG, DBG, pushLogLevel, popLogLevel} from 'logger'
import {
	undef, defined, notdefined, croak, assert, obviously,
	TIterator, TAsyncIterator, pass,
	} from 'base'
import {
	hash, isArray, isInteger, TVoidFunc,
	isAsyncIterator, isAsyncFunction,
	} from 'datatypes'
import {f, getOptions} from 'llutils'
import {OL, nice} from 'nice'

# ---------------------------------------------------------------------------

export type TState = number

export isStateNum := (x: number): x is TState =>
	return isInteger(x) && (x >= 0)

# --- a TStateFunc can throw the final value
#     for a premature exit
export type TStateFunc<T> = (
		item: T,
		i: number
		) => TState

# --- NOTE: TDoneFunc can only be async if
#           a TAsyncIterator<TIn> is used
export type TDoneFunc<TOut> = (finalState: TState) => TOut

# ---------------------------------------------------------------------------

export defaultDoneFunc := <TOut>(finalState: TState): TOut =>

	throw new Error('No value thrown, no doneFunc provided')

# ---------------------------------------------------------------------------

export fsmSync := <TIn, TOut>(
		iter: ArrayIterator<TIn> | TIterator<TIn>
		lStates: TStateFunc<TIn>[]
		doneFunc: TDoneFunc<TOut> = defaultDoneFunc
		): TOut =>

	let state: TState = 0
	try
		DBG "fsmSync Initial State: #{state}"
		let numItems = 0
		for item,i of iter
			numItems += 1
			DBG "Got item #{item}"
			stateFunc := lStates[state]
			assert defined(stateFunc), "Bad state func (undef)"
			newState := stateFunc item, i
			DBG f"#{state}:3 => #{newState}:3 on item #{OL(item)}"
			assert (0 <= newState < lStates.length),
				"Bad state: #{newState}"
			state = newState
		DBG "Processed all #{numItems} items, state = #{state}"
		return doneFunc(state)
	catch x
		DBG "FAILED in STATE #{state}"
		if (x instanceof Error)
			throw x
		DBG nice(x)
		return x as TOut

# ---------------------------------------------------------------------------
# ASYNC

export fsmAsync := <TIn, TOut>(
		iter: TAsyncIterator<TIn>
		lStates: TStateFunc<TIn>[]
		doneFunc: TDoneFunc<TOut> = defaultDoneFunc
		): Promise<TOut> =>

	let state: TState = 0
	try
		DBG "fsmAsync Initial State: #{state}"
		let numItems = 0
		for await item,i of iter
			numItems += 1
			DBG "Got item #{item}"
			stateFunc := lStates[state]
			assert defined(stateFunc), "Bad state func (undef)"
			newState := stateFunc item, i
			DBG f"#{state}:3 => #{newState}:3 on item #{OL(item)}"
			assert (0 <= newState < lStates.length),
				"Bad state: #{newState}"
			state = newState
		DBG "Processed all #{numItems} items, state = #{state}"
		return await doneFunc(state)
	catch x
		DBG "FAILED in STATE #{state}"
		if (x instanceof Error)
			throw x
		DBG nice(x)
		return x as Awaited<TOut>

# ---------------------------------------------------------------------------

export function fromFSM<TIn, TOut=unknown>(
		iter: TIn[] | TIterator<TIn>
		lStates: TStateFunc<TIn>[]
		doneFunc: TDoneFunc<TOut>
		hOptions: hash
		): TOut

export function fromFSM<TIn, TOut=unknown>(
		iter: TAsyncIterator<TIn>
		lStates: TStateFunc<TIn>[]
		doneFunc: TDoneFunc<TOut>
		hOptions: hash
		): Promise<TOut>

export function fromFSM<TIn, TOut=unknown>(
		iter:  TIn[] | TIterator<TIn> | TAsyncIterator<TIn>
		lStates: TStateFunc<TIn>[]
		doneFunc: TDoneFunc<TOut> = defaultDoneFunc
		hOptions: hash = {}
		): TOut | Promise<TOut>

	type opt = {
		initFunc: TVoidFunc?
		trace: boolean
		}
	{initFunc, trace} := getOptions<opt> hOptions, {
		initFunc: undef
		trace: false
		}

	if trace
		pushLogLevel 'debug'
		DBG "===== FSM ====="
	if defined(initFunc)
		DBG "Running initFunc"
		initFunc()

	# --- determine whether to run sync or async version
	result := (
		if isAsyncIterator(iter)
			DBG "exec fsmAsync"
			fsmAsync iter, lStates, doneFunc
		else if isArray(iter)
			DBG "exec fsmSync for array"
			fsmSync iter.values(), lStates, doneFunc
		else
			DBG "exec fsmSync for iterator"
			fsmSync iter, lStates, doneFunc
		)

	if trace
		popLogLevel()
	return result
