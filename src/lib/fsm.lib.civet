# fsm.lib.civet

import {
	undef, defined, notdefined, croak, assert,
	TIterator, TAsyncIterator, DBG, pass,
	} from 'base'
import {hash, isArray, isInteger, TVoidFunc, isAsyncIterator} from 'datatypes'
import {f, getOptions} from 'llutils'
import {OL, ML} from 'nice'

# ---------------------------------------------------------------------------

export type TState = number

export isStateNum := (x: number): x is TState =>
	return isInteger(x) && (x >= 0)

# --- a TStateFunc throws the final value
export type TStateFunc<T> = (
		item: T,
		i: number
		) => TState

export type TDoneFunc = (state: TState) => void

# ---------------------------------------------------------------------------

export fsmSync := <TIn, TOut>(
		iter: TIterator<TIn> | ArrayIterator<TIn>
		lStates: TStateFunc<TIn>[]
		doneFunc: TDoneFunc
		): TOut =>

	let state: TState = 0
	try
		for item,i of iter
			stateFunc := lStates[state]
			newState := stateFunc item, i
			assert (newState >= 0) && (newState < lStates.length),
				"Bad state: #{newState}"
			DBG f"#{state}:3 => #{newState}:3 #{OL(item)}"
			state = newState
		DBG "Processed all items, state = #{state}"
		doneFunc(state)    # --- must throw something
		croak "doneFunc failed to throw anything"
	catch x
		if (x instanceof Error)
			throw x
		else
			DBG "END STATE #{state}"
			DBG ML(x)
			return x as TOut

# ---------------------------------------------------------------------------
# ASYNC

export fsmAsync := <TIn, TOut>(
		iter: TAsyncIterator<TIn>
		lStates: TStateFunc<TIn>[]
		doneFunc: TDoneFunc
		): TOut =>

	let state: TState = 0
	try
		for await item,i of iter
			stateFunc := lStates[state]
			newState := stateFunc item, i
			assert (newState >= 0) && (newState < lStates.length),
				"Bad state: #{newState}"
			DBG f"#{state}:3 => #{newState}:3 #{OL(item)}"
			state = newState
		DBG "Processed all items, state = #{state}"
		doneFunc(state)    # --- must throw something
		croak "doneFunc failed to throw anything"
	catch x
		if (x instanceof Error)
			throw x
		else
			DBG "END STATE #{state}"
			DBG ML(x)
			return x as Awaited<TOut>

# ---------------------------------------------------------------------------

export function fromFSM<TIn, TOut=unknown>(
		iter: TIterator<TIn> | ArrayIterator<TIn>
		lStates: TStateFunc<TIn>[]
		hOptions: hash
		): TOut

export function fromFSM<TIn, TOut=unknown>(
		iter: TAsyncIterator<TIn>
		lStates: TStateFunc<TIn>[]
		hOptions: hash
		): Promise<TOut>

export function fromFSM<TIn, TOut=unknown>(
		iter:  TIterator<TIn> | ArrayIterator<TIn> | TAsyncIterator<TIn>
		lStates: TStateFunc<TIn>[]
		hOptions: hash = {}
		): TOut | Promise<TOut>

	type opt = {
		initFunc: TVoidFunc
		doneFunc: TDoneFunc
		}
	{initFunc, doneFunc} := getOptions<opt> hOptions, {
		initFunc: pass
		doneFunc: (state: TState) => croak "Ended in state #{state}"
		}

	initFunc()
	return (
		  isAsyncIterator(iter)
		? fsmAsync<TIn,TOut>(iter, lStates, doneFunc)
		: fsmSync<TIn,TOut>(iter, lStates, doneFunc)
		)

