# fsm.lib.civet

import {
	undef, defined, notdefined, croak, assert, obviously,
	TAsyncIterator,
	} from 'base'
import {hash, isArray} from 'datatypes'
import {f} from 'f-strings'
import {DBG, pushLogLevel, popLogLevel} from 'logger'

# ---------------------------------------------------------------------------

export type TState = number

export type TStateFunc<TIn, TOut> = (
		item: TIn,
		i: number
		) => TState
export type TReturnFunc<TOut> = () => TOut

export type TStateDesc<TIn, TOut> = {
	stateFunc: TStateFunc<TIn, TOut>
	retFunc?: TReturnFunc<TOut>
	}

# ---------------------------------------------------------------------------

export isStateNum := (x: number): x is TState =>

	return (x >= 0)

# ---------------------------------------------------------------------------

export fromFSM := <TIn, TOut>(
		lItems:  TIn[]
		lStates: TStateDesc<TIn, TOut>[]
		): TOut =>

	numStates := lStates.length
	try
		let state = 0
		let newState = 0
		DBG "state  new"
		DBG f"#{'-'}:5 #{0}:5"
		for item,i of lItems
			{stateFunc, retFunc} := lStates[state]
			newState = handleItem item, stateFunc, retFunc, i
			DBG f"#{state}:5 #{newState}:5"
			assert (newState >= 0), "Bad new state: #{newState}"
			state = newState

		{retFunc} := lStates[state]
		obviously 0 <= state <= lStates.length
		if defined(retFunc)
			retval := retFunc()
			DBG f"#{state}:5 #{state}:5 #{JSON.stringify(retval)}"
			return retval
		else
			croak "End state #{state} not a final state"
	catch x
		if (x instanceof Error)
			throw x
		else
			return x as TOut

# ---------------------------------------------------------------------------

export fromFSMdebug := <TIn, TOut>(
		lItems:  TIn[]
		lStates: TStateDesc<TIn, TOut>[]
		): TOut =>

	try
		pushLogLevel 'debug'
		result := fromFSM lItems, lStates
		popLogLevel()
		return result
	catch err
		popLogLevel()
		throw err

# ---------------------------------------------------------------------------

handleItem := <TIn, TOut>(
		item:      TIn
		stateFunc: TStateFunc<TIn, TOut>
		retFunc:   TReturnFunc<TOut>?
		i: number
		): TState =>

	result := stateFunc(item, i)

	# --- If we throw, it's a TOut to return to caller of fromFSM
	if isArray(result)
		throw result[1]
	else if (result == -1)
		assert defined(retFunc), "Return -1 without a TReturnFunc"
		throw retFunc()
	else
		return result
