# buildlib.cmd.civet

import {LOG, ERR} from 'logger'
import {
	assert, defined, notdefined,
	} from 'base'
import {o, cmdTitle, EXEC} from 'llutils'
import {getCmdArgs, inspect} from 'cmd-args'
import {withExt, findFile, toRelPath} from 'fsys'
import {execCmd} from 'exec'
import {doCompileCivet} from 'civet'
import {procFiles, procOneFile} from 'proc-files'
import {doUnitTest} from 'compile'

# getCmdArgs """
# 	buildlib -ftI (all | <stub>*)
# 	   -f = force, i.e. always compile
# 	   -t = test, i.e. run unit tests
# 	   -I = use Chrome debugger for compile
# 	   -J = use Chrome debugger for unit test
# 	"""

[
	lStubs
	{force, doTest, inspectTest}
	] := getCmdArgs 'buildlib', {
		_: {range: [1,99]}
		force:       {flag: 'f', desc: 'force build'}
		doTest:      {flag: 't', desc: 'run unit tests'}
		inspectTest: {flag: 'J', desc: 'inspect unit test'}
		}

# ---------------------------------------------------------------------------

await EXEC () =>
	if (lStubs[0] == 'all')
		LOG cmdTitle("BUILD ALL LIBS serially")
		await procFiles [doCompileCivet, ['**/*.lib.civet']], {
			force
			serial: true
			}
		if doTest
			await procFiles [doUnitTest, ['**/*.lib.ts']], {
				capture: false
				}

			# --- Create HTML coverage file
			await execCmd 'deno', ['coverage', '--html']
	else
		for stub of lStubs
			LOG cmdTitle("BUILD LIB #{stub}")

			fileName := "#{stub}.lib.civet"
			path := findFile fileName
			assert defined(path), "No such file: #{fileName}"

			await procOneFile
				path
				doCompileCivet
				{force, inspect}

			if doTest
				LOG cmdTitle("RUN TEST FOR #{stub}")

				tsPath := withExt(path, '.ts')
				await procOneFile tsPath, doUnitTest, {
					capture: true
					inspect: inspectTest
					}
