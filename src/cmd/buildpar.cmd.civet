# buildpar.cmd.civet

import {LOG, DBG, ERR} from 'logger'
import {assert, defined} from 'base'
import {centered, EXEC, cmdTitle} from 'llutils'
import {getCmdArgs, inspect} from 'cmd-args'
import {
	withExt, findFile, parsePath,
	} from 'fsys'
import {doInstallCmd} from 'exec'
import {doCompileCivet} from 'civet'
import {procFiles, procOneFile} from 'proc-files'
import {doCompileHera} from 'hera-compile'
import {doUnitTest} from 'compile'

[
	lStubs
	{force, doTest, inspectTest}  # --- flags
	{traceLib, oneIndent}                  #     string options
	] := getCmdArgs 'buildpar', {
		_:           {range: [1,99], desc: 'list of stubs'}
		force:       {flag: 'f',     desc: 'force build'}
		doTest:      {flag: 't',     desc: 'run unit test(s)'}
		inspectTest: {flag: 'J', desc: 'inspect unit test'}
		}

# ---------------------------------------------------------------------------

hStyle  := {char: '=', color: 'cyan'}
await EXEC () =>
	if (lStubs[0] == 'all')
		console.log centered("BUILD ALL PARSERS", hStyle)
		await procFiles [doCompileHera,  ['src/**/*.parse.hera']], {force}
		if doTest
			await procFiles [doUnitTest, ['src/**/*.parse.ts']]
	else
		for stub of lStubs
			LOG cmdTitle("BUILD PARSER #{stub}")

			fileName := "#{stub}.parse.hera"
			path := findFile fileName
			assert defined(path), "No such file: #{fileName}"
			await procOneFile path, doCompileHera, {force, inspect}
			if doTest
				LOG cmdTitle("RUN TEST FOR #{stub}")

				tsPath := withExt(path, '.ts')
				await procOneFile tsPath, doUnitTest, {
					capture: true
					inspect: inspectTest
					}
