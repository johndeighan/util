# unit-test.cmd.civet

import {
	initLogLevel, LOG, DBG, ERR, curLogLevel, appendDebugFile,
	} from 'logger'
import {undef, defined, notdefined, assert, getErrStr} from 'base'
import {hash} from 'datatypes'
import {f, dashes, EXEC} from 'llutils'
import {
	cmdStep, compileAllLibs, compileAllUnitTests, runAllUnitTests,
	} from 'cmd-utils'
import {OL} from 'nice'
import {parsePath, allFilesMatching, rmDir} from 'fsys'
import {getCmdArgs} from 'cmd-args'
import {runTasks, TTask} from 'run-tasks'

[
	lStubs
	{force, quiet, verbose, box}
	_
	{maxRunning, line: lineNum}
	] := getCmdArgs 'unit-test', {
		_:          {range: [0,99], desc: "stubs to test or 'all'"}
		force:      {flag: 'f', desc: 'force recompile of libs and tests'}
		quiet:      {flag: 'q', desc: 'quiet output'}
		verbose:    {flag: 'v', desc: 'verbose output'}
		maxRunning: {valType: 'integer', desc: 'max running'}
		line:       {valType: 'integer', desc: 'line number to test'}
		box:        {flag: 'b', desc: 'box in procFiles output'}
		}

# ---------------------------------------------------------------------------

EXEC () =>
	if verbose
		LOG "stubs = #{OL(lStubs)}"
		LOG "force = #{OL(force)}"
		LOG "quiet = #{OL(quiet)}"
		LOG "verbose = #{OL(verbose)}"
		LOG "box = #{OL(box)}"

	if not await compileAllLibs()
		Deno.exit -1

	if (lStubs.length == 0) || (lStubs[0] == 'all')
		if not await compileAllUnitTests()
			Deno.exit -1

		Deno.exit 0

		# --- At this point, all libs and unit tests have been compiled

		assert notdefined(lineNum), "Can't use -line with 'all'"
		rmDir './coverage', {clear: true}

		ok := await runAllUnitTests()
		LOG ok ? "OK" : "Failed"

