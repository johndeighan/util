# runtemp.cmd.civet

import {LOG, DBG, ERR} from 'logger'
import {
	undef, defined, notdefined, assert, obviously,
	colorize, croak,
	} from 'base'
import {findFile, withExt, isFile} from 'fsys'
import {execCmd, execTsFile, TExecResult} from 'exec'
import {doCompileCivet} from 'civet'
import {procOneFile} from 'proc-files'
import {f, EXEC} from 'llutils'
import {getCmdArgs, inspect} from 'cmd-args'
import {compileAllLibs} from 'civet'

[
	lNonOptions
	{force, noCompile}
	] := getCmdArgs 'runtemp', {
		_: {range: [0, 1]}
		force:     {flag: 'f', desc: 'force recompile'}
		noCompile: {flag: 'n', desc: 'do not compile all libs first'}
		}

# ---------------------------------------------------------------------------

await EXEC () =>
	if not noCompile
		# --- Compile any changed libraries
		await compileAllLibs()

	# --- compile temp file
	stub := lNonOptions[0] || 'temp'
	LOG colorize("Running #{stub}", 'cyan')
	root := 'src/.temp'

	# --- Make sure the '.temp' folder is NOT ignored
	path := findFile "#{stub}.civet", {
		root
		lIgnoreDirs: []
		}
	if notdefined(path) || not isFile(path)
		croak "Unable to find file: #{stub}.civet in #{root}"
	obviously defined(path)

	# --- compile the temp file
	hResult := await procOneFile path, doCompileCivet, {inspect, force}
	if hResult.success
		# --- Run the temp file
		tsPath := withExt path, '.ts'
		assert isFile(tsPath), "No such file: #{tsPath}"
		result := await execTsFile tsPath, {
			inspect
			capture: false
			}
	else
		console.log "Compile of #{path} failed"
		console.log hResult.stderr
