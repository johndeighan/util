# builddoc.cmd.civet

import {LOG} from 'logger'
import {
	undef, defined, notdefined, assert, croak,
	} from 'base'
import {cmdTitle, EXEC} from 'llutils'
import {getCmdArgs, inspect} from 'cmd-args'
import {findFile, toRelPath} from 'fsys'
import {procFiles, procOneFile} from 'proc-files'
import {doMakeMarkdown} from 'md-macros'

[
	lStubs,
	{force}
	] := getCmdArgs 'builddoc', {
		_: {range: [1,99]}
		force:     {flag: 'f', desc: 'force recompile'}
		}

# ---------------------------------------------------------------------------

await EXEC () =>
	if (lStubs[0] == 'all')
		LOG cmdTitle("BUILD ALL DOCS")
		await procFiles [doMakeMarkdown, ['**/*.doc.$md']], {force}
	else
		for stub of lStubs
			fileName := "#{stub}.doc.$md"
			path := findFile fileName
			assert defined(path), "No such file: #{fileName}"

			LOG cmdTitle("BUILD DOC #{toRelPath(path)}")
			await procOneFile path, doMakeMarkdown, {force}
