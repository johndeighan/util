# build-dot-symbols.cmd.civet

import {
	TRY, toRelPath, LOG, DBG, ERR, assert, TIterator,
	undef, defined, notdefined,
	} from 'base'
import {stdChecks, getOptions} from 'llutils'
import {hash} from 'datatypes'
import {indented} from 'indent'
import {DBGVALUE} from 'to-nice'
import {barf, allFilesMatching, withExt} from 'fsys'
import {CAnalysis, analyzeTsCode} from 'typescript'

# --- These may become command line options later
oneIndent := '\n'
maxLineLen := 75

stdChecks "build-dot-symbols"

# ---------------------------------------------------------------------------
# --- TIterator

allLinesFrom := (
		lExports: string[]
		): TIterator<string> ->

	lSymbols: string[] := []
	let lineLen = 0     # --- always <= maxLineLen
	for name of lExports
		pos := name.indexOf '<'
		sym := (pos == -1) ? name : name.substring(0, pos)
		if (lineLen + sym.length + 1 > maxLineLen)
			yield lSymbols.join(' ')
			lSymbols.length = 0
			lineLen = 0
		else
			lSymbols.push sym
			lineLen += sym.length + 1
	if (lSymbols.length > 0)
		yield lSymbols.join(' ')
	return

# ---------------------------------------------------------------------------

TRY () =>
	lLines: string[] := []
	for path of allFilesMatching('**/*.lib.civet')
		LOG "#{toRelPath(path)}"
		try
			analysis := analyzeTsCode(Deno.readTextFileSync(path))
			lExports := analysis.getExports()
			lLines.push withExt(path, '.ts')
			for line of allLinesFrom lExports
				lLines.push indented(line, 1, {oneIndent})
		catch err
			ERR err
	contents := lLines.join '\n'
	DBGVALUE 'contents', contents
	barf 'src/.symbols', contents

