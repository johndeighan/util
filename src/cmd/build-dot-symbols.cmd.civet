# build-dot-symbols.cmd.civet

import {TRY, toRelPath, LOG, DBG} from 'base'
import {stdChecks} from 'llutils'
import {undef, assert, hash, isEmpty, nonEmpty} from 'datatypes'
import {getOptions, keys} from 'llutils'
import {OL, LOGVALUE, DBGVALUE} from 'to-nice'
import {barf, allFilesMatching} from 'fsys'
import {analyzeTS, CAnalysis} from 'typescript'

stdChecks "build-dot-symbols"

# ---------------------------------------------------------------------------
# --- ASYNC GENERATOR

getDotSymbolsLines := (
		path: string,
		hOptions: hash = {}
		): Generator<string, void, void> ->

	type opt = {
		oneIndent: string
		maxLineLen: number
		}
	{oneIndent, maxLineLen} := getOptions<opt> hOptions, {
		oneIndent: '\t'
		maxLineLen: 75
		}

	lSymbols: string[] := []
	let lineLen = 0     # --- always <= maxLineLen
	let pathYielded = false
	analysis := analyzeTS path
	for name of analysis.getExports()
		pos := name.indexOf '<'
		sym := (pos == -1) ? name : name.substring(0, pos)
		if (lineLen + sym.length + 1 > maxLineLen)
			if not pathYielded
				yield path.replace('.civet', '.ts')
				pathYielded = true
			yield "#{oneIndent}#{lSymbols.join(' ')}"
			lSymbols.length = 0
			lineLen = 0
		else
			lSymbols.push sym
			lineLen += sym.length + 1
	if (lSymbols.length > 0)
		if not pathYielded
			yield path.replace('.civet', '.ts')
			pathYielded = true
		yield "#{oneIndent}#{lSymbols.join(' ')}"
	return

// ---------------------------------------------------------------------------

getDotSymbols := (
		hOptions: hash = {}
		): AsyncGenerator<string, void, void> ->

	for path of allFilesMatching('src/**/*.lib.civet')
		DBG "GET symbols from: #{toRelPath(path)}"
		for await line of getDotSymbolsLines(path)
			yield line
	return

// ---------------------------------------------------------------------------

TRY () =>
	lLines := await Array.fromAsync getDotSymbols()
	contents := lLines.join '\n'
	DBGVALUE 'contents', contents
	barf 'src/.symbols', contents

