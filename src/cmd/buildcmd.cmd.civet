# buildcmd.cmd.civet

import {LOG, DBG, WARN, ERR} from 'logger'
import {assert, defined, croak} from 'base'
import {cmdTitle, EXEC} from 'llutils'
import {getCmdArgs, inspect} from 'cmd-args'
import {withExt, findFile, isFile} from 'fsys'
import {doInstallCmd} from 'exec'
import {doCompileCivet} from 'civet'
import {procFiles, procOneFile} from 'proc-files'
import {doUnitTest} from 'compile'

[
	lStubs,
	{force, noInstall, doTest, inspectTest}
	] := getCmdArgs 'buildcmd', {
		_:           {range: [1,99]}
		force:       {flag: 'f', desc: 'force recompile'}
		noInstall:   {flag: 'n', desc: 'do not install'}
		doTest:      {flag: 't', desc: 'run unit test if it exists'}
		inspectTest: {flag: 'J', desc: 'inspect unit test'}
		}

# ---------------------------------------------------------------------------

await EXEC () =>
	if (lStubs[0] == 'all')
		LOG cmdTitle("BUILD ALL CMDS")
		await procFiles
			[doCompileCivet, ['src/**/*.cmd.civet']],
			{force}
		if doTest
			await procFiles [doUnitTest, ['src/**/*.cmd.ts']], {
				capture: false
				}
		if not noInstall
			await procFiles [doInstallCmd, ['src/**/*.cmd.ts']]
	else
		for stub of lStubs
			LOG cmdTitle("BUILD CMD #{stub}")

			fileName := "#{stub}.cmd.civet"
			path := findFile fileName
			assert defined(path), "No such file: #{fileName}"

			await procOneFile
				path
				doCompileCivet
				{force, inspect}

			tsPath := withExt path, '.ts'
			assert isFile(tsPath), "File #{tsPath} not created"

			if doTest
				LOG cmdTitle("RUN TEST FOR #{stub}")

				tsPath := withExt(path, '.ts')
				await procOneFile tsPath, doUnitTest, {
					capture: true
					inspect: inspectTest
					}

			if not noInstall
				await procOneFile tsPath, doInstallCmd
			else
				LOG "not installed (use -i to install)"
