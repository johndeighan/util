# mapsrc.cmd.civet

import {mapPos} from 'stack'
import {assert, defined} from 'base'
import {EXEC} from 'llutils'
import {looksLikeInteger} from 'datatypes'
import {getCmdArgs} from 'cmd-args'
import {isFile} from 'fsys'

[lArgs] := getCmdArgs 'mapsrc', {
		_: {range: [2,99], desc: 'file path and line numbers'}
		}

# ---------------------------------------------------------------------------

await EXEC () =>
	source := lArgs[0]
	assert defined(source), "Missing file path"
	assert isFile(source), "No such file: #{source}"

	for str,i of lArgs
		if (i == 0)
			# --- skip the path
			continue
		assert defined(str), "Missing line number"
		assert looksLikeInteger(str), "Bad line number: #{str}"

		hPos := await mapPos {
			source
			line: parseInt(str)
			col: 1
			}
		console.log "Line #{str} maps to:"
		console.dir hPos
