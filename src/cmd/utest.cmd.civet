# utest.cmd.civet

import {LOG, DBG, ERR} from 'logger'
import {
	undef, defined, notdefined, assert,
	colorize, decolorize, write, writeln, clearScreen,
	} from 'base'
import {isString} from 'datatypes'
import {f, dashes, EXEC} from 'llutils'
import {cmdStep} from 'cmd-utils'
import {
	isFile, rmDir, withExt, findFile, allFilesMatching,
	parsePath, toRelPath,
	} from 'fsys'
import {execCmd, TExecResult} from 'exec'
import {
	doCompileCivet, compileAllLibs, compileAllUnitTests,
	} from 'civet'
import {
	TProcSpec, execResult, allExecResults,
	} from 'proc-files'
import {LOGVALUE, OL} from 'nice'
import {CTimer} from 'timer'
import {getCmdArgs, inspect} from 'cmd-args'
import {doUnitTest} from 'compile'
import {utTableHeader, utTableSep, utTableRow} from 'unit-test'

[
	lStubs
	{force, quiet, verbose, maxRunning, line: lineNum, box}
	] := getCmdArgs 'utest', {
		_:          {range: [0,99], desc: "stubs to test or 'all'"}
		force:      {flag: 'f', desc: 'force recompile of libs and tests'}
		quiet:      {flag: 'q', desc: 'quiet output'}
		verbose:    {flag: 'v', desc: 'verbose output'}
		maxRunning: {flag: 'm', desc: 'max running'}
		line:       {valType: 'integer', desc: 'line number to test'}
		box:        {flag: 'b', desc: 'box in procFiles output'}
		}

# ---------------------------------------------------------------------------

await EXEC () =>
	debugger
	try
		LOG cmdStep("COMPILE ALL LIBS")
#		await compileAllLibs {force, box}
		LOG "...done"
	catch err
		Deno.exit(-1)

	if (lStubs.length == 0) || (lStubs[0] == 'all')
		try
			LOG cmdStep("COMPILE ALL UNIT TESTS")
#			await compileAllUnitTests {force, box}
			LOG '...done'
		catch err
			Deno.exit(-1)

		# --- At this point, all libs and unit tests have been compiled

		assert notdefined(lineNum), "Can't use -line with 'all'"
		assert not inspect, "Can't use -I with 'all'"
		rmDir './coverage', {clear: true}

		LOG cmdStep("UNIT TEST ALL")
		timer := new CTimer()

		# --- Print the header
		LOG f"#{'Lib'}:-14 #{'OK'}:4 #{'Fail'}:4 #{'Time'}:8"
		LOG [dashes(14), dashes(4), dashes(4), dashes(8)].join(' ')

		LOG utTableHeader()
		LOG utTableSep()
		for path of allFilesMatching '**/*.lib.ts'
			LOG toRelPath(path)
			hResult := await execResult doUnitTest, path
			LOG (hResult.success) ? colorize('OK', 'green') : colorize('Failed', 'red')


	else
		for stub of lStubs
			LOG cmdStep("UNIT TEST #{stub}")
