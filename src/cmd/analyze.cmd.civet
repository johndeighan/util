# analyze.cmd.civet

import {LOG, DBG, ERR} from 'logger'
import {assert, croak, undef, defined, notdefined} from 'base'
import {EXEC} from 'llutils'
import {getCmdArgs} from 'cmd-args'
import {LOGVALUE} from 'nice'
import {findFile, slurp, fileExt, toRelPath} from 'fsys'
import {analyzeTsCode} from 'typescript'
import {civet2ts} from 'civet'

hDesc := {
	_: {range: [1,1]}
	verbose: {flag: 'v', desc: 'dump analysis data structure'}
	}

[[fileName], {verbose}] := getCmdArgs 'analyze', hDesc

# ---------------------------------------------------------------------------

await EXEC () =>
	assert defined(fileName), "No file name provided"
	path := (
		  fileName.match(/[\\\/]/)
		? fileName
		: findFile(fileName, {lIgnoreDirs: []})
		)
	assert defined(path), "No such file: #{fileName}"
	LOG "-----  ANALYZE #{toRelPath(path)}  -----"
	tsCode := switch fileExt(path)
		when '.ts'
			slurp(path)
		when '.civet'
			await civet2ts(slurp path)
		default:
			croak "Bad path: #{path}"

	analysis := analyzeTsCode tsCode, {dumpAST: true, trace: true}
	LOGVALUE analysis, 'ANALYSIS'

	if verbose
		LOGVALUE analysis, 'ANALYSIS'
	else
		LOGVALUE analysis.asString(), 'ANALYSIS'

