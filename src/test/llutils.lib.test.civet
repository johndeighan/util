# llutils.lib.test.civet

import {
	undef, sleep, deepEqual, colorize, decolorize,
	} from 'base'
import {
	functionDef, isArray, isHash, TVoidFunc,
	} from 'datatypes'
import {
	o, s, s2, t, strToHash, getOptions, truncStr,
	keys, hasKey, hasKeys, spaces, tabs,
	ltrim, rtrim, countChars, words, getLineAndColumn,
	blockToArray, allLinesIn, toArray,
	arrayToBlock, toBlock, rpad, lpad,
	TAlignment, isAlignment, alignString, zpad,
	TBlockSpec, isBlockSpec, allMatches,
	blockWidth, blockHeight, CStringSetMap,
	isTAML, fromTAML, f, SKIP, EXEC,
	stdChecks, dashes, sep, centered,
	tabify, untabify, cmdTitle, likeNum,
	} from 'llutils'
import {
	equal, truthy, falsy, succeeds, fails,
	} from 'unit-test'

# ---------------------------------------------------------------------------

truthy deepEqual(2, 2)
truthy deepEqual('a', 'a')
truthy deepEqual(['a','b'], ['a','b'])
falsy  deepEqual(['a','b'], ['a','b','c'])

equal strToHash(''), {}
equal strToHash('x=3.14'), {x: 3.14}
equal strToHash('debug'), {debug: true}
equal strToHash('debug force'), {
	debug: true
	force: true
	}
equal strToHash('debug !force'), {
	debug: true
	force: false
	}
equal strToHash('debug !force  size=3'), {
	debug: true
	force: false
	size: 3
	}
equal strToHash('hide=1,2'), {
	hide: '1,2'
	}

equal o"debug", {debug: true}
equal o"!debug", {debug: false}
equal o"  debug  ", {debug: true}
equal o"  !debug  ", {debug: false}
equal o"debug label=abc n=42", {debug: true, label: 'abc', n: 42}

equal s"\txxx", "   xxx"
equal s"\t\tddd", "      ddd"

equal s2"\txxx", "  xxx"
equal s2"\t\tddd", "    ddd"

equal t"   wer", "\twer"
equal t"      asd", "\t\tasd"

(() =>
	type opt = {
		debug: boolean
		force: boolean
		}
	hDefs: opt := {
		debug: false
		force: false
		}
	equal getOptions<opt>({debug: true}, hDefs), {
		debug: true
		force: false
		}
	equal getOptions<opt>(o'debug', hDefs), {
		debug: true
		force: false
		}
	equal getOptions<opt>(o'!debug', hDefs), {
		debug: false
		force: false
		}
	equal getOptions<opt>(o'debug', hDefs), {
		debug: true
		force: false
		}
	)()

equal keys({a:1, b:2, c:3}), ['a','b','c']

truthy hasKey({a:1, b:2}, 'a')
truthy hasKeys({a:1, b:2}, 'a', 'b')
falsy  hasKey({a:1, b:2}, 'x')
falsy  hasKeys({a:1, b:2}, 'a', 'x')
fails () => hasKey(42, 'a')
fails () => hasKeys(42, 'a')

ms0 := Date.now()
await sleep(2000)   # 2 seconds
truthy (Date.now()-ms0 > 1000)

equal spaces(3), '   '

equal tabs(3), '\t\t\t'
equal tabify('   abc'), '\tabc'
equal untabify('\tabc'), '   abc'

equal dashes(3), '---'

equal ltrim('   \t\tbb'), 'bb'
equal rtrim('bb   \t\t'), 'bb'
equal ltrim('   \t\tbb '), 'bb '
equal rtrim(' bb   \t\t'), ' bb'

equal countChars('abcabcabc', 'a'), 3

equal blockToArray(''), []

equal blockToArray("""
	abcx
	def
	"""), ['abcx','def']

equal Array.from(allLinesIn("""
	abcy
	def
	""")), ['abcy', 'def']

equal Array.from(allLinesIn("""
	qqq

	def
	""")), ['qqq', '', 'def']

equal Array.from(allLinesIn("a\nb\n")), [
	'a'
	'b'
	]

equal Array.from(allLinesIn("abc\n\t/^\\u000f\\u000e]+/\n")), [
	'abc'
	'\t/^\\u000f\\u000e]+/'
	]

truthy isBlockSpec('vvv')
truthy isBlockSpec(['ttt','def'])
falsy  isBlockSpec(42)

equal toArray("aaa\ndef\nx"), ['aaa','def','x']
equal toArray(['a','b']), ['a', 'b']

equal arrayToBlock(['a','b']), 'a\nb'

equal toBlock(['a','b']), 'a\nb'
equal toBlock("bbb\ndef"), "bbb\ndef"

equal words("abc def"), ["abc", "def"]
equal words("abc"), ["abc"]
equal words(""), []
equal words("  "), []
equal words("\t"), []
equal words("  abc  def\t\t"), ["abc", "def"]
equal words(" abc  def", "ghi j "), [
	"abc"
	"def"
	"ghi"
	"j"
	]

equal rpad('abcd', 10, '-'), 'abcd------'

equal lpad('abcd', 10, '-'), '------abcd'

truthy isAlignment('l')
truthy isAlignment('left')
falsy  isAlignment('x')

equal alignString('abc', 5, 'left'), 'abc  '
equal alignString('abc', 5, 'center'), ' abc '
equal alignString('abc', 5, 'right'), '  abc'
equal alignString('abc', 5, 'l'), 'abc  '
equal alignString('abc', 5, 'c'), ' abc '
equal alignString('abc', 5, 'r'), '  abc'

equal zpad(23, 5), '00023'

(() =>
	str := '"a,b", "c,d"'
	re := /"([^"]*)"/
	equal Array.from(allMatches(str, re)).map((x) => x[1]), [
		'a,b'
		'c,d'
		]
	)()

(() =>
	str := 'DBG "type TBlockSpec", "function isBlockSpec"'
	re := ///
		"
		\s*             # optional whitespace
		(?:
			(
				  type
				| const
				| interface
				| enum
				| class
				| function
				)
			\s+
			)?
		([A-Za-z0-9_]+)   # an identifier
		(
			\(
			.*
			\)
			)?
		\s*
		"
		///
	lMatches := Array.from(allMatches(str, re))
	equal lMatches.map((x) => x[1]), ['type', 'function']
	equal lMatches.map((x) => x[2]), ['TBlockSpec', 'isBlockSpec']
	equal lMatches.map((x) => x[3]), [undef, undef]
	)()

(() =>
	str := 'DBG "type TBlockSpec", "function isBlockSpec"'
	re := ///
		"
		\s*             # optional whitespace
		(?:
			(
				  type
				| const
				| interface
				| enum
				| class
				| function
				)
			\s+
			)?
		([A-Za-z0-9_]+)   # an identifier
		(
			\(
			.*
			\)
			)?
		\s*
		"
		///
	lIdents: string[] := []
	for x of allMatches(str, re)
		lIdents.push x[2]
	equal lIdents, ['TBlockSpec', 'isBlockSpec']
	)()

equal getLineAndColumn('abc\ndef\nghi', 5), [2, 2]
equal getLineAndColumn('abcd\nefgh\nijkl', 5), [2, 1]

equal truncStr('abc', 12), 'abc'
equal truncStr('abcdefg', 5), 'ab...'

equal blockWidth("""
	abc
	abcde
	xx
	"""), 5

equal blockWidth("""
	xx
	abc
	abcde
	"""), 5

equal blockWidth("""
	abcde
	abc
	xx
	"""), 5

equal blockHeight("""
	abc
	def
	xx
	"""), 3

equal blockHeight(''), 0

# ---------------------------------------------------------------------------

ss := new CStringSetMap()
ss.add 'llutils', 'pass'
ss.add 'fsys', 'isFile'
ss.add 'llutils', 'require'

truthy ss.hasKey('fsys')
falsy  ss.hasKey('dummy')

truthy ss.hasValue('pass')
falsy  ss.hasValue('dummy')

equal Array.from(ss.allKeys()), ['llutils', 'fsys']
equal Array.from(ss.allValues('llutils')), ['pass','require']

# ---------------------------------------------------------------------------

imports := new CStringSetMap()
imports.add 'llutils', 'sep'
imports.add 'llutils', 'center'
imports.add 'base',    'is'

equal Array.from(imports.allKeys()), ['llutils', 'base']
equal Array.from(imports.allValues('llutils')), ['sep','center']

equal imports.asString(), """
	llutils: sep center
	base: is
	"""

# ---------------------------------------------------------------------------

str := """
	foo: bar
	baz:
		- qux
		- quux
	"""

truthy isTAML(str)

equal fromTAML(str), {
	foo: 'bar'
	baz: ['qux', 'quux']
	}

(() =>
	meaning := 42
	equal f"meaning is #{meaning}:3!",   "meaning is  42"
	equal f"meaning is #{meaning}:",     "meaning is 42:"
	equal f"meaning is #{meaning}: ok?", "meaning is 42: ok?"
	)()

(() =>
	str := 'abc def'
	equal f"str is #{str}",    "str is abc def"
	equal f"str is #{str}:!",  "str is abc˳def"
	equal f"str is #{str}:-10", "str is abc def   "
	)()

# ---------------------------------------------------------------------------

(() =>
	meaning := 42
	str := f":{blue}meaning is #{meaning}:3{red}"
	equal decolorize(str), "meaning is  42"
	)()

succeeds () => stdChecks()

equal sep(), '-'.repeat(64)
equal sep('=', undef, 5), '====='
equal sep('-', 'HI', 10), '--  HI  --'

equal centered('John'), spaces(30) + 'John' + spaces(30)
equal centered('John', {char: '-'}),
	dashes(28) + spaces(2) + 'John' + spaces(2) + dashes(28)

equal decolorize(cmdTitle('THIS')),
	'='.repeat(28) + spaces(2) + 'THIS' + spaces(2) + '='.repeat(28)

truthy likeNum('13')
truthy likeNum('3.14')
truthy likeNum('3.14e12')
truthy likeNum('3.14E12')
falsy  likeNum('abc')

vfunc: TVoidFunc := (): void =>
	console.log 'hello'
	return

succeeds () => EXEC(vfunc)
succeeds () => SKIP(vfunc)
