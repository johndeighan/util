# typescript.lib.test.civet

import {SourceFile} from 'npm:typescript'

import {initLogLevel} from 'logger'
import {undef} from 'base'
import {
	isHash, isEmpty, nonEmpty,
	} from 'datatypes'
import {o, s, t} from 'llutils'
import {slurp, withExt} from 'fsys'
import {
	typeCheckTsFile, typeCheckTsCode, ts2ast,
	kindStr, ast2ts, descFunc, astAsString,
	getSymbolsFromType, AstWalker,
	CAnalysis, getNode, analyzeTsCode,
	} from 'typescript'
import {
	beginUnitTest, setDirTree,
	equal, succeeds, fails, truthy, falsy,
	} from 'unit-test'

[root, r] := beginUnitTest(import.meta.url)

# ---------------------------------------------------------------------------
# ASYNC

setup := (): void ->

	await setDirTree """
		./#{root} clear
		tstest.ts
			const str: string = 'abc'
		tstest2.ts
			const func1 = (str: string): boolean =>
				return true
		ok.ts
			const x: string = 'abc';
		bad.ts
			const x: number = 'abc';
		"""
	return

await setup()

# ---------------------------------------------------------------------------

equal await typeCheckTsCode("let s: string = 'abc';"), ''
truthy  await typeCheckTsCode("let s: string = 42;")

equal  await typeCheckTsFile(r'ok.ts'), ''
truthy await typeCheckTsFile(r'bad.ts')

# ---------------------------------------------------------------------------

equal kindStr(220), 'ArrowFunction'
equal kindStr(261), 'VariableDeclaration'
equal kindStr(227), 'BinaryExpression'

# ---------------------------------------------------------------------------

equal getSymbolsFromType('integer'), ['integer']
equal getSymbolsFromType('hashof<integer>'), ['hashof','integer']

equal analyzeTsCode("""
	const x = y + z + func(min);
	""").asString(), s"""
	MISSING: y z func min
	EXTRA: x
	"""

equal analyzeTsCode("""
	import {defined, notdefined} from 'datatypes';
	""").asString(), s"""
	IMPORTS: datatypes: defined notdefined
	EXTRA: defined notdefined
   """

equal analyzeTsCode("""
	const x = y + z + func(min);
	""").asString(), s"""
	MISSING: y z func min
	EXTRA: x
	"""

equal analyzeTsCode("""
	import {defined, notdefined} from 'datatypes';
	""").asString(), s"""
	IMPORTS: datatypes: defined notdefined
	EXTRA: defined notdefined
   """

equal analyzeTsCode("""
	export const meaning = 42;
	""").asString(), s"""
	EXPORTS: meaning
	"""

equal analyzeTsCode("""
	func("Hello");
	""").asString(), s"""
	MISSING: func
	"""

equal analyzeTsCode("""
	func(x, y+z);
	""").asString(), s"""
	MISSING: func x y z
	"""

# --- imports are not needed

equal analyzeTsCode("""
	import {func} from 'willy';

	func(x, y+z);
	""").asString(), s"""
	IMPORTS: willy: func
	MISSING: x y z
	"""

# --- Only t is needed, s is a parameter

equal analyzeTsCode("""
	const func = (s: string): string =>
		return s + t + '.txt';
	func('abc');
	""").asString(), s"""
	MISSING: t
	"""

# --- Same, only using 'function' keyword

equal analyzeTsCode("""
	function func(s: string): string {
		return s + t + '.txt';
		}
	func('abc');
	""").asString(), s"""
	MISSING: t
	"""

# ---------------------------------------------------------------------------
# test astAsString()

equal astAsString(ts2ast('const x = 42;')), """
	kind: 308
	statements:
		-
			kind: 244
			declarationList:
				kind: 262
				declarations:
					-
						kind: 261
						name:
							kind: 80
							escapedText: x
						initializer:
							kind: 9
							text: “42
	endOfFileToken:
		kind: 1
	text: const˳x˳=˳42;
	fileName: temp.ts
	scriptKind: 3
	isDeclarationFile: ｟false｠
	nodeCount: 7
	identifierCount: 1
	symbolCount: 0
	identifiers:
		x:: x
	"""
