# section.lib.test.civet

import {isSectionName, Section} from 'section'
import {equal, truthy, falsy} from 'unit-test'

# ---------------------------------------------------------------------------

truthy isSectionName 'abc'
truthy isSectionName 'aThing'
falsy  isSectionName 'ABC'

(() =>
	section := new Section('main')
	equal section.name, 'main'
	)()

(() =>
	section := new Section('main', 0, (x) => x.toUpperCase())
	section.add 'abc', 'def'

	equal section.name, 'main'
	equal section.getBlock(), "ABC\nDEF"
	)()

(() =>
	section := new Section('main', 1, (x) => x.toLowerCase())
	section.add 'ABC'
	section.add 'XYZ'
	equal section.getBlock(), "\tabc\n\txyz"
	)()

(() =>
	section := new Section('main')
	section.add 'first line'
	section.add 1, 'indented'
	section.add 'abc', 'def'
	equal section.getBlock(), """
		first line
			indented
		abc
		def
		"""
	)()

(() =>
	section := new Section('main', 0, (x) => x.toUpperCase())
	section.add 'first line'
	section.add 1, 'indented'
	section.prepend 'abc', 'def'
	equal section.getBlock(), """
		DEF
		ABC
		FIRST LINE
			INDENTED
		"""
	)()

(() =>
	section := new Section('main', 0, (x) => x.toUpperCase())
	section.add 'first line'
	section.add 1, 'indented'
	lLines := ['abc', 'def']
	section.add ...lLines
	equal section.getBlock(), """
		FIRST LINE
			INDENTED
		ABC
		DEF
		"""
	)()
