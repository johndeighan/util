# hera-parse.lib.test.civet

import {initLogLevel} from 'logger'
import {esc} from 'unicode'
import {str2indents} from 'hera-parse'
import {
	beginUnitTest, equal, truthy, falsy, succeeds, fails,
	} from 'unit-test'

r := beginUnitTest(import.meta.url)

# ---------------------------------------------------------------------------

equal esc(str2indents("""
	file
		abc
		def
	""")), 'file↓»abc↓def↓«↓'

equal esc(str2indents("""
	file
		abc
			def
	/dir
		file
			xyz
	""")), 'file↓»abc↓»def↓««/dir↓»file↓»xyz↓««↓'

equal esc(str2indents("""
	src/lib clear
	temp.txt
		abc
	/sub
		temp.civet
			LOG "OK"
	""")), 'src/lib˳clear↓temp.txt↓»abc↓«/sub↓»temp.civet↓»LOG˳"OK"↓««↓'

equal esc(str2indents("""
	./src
	file
		abc

		def
	""")), './src↓file↓»abc↓↓def↓«↓'

