# hera-parse.lib.test.civet

import {parseText, parseFile} from 'hera-parse'
import {
	beginUnitTest, setDirTree, equal, truthy, falsy, succeeds, fails,
	} from 'unit-test'

r := beginUnitTest(import.meta.url)

# ---------------------------------------------------------------------------
# ASYNC

setup := (): void ->

	await setDirTree """
		./#{r''} clear
		test.parse.hera compile
			#beginParse(text)
			Program
				"a"* "b"*
					return ($1.length - $2.length)
				return
		"""

await setup()

# ---------------------------------------------------------------------------

equal esc(str2indents("""
	file
		abc
		def
	""")), 'file↓»abc↓def↓«↓'

equal esc(str2indents("""
	file
		abc
			def
	/dir
		file
			xyz
	""")), 'file↓»abc↓»def↓««/dir↓»file↓»xyz↓««↓'

equal esc(str2indents("""
	src/lib clear
	temp.txt
		abc
	/sub
		temp.civet
			LOG "OK"
	""")), 'src/lib˳clear↓temp.txt↓»abc↓«/sub↓»temp.civet↓»LOG˳"OK"↓««↓'

equal esc(str2indents("""
	./src
	file
		abc

		def
	""")), './src↓file↓»abc↓↓def↓«↓'

# ---------------------------------------------------------------------------

