# hera-parse.lib.test.civet

import {esc, escd} from 'unicode'
import {
	str2indents,
	} from 'hera-parse'
import {
	equal, truthy, falsy, succeeds, fails,
	} from 'unit-test'

# ---------------------------------------------------------------------------

equal escd(str2indents("""
	file
		abc
		def
	""")), 'file»abc↓def«'

equal escd(str2indents("""
	file
		abc
			def
	/dir
		file
			xyz
	""")), 'file»abc»def««/dir»file»xyz««'

equal escd(str2indents("""
	src/lib clear
	temp.txt
		abc
	/sub
		temp.civet
			LOG "OK"
	""")), 'src/lib˳clear↓temp.txt»abc«/sub»temp.civet»LOG˳"OK"««'
