# meta-data.lib.test.civet

import {convertMetaData, extractMetaData} from 'meta-data'
import {
	equal, truthy, falsy, succeeds, fails,
	} from 'unit-test'

# ---------------------------------------------------------------------------
# --- Create 3 log records for use in testing

equal convertMetaData('---', """
	fname: John
	lname: Deighan
	"""), {
		fname: 'John'
		lname: 'Deighan'
		}

equal extractMetaData("""
	---
	fname: John
	lname: Deighan
	---
	<p>Name is {fname} {lname}</p>
	"""), [
	{fname: 'John', lname: 'Deighan'}
	"<p>Name is {fname} {lname}</p>"
	]
