# indent.lib.test.civet

import {
	undef, defined, notdefined, croak, obviously, deepEqual,
	} from 'base'
import {spaces, tabs, s} from 'llutils'
import {
	inputIndent, outputIndent, resetOneIndent,
	indentLevel, splitLine,
	indented, undented, blockify, Blockify,
	} from 'indent'
import {
	equal, truthy, falsy, succeeds, fails,
	} from 'unit-test'

# ---------------------------------------------------------------------------

equal inputIndent, undef
equal outputIndent, undef

equal indentLevel("\t\tabc"), 2
equal inputIndent, tabs(1)
resetOneIndent()

equal inputIndent, undef
equal outputIndent, undef

equal indentLevel("   abc"), 1
equal inputIndent, spaces(3)

# ---------------------------------------------------------------------------

# --- TEST using TABs ---

# ---------------------------------------------------------------------------

(() =>
	resetOneIndent()
	truthy notdefined(inputIndent)

	truthy (indentLevel('abc') == 0)
	truthy (indentLevel('\tabc') == 1)
	truthy defined(inputIndent)
	truthy (inputIndent == '\t')
	truthy (indentLevel('\t\tabc') == 2)
	fails () => indentLevel('\t abc')
	fails () => indentLevel(' \tabc')
	truthy (indentLevel('abc') == 0)

	truthy (indentLevel('abc') == 0)
	truthy (indentLevel('\tabc') == 1)
	truthy (indentLevel('\t\tabc') == 2)
	)()

# ---------------------------------------------------------------------------

(() =>
	resetOneIndent()
	truthy deepEqual(splitLine('abc'), [0, 'abc'])
	truthy deepEqual(splitLine('\t\tabc'), [2, 'abc'])

	truthy deepEqual(splitLine('\tabc'), [1, 'abc'])

	# --- fails since we're now expecting TABs
	fails () =>  splitLine('      abc')
	)()

# ---------------------------------------------------------------------------

(() =>
	resetOneIndent()
	truthy notdefined(outputIndent)
	truthy indented('abc', 0) == 'abc'
	truthy notdefined(outputIndent)
	truthy indented('abc') == '\tabc'
	truthy defined(outputIndent)
	truthy (outputIndent == '\t')
	truthy indented('abc', 2) == '\t\tabc'
	truthy (outputIndent == '\t')

	truthy notdefined(inputIndent)
	truthy (indentLevel('\tabc') == 1)
	truthy (inputIndent == '\t')
	truthy indented('abc', 2) == (tabs(2) + 'abc')
	truthy indented('abc', 2) == "#{tabs(2)}abc"
	)()

# --- Test with blocks

(() =>
	resetOneIndent()
	truthy (indented("""
		first line
		\tsecond line
		\t\tthird line
		""") == """
		\tfirst line
		\t\tsecond line
		\t\t\tthird line
		""")

	truthy (indented("""
		first line
		\tsecond line
		\t\tthird line
		""", 2) == """
		\t\tfirst line
		\t\t\tsecond line
		\t\t\t\tthird line
		""")
	)()

(() =>
	resetOneIndent()
	truthy (indented("""
		first line

		\tsecond line
		""") == """
		\tfirst line

		\t\tsecond line
		""")
	)()

# --- Test with arrays

(() =>
	resetOneIndent()
	truthy (deepEqual(indented([
		'first line'
		'\tsecond line'
		'\t\tthird line'
		]), [
		'\tfirst line'
		'\t\tsecond line'
		'\t\t\tthird line'
		]))

	truthy (deepEqual(indented([
		'first line'
		'\tsecond line'
		'\t\tthird line'
		], 2), [
		'\t\tfirst line'
		'\t\t\tsecond line'
		'\t\t\t\tthird line'
		]))
	)()

# ---------------------------------------------------------------------------

(() =>
	resetOneIndent()
	equal undented("""
		\tabc
		\t\tdef
		\t\t\tghi
		"""), """
		abc
		\tdef
		\t\tghi
		"""
	)()

(() =>
	resetOneIndent()
	equal undented("""
		abc
		\tdef
		\t\tghi
		"""), """
		abc
		\tdef
		\t\tghi
		"""
	)()

# ---------------------------------------------------------------------------

# TEST using 3 spaces

# ---------------------------------------------------------------------------

(() =>
	resetOneIndent()
	truthy notdefined(inputIndent)
	truthy notdefined(outputIndent)
	truthy (indentLevel('\t\tabc') == 2)
	truthy (inputIndent == '\t')
	)()

(() =>
	resetOneIndent()
	truthy notdefined(inputIndent)
	truthy (indentLevel('   abc') == 1)
	truthy (indentLevel('      abc') == 2)
	truthy (inputIndent == spaces(3))
	)()

# ---------------------------------------------------------------------------

(() =>
	resetOneIndent()
	truthy (indentLevel('abc') == 0)
	truthy (indentLevel('   abc') == 1)
	truthy (indentLevel('      abc') == 2)
	fails () => indentLevel('\t abc')
	fails () => indentLevel(' \tabc')
	truthy (indentLevel('abc') == 0)

	truthy (indentLevel('abc') == 0)
	truthy (indentLevel('   abc') == 1)
	truthy (indentLevel('      abc') == 2)
	)()

# ---------------------------------------------------------------------------

(() =>
	resetOneIndent()
	truthy notdefined(inputIndent)

	truthy deepEqual(splitLine('abc'), [0, 'abc'])
	truthy notdefined(inputIndent)
	truthy deepEqual(splitLine('   abc'), [1, 'abc'])
	truthy defined(inputIndent)
	truthy deepEqual(splitLine('      abc'), [2, 'abc'])
	truthy (inputIndent == spaces(3))

	truthy deepEqual(splitLine('   abc'), [1, 'abc'])

	# ---fails since we're now expecting spaces
	fails () => splitLine('\t\tabc')
	)()

# ---------------------------------------------------------------------------

(() =>
	resetOneIndent(spaces(3), spaces(3))
	truthy (indented('abc', 2) == '      abc')
	truthy (indented('abc') == '   abc')

	truthy (indentLevel('   abc') == 1)
	truthy (indented('abc', 2) == spaces(6) + 'abc')
	)()

# --- Test with blocks

(() =>
	resetOneIndent(spaces(3), spaces(3))
	truthy (indented("""
		first line
		#{spaces(3)}second line
		#{spaces(6)}third line
		""") == """
		#{spaces(3)}first line
		#{spaces(6)}second line
		#{spaces(9)}third line
		""")

	truthy (indented("""
		first line
		#{spaces(3)}second line
		#{spaces(6)}third line
		""", 2) == """
		#{spaces(6)}first line
		#{spaces(9)}second line
		#{spaces(12)}third line
		""")
	)()

# --- Test with arrays

(() =>
	resetOneIndent(spaces(3), spaces(3))
	truthy deepEqual(indented([
		'first line'
		'   second line'
		'      third line'
		]), [
		'   first line'
		'      second line'
		'         third line'
		])

	truthy deepEqual(indented([
		'first line'
		'   second line'
		'      third line'
		], 2), [
		'      first line'
		'         second line'
		'            third line'
		])
	)()

# ---------------------------------------------------------------------------

equal undented("""
	#{spaces(6)}abc
	#{spaces(9)}def
	#{spaces(12)}ghi
	"""), """
	abc
	#{spaces(3)}def
	#{spaces(6)}ghi
	"""

# ---------------------------------------------------------------------------

(() =>
	lWords := ['abc','def','ghi','jkl']
	equal blockify(lWords, {width: 10}), """
		abc def
		ghi jkl
		"""
	equal blockify(lWords, {width: 5}), """
		abc
		def
		ghi
		jkl
		"""
	equal blockify(lWords, {width: 12}), """
		abc def ghi
		jkl
		"""
	equal blockify(lWords, {width: 64}), """
		abc def ghi jkl
		"""
	)()

# ---------------------------------------------------------------------------

equal Blockify(['abc', 'def', 'ghi']), """
	abc def ghi
	"""

equal Blockify(['abc', 'def', 'ghi'], {width: 8}), """
	abc def
	ghi
	"""

equal Blockify(['abc', 'def', 'ghi'], {width: 5}), """
	abc
	def
	ghi
	"""

equal Blockify({names: ['abc','def','ghi']}, {width: 8}), s"""
	names:
		abc
		def
		ghi
	"""

equal Blockify({
	EXPORTS: ['abc','def','ghi']
	IMPORTS: ['mno','xyz']
	}, {width: 12}), s"""
	EXPORTS:
		abc def
		ghi
	IMPORTS:
		mno xyz
	"""

equal Blockify({
	EXPORTS: ['abc','def','ghi']
	IMPORTS: []
	}, {width: 12}), s"""
	EXPORTS:
		abc def
		ghi
	IMPORTS: (none)
	"""

equal Blockify({
	EXPORTS: ['abc','def']
	IMPORTS: {
		datatypes: ['isString', 'isArray', 'hash']
		llutils:   ['o', 's', 'blockWidth']
		}
	}, {width: 18}), s"""
	EXPORTS: abc def
	IMPORTS:
		datatypes:
			isString
			isArray
			hash
		llutils:
			o s
			blockWidth
	"""
