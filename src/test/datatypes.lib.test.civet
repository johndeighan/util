# datatypes.lib.test.civet

import {initLogLevel} from 'logger'
import {
	undef, defined, notdefined, anyDefined, anyNotDefined,
	deepEqual, sleep,
	croak, assert, obviously, TIterator, TAsyncIterator,
	} from 'base'
import {
	array, arrayof, isArray,
	hash, hashof, isHash,
	TVoidFunc, nonEmptyString,
	isString, char, isChar, isNonEmptyString, isBoolean,
	isNumber, isPrimitive, isInteger,
	isArrayOfStrings, isArrayOfIntegers,
	isFunction, isRegExp, lPrimTypes,
	isEmpty, nonEmpty,
	isClass, className, isPromise, isClassInstance,
	isSymbol, symbolName, functionName, functionDef,
	classDef, regexpDef,
	isObject, isGeneratorFunction, isAsyncGeneratorFunction,
	isIterator, isAsyncIterator, jsType,
	isStringMapper, isIterable, isAsyncIterable, isAsyncFunction,
	clearHash, setHash, clearArray, setArray,
	looksLikeNumber, looksLikeInteger,
	} from 'datatypes'
import {
	beginUnitTest, equal, truthy, falsy, fails, succeeds, sampleVal,
	} from 'unit-test'

[root, r] := beginUnitTest(import.meta.url)

# ---------------------------------------------------------------------------

truthy lPrimTypes.includes('undefined')
falsy  lPrimTypes.includes('not there')

# ---------------------------------------------------------------------------

truthy deepEqual 'a', 'a'
truthy deepEqual ['a'], ['a']

# ---------------------------------------------------------------------------

fails () => croak "Bad"

# ---------------------------------------------------------------------------

truthy defined(42)
falsy  defined(undef)
falsy  notdefined(42)
truthy notdefined(undef)

succeeds () =>
	assert (2+2 == 4), "bs"
	assert defined(42), "bs"
	assert notdefined(undef), "bs"
	assert notdefined(null), "bs"

nonsense := (): boolean =>
	return false
fails () => assert nonsense(), "bs"

# ---------------------------------------------------------------------------

truthy anyDefined(undef, 42, undef)
falsy  anyDefined(undef, undef)

truthy anyNotDefined('abc', undef, 42)
falsy  anyNotDefined('abc', 42, 'xyz')

# ---------------------------------------------------------------------------

equal jsType(undef),       'undef'
equal jsType(true),        'boolean'
equal jsType(false),       'boolean'
equal jsType(''),          'string'
equal jsType('abc'),       'string'
equal jsType(Symbol('x')), 'symbol'
equal jsType(Symbol()),    'symbol'
equal jsType(12345n),      'bigint'
equal jsType(42),          'integer'
equal jsType(3.14),        'float'
equal jsType(Number.NaN),  'NaN'
equal jsType(Infinity),    'inf'
equal jsType(-Infinity),   'neginf'
equal jsType(null),        'null'
equal jsType(/^ab*/),      'regexp'
equal jsType(new Set()),   'set'
equal jsType(new Map()),   'map'
equal jsType([]),          'array'
equal jsType([1,2,3]),     'array'
equal jsType({}),          'hash'
equal jsType({a:1, b:2}),  'hash'
equal jsType(class MyClass), 'class'
equal jsType(() -> 42),      'plainFunction'

equal jsType(sampleVal.undef), 'undef'
equal jsType(sampleVal.null), 'null'
equal jsType(sampleVal.emptyStr), 'string'
equal jsType(sampleVal.str), 'string'
equal jsType(sampleVal.i), 'integer'
equal jsType(sampleVal.inf), 'inf'
equal jsType(sampleVal.neginf), 'neginf'
equal jsType(sampleVal.f), 'float'
equal jsType(sampleVal.b), 'boolean'
equal jsType(sampleVal.genFunc), 'generator'
equal jsType(sampleVal.asyncGenFunc), 'asyncGenerator'
equal jsType(sampleVal.regularFunc), 'plainFunction'
equal jsType(sampleVal.lambdaFunc), 'plainFunction'
equal jsType(sampleVal.emptyHash), 'hash'
equal jsType(sampleVal.fullHash), 'hash'
equal jsType(sampleVal.emptyList), 'array'
equal jsType(sampleVal.fullList), 'array'

# ---------------------------------------------------------------------------

truthy isNumber 42
truthy isHash {a:1, b:2}
truthy isHash {}
truthy isArray ['a', 2, undef]
truthy isArray []

# ---------------------------------------------------------------------------

truthy isString('abc')
truthy isString('')
truthy isString(new String('abc'))
falsy  isString(42)
falsy  isString(undef)
falsy  isString(null)

truthy isChar('a')
falsy  isChar('abc')
falsy  isChar(42)
falsy  isChar(undef)
falsy  isChar(null)
falsy  isChar('')

truthy isBoolean(true)
truthy isBoolean(false)
truthy isBoolean(new Boolean(true))
falsy  isBoolean('abc')
falsy  isBoolean(42)
falsy  isBoolean(undef)
falsy  isBoolean(null)
falsy  isBoolean('')

truthy isNumber(42)
truthy isNumber(3.14159)
truthy isNumber(new Number(42))
truthy isNumber(new Number(3.14))
falsy  isNumber('abc')
falsy  isNumber(undef)
falsy  isNumber(null)
falsy  isNumber('')

truthy isInteger(42)
truthy isInteger(0)
truthy isInteger(new Number(42))
falsy  isInteger(new Number(3.14))
falsy  isInteger(3.14159)
falsy  isInteger('abc')
falsy  isInteger(undef)
falsy  isInteger(null)
falsy  isInteger('')

truthy isRegExp(/^abc/)
falsy  isRegExp(42)
equal regexpDef(/^abc/), '^abc'
fails () => regexpDef(42)

truthy isHash({a: 1})
falsy  isHash(42)

truthy isArray(['a', 1])
falsy  isArray(42)

truthy isSymbol(Symbol('xxx'))
equal symbolName(Symbol('xxx')), 'xxx'
fails () => symbolName(42)

truthy isObject({a: 1})
falsy  isObject(42)
(() =>
	function fs(a: string, b: string): boolean
		return a == b;

	truthy isFunction((c: string) => 42)
	truthy isFunction(fs)
	falsy  isFunction(42)

	equal functionName((x: string) => return 42), '<anonymous>'
	equal functionName(fs), 'fs'

	equal functionDef(fs),
	'function fs(a,b){return a===b}'
	)()

(() =>
	class MyClass
		fname: string
		constructor()
			@fname = 'John'

	inst := new MyClass()

	Foo := class {
		constructor() {}
		bar() {
			return "Hello World!";
			}
		}

	truthy isClass(MyClass)

	equal className(MyClass), 'MyClass'
	equal className(inst), 'MyClass'
	equal className(Foo), 'Foo'
	equal className(class {
		constructor() {}
		bar() {
			return "Hello World!";
			}
		}
		), '<anonymous>'
	fails () => className(42)
	fails () => classDef(42)

	equal classDef(MyClass),
		'class MyClass{fname;constructor(){this.fname="John"}}'

	truthy isClassInstance(inst)
	truthy isClassInstance(new MyClass())
	falsy  isClassInstance(42)
	falsy  isClassInstance({})
	falsy  isClassInstance({a:1, b:2})
	)()
# ---------------------------------------------------------------------------

(() =>
	function func(): string
		return 'ok'

	equal functionName(func), 'func'
	)()

# ---------------------------------------------------------------------------

truthy isNonEmptyString('abc')
falsy  isNonEmptyString(42)
falsy  isNonEmptyString('')
falsy  isNonEmptyString('   ')

truthy isPrimitive(null)
truthy isPrimitive(undef)
truthy isPrimitive(true)
truthy isPrimitive('abc')
truthy isPrimitive(Symbol())
truthy isPrimitive(12345n)
truthy isPrimitive(42)
truthy isPrimitive(3.14)
truthy isPrimitive((x: string): string => 'abc')
truthy isPrimitive(/^abc$/)
falsy  isPrimitive([1,2,3])
falsy  isPrimitive({a:1, b:2})

truthy isEmpty(undef)
truthy isEmpty(null)
truthy isEmpty('')
truthy isEmpty('   ')
truthy isEmpty([])
truthy isEmpty(new Set())
truthy isEmpty(new Map())
truthy isEmpty({})
falsy  isEmpty('abc')
falsy  isEmpty(['x'])
falsy  isEmpty(new Set(['a','b']))
falsy  isEmpty(new Map([['a',1], ['b',2]]))
falsy  isEmpty({a:1, b:2})
truthy isEmpty({})

truthy nonEmpty('abc')
truthy nonEmpty(['x'])
truthy nonEmpty(new Set(['a','b']))
truthy nonEmpty(new Map([['a',1], ['b',2]]))
truthy nonEmpty({a:1, b:2})
falsy  nonEmpty({})

falsy  nonEmpty(undef)
falsy  nonEmpty(null)
falsy  nonEmpty('')
falsy  nonEmpty('   ')
falsy  nonEmpty([])
falsy  nonEmpty(new Set())
falsy  nonEmpty(new Map())
falsy  nonEmpty({})

truthy isArrayOfStrings(['abc', 'def'])
falsy  isArrayOfStrings(['abc', 1])
truthy isArrayOfStrings([])
falsy  isArrayOfStrings(42)
falsy  isArrayOfStrings('abc')

truthy isArrayOfIntegers([1,2,3])
falsy  isArrayOfIntegers([1, 'abc'])
truthy isArrayOfIntegers([])
falsy  isArrayOfIntegers(42)
falsy  isArrayOfIntegers('abc')

prom := new Promise<string>((resolve, reject) =>
	setTimeout(() =>
		let success = true
		if success
			resolve("Hello, world!")
		else
			reject(new Error("Failed to generate greeting"))
    , 1000)
    )

truthy isPromise(prom)
falsy  isPromise(42)
falsy  isPromise(undef)
falsy  isPromise(null)

# ---------------------------------------------------------------------------

truthy isGeneratorFunction(sampleVal.genFunc)
truthy isAsyncGeneratorFunction(sampleVal.asyncGenFunc)
falsy  isGeneratorFunction(sampleVal.regularFunc)
falsy  isGeneratorFunction(sampleVal.lambdaFunc)

obviously isGeneratorFunction(sampleVal.genFunc)
truthy isIterator(sampleVal.genFunc())

obviously isAsyncGeneratorFunction(sampleVal.asyncGenFunc)
truthy isAsyncIterator(sampleVal.asyncGenFunc())

falsy  isIterator(sampleVal.genFunc)
falsy  isIterator(sampleVal.regularFunc)
falsy  isIterator(sampleVal.lambdaFunc)

truthy isStringMapper((s: string) => return s.toUpperCase())

(() =>
	class MyClass
		name: string
		constructor(@name: string)

	x := new MyClass('John')
	equal className(x), 'MyClass'
	truthy isClassInstance(x)
	)()

(() =>
	func := (x: number): TIterator<number> ->
		yield 1
		yield 2
		yield 3
		return

	falsy isIterator(func)
	)()

(() =>
	func := (x: number): TAsyncIterator<number> ->
		await sleep 10
		yield 1
		yield 2
		yield 3
		return

	falsy isAsyncIterator(func)
	)()

(() =>
	func := () ->
		yield 2
		return
	truthy isIterable(func())
	)()

(() =>
	func := () ->
		await sleep 100
		yield 2
		return
	truthy isAsyncIterable(func())
	)()

(() =>
	gen := () ->
		yield 1
		yield 2
		return

	truthy isGeneratorFunction(gen)
	falsy  isGeneratorFunction(42)
	equal functionName(gen), 'gen'
	)()

falsy isAsyncFunction(42)
falsy isAsyncFunction((x: string) => return 42)

(() =>
	h := {a: 1, b: 2}
	clearHash(h)
	equal h, {}
	)()

(() =>
	l := [1,2,3]
	clearArray(l)
	equal l, []
	)()

(() =>
	h := {a: 1, b: 2}
	setHash(h, {x: 42})
	equal h, {x: 42}
	)()

(() =>
	l := [1,2,3]
	setArray(l, ['a','b'])
	equal l, ['a','b']
	)()

truthy looksLikeInteger '0'
truthy looksLikeInteger '42'
falsy  looksLikeInteger 'abc'
falsy  looksLikeInteger '3.14'

truthy looksLikeNumber '0'
truthy looksLikeNumber '42'
falsy  looksLikeNumber 'abc'
truthy looksLikeNumber '3.14'

