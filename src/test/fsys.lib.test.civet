equal slurp(r'file1.txt'), """
	---
	fname: John
	lname: Deighan
	---
	line1
	line2
	line3
	"""

await equal await slurpAsync(r'file1.txt'), """
	---
	fname: John
	lname: Deighan
	---
	line1
	line2
	line3
	"""

(() =>
	lChanges: string[] := []
	fileChangeFunc: TFsEventHandler := (kind, path) =>
		lChanges.push kind
		return

	handler := new FileEventHandler(fileChangeFunc)
	handler.handle {
		kind: 'modify',
		paths: ['/usr/lib/temp.txt']
		}
	handler.handle {
		kind: 'modify',
		paths: ['/usr/lib/temp.txt']
		}
	handler.handle {
		kind: 'modify',
		paths: ['/usr/lib/temp2.txt']
		}
	handler.handle {
		kind: 'modify',
		paths: ['/usr/lib/temp.txt']
		}

	await sleep 2000

	handler.handle {
		kind: 'modify',
		paths: ['/usr/lib/temp.txt']
		}
	handler.handle {
		kind: 'modify',
		paths: ['/usr/lib/temp.txt']
		}

	await sleep 2000

	expected := [
		{kind: 'modify', paths: ['/usr/lib/temp2.txt']}
		{kind: 'modify', paths: ['/usr/lib/temp.txt']}
		{kind: 'modify', paths: ['/usr/lib/temp.txt']}
		]

	equal lChanges, expected
	)()

(() =>
	lChanges: hash[] := []
	handler := new FileEventHandler((kind, path) =>
		lChanges.push {kind, path}
		return
		)
	handler.handle {
		kind: 'modify',
		paths: ['/usr/lib/temp.txt']
		}
	handler.handle {
		kind: 'modify',
		paths: ['/usr/lib/temp.txt']
		}
	handler.handle {
		kind: 'modify',
		paths: ['/usr/lib/temp2.txt']
		}
	handler.handle {
		kind: 'modify',
		paths: ['/usr/lib/temp.txt']
		}

	await sleep 2000

	handler.handle {
		kind: 'modify',
		paths: ['/usr/lib/temp.txt']
		}
	handler.handle {
		kind: 'modify',
		paths: ['/usr/lib/temp.txt']
		}

	await sleep 2000

	expected := [
		{kind: 'modify', path: '/usr/lib/temp2.txt'}
		{kind: 'modify', path: '/usr/lib/temp.txt'}
		{kind: 'modify', path: '/usr/lib/temp.txt'}
		]

	equal lChanges, expected, red('MIDDLE')
	)()

