(() =>
	path := barfTempFile('abc', {ext: '.txt'})
	truthy isFile(path)
	truthy (fileExt(path) == '.txt')
	)()

(() =>
	filterFunc := (path: string) =>
		{fileName} := parsePath(path)
		return fileName.match(/^[a-z0-9]+\.txt$/)

	lPaths := Array.from(allFilesMatching(r'**'))
	equal lPaths.filter(filterFunc).map((x) => parsePath(x).fileName), [
		'newfile.txt'
		'oldfile.txt'
		'temp.txt'
		'dummy.txt'
		'file1.txt'
		'file2.txt'
		'new.txt'
		'tokens.txt'
		]
	)()

(() =>
	lDirs := Array.from(allDirsMatching(r'**'))
	equal lDirs.map((x) => toRelPath(x)), [
		root
		r'aaa'
		r'aaa/bbb'
		r'subdir'
		]
	)()

(() =>
