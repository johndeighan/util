# fsys.lib.test.civet

import {cyan, red, green} from '@std/fmt/colors'

import {
	undef, defined, notdefined, sleep, toRelPath,
	} from 'base'
import {
	hash, isString, isFunction, isAsyncIterator,
	} from 'datatypes'
import {sinceLoad, sinceLoadStr} from 'timer'
import {o, spaces} from 'llutils'
import {
	isFile, isDir, getPathType, fileExt, withExt, inSameDir, modTime,
	isStub, parsePath, allFilesMatching, allDirsMatching, allLinesInFile,
	normalizePath, pathToURL, mkpath, pathSubDirs, myself, touch,
	rmFile, rmDir, newerDestFileExists, configFromFile,
	clearDir, mkDir, mkDirsForFile, slurp, slurpAsync, barf, isPathType,
	removeFilesMatching, watchFile, FileEventHandler, TFsEventHandler,
	TPathType, TPathInfo, patchFirstLine, toFullPath, splitPatterns,
	isValidStub, barfTempFile,
	fromJsonFile, toJsonFile, addJsonValue, pathStr,
	CReadableFile, CWritableFile, myTestDir,
	} from 'fsys'
import {
	equal, truthy, falsy, unifies,
	succeeds, fails, setDirTree, fileOpsTable,
	} from 'unit-test'

root := myTestDir(import.meta.url)
console.log "ROOT: #{root}"

# ---------------------------------------------------------------------------

r := (lStrings: TemplateStringsArray): string =>

	return "#{root}/#{lStrings[0]}"

# ---------------------------------------------------------------------------
# ASYNC

setup := (): void ->

	await setDirTree """
		./#{root} clear
		file.config.ts
			export default new Object({
				a: 1,
				b: 'abc',
				f: () => 'hello'
				})
		dummy.txt
			dummy
		tokens.txt
			if x==1
				print "OK"
			exit
		file1.txt
			---
			fname: John
			lname: Deighan
			---
			line1
			line2
			line3
		file2.txt
			# test1.cielo

			LOG := (str) => console.log str
			LOG "Hello, World!"
		file3.flags.txt
			# test1.cielo

			LOG := (str) => console.log str
			LOG "Hello, World!"
		file4.cielo
			# file.cielo

			abc
		file5.cielo
			this is the REAL first line
			# file.cielo

			abc
		file.config.ts
			export default new Object({
				a: 1,
				b: 'abc',
				f: () => 'hello'
				})
		/aaa
			/bbb
				newfile.txt
					abc
				oldfile.txt
					abc
				temp.txt
					abc
		/subdir
			new.txt
				abc
				def
		"""
	return

await setup()

