# --- These tests depend on my particular directory structure

(() =>
	lFiles := Array.from(allFilesMatching(r'file*.txt'))
	equal lFiles.map((x) => toRelPath(x)), [
		r'file1.txt'
		r'file2.txt'
		r'file3.flags.txt'
		]
	)()

(() =>
	lFiles :=  Array.from(allFilesMatching(r'**', o'includeDirs'))
	equal lFiles.map((x) => parsePath(x).fileName), [
		'fsys',
		'aaa',
		'bbb',
		'newfile.txt',
		'oldfile.txt',
		'temp.txt',
		'dummy.txt',
		'file.config.ts'
		'file1.txt',
		'file2.txt',
		'file3.flags.txt',
		'file4.cielo',
		'file5.cielo',
		'subdir',
		'new.txt',
		'tokens.txt',
		]
	)()

(() =>
	filterFunc := (path: string) =>
		if isDir(path)
			return parsePath(path).fileName != 'fsys'
		else if isFile(path)
			{fileName} := parsePath(path)
			return defined(fileName.match(/^[a-z0-9]+\.txt$/))
		else
			return false

	lPaths := Array.from(allFilesMatching(r'**', {includeDirs: true}))
	equal lPaths.filter(filterFunc).map((x) => parsePath(x).fileName), [
		'aaa',
		'bbb',
		'newfile.txt',
		'oldfile.txt',
		'temp.txt',
		'dummy.txt',
		'file1.txt',
		'file2.txt',
		'subdir',
		'new.txt',
		'tokens.txt',
		]
	)()

