(() =>
	equal splitPatterns(['xxx.ts', 'yyy.ts']), [['xxx.ts', 'yyy.ts'], []]
	equal splitPatterns(['xxx.ts', '! yyy.ts']), [['xxx.ts'], ['yyy.ts']]
	equal splitPatterns(['! xxx.ts', 'yyy.ts']), [['yyy.ts'], ['xxx.ts']]
	)()

# ---------------------------------------------------------------------------
#           Test file/dir modifying functions
# ---------------------------------------------------------------------------

(() =>
	path1 := r'file4.cielo'
	path2 := r'file5.cielo'
	patchFirstLine path1, '.cielo', '.civet'
	patchFirstLine path2, '.cielo', '.civet'
	truthy slurp(path1).includes 'file.civet'
	falsy  slurp(path2).includes 'file.civet'
	)()

(() =>
	barfPath := r'barfed.txt'

	contents := """
		abc

		xyz
		"""

	barf barfPath, contents
	equal slurp(barfPath), """
		abc

		xyz
		"""

	truthy newerDestFileExists(r'file1.txt', barfPath)
	falsy  newerDestFileExists(barfPath, r'file1.txt')
	fails () => newerDestFileExists('dummy.txt', '.txt')

	truthy isFile(barfPath)
	rmFile barfPath
	falsy  isFile(barfPath)
	)()

(() =>
	falsy  isDir(r'tempdir')
	falsy  isFile(r'tempdir/file42.txt')
	mkDir r'tempdir', true
	barf r'tempdir/file42.txt', 'abc'
	truthy isDir(r'tempdir')
	truthy isFile(r'tempdir/file42.txt')

	rmDir r'tempdir', o'clear'
	falsy  isDir(r'tempdir')
	)()

(() =>
	path := r'xxx/yyy/newfile.txt'
	mkDirsForFile path
	truthy isDir(r'xxx')
	truthy isDir(r'xxx/yyy')
	falsy  isDir(r'xxx/yyy/ccc')
	falsy  isFile(path)
	barf path, 'abc'
	truthy isFile(path)
	rmFile path
	falsy  isFile(path)
	rmDir 'src/test/fshs/xxx', {clear: true}
	)()

(() =>
	removeFilesMatching '**/*file.txt'

	falsy  isFile(r'aaa/newfile.txt')
	falsy  isFile(r'aaa/bbb/newfile.txt')
	falsy  isFile(r'aaa/bbb/oldfile.txt')
	truthy isFile(r'aaa/bbb/temp.txt')
	)()

(() =>
	clearDir r'aaa'
	truthy isDir(r'aaa')
	falsy  isDir(r'aaa/bbb')
	clearDir r'aaa/bbb'
	truthy isDir(r'aaa/bbb')
	rmDir r'aaa/bbb'
	falsy  isDir(r'aaa/bbb')
	)()

(() =>
	falsy isDir(r'notthere')
	clearDir r'notthere'
	truthy isDir(r'notthere')
	)()

(() =>
	# --- Set contents of dummy.txt to standard contents
	path := toFullPath(r'dummy.txt')
	barf path, 'dummy'

	let doStop: boolean = false
	lChanges: hash[] := []
	add := (str: string, stop: boolean=false): void =>
		if stop
			doStop = true
		barf path, str, {append: true}
		return

	callback: TFsEventHandler := (kind, path) =>
		lChanges.push {
			kind
			path
			ms: sinceLoad()
			}
		return doStop

	promise := watchFile path, callback

	add 'A'
	add 'B'
	add 'C'
	await sleep 300
	add 'D'
	add 'E', true

	await Promise.allSettled([promise])

	equal slurp(path), 'dummyABCDE'

	unifies lChanges, [
		{kind: 'modify', path}
		{kind: 'modify', path}
		]
	)()

