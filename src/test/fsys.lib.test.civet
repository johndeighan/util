truthy isFile('./deno.json')
truthy isFile('deno.json')
falsy  isFile('./src/lib/notafile.txt')
truthy isFile(r"dummy.txt")
falsy  isFile(root)

truthy isDir(root)
truthy isDir("./#{root}")
falsy  isDir('nosuchdir')
falsy  isDir(r"dummy.txt")

truthy isValidStub('abc')
falsy  isValidStub('ab,cd')
falsy  isValidStub('ab/cd')
falsy  isValidStub('ab\\cd')
falsy  isValidStub('all')

truthy isPathType('missing')
truthy isPathType('file')
falsy  isPathType('xxx')
falsy  isPathType(42)

equal getPathType('./deno.json'), 'file'
equal getPathType(root), 'dir'
equal getPathType(r'notafile.txt'), 'missing'
equal getPathType("./#{root}"), 'dir'
equal getPathType("./src/test/fsys.lib.test.civet"), 'file'
equal getPathType("C:/temp/file.txt"), 'missing'

equal fileExt('C:/Users/johnd/util/deno.json'), '.json'
equal fileExt("C:/temp/file.txt"), ".txt"
equal fileExt("c:\\temp/to/file.txt"), ".txt"
equal fileExt("c:\\temp/to/file.flag.txt"), ".txt"

equal withExt('deno.json', '.txt'), 'deno.txt'
equal withExt("C:/temp/file.txt", ".js"), "C:/temp/file.js"
equal withExt("c:\\temp/to/file.txt", ".js"), "C:/temp/to/file.js"
equal withExt("c:\\temp/to/file.flag.txt", ".js"), "C:/temp/to/file.flag.js"

equal inSameDir("C:/temp/file.txt", "tempfile.js"), "C:/temp/tempfile.js"
equal inSameDir("c:\\temp/to/file.txt", "file3.js"), "C:/temp/to/file3.js"
equal inSameDir("c:\\temp/to/file.flag.txt", "file.flag2.js"), "C:/temp/to/file.flag2.js"

truthy isStub('abc')
falsy  isStub('.js')
falsy  isStub('abc/deno')
falsy  isStub('abc\\deno')

equal parsePath("C:/temp/file.txt"), {
	root: 'C:/'
	dir: 'C:/temp'
	fileName: 'file.txt'
	stub: 'file'
	purpose: undefined
	ext: '.txt'
	}

unifies parsePath(import.meta.url), {
	fileName: 'fsys.lib.test.ts'
	stub: 'fsys.lib'
