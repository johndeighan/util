# fsys.lib.test.civet

import {
	undef, defined, notdefined, sleep, toRelPath,
	} from 'base'
import {hash, isString, isFunction} from 'datatypes'
import {
	o, spaces, sinceLoad, sinceLoadStr,
	} from 'llutils'
import {
	isFile, isDir, getPathType, fileExt, withExt, inSameDir,
	isStub, parsePath, allFilesMatching, allLinesInFile,
	normalizePath, pathToURL, mkpath, pathSubDirs, myself,
	rmFile, rmDir, newerDestFileExists, configFromFile,
	clearDir, mkDir, mkDirsForFile, slurp, slurpAsync, barf, isPathType,
	removeFilesMatching, watchFile, FileEventHandler, TFsEventHandler,
	TPathType, TPathInfo, patchFirstLine, toFullPath, splitPatterns,
	openTextFile, openAndReadTextFile,
	} from 'fsys'
import {
	equal, truthy, falsy, unifies,
	succeeds, fails, setDirTree, fileOpsTable,
	} from 'unit-test'

# ---------------------------------------------------------------------------
# ASYNC

setup := (): void =>

	await setDirTree """
		./src/test/fsys clear
		file.config.ts
			export default new Object({
				a: 1,
				b: 'abc',
				f: () => 'hello'
				})
		dummy.txt
			dummy
		tokens.txt
			if x==1
				print "OK"
			exit
		file1.txt
			---
			fname: John
			lname: Deighan
			---
			line1
			line2
			line3
		file2.txt
			# test1.cielo

			LOG := (str) => console.log str
			LOG "Hello, World!"
		file3.flags.txt
			# test1.cielo

			LOG := (str) => console.log str
			LOG "Hello, World!"
		file4.cielo
			# file.cielo

			abc
		file5.cielo
			this is the REAL first line
			# file.cielo

			abc
		file.config.ts
			export default new Object({
				a: 1,
				b: 'abc',
				f: () => 'hello'
				})
		/aaa
			/bbb
				newfile.txt
					abc
				oldfile.txt
					abc
				temp.txt
					abc
		/subdir
			new.txt
				abc
				def
		"""
	return

# await setup()

# ---------------------------------------------------------------------------

truthy isFile('./deno.json')
truthy isFile('deno.json')
falsy  isFile('./src/lib/notafile.txt')
truthy isFile("./src/test/fsys/dummy.txt")
falsy  isFile("./src/test/fsys")

truthy isDir('src/test')
falsy  isDir('nosuchdir')
truthy isDir("./src/test/fsys")
falsy  isDir("./src/test/fsys/dummy.txt")

truthy isPathType('missing')
truthy isPathType('file')
falsy  isPathType('xxx')

equal getPathType('./deno.json'), 'file'
equal getPathType("./src/test/fsys"), 'dir'
equal getPathType('./src/lib/notafile.txt'), 'missing'
equal getPathType("./src/test"), 'dir'
equal getPathType("./src/test/fsys.lib.test.civet"), 'file'
equal getPathType("C:/temp/file.txt"), 'missing'

equal fileExt('C:/Users/johnd/util/deno.json'), '.json'
equal fileExt("C:/temp/file.txt"), ".txt"
equal fileExt("c:\\temp/to/file.txt"), ".txt"
equal fileExt("c:\\temp/to/file.flag.txt"), ".txt"

equal withExt('deno.json', '.txt'), 'deno.txt'
equal withExt("C:/temp/file.txt", ".js"), "C:/temp/file.js"
equal withExt("c:\\temp/to/file.txt", ".js"), "C:/temp/to/file.js"
equal withExt("c:\\temp/to/file.flag.txt", ".js"), "C:/temp/to/file.flag.js"

equal inSameDir("C:/temp/file.txt", "file.js"), "C:/temp/file.js"
equal inSameDir("c:\\temp/to/file.txt", "file.js"), "C:/temp/to/file.js"
equal inSameDir("c:\\temp/to/file.flag.txt", "file.flag.js"), "C:/temp/to/file.flag.js"

truthy isStub('abc')
falsy  isStub('.js')
falsy  isStub('abc/deno')
falsy  isStub('abc\\deno')

equal parsePath("C:/temp/file.txt"), {
	root: 'C:/'
	dir: 'C:/temp'
	fileName: 'file.txt'
	stub: 'file'
	purpose: undefined
	ext: '.txt'
	}

unifies parsePath(import.meta.url), {
	fileName: 'fsys.lib.test.ts'
	stub: 'fsys.lib'
	purpose: 'test'
	ext: '.ts'
	}

(() =>
	filterFunc := (path: string) =>
		{fileName} := parsePath(path)
		return fileName.match(/^[a-z0-9]+\.txt$/)

	lPaths := Array.from(allFilesMatching('src/test/fsys/**'))
	equal lPaths.filter(filterFunc).map((x) => parsePath(x).fileName), [
		'newfile.txt',
		'oldfile.txt',
		'temp.txt',
		'dummy.txt',
		'file1.txt',
		'file2.txt',
		'new.txt',
		'tokens.txt',
		]
	)()

(() =>
	lLines: string[] := []
	for await line of allLinesInFile('./src/test/fsys/file1.txt')
		lLines.push line

	equal lLines, [
		'---'
		'fname: John'
		'lname: Deighan'
		'---'
		'line1'
		'line2'
		'line3'
		]
	)()

equal normalizePath("C:/temp/file.txt"), "C:/temp/file.txt"
equal normalizePath("C:\\temp/to/file.txt"), "C:/temp/to/file.txt"
equal normalizePath("C:\\temp/to/file.flag.txt"), "C:/temp/to/file.flag.txt"
equal normalizePath('C:\\Users\\johnd'), 'C:/Users/johnd'

equal pathToURL('c:/x/temp.txt'), "file:///c:/x/temp.txt"

equal mkpath("C:/temp/file.txt"), "C:/temp/file.txt"
