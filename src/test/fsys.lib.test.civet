(() =>
	path := r'data.json'
	falsy isFile(path)
	toJsonFile path, {a: 13}
	truthy isFile(path)
	h := fromJsonFile(path)
	equal h, {a: 13}
	addJsonValue path, 'x', 42
	h1 := fromJsonFile(path)
	equal h1, {a: 13, x: 42}

	path2 := r'data2.json'
	Deno.writeTextFileSync path2, ''
	equal fromJsonFile(path2), {}
	equal fromJsonFile('doesNotExist.tst'), {}
	)()

fullpath := "c:\\Users\\johnd\\util\\src\\lib\\datatypes.lib.civet"
equal pathStr(fullpath), 'src/lib/datatypes.lib.civet'

(() =>
	path := r'dummy.txt'
	t0 := modTime(path)
	touch path
	t1 := modTime(path)
	truthy (t1 >= t0)
	)()

# ---------------------------------------------------------------------------

(await () =>
	path := r'file99.txt'
	f := new CWritableFile path
	await f.writeln 'abc'
	await f.writeln 'def'
	f.close()

	equal slurp(path), 'abc\ndef\n'
	)()

(await () =>
	path := r'file99.txt'
	fr := new CReadableFile path
	line1 := await fr.getLine()
	equal line1, 'abc'
	line2 := await fr.getLine()
	equal line2, 'def'
	line3 := await fr.getLine()
	equal line3, undef
	equal await fr.metaData(), {}
	)()

# ---------------------------------------------------------------------------

(await () =>
	path := r'file999.txt'
	f := new CWritableFile path
	await f.writeln '---'
	await f.writeln 'name: John'
	await f.writeln '---'
	await f.writeln 'abc'
	await f.writeln 'def'
	f.close()

	equal slurp(path), '---\nname: John\n---\nabc\ndef\n'
	)()

(await () =>
	path := r'file999.txt'
	fr := new CReadableFile path
	line1 := await fr.getLine()
	equal line1, 'abc'
	line2 := await fr.getLine()
	equal line2, 'def'
	line3 := await fr.getLine()
	equal line3, undef
	equal await fr.metaData(), {name: 'John'}
	)()

(await () =>
	path := r'file999.txt'
	fr := new CReadableFile path
	line1 := await fr.getLine()
	equal line1, 'abc'
	line2 := await fr.getLine()
	equal line2, 'def'
	line3 := await fr.getLine()
	equal line3, undef
	)()

(await () =>
	path := r'file999.txt'
	fr := new CReadableFile path
	contents := await fr.getContents()
	equal contents, 'abc\ndef'
	equal await fr.metaData(), {name: 'John'}
	)()
