equal toRelPath('C:/Users/johnd/util/deno.json'), 'deno.json'

(() =>
	fullPath := "C:/Users/johnd/util/src/test/fsys/deno.json"
	relPath  := "src/test/fsys/deno.json"

	# --- try both full and relative paths
