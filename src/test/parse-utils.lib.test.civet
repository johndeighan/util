# parse-utils.lib.test.civet

import {s} from 'llutils'
import {
	slot, TStrLoc, TParseMatch, CParseMatches,
	} from 'parse-utils'
import {equal} from 'unit-test'

# ---------------------------------------------------------------------------

str := """
	./x
	test
		im
		ex
			ret
	"""

pm := new CParseMatches()
pm.match 'EOL',      [ 3, 1]
pm.returnVal 42
pm.match 'Root',     [ 0, 4]
pm.returnVal 'abc'
pm.match 'Name',     [ 4, 4]
pm.match 'EOL',      [ 8, 1]
pm.match 'FileName', [ 4, 5]
pm.match 'INDENT',   [ 9, 1]
pm.match 'EOL',      [12, 1]
pm.match 'Line',     [10, 3]
pm.match 'EOL',      [15, 1]
pm.match 'Line',     [13, 3]
pm.match 'INDENT',   [16, 1]
pm.match 'EOL',      [20, 1]
pm.match 'Line',     [17, 4]
pm.match 'Block',    [17, 4]
pm.match 'UNDENT',   [21, 1]
pm.match 'Block',    [10, 6]

equal pm.matchesTable(), s"""
	------------------------
			  matches
	------------------------
		Op    Pos Len  data
	-------- --- --- -------
	EOL        3   1 42.00
	Root       0   4 abc
	Name       4   4 ｟undef｠
	EOL        8   1 ｟undef｠
	FileName   4   5 ｟undef｠
	INDENT     9   1 ｟undef｠
	EOL       12   1 ｟undef｠
	Line      10   3 ｟undef｠
	EOL       15   1 ｟undef｠
	Line      13   3 ｟undef｠
	INDENT    16   1 ｟undef｠
	EOL       20   1 ｟undef｠
	Line      17   4 ｟undef｠
	Block     17   4 ｟undef｠
	UNDENT    21   1 ｟undef｠
	Block     10   6 ｟undef｠
	------------------------
	"""
