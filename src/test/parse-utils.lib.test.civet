# parse-utils.lib.test.civet

import {initLogLevel, clearLog, getLog} from 'logger'
import {decolorize, deepFreeze} from 'base'
import {s} from 'llutils'
import {
	slot, TStrLoc, TParseMatch, CParseMatches,
	} from 'parse-utils'
import {beginUnitTest, equal} from 'unit-test'

[root, r] := beginUnitTest(import.meta.url)

# ---------------------------------------------------------------------------

equal slot('name', 0), ['', '']
equal slot('name', 1), ['│', 'n']
equal slot('name', 2), ['└┘', 'na']
equal slot('name', 3), ['└─┘', 'nam']
equal slot('name', 4), ['└──┘', 'name']
equal slot('name', 6), ['└────┘', ' name ']

pm := new CParseMatches()
pm.match 'EOL',      [ 3, 1]
pm.returnVal 42
pm.match 'Root',     [ 0, 4]
pm.returnVal 'abc'
pm.match 'Name',     [ 4, 4]
pm.match 'EOL',      [ 8, 1]
pm.match 'FileName', [ 4, 5]
pm.match 'INDENT',   [ 9, 1]
pm.match 'EOL',      [12, 1]
pm.match 'Line',     [10, 3]
pm.match 'EOL',      [15, 1]
pm.match 'Line',     [13, 3]
pm.match 'INDENT',   [16, 1]
pm.match 'EOL',      [20, 1]
pm.match 'Line',     [17, 4]
pm.match 'Block',    [17, 4]
pm.match 'UNDENT',   [21, 1]
pm.match 'Block',    [10, 6]
deepFreeze(pm)

(() =>
	equal pm.matchesTable(), s"""
		------------------------
				  matches
		------------------------
			Op    Pos Len  data
		-------- --- --- -------
		EOL        3   1 42.00
		Root       0   4 abc
		Name       4   4 ｟undef｠
		EOL        8   1 ｟undef｠
		FileName   4   5 ｟undef｠
		INDENT     9   1 ｟undef｠
		EOL       12   1 ｟undef｠
		Line      10   3 ｟undef｠
		EOL       15   1 ｟undef｠
		Line      13   3 ｟undef｠
		INDENT    16   1 ｟undef｠
		EOL       20   1 ｟undef｠
		Line      17   4 ｟undef｠
		Block     17   4 ｟undef｠
		UNDENT    21   1 ｟undef｠
		Block     10   6 ｟undef｠
		------------------------
		"""
	)()

(() =>
	clearLog()
	pm.dumpParseInfo()
	equal decolorize(getLog()), s"""
		------------------------
				  matches
		------------------------
			Op    Pos Len  data
		-------- --- --- -------
		EOL        3   1 42.00
		Root       0   4 abc
		Name       4   4 ｟undef｠
		EOL        8   1 ｟undef｠
		FileName   4   5 ｟undef｠
		INDENT     9   1 ｟undef｠
		EOL       12   1 ｟undef｠
		Line      10   3 ｟undef｠
		EOL       15   1 ｟undef｠
		Line      13   3 ｟undef｠
		INDENT    16   1 ｟undef｠
		EOL       20   1 ｟undef｠
		Line      17   4 ｟undef｠
		Block     17   4 ｟undef｠
		UNDENT    21   1 ｟undef｠
		Block     10   6 ｟undef｠
		------------------------
		---------------------------  debug  ----------------------------
		|    .    |    .    |    .    |    .    |    .    |    .    |    .

			│└──┘││  │  ││   ││
			ENameEI  E  EI   EU
		└──┘└───┘ └─┘└─┘ └──┘
		RootFileN LinLin Line
							  └──┘
							  Bloc
					 └────┘
					 Block
		----------------------------------------------------------------
		"""
	)()
