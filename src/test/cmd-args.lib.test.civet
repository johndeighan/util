# cmd-args.lib.test.civet

import {initLogLevel} from 'logger'
import {undef} from 'base'
import {s} from 'llutils'
import {DUMP} from 'nice'
import {
	TNonOptionDesc, TValueDesc, TBoolValDesc, TArgDesc,
	helping, debugging, inspect, silent,
	getCmdArgs, parseCmdArgDesc, helpStr,
	doSetLogLevel, doHandleClearScreen,
	} from 'cmd-args'
import {
	equal, succeeds, fails, truthy, falsy, beginUnitTest,
	} from 'unit-test'

r := beginUnitTest(import.meta.url)

# ---------------------------------------------------------------------------

(() =>
	equal parseCmdArgDesc({
			force: {flag: 'f'}
			label: {valType: 'string'}
			}),
		{
			hFlagNames: {f: 'force'}
			hStrTypes:  {label: 'string'}
			hNumTypes:   {}
			minNonOpt:  0
			maxNonOpt:  0
			}
	)()

(() =>
	equal parseCmdArgDesc({
			_: {range: [1,3]}
			force: {flag: 'f'}
			label: {valType: 'string'}
			}),
		{
			hFlagNames: {f: 'force'}
			hStrTypes:  {label: 'string'}
			hNumTypes:   {}
			minNonOpt:  1
			maxNonOpt:  3
			}
	)()

(() =>
	equal parseCmdArgDesc({
			_: {range: [0,10]}
			force: {flag: 'f'}
			count: {valType: 'integer'}
			}),
		{
			hFlagNames:  {f: 'force'}
			hStrTypes:   {}
			hNumTypes:   {count: 'integer'}
			minNonOpt:   0
			maxNonOpt:  10
			}
	)()

(() =>
	hDesc := {
		_:          {range: [1,3]}
		force:      {flag: 'f'}
		verbose:    {flag: 'v'}
		label:      {valType: 'string'}
		numAllowed: {valType: 'integer'}
		}
	h := getCmdArgs 'doit', hDesc, ['-vf', 'file.txt']
	equal h, [
		['file.txt']
		{force: true, verbose: true}
		{}
		{}
		]
	falsy helping
	falsy debugging
	falsy inspect
	falsy silent
	)()

(() =>
	hDesc := {
		_: {range: [1,3]}
		force: {flag: 'f'}
		verbose: {flag: 'v'}
		label: {valType: 'string'}
		numAllowed: {valType: 'integer'}
		}

	h := getCmdArgs 'doit', hDesc, ['-vfD', 'file.txt']

	equal h, [
		['file.txt']
		{force: true, verbose: true}
		{}
		{}
		]
	falsy helping
	truthy debugging
	falsy inspect
	falsy silent
	)()

(() =>
	hDesc := {
		_: {range: [1,3]}
		force: {flag: 'f'}
		verbose: {flag: 'v'}
		label: {valType: 'string'}
		numAllowed: {valType: 'integer'}
		}

	h := getCmdArgs 'doit', hDesc, [
		'file.txt'
		'-vfS',
		'-label=myfile'
		'-numAllowed=5'
		]

	equal h, [
		['file.txt']
		{force: true, verbose: true}
		{label: 'myfile'}
		{numAllowed: 5}
		]
	falsy helping
	falsy debugging
	falsy inspect
	truthy silent
	)()

(() =>
	hDesc := {
		force:      {flag: 'f',          desc: 'force build'}
		traceLib:   {valType: 'string',  desc: 'lib to trace'}
		oneIndent:  {valType: 'string',  desc: 'indent by',    defStr: '\t'}
		maxLineLen: {valType: 'integer', desc: 'max line len', defNum: 75}
		}
	[
		_
		{force}
		{traceLib, oneIndent}
		{maxLineLen}
		] := getCmdArgs 'build-dot-symbols', hDesc, ['-f']

	truthy force
	equal traceLib, undef
	equal oneIndent, '\t'
	equal maxLineLen, 75
	)()
