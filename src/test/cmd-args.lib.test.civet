# cmd-args.lib.test.civet

import {undef} from 'base'
import {s} from 'llutils'
import {DUMP} from 'nice'
import {
	TCmdArgDesc, flag, flags, getFlags, setFlag, clearFlag,
	numNonOptions, nonOption, allNonOptions,
	argValue, parseCmdArgs, setCmdArgs,
	debugging, inspecting, helping, silent,
	TKeyDesc, TCmdDesc, stdChecks,
	helpStr, getCmdArgErrors, checkCmdArgs,
	} from 'cmd-args'
import {
	equal, succeeds, fails, truthy, falsy,
	} from 'unit-test'

stdChecks()

# ---------------------------------------------------------------------------

(() =>
	h := parseCmdArgs [
		'-n'
		'-xtI'
		'abc'
		'--'
		'-h'
		'-label=xyz'
		'-width=32'
		'-prop=0.25'
		'!'
		]
	equal h, {
		hFlags: {
			n: true
			x: true
			t: true
			I: true
			h: true
			}
		hValues: {
			label: 'xyz'
			width: 32
			prop: 0.25
			}
		lNonOptions: ['abc']
		helping: true
		debugging: false
		silent: false
		inspecting: true
		clearScreen: true
		}
	)()

(() =>
	h := parseCmdArgs ['-D']
	truthy h.debugging
	)()

(() =>
	h := parseCmdArgs ['-I']
	truthy h.inspecting
	)()

(() =>
	h := parseCmdArgs ['-h']
	truthy h.helping
	)()

(() =>
	h := parseCmdArgs ['-S']
	truthy h.silent
	)()

(() =>
	h := parseCmdArgs ['-DIh']
	truthy h.debugging
	truthy h.inspecting
	truthy h.helping
	)()

# ---------------------------------------------------------------------------

(() ->
	hDesc: TCmdDesc := {
		_: {
			desc: 'the alphabet'
			range: [1, 3]
			}
		n: {
			desc: 'do not test'
			type: 'boolean'
			}
		x: {
			desc: 'a lower case X'
			type: 'boolean'
			}
		t: { desc: 'set flag t' }
		label: { desc: 'a label to use' }
		width: { type: 'float' }
		prop:  { type: 'number' }
		numItems:  { type: 'integer' }
		}

	setCmdArgs [
		'-n'
		'-xtI'
		'abc'
		'--'
		'-label=xyz'
		'-width=32'
		'-prop=0.25'
		'!'
		]

	lErrors := getCmdArgErrors(hDesc)
	equal lErrors, []

	succeeds () => checkCmdArgs(hDesc)

	# --- for some reason, this test fails
	succeeds () => checkCmdArgs(hDesc)

	# --- test flag functions

	truthy flag('n')
	truthy flag('x')
	truthy flag('t')
	truthy flag('I')
	falsy  flag('a')
	falsy  flag('l')

	equal flags('n','t','i'), [true, true, false]

	h := getFlags({
		next: 'n'
		tell: 't'
		micro: 'm'
		})
	equal h, {
		next: true
		tell: true
		micro: false
		}

	# --- test non-option functions

	equal numNonOptions(), 1

	equal allNonOptions(), ['abc']
	equal nonOption(0), 'abc'
	equal nonOption(1), undef

	# --- test arg value functions

	equal argValue('label'), 'xyz'
	equal argValue('width'), 32
	equal argValue('prop'), 0.25
	equal argValue('dummy'), undef
	equal argValue('n'), undef

	# --- test building a help string

	equal helpStr(hDesc), s"""
		Usage:
			non-options: the alphabet
				min: 1
				max: 3
			n: boolean - do not test
			x: boolean - a lower case X
			t - set flag t
			label - a label to use
			width: float
			prop: number
			numItems: integer
		"""

	falsy  helping
	falsy  debugging
	truthy inspecting
	falsy  silent

	setFlag 'm'

	h2 := getFlags({
		next: 'n'
		tell: 't'
		micro: 'm'
		})
	equal h2, {
		next: true
		tell: true
		micro: true
		}

	clearFlag 'm'

	h3 := getFlags({
		next: 'n'
		tell: 't'
		micro: 'm'
		})
	equal h3, {
		next: true
		tell: true
		micro: false
		}
	)()
