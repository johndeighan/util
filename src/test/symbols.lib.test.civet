# symbols.lib.test.civet

import {undef} from 'base'
import {
	loadSymbols, loadSymbolsFrom, getSymbolLib, getNeededImportStmts,
	} from 'symbols'
import {equal, succeeds} from 'unit-test'

# ---------------------------------------------------------------------------

await (() =>
	hSymbols := await loadSymbolsFrom """
		datatypes
			undef defined
		indent
			splitLine
		"""

	equal getSymbolLib('undef',     hSymbols), 'datatypes'
	equal getSymbolLib('defined',   hSymbols), 'datatypes'
	equal getSymbolLib('splitLine', hSymbols), 'indent'
	equal getSymbolLib('dummy',     hSymbols), undef
	)()

await (() =>
	# --- Use the actual .symbols file
	hSymbols := await loadSymbols()

	equal getSymbolLib('defined'), 'base', 'FAILS'
	equal getSymbolLib('isArray'), 'datatypes'

	equal getSymbolLib('array'), 'datatypes'
	equal getSymbolLib('hash'), 'datatypes'

	equal getNeededImportStmts(['defined','array']), [
		"import {defined} from 'base';"
		"import {array} from 'datatypes';"
		], 'FAILS'
	equal getNeededImportStmts(['arrayof','integer']), [
		"import {arrayof, integer} from 'datatypes';"
		]
	)()
