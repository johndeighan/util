# civet.lib.test.civet

import {exists, existsSync} from '@std/fs'
import {stripAnsiCode} from '@std/fmt/colors'
import {SourceFile} from 'npm:typescript'

import {initLogLevel} from 'logger'
import {undef, defined} from 'base'
import {isHash} from 'datatypes'
import {s, rtrim} from 'llutils'
import {slurp, withExt, rmFile} from 'fsys'
import {procOneFile, compileAllLibs} from 'proc-files'
import {ts2ast, astAsString} from 'typescript'
import {
	civet2ts, civet2tsFile, civet2ast, a, A,
	} from 'civet'
import {doCompileCivet} from 'exec'
import {
	equal, succeeds, fails, truthy, falsy,
	beginUnitTest, setDirTree,
	} from 'unit-test'

r := beginUnitTest(import.meta.url)

# ---------------------------------------------------------------------------

setup := (): void ->

	await setDirTree """
		./#{r''} clear
		test.civet compile
			x := 42
			console.log "x = \#{x}"
		temp.civet
			s: string := 'abc'
		hello.txt
			Hello
		"""
	return

await setup()

# ---------------------------------------------------------------------------

(() =>
	civetCode := slurp r"test.civet"
	tsCode :=  await civet2ts civetCode

	# --- source maps are stripped out before an ast is created
	ast1 := await civet2ast civetCode
	ast2 := ts2ast tsCode
	equal ast1, ast2

	equal await civet2ts('x := 42', {inlineMap: false}), """
		"use strict";
		const x = 42
		console.log(`x = ${x}`)
		"""
	)

(() =>
	path := r"test.civet"
	tsPath := withExt path, '.ts'

	debugger
	await civet2tsFile path, tsPath, {inlineMap: false}
	code := rtrim(slurp tsPath)
	equal code, """
		"use strict";
		const x = 42
		""", "THIS FAILS"
	)

(() =>
	await succeeds () => await civet2ast('x := 42')
	)

# ---------------------------------------------------------------------------

await (() =>
	equal await a"""
		import {defined, notdefined} from 'datatypes'
		""", s"""
		IMPORTS: datatypes: defined notdefined
		EXTRA: defined notdefined
		"""

	equal await A"""
		import {defined, notdefined} from 'datatypes'
		""", s"""
		IMPORTS: datatypes: defined notdefined
		EXTRA: defined notdefined
		"""

	equal await a"""
		x := y + z + func(min)
		""", s"""
		MISSING: y z func min
		EXTRA: x
		"""

	equal await a"""
		import {defined, notdefined} from 'datatypes'
		""", s"""
		IMPORTS: datatypes: defined notdefined
		EXTRA: defined notdefined
		"""

	equal await a"""
		x := y + z + func(min)
		""", s"""
		MISSING: y z func min
		EXTRA: x
		"""

	equal await a"""
		import {defined, notdefined} from 'datatypes'
		""", s"""
		IMPORTS: datatypes: defined notdefined
		EXTRA: defined notdefined
		"""

	equal await a"""
		export meaning := 42
		""", s"""
		EXPORTS: meaning
		"""

	equal await a"""
		func "Hello"
		""", s"""
		MISSING: func
		"""

	equal await a"""
		func x, y+z
		""", s"""
		MISSING: func x y z
		"""

	# --- imports are not needed

	equal await a"""
		import {func} from 'willy'

		func x, y+z
		""", s"""
		IMPORTS: willy: func
		MISSING: x y z
		"""

	# --- Only t is needed, s is a parameter

	equal await a"""
		func := (s: string): string =>
			return s + t + '.txt'
		func('abc')
		""", s"""
		MISSING: t
		"""

	# --- Same, only using 'function' keyword

	equal await a"""
		function func(s: string): string
			return s + t + '.txt'
		func('abc')
		""", s"""
		MISSING: t
		"""

	await (() =>
		rmFile r"test.ts"
		await procOneFile r"test.civet", doCompileCivet
		truthy await exists r"test.ts"
		)()
	)()

# ---------------------------------------------------------------------------

truthy isFile(r'hello.txt')

equal await civet2ts('x: number := 42', {inlineMap: false}), """
	"use strict";
	const x: number = 42
	"""

equal await civet2js('x: number := 42'), """
	"use strict";
	const x = 42
	"""

await (() =>
	await civet2tsFile(r"temp.civet", r"temp.ts", {inlineMap: false})
	equal slurp(r"temp.ts"), """
		"use strict";
		const s = 'abc'
		"""
	)()
