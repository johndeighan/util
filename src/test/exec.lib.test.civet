		input: lInput
		}
	)()

await (() =>
	let output = ''
	h := await execCmd 'grep', ['-E', '[0-9]+'], {
		input: lInput
		callback: (s: string): void =>
			output += s
			return
		}
	equal output, "123\n1313\n42\n"
	)()

await (() =>
	h := await execCmd 'grep', ['-E', '[0-9]+'], {
