# exec.lib.test.civet

import {initLogLevel, pushLogLevel, popLogLevel} from 'logger'
import {undef, sleep, matches, decolorize} from 'base'
import {hash} from 'datatypes'
import {isFile, slurp, withExt} from 'fsys'
import {
	getCmdLine, TStreamType, TExecResult,
	mkstr, execCmd, execTsFile, CFileHandler,
	cmdIsInstalled, getCmdName,
	doInstallCmd, doUninstallCmd,
	} from 'exec'
import {doUnitTest} from 'compile'
import {
	equal, succeeds, fails, truthy, falsy, beginUnitTest, setDirTree,
	} from 'unit-test'

[root, r] := beginUnitTest(import.meta.url)

# ---------------------------------------------------------------------------

gen := () ->
	yield 'abc\n'
	yield '123\n'
	yield 'def\n'
	yield '1313\n'
	yield 'ghi\n'
	yield '42\n'
	return

agen := () ->
	await sleep 100
	yield 'abc\n'
	yield '123\n'
	await sleep 100
	yield 'def\n'
	yield '1313\n'
	await sleep 100
	yield 'ghi\n'
	yield '42\n'
	return

lInput := [
	'abc\n'
	'123\n'
	'def\n'
	'1313\n'
	'ghi\n'
	'42\n'
	]

str := """
	abc
	123
	def
	1313
	ghi
	42
	"""

# ---------------------------------------------------------------------------
# ASYNC

setup := (): void ->

	await setDirTree """
		./#{root} clear
		hello.txt
			Hello
		temp.txt
			abc
			def
		temp1.civet compile
			str: string := 'abc'
		temp2.civet compile
			n: number := 42
		numbers.txt
			abc
			123
			def
			1313
		nocivet.ts
			const x = 13;
		sample.ts
			const x = 42;
		sample.civet
			x := 42
		hello.cmd.ts
			console.log("Hello, World!");
		"""
	return

await setup()

# ---------------------------------------------------------------------------
#    Run tests that don't change the file system first
# ---------------------------------------------------------------------------

truthy await cmdIsInstalled('analyze')
truthy await cmdIsInstalled('builddoc')
falsy  await cmdIsInstalled('nosuchcmd')

equal getCmdName(r"sample.cmd.ts", {}), 'sample'
equal getCmdName(r"sample.cmd.ts", {name: 'mycmd'}), 'mycmd'
equal getCmdName(r"a.b.c.cmd.ts", {}), "a_b_c"

truthy isFile(r"temp2.civet")
truthy isFile(r"temp1.ts")
truthy isFile(r"temp2.ts")
falsy  isFile(r"missing.txt")

equal doInstallCmd.op, 'doInstallCmd'
equal doUninstallCmd.op, 'doUninstallCmd'

(() =>
	buffer := new ArrayBuffer(3)
	view := new Int8Array(buffer)

	view[0] = 97
	view[1] = 98
	view[2] = 99

	equal mkstr('abc'), 'abc'
	equal mkstr(buffer), 'abc'
	equal mkstr(view), 'abc'
	equal getCmdLine('dothis', ['-a', 'willy']), 'dothis -a willy'
	)()

await (() =>
	{stdout} := await execCmd 'echo', ["Hello"], {
		capture: true
		}
	equal stdout, "Hello"
	)()

await (() =>
	{stdout} := await execCmd 'cat', [], {
		capture: true
		infile: r"hello.txt"
		}
	equal stdout, "Hello"
	)()

# ---------------------------------------------------------------------------
#     Next run commands that only create new files
# ---------------------------------------------------------------------------

await (() =>
	outfile := r'output.txt'
	hResult := await execCmd 'grep', ['-E', '[0-9]+'], {
		input: slurp(r'numbers.txt')
		outfile
		}
	equal slurp(outfile), "123\n1313\n"
	)()

# ---------------------------------------------------------------------------
# --- Exhaustively test execCmd()
# ---------------------------------------------------------------------------

await (() =>
	succeeds (() => await execCmd 'civet', ['--version'])
	)()

await (() =>
	let version = ''
	h := await execCmd 'civet', ['--version'], {
		callback: (s: string): void =>
			version += s
			return
		}
	truthy h.success
	truthy matches(version, /^\d+\.\d+\.\d+\n$/)
	equal version, '0.11.7'
	)()

await (() =>
	h := await execCmd 'civet', ['--version'], {
		capture: true
		}
	version := h.stdout as string
	truthy matches(version, /^\d+\.\d+\.\d+\n$/)
	)()

await (() =>
	let version = ''
	h := await execCmd 'civet', ['--version'], {
		capture: true
		callback: (s: string): void =>
			version += s
			return
		}
	truthy matches(version, /^\d+\.\d+\.\d+\n$/)
	stdout := h.stdout as string
	truthy matches(stdout, /^\d+\.\d+\.\d+\n$/)
	)()

# ---------------------------------------------------------------------------
# --- Feed strings into grep, output only numeric lines

await (() =>
	succeeds (() => await execCmd 'grep', ['-E', '[0-9]+'], {
		input: gen()
		})
	)()

await (() =>
	let output = ''
	h := await execCmd 'grep', ['-E', '[0-9]+'], {
		input: gen()
		callback: (s: string): void =>
			output += s
			return
		}
	equal output, "123\n1313\n42\n"
	)()

await (() =>
	h := await execCmd 'grep', ['-E', '[0-9]+'], {
		input: gen()
		capture: true
		}
	output := h.stdout as string
	equal output, "123\n1313\n42\n"
	)()

await (() =>
	let output = ''
	h := await execCmd 'grep', ['-E', '[0-9]+'], {
		input: gen()
		capture: true
		callback: (s: string): void =>
			output += s
			return
		}
	output2 := h.stdout as string
	equal output, "123\n1313\n42\n"
	equal output2, "123\n1313\n42\n"     # FAILED 1
	)()

# ---------------------------------------------------------------------------
