# exec.lib.test.civet

import {undef, sleep, matches} from 'base'
import {isFile, slurp, myTestDir} from 'fsys'
import {
	getCmdLine, TStreamType, TExecResult,
	mkstr, execCmd, CFileHandler,
	doRemoveFile, doRemoveTsFile, isInstalled, getCmdName,
	doInstallCmd, doUninstallCmd, doRun,
	} from 'exec'
import {
	equal, succeeds, fails, truthy, falsy, setDirTree, line,
	} from 'unit-test'

root := myTestDir(import.meta.url)
console.log "ROOT: #{root}"

# ---------------------------------------------------------------------------

r := (lStrings: TemplateStringsArray): string =>

	return "#{root}/#{lStrings[0]}"

# ---------------------------------------------------------------------------

gen := () ->
	yield 'abc\n'
	yield '123\n'
	yield 'def\n'
	yield '1313\n'
	yield 'ghi\n'
	yield '42\n'
	return

agen := () ->
	await sleep 100
	yield 'abc\n'
	yield '123\n'
	await sleep 100
	yield 'def\n'
	yield '1313\n'
	await sleep 100
	yield 'ghi\n'
	yield '42\n'
	return

lInput := [
	'abc\n'
	'123\n'
	'def\n'
	'1313\n'
	'ghi\n'
	'42\n'
	]

str := """
	abc
	123
	def
	1313
	ghi
	42
	"""

# ---------------------------------------------------------------------------
# ASYNC

setup := (): void ->

	await setDirTree """
		./#{root} clear
		hello.txt
			Hello
		temp.txt
			abc
			def
		temp1.civet compile
			str: string := 'abc'
		temp2.civet compile
			n: number := 42
		numbers.txt
			abc
			123
			def
			1313
		nocivet.ts
			const x = 13;
		sample.ts
			const x = 42;
		sample.civet
			x := 42
		hello.cmd.ts
			console.log("Hello, World!");
		"""
	return

await setup()

# ---------------------------------------------------------------------------
#    Run tests that don't change the file system first
# ---------------------------------------------------------------------------

truthy await isInstalled('analyze'), line(103)
truthy await isInstalled('builddoc'), line(104)
falsy  await isInstalled('nosuchcmd'), line(105)

equal getCmdName(r"sample.cmd.ts", {}), 'sample'
equal getCmdName(r"sample.cmd.ts", {name: 'mycmd'}), 'mycmd'
equal getCmdName(r"a.b.c.cmd.ts", {}), "a_b_c"

truthy isFile(r"temp2.civet")
truthy isFile(r"temp1.ts")
truthy isFile(r"temp2.ts")
falsy  isFile(r"missing.txt")

equal doRemoveFile.op, 'doRemoveFile'
equal doRemoveTsFile.op, 'doRemoveTsFile'
equal doInstallCmd.op, 'doInstallCmd', line(118)
equal doUninstallCmd.op, 'doUninstallCmd'
equal doRun.op, 'doRun'

truthy await doRemoveFile.needed(r"hello.txt")
falsy  await doRemoveFile.needed(r"dummy.txt")
truthy await doRemoveTsFile.needed(r"temp1.ts")
falsy  await doRemoveTsFile.needed(r"dummy.ts")
falsy  await doRemoveTsFile.needed(r"nocivet.ts")

(() =>
	buffer := new ArrayBuffer(3)
	view := new Int8Array(buffer)

	view[0] = 97
	view[1] = 98
	view[2] = 99

	equal mkstr('abc'), 'abc'
	equal mkstr(buffer), 'abc'
	equal mkstr(view), 'abc'
	equal getCmdLine('dothis', ['-a', 'willy']), 'dothis -a willy'
	)()

await (() =>
	{stdout} := await execCmd 'echo', ["Hello"], {
		capture: true
		}
	equal stdout, "Hello"
	)()

await (() =>
	{stdout} := await execCmd 'cat', [], {
		capture: true
		infile: r"hello.txt"
		}
	equal stdout, "Hello"
	)()

# ---------------------------------------------------------------------------
#     Next run commands that only create new files
# ---------------------------------------------------------------------------

await (() =>
	outfile := r'output.txt'
	hResult := await execCmd 'grep', ['-E', '[0-9]+'], {
		input: slurp(r'numbers.txt')
		outfile
		}
	equal slurp(outfile), "123\n1313\n", line(167)
	)()

# ---------------------------------------------------------------------------
#    Next run commands that add or remove files
# ---------------------------------------------------------------------------

await (() =>
	truthy isFile(r'temp.txt'), line(146)
	await doRemoveFile.handle r'temp.txt'
	falsy isFile(r'temp.txt')

	# --- this time it should not be needed
	falsy await doRemoveFile.needed(r'temp.txt')
	)()

await (() =>
	truthy isFile(r'sample.ts')

	# --- NOTE: Only removes a .ts file if there's a .civet file
	await doRemoveTsFile.handle r'sample.ts'

	falsy isFile(r'sample.ts'), line(189)
	)()

# ---------------------------------------------------------------------------
# --- Exhaustively test execCmd()
# ---------------------------------------------------------------------------

await (() =>
	succeeds (() => await execCmd 'civet', ['--version']), line(197)
	)()

await (() =>
	let version = ''
	h := await execCmd 'civet', ['--version'], {
		callback: (s: string): void =>
			version += s
			return
		}
	truthy h.success
	truthy matches(version, /^\d+\.\d+\.\d+\n$/)
	equal version, '0.11.7'
	)()

await (() =>
	h := await execCmd 'civet', ['--version'], {
		capture: true
		}
	version := h.stdout as string
	truthy matches(version, /^\d+\.\d+\.\d+\n$/), line(217)
	)()

await (() =>
	let version = ''
	h := await execCmd 'civet', ['--version'], {
		capture: true
		callback: (s: string): void =>
			version += s
			return
		}
	truthy matches(version, /^\d+\.\d+\.\d+\n$/)
	stdout := h.stdout as string
	truthy matches(stdout, /^\d+\.\d+\.\d+\n$/)
	)()

# ---------------------------------------------------------------------------
# --- Feed strings into grep, output only numeric lines

await (() =>
	succeeds (() => await execCmd 'grep', ['-E', '[0-9]+'], {
		input: gen()
		}), line(237)
	)()

await (() =>
	let output = ''
	h := await execCmd 'grep', ['-E', '[0-9]+'], {
		input: gen()
		callback: (s: string): void =>
			output += s
			return
		}
	equal output, "123\n1313\n42\n", line(250)
	)()

await (() =>
	h := await execCmd 'grep', ['-E', '[0-9]+'], {
		input: gen()
		capture: true
		}
	output := h.stdout as string
	equal output, "123\n1313\n42\n"
	)()

await (() =>
	let output = ''
	h := await execCmd 'grep', ['-E', '[0-9]+'], {
		input: gen()
		capture: true
		callback: (s: string): void =>
			output += s
			return
		}
	output2 := h.stdout as string
	equal output, "123\n1313\n42\n", line(272)
	equal output2, "123\n1313\n42\n", line(273)
	)()

# ---------------------------------------------------------------------------
# --- Feed strings into grep async, output only numeric lines

await (() =>
	succeeds (() => await execCmd 'grep', ['-E', '[0-9]+'], {
		input: agen()
		}), line(282)
	)()

await (() =>
	let output = ''
	h := await execCmd 'grep', ['-E', '[0-9]+'], {
		input: agen()
		callback: (s: string): void =>
			output += s
			return
		}
	equal output, "123\n1313\n42\n", line(293)
	)()

await (() =>
	h := await execCmd 'grep', ['-E', '[0-9]+'], {
		input: agen()
		capture: true
		}
	output := h.stdout as string
	equal output, "123\n1313\n42\n", line(302)
	)()

await (() =>
	let output = ''
	h := await execCmd 'grep', ['-E', '[0-9]+'], {
		input: agen()
		capture: true
		callback: (s: string): void =>
			output += s
			return
		}
	output2 := h.stdout
	equal output, "123\n1313\n42\n"
	equal output2, "123\n1313\n42\n"
	)()

# ---------------------------------------------------------------------------
# --- Feed strings into grep, output only numeric lines

await (() =>
	succeeds () => await execCmd 'grep', ['-E', '[0-9]+'], {
		input: lInput
		}
	)()

await (() =>
	let output = ''
	h := await execCmd 'grep', ['-E', '[0-9]+'], {
		input: lInput
		callback: (s: string): void =>
			output += s
			return
		}
	equal output, "123\n1313\n42\n", line(336)              # FAILED 1
	)()

await (() =>
	h := await execCmd 'grep', ['-E', '[0-9]+'], {
		input: lInput
		capture: true
		}
	output := h.stdout as string
	equal output, "123\n1313\n42\n", line(345)
	)()

await (() =>
	let output = ''
	h := await execCmd 'grep', ['-E', '[0-9]+'], {
		input: lInput
		capture: true
		callback: (s: string): void =>
			output += s
			return
		}
	equal output, "123\n1313\n42\n"
	output2 := h.stdout as string
	equal output2, "123\n1313\n42\n"
	)()

# ---------------------------------------------------------------------------
# --- Feed one string into grep, output only numeric lines

await (() =>
	succeeds () => await execCmd 'grep', ['-E', '[0-9]+'], {
		input: str
		}
	)()

await (() =>
	let output = ''
	h := await execCmd 'grep', ['-E', '[0-9]+'], {
		input: str
		callback: (s: string): void =>
			output += s
			return
		}
	equal output, "123\n1313\n42\n", line(379)
	)()

await (() =>
	h := await execCmd 'grep', ['-E', '[0-9]+'], {
		input: str
		capture: true
		}
	output := h.stdout as string
	equal output, "123\n1313\n42\n", line(388)     # FAILED 1
	)()

await (() =>
	let output = ''
	h := await execCmd 'grep', ['-E', '[0-9]+'], {
		input: str
		capture: true
		callback: (s: string): void =>
			output += s
			return
		}
	equal output, "123\n1313\n42\n", line(400)      # FAILED 2
	output2 := h.stdout as string
	equal output2, "123\n1313\n42\n", line(402)
	)()

# ---------------------------------------------------------------------------

await (() =>
	await doInstallCmd.handle(r"hello.cmd.ts")
	await sleep(1000)
	truthy await isInstalled('hello'), line(410)     # FAILED 2
	await doUninstallCmd.handle('hello')
	)()
