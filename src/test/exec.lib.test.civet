# exec.lib.test.civet

import {undef} from 'base'
import {isEmpty, nonEmpty} from 'datatypes'
import {o} from 'llutils'
import {
	mkstr, getCmdLine, execCmd, execCmdSync, TExecResult,
	} from 'exec'
import {
	equal, succeeds, fails, truthy, falsy, setDirTree,
	} from 'unit-test'

# ---------------------------------------------------------------------------
# ASYNC

setup := (): void =>

	await setDirTree """
		./src/test/exec
		bad.civet
			str: string := undef

		"""

await setup()

# ---------------------------------------------------------------------------

buffer := new ArrayBuffer(3)
view := new Int8Array(buffer)

view[0] = 97
view[1] = 98
view[2] = 99

equal mkstr('abc'), 'abc'
equal mkstr(buffer), 'abc'
equal mkstr(view), 'abc'

equal getCmdLine('dothis', ['-a', 'willy']), 'dothis -a willy'

(() =>
	{stdout} := await execCmd 'echo', ["Hello"]
	equal stdout, "Hello\n"
	)()

truthy execCmdSync("echo", ["Hello"]).success
