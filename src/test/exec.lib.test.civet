await (() =>
	succeeds (() => await execCmd 'grep', ['-E', '[0-9]+'], {
		input: agen()
		})
	)()

await (() =>
	let output = ''
	h := await execCmd 'grep', ['-E', '[0-9]+'], {
		input: agen()
		callback: (s: string): void =>
			output += s
			return
		}
	equal output, "123\n1313\n42\n"
	)()

await (() =>
	h := await execCmd 'grep', ['-E', '[0-9]+'], {
		input: agen()
		capture: true
		}
	output := h.stdout as string
	equal output, "123\n1313\n42\n"
	)()

await (() =>
	let output = ''
	h := await execCmd 'grep', ['-E', '[0-9]+'], {
		input: agen()
		capture: true
		callback: (s: string): void =>
			output += s
			return
		}
	output2 := h.stdout
	equal output, "123\n1313\n42\n"
	equal output2, "123\n1313\n42\n"
	)()

# ---------------------------------------------------------------------------
# --- Feed strings into grep, output only numeric lines

await (() =>
	succeeds () => await execCmd 'grep', ['-E', '[0-9]+'], {
		input: lInput
		}
	)()

await (() =>
	let output = ''
	h := await execCmd 'grep', ['-E', '[0-9]+'], {
		input: lInput
		callback: (s: string): void =>
			output += s
			return
		}
	equal output, "123\n1313\n42\n"          # FAILED 1
	)()

await (() =>
	h := await execCmd 'grep', ['-E', '[0-9]+'], {
		input: lInput
		capture: true
		}
	output := h.stdout as string
	equal output, "123\n1313\n42\n"
	)()

await (() =>
	let output = ''
	h := await execCmd 'grep', ['-E', '[0-9]+'], {
		input: lInput
		capture: true
		callback: (s: string): void =>
			output += s
			return
		}
	equal output, "123\n1313\n42\n"
	output2 := h.stdout as string
	equal output2, "123\n1313\n42\n"
	)()

# ---------------------------------------------------------------------------
# --- Feed one string into grep, output only numeric lines

await (() =>
	succeeds () => await execCmd 'grep', ['-E', '[0-9]+'], {
		input: str
		}
	)()

await (() =>
	let output = ''
	h := await execCmd 'grep', ['-E', '[0-9]+'], {
		input: str
		callback: (s: string): void =>
			output += s
			return
		}
	equal output, "123\n1313\n42\n"
	)()

await (() =>
	h := await execCmd 'grep', ['-E', '[0-9]+'], {
		input: str
		capture: true
		}
	output := h.stdout as string
	equal output, "123\n1313\n42\n"     # FAILED 1
	)()

await (() =>
	let output = ''
	h := await execCmd 'grep', ['-E', '[0-9]+'], {
		input: str
		capture: true
		callback: (s: string): void =>
			output += s
			return
		}
	equal output, "123\n1313\n42\n"      # FAILED 2
	output2 := h.stdout as string
	equal output2, "123\n1313\n42\n"
	)()

# ---------------------------------------------------------------------------

await (() =>
	await doInstallCmd.handle(r"hello.cmd.ts")
	truthy await cmdIsInstalled('hello')       # FAILED 3
	await doUninstallCmd.handleFile(r'hello.cmd.ts')
	falsy await cmdIsInstalled('hello')
	debugger
	await doUninstallCmd.handleFile(r'hello.cmd.ts')
	)()

await (() =>
	hResult := await execTsFile r'hello.cmd.ts', {capture: true}
	equal hResult.stdout, 'Hello, World!\n'
	)()

# ---------------------------------------------------------------------------
# Create a CFileHandler that handles .txt files by
# converting contents to all upper-case and saving the
# result as a .utxt file

class CFileUpperCaser extends CFileHandler

	get op()
		return 'doUpperCase'

	async canHandle(path: string, hOptions: hash = {})
		return path.endsWith('.txt')

	override allOutPaths(path: string, hOptions: hash = {})
		return [withExt(path, '.utxt')]

	handle(path: string, hOptions: hash = {})
		contents := await Deno.readTextFile path
		await Deno.writeTextFile withExt(path, '.utxt'), contents.toUpperCase()
		return {success: true, timeTaken: -1}

doUpperCase := new CFileUpperCaser()

await (() =>
	hResult := await doUpperCase.handleFile(r'nosuchfile.txt')
	falsy hResult.success
	)()

await (() =>
	falsy isFile(r'hello.utxt')
	hResult := await doUpperCase.handleFile(r'hello.txt')
	truthy hResult.success
	truthy isFile(r'hello.utxt')
	)()

