# dir-tree.parse.test.civet

import {initLogLevel} from 'logger'
import {DUMP} from 'nice'
import {parseText} from 'hera-parse'
import {beginUnitTest, equal} from 'unit-test'

r := beginUnitTest(import.meta.url)

# ---------------------------------------------------------------------------

await (() =>
	lOps := await parseText 'dir-tree', """
		./src
		file.txt
			abcdef
		"""

	equal lOps, [
		{ op: 'mkDir', path: './src'}
		{ op: 'barf', path: './src/file.txt', contents: "abcdef\n"}
		]
	)()

await (() =>
	lOps := await parseText 'dir-tree', """
		./src clear
		file.txt
			abc
		"""

	equal lOps, [
		{ op: 'clearDir', path: './src'}
		{ op: 'barf', path: './src/file.txt', contents: "abc\n"}
		]
	)()

await (() =>
	lOps := await parseText 'dir-tree', """
		./src
		/temp
			file.txt
				abc
				def
		"""

	equal lOps, [
		{ op: 'mkDir', path: './src'}
		{ op: 'mkDir', path: './src/temp'}
		{ op: 'barf', path: './src/temp/file.txt', contents: "abc\ndef\n"}
		]
	)()

await (() =>
	lOps := await parseText 'dir-tree', """
		./src/test clear
		/temp
			/subdir
				file.txt
					abc
					def
		"""

	equal lOps, [
		{ op: 'clearDir', path: './src/test'}
		{ op: 'mkDir', path: './src/test/temp'}
		{ op: 'mkDir', path: './src/test/temp/subdir'}
		{ op: 'barf', path: './src/test/temp/subdir/file.txt', contents: "abc\ndef\n"}
		]
	)()

await (() =>
	lOps := await parseText 'dir-tree', """
		./src/test clear
		/temp
			/subdir
				file.txt
					abc
					def
				file.civet compile
					meaning := 42
		"""

	equal lOps, [
		{ op: 'clearDir', path: './src/test'}
		{ op: 'mkDir', path: './src/test/temp'}
		{ op: 'mkDir', path: './src/test/temp/subdir'}
		{ op: 'barf', path: './src/test/temp/subdir/file.txt', contents: "abc\ndef\n"}
		{ op: 'barf', path: './src/test/temp/subdir/file.civet', contents: "meaning := 42\n"}
		{ op: 'compile', path: './src/test/temp/subdir/file.civet'}
		]
	)()
