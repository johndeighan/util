# unicode.lib.test.civet

import {undef, decolorize} from 'base'
import {
	uni, lit, delit, litC,
	esc, escm, escd, unesc, getPrefix,
	} from 'unicode'
import {
	equal, succeeds, fails, truthy, falsy,
	} from 'unit-test'

# ---------------------------------------------------------------------------

equal lit('undef'), '｟undef｠'

equal delit('｟undef｠'), 'undef'
equal delit('abc'), undef
equal delit(''), undef

equal litC('undef'), '\\undef'

equal escd('cba'), 'cba'
equal escd('   acb'), '˳˳˳acb'
equal escd('\t\t\tabc'), '→→→abc'
equal escd('abc\r\ndef'), 'abc←↓def'
equal escd('abc\r\ndef', 'multiline'), 'abc←↓\ndef'
equal escd('abcc\n'), 'abcc↓'
equal escd('abcb\r\n'), 'abcb←↓'
equal escd('abcb\r\n', 'multiline'), 'abcb←↓\n'
equal escd('ab cd'), 'ab˳cd'
equal escd('ab\tcd'), 'ab→cd'

equal unesc('cba'), 'cba'
equal unesc('˳˳˳acb'), '   acb'
equal unesc('→→→abc'), '\t\t\tabc'
equal unesc('abc←↓def'), 'abc\r\ndef'
equal unesc('abc←↓\ndef'), 'abc\r\ndef'
equal unesc('abcc↓'), 'abcc\n'
equal unesc('abcb←↓'), 'abcb\r\n'
equal unesc('abcb←↓\n'), 'abcb\r\n'
equal unesc('ab˳cd'), 'ab cd'
equal unesc('ab→cd'), 'ab\tcd'

equal getPrefix(2, 'plain'),      '│   │   '
equal getPrefix(2, 'withArrow'),  '│   └─> '
equal getPrefix(2, 'withResume'), '│   ├─> '
equal getPrefix(2, 'withFlat'),   '│   ├── '
equal getPrefix(2, 'withYield'),  '│   ├<─ '
equal getPrefix(2, 'noLastVbar'), '│       '
equal getPrefix(2, 'none'),       '        '

equal decolorize(escm('abc\ndef')), 'abc↓\ndef'
