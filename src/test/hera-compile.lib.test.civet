# hera-compile.lib.test.civet

import {initLogLevel} from 'logger'
import {esc} from 'unicode'
import {s2} from 'llutils'
import {
	doCompileHera, preprocHera, testHeraCode,
	} from 'hera-compile'
import {
	beginUnitTest, equal, truthy, falsy, succeeds, fails, setDirTree,
	} from 'unit-test'

[root, r] := beginUnitTest(import.meta.url)

# ---------------------------------------------------------------------------

setup := (): void ->

	await setDirTree """
		./#{root} clear
		counter.parse.hera compile
			---
			type: civet
			---
			#beginParse(text)

			Program
				"a"* "b"* ->
					return ($1.length - $2.length)
		hello.txt
			Hello, there
		"""
	return

await setup()

# ---------------------------------------------------------------------------

equal await testHeraCode("""
	name := 'John Deighan'
	lItems: string[] := []

	#beginParse
		lItems.length = 0

	Main
		/abc/
	"""), s2"""
	```
	import {CParseMatches} from 'parse-utils';
	export let pm = new CParseMatches();

	const name = 'John Deighan'
	const lItems: string[] = []

	export const beginParse = (
			text: string,
			hOptions: {[key: string|symbol]: unknown} = {}
			): string|undefined => {
		pm.reset(text);
		lItems.length = 0
		}
	```

	Main
		/abc/ ->
			pm.match('Main', $loc);

	"""

equal await testHeraCode("""
	name := 'John Deighan'
	lItems: string[] := []

	#beginParse
		lItems.length = 0

	Main
		/abc/ Next
			lItems.push 'main'

	Next
		"xyz"
			lItems.push 'done'
	"""), s2"""
	```
	import {CParseMatches} from 'parse-utils';
	export let pm = new CParseMatches();

	const name = 'John Deighan'
	const lItems: string[] = []

	export const beginParse = (
			text: string,
			hOptions: {[key: string|symbol]: unknown} = {}
			): string|undefined => {
		pm.reset(text);
		lItems.length = 0
		}
	```

	Main
		/abc/ Next ->
			pm.match('Main', $loc);
			lItems.push('main')

	Next
		"xyz" ->
			pm.match('Next', $loc);
			lItems.push('done')
	"""
