# hera-compile.lib.test.civet

import {esc} from 'unicode'
import {s2} from 'llutils'
import {
	doCompileHera, preprocHera, testHeraCode,
	} from 'hera-compile'
import {
	equal, truthy, falsy, succeeds, fails,
	} from 'unit-test'

# ---------------------------------------------------------------------------

debugger
equal await testHeraCode("""
	name := 'John Deighan'
	lItems: string[] := []

	#beginParse
		lItems.length = 0

	Main
		/abc/
	"""), s2"""
	```
	import {CParseMatches} from 'parse-utils';
	export let pm = new CParseMatches();

	const name = 'John Deighan'
	const lItems: string[] = []

	export const beginParse = (
			text: string,
			hOptions: {[key: string|symbol]: unknown} = {}
			): string|undefined => {
		pm.reset(text);
		lItems.length = 0
		}
	```

	Main
		/abc/ ->
			pm.match('Main', $loc);

	"""

equal await testHeraCode("""
	name := 'John Deighan'
	lItems: string[] := []

	#beginParse
		lItems.length = 0

	Main
		/abc/ Next
			lItems.push 'main'

	Next
		"xyz"
			lItems.push 'done'
	"""), s2"""
	```
	import {CParseMatches} from 'parse-utils';
	export let pm = new CParseMatches();

	const name = 'John Deighan'
	const lItems: string[] = []

	export const beginParse = (
			text: string,
			hOptions: {[key: string|symbol]: unknown} = {}
			): string|undefined => {
		pm.reset(text);
		lItems.length = 0
		}
	```

	Main
		/abc/ Next ->
			pm.match('Main', $loc);
			lItems.push('main')

	Next
		"xyz" ->
			pm.match('Next', $loc);
			lItems.push('done')
	"""
