# automate.lib.test.civet

import {defined} from 'base'
import {isHash, isFunction} from 'datatypes'
import {o} from 'llutils'
import {withExt, TPathInfo, isFile} from 'fsys'
import {DBG} from 'logger'
import {typeCheckTsCode, typeCheckTsCodeSync} from 'lltypescript'
import {
	TCompilerFunc, TPostProcessor, compileFile,
	TCompilerInfo, isCompilerInfo, TCompilerConfig, isCompilerConfig,
	TCompileResult, getCompilerConfig, getCompilerInfo, getPostProcessor,
	} from 'automate'
import {
	equal, succeeds, fails, truthy, falsy, setDirTree,
	} from 'unit-test'

# ---------------------------------------------------------------------------
# ASYNC

setup := (): void =>

	await setDirTree """
		./src/test/automate clear
		test1.cielo compile
			# test1.cielo

			LOG := (str: string) => console.log str
			LOG "Hello, World!"
		test2.civet compile
			# test2.civet

			LOG := (str: string) => console.log str
			LOG "Hello, World!"
		test3.coffee
			# test3.coffee

			LOG = (str: string) => console.log str
			LOG "Hello, World!"
		graph.dot
			EE -> EO | OE | OO
			EO -> EE
			OE -> EE
			OO -> EE
		hello.ts
			console.log("Hello, World!");
		mycompile.config.civet
			import {withExt} from 'fsys'
			export default new Object {
				hCompilers: {
					'.test': {
						getOutPaths: (path: string) => [withExt(path, '.out')],
						tester: () => true,
						compiler: (path: string) => undefined
						}
					},
				hPostProcessors: {}
				}
		"""
	return

await setup()

# ---------------------------------------------------------------------------

DBG "type TCompilerFunc"

succeeds () => typeCheckTsCodeSync """
	import type {TCompilerFunc} from 'automate';
	const func: TCompilerFunc = (path: string) =>
		console.log(path);
		return 'compiled'
	"""


DBG "type TPostProcessor"

(() =>
	logit := (hInfo: TPathInfo) =>
		console.log "done"
		return
	# isType 'TPostProcessor', logit
	)()

DBG "type TCompilerInfo"

(() =>
	h := {
		tester: () => true
		compiler: (path: string) => return 'compiled',
		getOutPaths: (path: string) => return ['temp.ts']
		}
	truthy isCompilerInfo h
	)()

DBG "type TCompilerConfig", "isCompilerConfig()"

(() =>
	h := {
		hCompilers: {}
		hPostProcessors: {}
		}
	truthy isCompilerConfig(h)
	)()

DBG "getCompilerConfig(path)"

(() =>
	civetPath := 'src/test/automate/mycompile.config.civet'
	hConfig := getCompilerConfig(civetPath)
	truthy isCompilerConfig(hConfig)
	)()

DBG "getCompilerInfo()"

truthy isCompilerInfo(getCompilerInfo('.dot'))

DBG "getPostProcessor()"

(() =>
	pp := getPostProcessor('test')
	truthy defined(pp)
	truthy isFunction(pp)
	)()

(() =>
	pp := getPostProcessor('lib')
	truthy defined(pp)
	truthy isFunction(pp)
	)()

(() =>
	pp := getPostProcessor('cmd')
	truthy defined(pp)
	truthy isFunction(pp)
	)()

DBG "compileFile()"

fails () => compileFile 'nosuchfile.civet'

(() =>
	hResult := compileFile('src/test/automate/test1.cielo', o'nopp')
	truthy isFile('src/test/automate/test1.temp.civet')
	)()
