# automate.lib.test.civet

import {initLogLevel} from 'logger'
import {undef, defined} from 'base'
import {isHash, isFunction} from 'datatypes'
import {o} from 'llutils'
import {withExt, TPathInfo, isFile} from 'fsys'
import {procOneFile} from 'proc-files'
import {
	TCompilerFunc, TPostProcessor, doCompileFile, configFromFile,
	TCompilerInfo, isCompilerInfo, TCompilerConfig, isCompilerConfig,
	getCompilerConfig, getCompilerInfo, getPostProcessor,
	} from 'automate'
import {
	equal, succeeds, fails, truthy, falsy, beginUnitTest, setDirTree,
	} from 'unit-test'

[root, r] := beginUnitTest(import.meta.url)

# ---------------------------------------------------------------------------
# ASYNC

setup := (): void ->

	await setDirTree """
		./#{root} clear
		file.config.ts
			export default new Object({
				a: 1,
				b: 'abc',
				f: () => 'hello'
				})
		hello
			console.log("Hello, World!");
		hello.cmd.civet
			console.log("Hello, World!");
		graph.dot
			EE -> EO | OE | OO
			EO -> EE
			OE -> EE
			OO -> EE
		mycompile.config.civet
			import {withExt} from 'fsys'
			export default new Object {
				hCompilers: {
					'.test': {
						getOutPaths: (path: string) => [withExt(path, '.out')],
						tester: () => true,
						compiler: (path: string) => undefined
						}
					},
				hPostProcessors: {}
				}
		"""
	return

await setup()

# ---------------------------------------------------------------------------

hInfo := {
	isInstalled: () =>
		return true

	getOutPaths: (path: string) =>
		return [withExt(path, '.js')]

	compiler: (path: string) =>
		jsPath := withExt(path, '.js')
		return 'compiled'
	}

truthy isCompilerInfo hInfo
falsy  isCompilerInfo {a: 42}
falsy  isCompilerInfo 42

truthy isCompilerConfig {
	hCompilers: hInfo
	hPostProcessors: {}
	}
falsy isCompilerConfig {
	a: 13
	b: 92
	}
falsy isCompilerConfig 42

await (() =>
	falsy isFile r"hello.cmd.ts"
	result := await procOneFile(r"hello.cmd.civet", doCompileFile)
	equal result, {
		infile: r"hello.cmd.civet"
		success: true
		outfile: "src/test/automate/hello.cmd.ts"
		}

	truthy isFile r"hello.cmd.ts"
	)()

await (() =>
	result := await procOneFile(r"hello", doCompileFile)
	equal result, {
		infile: r"hello"
		stderr: "doCompileFile can't handle 'src/test/automate/hello'"
		success: false
		}

	)()

# ---------------------------------------------------------------------------

await (() =>
	hConfig := await configFromFile r'file.config.ts'
	truthy defined(hConfig)
	truthy defined(hConfig.a)
	falsy  defined(hConfig.x)
	if isFunction(hConfig.f)
		equal hConfig.f(), 'hello'
	)

