# cielo.lib.test.civet

import {initLogLevel} from 'logger'
import {defined, sleep} from 'base'
import {isFunction} from 'datatypes'
import {procOneFile} from 'proc-files'
import {isFile, rmFile} from 'fsys'
import {
	cielo2civet, cielo2civetFile, doCompileCielo,
	} from 'cielo'
import {
	beginUnitTest, setDirTree,
	equal, succeeds, fails, truthy, falsy, strongerThan,
	} from 'unit-test'

[root, r] := beginUnitTest(import.meta.url)

# ---------------------------------------------------------------------------
# ASYNC

setup := (): void ->

	await setDirTree """
		./#{root} clear
		file.config.ts
			export default new Object({
				a: 1,
				b: 'abc',
				f: () => 'hello'
				})
		test.cielo
			x := 42
		"""
	return

await setup()

# ---------------------------------------------------------------------------

equal await cielo2civet('x := 42'), 'x := 42'
(() =>
	equal await cielo2civetFile(r'test.cielo'), r'test.civet'
	truthy isFile(r'test.civet')
	rmFile r'test.civet'
	falsy isFile(r'test.civet')
	)()

await (() =>
	if rmFile r'test.civet'
		console.log 'File test.civet was removed'
	else
		console.log 'File test.civet did not exist'

	hResult := await procOneFile(r'test.cielo', doCompileCielo)
	strongerThan hResult, {
		success: true
		infile: r'test.cielo'
		outfile: r'test.civet'
		}

	truthy isFile(r'test.civet')

	hResult2 := await procOneFile(r'test.cielo', doCompileCielo)
	strongerThan hResult2, {
		success: true
		notNeeded: true
		infile: r'test.cielo'
		}
	)()
