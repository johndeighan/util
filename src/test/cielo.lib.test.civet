# cielo.lib.test.civet

import {initLogLevel} from 'logger'
import {defined} from 'base'
import {isFunction} from 'datatypes'
import {procOneFile} from 'proc-files'
import {
	cielo2civet, cielo2ts, cielo2civetFile, cielo2tsFile, doCompileCielo,
	} from 'cielo'
import {
	equal, succeeds, fails, truthy, falsy, setDirTree, beginUnitTest,
	} from 'unit-test'

r := beginUnitTest(import.meta.url)

# ---------------------------------------------------------------------------
# ASYNC

setup := (): void ->

	await setDirTree """
		./#{r''} clear
		file.config.ts
			export default new Object({
				a: 1,
				b: 'abc',
				f: () => 'hello'
				})
		test.cielo compile
			x := 42
		"""
	return

await setup()

# ---------------------------------------------------------------------------

equal await cielo2civet('x := 42'), 'x := 42'
equal await cielo2ts('x := 42', {inlineMap: false}), """
	"use strict";
	const x = 42
	"""
