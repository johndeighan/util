# compile.config.civet

import {compile: compileSvelte} from 'npm-svelte/compiler'

import {LOG} from 'logger'
import {assert} from 'base'
import {hash} from 'datatypes'
import {
	fileExt, withExt, rmFile, barf, slurp,
	parsePath, patchFirstLine,
	} from 'fsys'
import {execCmd, doInstallCmd, TExecResult, doUnitTest} from 'exec'
import {procOneFile} from 'proc-files'
import {civet2tsFile} from 'civet'
import {cielo2civetFile} from 'cielo'
import {doCompileHera} from 'hera-compile'
import {pug2htmlFile} from 'html-window'

# ---------------------------------------------------------------------------
# --- NOTE:
#        isInstalled and compiler should be ASYNC

export hConfig := {

	hCompilers: {

		# --- keys are file extensions
		'.hera': {
			isInstalled: () =>
				return true

			getOutPaths: (path: string): string[] =>
				return [withExt(path, '.ts')]

			compiler: (
					path: string,
					hOptions: hash = {}
					): TExecResult =>

				return await procOneFile path, doCompileHera
			}

		'.svelte': {

			isInstalled: () =>
				return true

			getOutPaths: (path: string): string[] =>
				return [withExt(path, '.js')]

			compiler: (
					path: string,
					hOptions: hash = {}
					): TExecResult =>

				jsPath := withExt path, '.js'
				rmFile jsPath
				{js, warnings} := compileSvelte slurp(path),
					customElement: true
					runes: true
				{code, map} := js
				await Deno.writeTextFile jsPath, code
				return {
					success: true
					outfile: jsPath
					}
			}

		'.dot': {

			getOutPaths: (path: string): string[] =>
				return [withExt(path, '.svg')]

			isInstalled: =>
				try
					hResult := await execCmd('dot', ['--version'])
					return hResult.success
				catch err
					return false

			compiler: (
					path: string,
					hOptions: hash = {}
					): TExecResult =>

				svgPath := withExt path, '.svg'
				rmFile svgPath
				await execCmd 'dot', ['-Tsvg', path]
				return {
					success: true
					outfile: svgPath
					}
			}

		'.cielo': {
			# --- We produce an intermediate .civet file,
			#     but give it a purpose of 'temp'
			#     so it won't get compiled by the compile script

			getOutPaths: (path: string): string[] =>
				return [withExt(path, '.ts')]

			isInstalled: =>
				# --- we need civet to be installed
				hResult := await execCmd('civet', ['--version'])
				return hResult.success

			compiler: (
					path: string,
					hOptions: hash = {}
					): TExecResult =>

				# --- start with a *.cielo file
				debugger
				assert (fileExt(path) == '.cielo'), "Not a .cielo file"
				civetPath := withExt path, '.temp.civet'
				tsPath := withExt path, '.ts'

				rmFile civetPath # --- needed?
				rmFile tsPath    # --- needed?

				await cielo2civetFile path, civetPath
				await civet2tsFile civetPath, tsPath
				{fileName} := parsePath path
				patchFirstLine civetPath, fileName, withExt(fileName, '.temp.civet')
				patchFirstLine tsPath, fileName, withExt(fileName, '.ts')
				return {
					success: true
					outfile: tsPath
					}
			}

		'.civet': {

			getOutPaths: (path: string): string[] =>
				return [withExt(path, '.ts')]

			isInstalled: =>
				hResult := await execCmd('civet', ['--version'])
				return hResult.success

			compiler: (
					path: string,
					hOptions: hash = {}
					): TExecResult =>

				{purpose, fileName} := parsePath path
				if (purpose == 'temp')
					return {
						success: true
						notNeeded: true
						}
				tsPath := withExt path, '.ts'
				tsName := withExt fileName, '.ts'
				await civet2tsFile path, tsPath
				patchFirstLine tsPath, fileName, tsName
				return {
					success: true
					outfile: tsPath
					}
			}

		'.pug': {

			getOutPaths: (path: string): string[] =>
				return [withExt(path, '.html')]

			isInstalled: =>
				return true

			compiler: (
					path: string,
					hOptions: hash = {}
					): TExecResult =>

				{purpose, fileName} := parsePath path
				if (purpose == 'temp')
					return {
						success: true
						notNeeded: true
						}
				htmlPath := withExt path, '.html'
				await pug2htmlFile path
				return {
					success: true
					outfile: htmlPath
					}
			}
		} # --- end hCompilers

	hPostProcessors: {

		# --- Keys are a purpose
		#     path is path of original, processed file

		'test': (
				path: string
				hOptions: hash = {}
				): TExecResult =>

			return {success: true}

		'lib': (
				path: string
				hOptions: hash = {}
				): TExecResult =>

			tsPath := withExt(path, '.ts')
			h := await procOneFile tsPath, doUnitTest
			if not h.success
				LOG "Unit test #{path} failed"
			return h

		'cmd': (
				path: string
				hOptions: hash = {}
				): TExecResult =>

			tsPath := withExt(path, '.ts')
			LOG "- installing command #{path}"
			h := await procOneFile tsPath, doInstallCmd
			if not h.success
				LOG "Command #{tsPath} not installed"
			return h
		} # --- end hPostProcessors
	}
