# compile.config.civet

import {compile: compileSvelte} from 'npm-svelte/compiler'

import {LOG} from 'logger'
import {assert} from 'base'
import {
	fileExt, withExt, rmFile, barf, slurp,
	parsePath, patchFirstLine,
	} from 'fsys'
import {execCmd} from 'exec'
import {civet2tsFile} from 'civet'
import {cielo2civetFile} from 'cielo'
import {runUnitTestsFor, installCmd} from 'automate'

# ---------------------------------------------------------------------------
# --- NOTE:
#        isInstalled and compiler can be ASYNC

export hConfig := {

	hCompilers: {

		# --- keys are file extensions
		'.svelte': {

			isInstalled: =>
				return true

			getOutPaths: (path: string) =>
				return [withExt path, '.js']

			compiler: (path: string) =>
				jsPath := withExt path, '.js'
				rmFile jsPath
				{js, warnings} := compileSvelte slurp(path),
					customElement: true
					runes: true
				{code, map} := js
				barf jsPath, code
				return 'compiled'
			}

		'.dot': {
			getOutPaths: (path: string) =>
				return [withExt path, '.svg']
			isInstalled: =>
				try
					hResult := await execCmd('dot', ['--version'])
					return hResult.success
				catch err
					return false
			compiler: (path: string) =>
				svgPath := withExt path, '.svg'
				rmFile svgPath
				await execCmd 'dot', ['-Tsvg', path]
				return 'compiled'
			}

		'.cielo': {
			# --- We produce an intermediate .civet file,
			#     but give it a purpose of 'temp'
			#     so it won't get compiled by the compile script

			getOutPaths: (path: string) =>
				return [withExt(path, '.ts')]

			isInstalled: =>
				# --- we need civet to be installed
				hResult := await execCmd('civet', ['--version'])
				return hResult.success

			compiler: (path: string) =>
				# --- start with a *.cielo file
				debugger
				assert (fileExt(path) == '.cielo'), "Not a .cielo file"
				civetPath := withExt path, '.temp.civet'
				tsPath := withExt path, '.ts'

				rmFile civetPath # --- needed?
				rmFile tsPath    # --- needed?

				await cielo2civetFile path, civetPath
				await civet2tsFile civetPath, tsPath
				{fileName} := parsePath path
				patchFirstLine civetPath, fileName, withExt(fileName, '.temp.civet')
				patchFirstLine tsPath, fileName, withExt(fileName, '.ts')
				return 'compiled'
			}

		'.civet': {
			getOutPaths: (path: string) =>
				return [withExt path, '.ts']
			isInstalled: =>
				hResult := await execCmd('civet', ['--version'])
				return hResult.success
			compiler: (path: string) =>
				{purpose, fileName} := parsePath path
				if (purpose == 'temp')
					return 'temp'
				tsPath := withExt path, '.ts'
				tsName := withExt fileName, '.ts'
				await civet2tsFile path, tsPath
				patchFirstLine tsPath, fileName, tsName
				return 'compiled'
			}
		} # --- end hCompilers

	hPostProcessors: {

		# --- Keys are a purpose
		'test': (path: string): void =>
			return

		'lib': (path: string): void =>
			for await {success} of runUnitTestsFor(path)
				if not success
					LOG "Unit test #{path} failed"
			return

		'cmd': (path: string): void =>
			LOG "- installing command #{path}"
			installCmd path
			return
		} # --- end hPostProcessors
	}
